' SHOW.UXB -- prints the file its command tail names, a line at a time. The tail's spaces are
' dropped.
BIND MEM_READ PEEK
DIM TAIL_LENGTH AS UBYTE AT $0780
DIM INDEX AS UBYTE
DIM FILE_HANDLE AS UWORD
DIM FILE_NAME AS STRING * 80
DIM LINE_TEXT AS STRING * 80
FILE_NAME = ""
FOR INDEX = 1 TO TAIL_LENGTH
  IF MEM_READ($0780 + INDEX) <> 32
    FILE_NAME = FILE_NAME + CHR$(PEEK($0780 + INDEX))
  ENDIF
NEXT
FILE_HANDLE = OPEN(FILE_NAME, O.READ)
IF FILE_HANDLE = NOFILE
  PRINT "NO FILE"
  END
ENDIF
DO WHILE NOT EOF(FILE_HANDLE)
  LINPUT #FILE_HANDLE, LINE_TEXT
  PRINT "["; LINE_TEXT; "]"
LOOP
CLOSE FILE_HANDLE
