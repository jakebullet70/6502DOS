' KEYTEST.UXB -- prints the codes and the name of each key pressed, and the modifiers each
' time they change. Esc twice ends it.
#INCLUDE "DOS.UXI"
#INCLUDE "KEYS.UXI"

DIM CHARACTER AS UBYTE, SCAN AS UBYTE
DIM MODIFIERS AS UBYTE, SHOWN_MODIFIERS AS UBYTE
DIM ESCAPES AS UBYTE

' The modifiers named, as SHIFT CTRL ALT CAPS, or NONE.
FUNCT MODIFIER_NAMES(BITS AS UBYTE) AS STRING
  DIM NAMES AS STRING * 24
  NAMES = ""
  IF BITS AND KEYS.MOD_SHIFT THEN NAMES = NAMES + " SHIFT"
  IF BITS AND KEYS.MOD_CTRL THEN NAMES = NAMES + " CTRL"
  IF BITS AND KEYS.MOD_ALT THEN NAMES = NAMES + " ALT"
  IF BITS AND KEYS.MOD_CAPS THEN NAMES = NAMES + " CAPS"
  IF NAMES = "" THEN NAMES = " NONE"
  RETURN NAMES
END FUNCT

' The name of the extended key with scan code CODE, or "?".
FUNCT SCAN_NAME(CODE AS UBYTE) AS STRING
  SELECT CASE CODE
    CASE KEYS.SCAN_UP
      RETURN "UP"
    CASE KEYS.SCAN_DOWN
      RETURN "DOWN"
    CASE KEYS.SCAN_LEFT
      RETURN "LEFT"
    CASE KEYS.SCAN_RIGHT
      RETURN "RIGHT"
    CASE KEYS.SCAN_HOME
      RETURN "HOME"
    CASE KEYS.SCAN_END
      RETURN "END"
    CASE KEYS.SCAN_PGUP
      RETURN "PGUP"
    CASE KEYS.SCAN_PGDN
      RETURN "PGDN"
    CASE KEYS.SCAN_INSERT
      RETURN "INSERT"
    CASE KEYS.SCAN_DELETE
      RETURN "DELETE"
    CASE KEYS.SCAN_CTRL_LEFT
      RETURN "CTRL+LEFT"
    CASE KEYS.SCAN_CTRL_RIGHT
      RETURN "CTRL+RIGHT"
    CASE KEYS.SCAN_CTRL_HOME
      RETURN "CTRL+HOME"
    CASE KEYS.SCAN_CTRL_END
      RETURN "CTRL+END"
    CASE KEYS.SCAN_CTRL_PGUP
      RETURN "CTRL+PGUP"
    CASE KEYS.SCAN_CTRL_PGDN
      RETURN "CTRL+PGDN"
    CASE KEYS.SCAN_CTRL_2
      RETURN "CTRL+2"
    CASE KEYS.SCAN_F1 TO KEYS.SCAN_F10
      RETURN "F" + MID$(STR$(CODE - KEYS.SCAN_F1 + 1), 2)
    CASE KEYS.SCAN_SHIFT_F1 TO KEYS.SCAN_SHIFT_F10
      RETURN "SHIFT+F" + MID$(STR$(CODE - KEYS.SCAN_SHIFT_F1 + 1), 2)
    CASE KEYS.SCAN_CTRL_F1 TO KEYS.SCAN_CTRL_F10
      RETURN "CTRL+F" + MID$(STR$(CODE - KEYS.SCAN_CTRL_F1 + 1), 2)
    CASE KEYS.SCAN_ALT_F1 TO KEYS.SCAN_ALT_F10
      RETURN "ALT+F" + MID$(STR$(CODE - KEYS.SCAN_ALT_F1 + 1), 2)
    CASE KEYS.SCAN_ALT_1 TO KEYS.SCAN_ALT_EQUALS
      RETURN "ALT+" + MID$("1234567890-=", CODE - KEYS.SCAN_ALT_1 + 1, 1)
    CASE KEYS.SCAN_ALT_Q TO KEYS.SCAN_ALT_P
      RETURN "ALT+" + MID$("QWERTYUIOP", CODE - KEYS.SCAN_ALT_Q + 1, 1)
    CASE KEYS.SCAN_ALT_A TO KEYS.SCAN_ALT_L
      RETURN "ALT+" + MID$("ASDFGHJKL", CODE - KEYS.SCAN_ALT_A + 1, 1)
    CASE KEYS.SCAN_ALT_Z TO KEYS.SCAN_ALT_M
      RETURN "ALT+" + MID$("ZXCVBNM", CODE - KEYS.SCAN_ALT_Z + 1, 1)
  END SELECT
  RETURN "?"
END FUNCT

' The name of the one-character key CODE.
FUNCT CHARACTER_NAME(CODE AS UBYTE) AS STRING
  SELECT CASE CODE
    CASE KEYS.BACKSPACE
      RETURN "BACKSPACE"
    CASE KEYS.TAB
      RETURN "TAB"
    CASE KEYS.ENTER
      RETURN "ENTER"
    CASE KEYS.ESC
      RETURN "ESC"
    CASE KEYS.SPACE
      RETURN "SPACE"
    CASE KEYS.CTRL_A TO 26
      RETURN "CTRL+" + CHR$(CODE + 64)
    CASE 28
      RETURN "CTRL+\"
    CASE 29
      RETURN "CTRL+]"
    CASE KEYS.CTRL_6
      RETURN "CTRL+6"
    CASE KEYS.CTRL_MINUS
      RETURN "CTRL+-"
  END SELECT
  RETURN CHR$(CODE)
END FUNCT

PRINT "KEYTEST: PRESS KEYS. ESC TWICE ENDS IT."
SHOWN_MODIFIERS = $FF
ESCAPES = 0
DO
  ' API_CON_STATUS gives A = $FF when a key waits, and the modifiers in X.
  SYS DOS.API_CON_STATUS
  MODIFIERS = DOS.REG_X
  IF MODIFIERS <> SHOWN_MODIFIERS
    PRINT "MODIFIERS:"; MODIFIER_NAMES(MODIFIERS)
    SHOWN_MODIFIERS = MODIFIERS
  ENDIF
  IF DOS.REG_A <> 0
    CHARACTER = GETKEY()
    IF CHARACTER = KEYS.EXTENDED
      SCAN = GETKEY()
      PRINT "0"; SCAN; "  "; SCAN_NAME(SCAN)
      ESCAPES = 0
    ELSE
      PRINT CHARACTER; "  "; CHARACTER_NAME(CHARACTER)
      IF CHARACTER = KEYS.ESC
        ESCAPES = ESCAPES + 1
      ELSE
        ESCAPES = 0
      ENDIF
    ENDIF
  ENDIF
LOOP UNTIL ESCAPES = 2
