'=============================================================================================
' -- Callable Commandlet -----> DATE [yyyy-mm-dd] [SILENT]
' -- With no date, prints the date of the RTC with its weekday, such as Sun 2026-10-18.
' -- With a date, sets the RTC to it and prints nothing. The month and the day are 1 or 2
' -- digits. The year runs 2000 to 2099.
' -- Sets P1$ to the date, 2026-10-18, P2$ to the weekday, Sun, and P3$ to P5$ to the year,
' -- the month and the day, 2026, 10 and 18. Sets P1$ to an empty string on an invalid date.
' -- SILENT, in capitals, prints nothing. It is P1$ with no date, else P2$.
' -- A date that is not like that, or does not exist, prints Invalid date and gives exit
' -- code 1. Exit code 0 otherwise.
' --
' -- From a script:
' --     DATE SILENT
' --     PRINT "Today is " + P1$
'=============================================================================================
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
#INCLUDE "SCOM.UXI"
CONST WEEKDAY_NAMES$ = "SunMonTueWedThuFriSat"

DIM ARGUMENT AS STRING * 255
DIM FIELDS(3) AS UWORD

' Clears P1$, prints Invalid date unless SILENT, and ends with exit code 1.
SUB INVALID_DATE()
  HEAP.SYS_STRINGS_SET(SLOT_P1, "")
  IF SILENT = 0 THEN PRINT "Invalid date"
  END 1
END SUB

' The number with no space in front.
FUNCT PLAIN(NUMBER AS UWORD) AS STRING
  RETURN MID$(STR$(NUMBER), 2)
END FUNCT

' The number as 2 digits, with a 0 in front below 10.
FUNCT TWO_DIGITS(NUMBER AS UBYTE) AS STRING
  RETURN RIGHT$("0" + PLAIN(NUMBER), 2)
END FUNCT

' Reads ARGUMENT as numbers of 1 to 4 digits, with SEPARATOR between them, into FIELDS.
' Returns the count of numbers, or 0 when ARGUMENT has another character, an empty number or
' more than 3 numbers.
FUNCT SPLIT_NUMBERS(SEPARATOR AS UBYTE) AS UBYTE
  DIM POSITION AS UBYTE, CHARACTER AS UBYTE, DIGITS AS UBYTE, COUNT AS UBYTE
  COUNT = 0
  DIGITS = 0
  FIELDS(0) = 0
  POSITION = 0
  DO WHILE POSITION < LEN(ARGUMENT)
    CHARACTER = ContentsAt(@ARGUMENT + 2 + POSITION)
    POSITION = POSITION + 1
    IF CHARACTER = SEPARATOR THEN
      IF DIGITS = 0 THEN RETURN 0
      COUNT = COUNT + 1
      IF COUNT = 3 THEN RETURN 0
      FIELDS(COUNT) = 0
      DIGITS = 0
    ELSE
      IF CHARACTER < ASC("0") THEN RETURN 0
      IF CHARACTER > ASC("9") THEN RETURN 0
      DIGITS = DIGITS + 1
      IF DIGITS > 4 THEN RETURN 0
      FIELDS(COUNT) = FIELDS(COUNT) * 10 + CHARACTER - ASC("0")
    END IF
  LOOP
  IF DIGITS = 0 THEN RETURN 0
  RETURN COUNT + 1
END FUNCT

ARGUMENT = HEAP.SYS_STRINGS_GET(SLOT_P1)
IF HEAP.SYS_STRINGS_GET(SLOT_P2) = "SILENT" THEN SILENT = 1
IF ARGUMENT = "SILENT" THEN
  SILENT = 1
  ARGUMENT = ""
END IF
IF ARGUMENT <> "" THEN
  IF SPLIT_NUMBERS(ASC("-")) <> 3 THEN INVALID_DATE()
  IF FIELDS(1) > 255 OR FIELDS(2) > 255 THEN INVALID_DATE()
  DOS.SETDATE(FIELDS(0), FIELDS(1), FIELDS(2))
  IF DOS.ERROR <> 0 THEN INVALID_DATE()
END IF
DOS.GETDATE()
HEAP.SYS_STRINGS_SET(SLOT_P1, PLAIN(DOS.YEAR) + "-" + TWO_DIGITS(DOS.MONTH) + "-" + TWO_DIGITS(DOS.DAY))
HEAP.SYS_STRINGS_SET(SLOT_P2, MID$(WEEKDAY_NAMES$, DOS.WEEKDAY * 3 + 1, 3))
HEAP.SYS_STRINGS_SET(SLOT_P3, PLAIN(DOS.YEAR))
HEAP.SYS_STRINGS_SET(SLOT_P4, PLAIN(DOS.MONTH))
HEAP.SYS_STRINGS_SET(SLOT_P5, PLAIN(DOS.DAY))
IF SILENT = 0 AND ARGUMENT = "" THEN PRINT HEAP.SYS_STRINGS_GET(SLOT_P2); " "; HEAP.SYS_STRINGS_GET(SLOT_P1)
END 0
