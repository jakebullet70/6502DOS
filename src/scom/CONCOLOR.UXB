'=============================================================================================
' -- Callable Commandlet -----> CONCOLOR
' -- Sets the console color to the CONSOLE color of the current theme. Prints nothing.
' -- The registry key THEME names the theme file: THEME = DARK reads C:\sys\themes\DARK.GTH.
' -- Exit code 0 when the color is set. The color stays as it is otherwise.
' -- Exit code 1 when the key is missing, 2 when the file is missing or has no CONSOLE byte.
' --
' -- From a script:
' --     REG THEME = DARK
' --     CONCOLOR
'=============================================================================================
#INCLUDE "DOS.UXI"
DIM THEME_NAME AS STRING * 128, THEME_COLORS(DOS.THEME_SIZE) AS UBYTE

THEME_NAME = DOS.REG_GET("THEME", "")
IF DOS.ERROR THEN END 1
IF DOS.READ_THEME(DOS.THEME_PATH(THEME_NAME), @THEME_COLORS) <= DOS.THEME_CONSOLE THEN END 2
DOS.SET_COLOR(THEME_COLORS(DOS.THEME_CONSOLE))
END 0
