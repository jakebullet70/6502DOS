'=============================================================================================
' -- Callable Commandlet -----> WHERE name [SILENT]
' -- Prints the path of the program the shell runs for name: C:\sys\HEAD.COM.
' -- The look-up is the shell's. The name is taken in capitals. A name with an extension is
' -- looked for as typed, any other as NAME.SCOM, then NAME.COM, then NAME.CMD. A name with a
' -- directory is looked for there only, any other in the current directory, then in each
' -- directory of PATH$. A name found in the current directory is printed after its path.
' -- Aliases and the shell's statements are not looked up. A name with * or ? names nothing.
' -- Sets P1$ to the path, and to an empty string when nothing is found.
' -- SILENT, in capitals, prints nothing.
' -- A name not found prints File not found and gives exit code 1. No name prints Required
' -- parameter missing and gives exit code 2. Exit code 0 otherwise.
' --
' -- From a script:
' --     WHERE HEAD SILENT
' --     IF P1$ = "" PRINT "No HEAD"
'=============================================================================================
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
#INCLUDE "SCOM.UXI"
CONST SLOT_PATH AS UBYTE = 9                       ' PATH$, system string 9
DIM PROGRAM_NAME AS STRING * 255, PROGRAM_PATH AS STRING * 255
DIM SEARCH_PATH AS STRING * 255, SEARCH_DIRECTORY AS STRING * 255
DIM INDEX AS UBYTE, CODE AS UBYTE, NAME_START AS UBYTE
DIM START AS UBYTE, FINISH AS UBYTE

' Whether CODE is \, / or :, which end a directory.
FUNCT IS_SEPARATOR(CODE AS UBYTE) AS UBYTE
  IF CODE = 92 OR CODE = 47 OR CODE = 58 THEN RETURN 1
  RETURN 0
END FUNCT

' Whether PROGRAM_PATH names a file.
FUNCT IS_FILE() AS UBYTE
  DOS.FINDFIRST(PROGRAM_PATH, 0)
  IF DOS.ERROR = 0 THEN RETURN 1
  RETURN 0
END FUNCT

' Whether the program PROGRAM_NAME is in DIRECTORY$, which is empty or ends in a separator.
' Puts the path in PROGRAM_PATH.
FUNCT FIND_IN(DIRECTORY$) AS UBYTE
  IF INSTR(PROGRAM_NAME, ".", NAME_START) THEN
    PROGRAM_PATH = DIRECTORY$ + PROGRAM_NAME
    RETURN IS_FILE()
  END IF
  PROGRAM_PATH = DIRECTORY$ + PROGRAM_NAME + ".SCOM"
  IF IS_FILE() THEN RETURN 1
  PROGRAM_PATH = DIRECTORY$ + PROGRAM_NAME + ".COM"
  IF IS_FILE() THEN RETURN 1
  PROGRAM_PATH = DIRECTORY$ + PROGRAM_NAME + ".CMD"
  RETURN IS_FILE()
END FUNCT

' Whether PROGRAM_NAME names a program, with its path in PROGRAM_PATH.
FUNCT FIND_PROGRAM() AS UBYTE
  IF INSTR(PROGRAM_NAME, "*") OR INSTR(PROGRAM_NAME, "?") THEN RETURN 0
  IF NAME_START > 1 THEN RETURN FIND_IN("")
  SEARCH_DIRECTORY = DOS.GETCWD(0)
  IF SEARCH_DIRECTORY <> "" THEN SEARCH_DIRECTORY = SEARCH_DIRECTORY + "\"
  IF FIND_IN(CHR$(65 + DOS.GETDRIVE()) + ":\" + SEARCH_DIRECTORY) THEN RETURN 1
  SEARCH_PATH = HEAP.SYS_STRINGS_GET(SLOT_PATH)
  START = 1
  DO WHILE START <= LEN(SEARCH_PATH)
    FINISH = INSTR(SEARCH_PATH, ";", START)
    IF FINISH = 0 THEN FINISH = LEN(SEARCH_PATH) + 1
    SEARCH_DIRECTORY = MID$(SEARCH_PATH, START, FINISH - START)
    START = FINISH + 1
    IF SEARCH_DIRECTORY <> "" THEN
      IF IS_SEPARATOR(ASC(RIGHT$(SEARCH_DIRECTORY, 1))) = 0 THEN SEARCH_DIRECTORY = SEARCH_DIRECTORY + "\"
      IF FIND_IN(SEARCH_DIRECTORY) THEN RETURN 1
    END IF
  LOOP
  RETURN 0
END FUNCT

PROGRAM_NAME = HEAP.SYS_STRINGS_GET(SLOT_P1)
IF HEAP.SYS_STRINGS_GET(SLOT_P2) = "SILENT" THEN SILENT = 1
IF PROGRAM_NAME = "" THEN
  IF SILENT = 0 THEN PRINT "Required parameter missing"
  END 2
END IF
' The name in capitals. NAME_START is the first character after its directory.
NAME_START = 1
FOR INDEX = 1 TO LEN(PROGRAM_NAME)
  CODE = ContentsAt(@PROGRAM_NAME + 1 + INDEX)
  IF CODE >= 97 AND CODE <= 122 THEN ContentsAt(@PROGRAM_NAME + 1 + INDEX) = CODE - 32
  IF IS_SEPARATOR(CODE) THEN NAME_START = INDEX + 1
NEXT
IF FIND_PROGRAM() = 0 THEN
  HEAP.SYS_STRINGS_SET(SLOT_P1, "")
  IF SILENT = 0 THEN PRINT "File not found"
  END 1
END IF
HEAP.SYS_STRINGS_SET(SLOT_P1, PROGRAM_PATH)
IF SILENT = 0 THEN PRINT PROGRAM_PATH
END 0
