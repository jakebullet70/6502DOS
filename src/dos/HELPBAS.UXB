'=============================================================================================
' -- HELPBAS [topic | -R]
' -- runs HELP -F C:\sys\basic\HELPBAS.HLP with P1$: it prints the help on the
' -- MSBASIC keyword topic, or with no topic lists the topic names, or with -R writes
' -- C:\sys\basic\HELPBAS.IDX anew. HELP gives the exit code.
' -- -H or -? as the first parameter runs HELP HELPBAS. HELP that does not run prints its error
' -- message and gives exit code 1.
' --
' -- From a prompt:
' --     HELPBAS
' --     HELPBAS print
' --     HELPBAS -R
'=============================================================================================
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
#INCLUDE "ARGS.UXI"
ARGS.HELP_SWITCH("HELPBAS")
DOS.EXEC(DOS.PROGRAM_FOLDER() + "HELP.COM", "-F " + DOS.PROGRAM_FOLDER() + "basic\HELPBAS.HLP " + HEAP.SYS_STRINGS_GET(ARGS.SLOT_P1))
IF DOS.ERROR <> 0 THEN
  PRINT DOS.ERRMSG(DOS.ERROR)
  END ARGS.EXIT_CODE.FAILED
END IF
END DOS.EXITCODE()
