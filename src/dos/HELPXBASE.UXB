'=============================================================================================
' -- HELPXBASE [topic | -R]
' -- runs HELP -F C:\sys\xbase\HELPXBASE.HLP with P1$: it prints the help on the
' -- DB command topic, or with no topic lists the topic names, or with -R writes
' -- C:\sys\xbase\HELPXBASE.IDX anew. HELP gives the exit code.
' -- -H or -? as the first parameter runs HELP HELPXBASE. HELP that does not run prints its error
' -- message and gives exit code 1.
' --
' -- From a prompt:
' --     HELPXBASE
' --     HELPXBASE replace
' --     HELPXBASE -R
'=============================================================================================
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
#INCLUDE "ARGS.UXI"
ARGS.HELP_SWITCH("HELPXBASE")
DOS.EXEC(DOS.PROGRAM_FOLDER() + "HELP.COM", "-F " + DOS.PROGRAM_FOLDER() + "xbase\HELPXBASE.HLP " + HEAP.SYS_STRINGS_GET(ARGS.SLOT_P1))
IF DOS.ERROR <> 0 THEN
  PRINT DOS.ERRMSG(DOS.ERROR)
  END ARGS.EXIT_CODE.FAILED
END IF
END DOS.EXITCODE()
