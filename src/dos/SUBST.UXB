'=============================================================================================
' -- SUBST [drive: path | drive: -D]
' -- makes drive a name for the directory path: drive:\ is path, and drive:\X is path\X. A drive
' -- already substituted gets the new path. -D makes drive no drive.
' -- drive is A:, B:, or a letter past the card's, up to H:. The current drive cannot be
' -- changed. Host files do not support SUBST.
' -- With no parameters, SUBST lists the substituted drives: E: => C:\DOCS.
' -- .. in drive:\ goes up past path.
' -- -H or -? as the first parameter runs HELP SUBST.
' -- Exit codes: 0 set, removed or listed. 1 the kernel's error, such as a path not found. 4
' -- Required parameter missing, Invalid switch, Too many parameters, and Invalid drive.
' --
' -- From a prompt:
' --     SUBST E: C:\DOCS
' --     SUBST
' --     SUBST E: -D
'=============================================================================================
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
#INCLUDE "ARGS.UXI"
' Trap: the card driver has one unit, so C: is the only card drive, and each substituted drive
' names a directory of C:.
CONST CARD_DRIVE$ = "C:"
' Checklist: DRIVES in src/asm/mem.inc.
CONST DRIVE_COUNT AS UBYTE = 8

DIM ARGUMENT AS STRING * 255, DRIVE_NAME AS STRING * 255, FOLDER AS STRING * 255
DIM DRIVE AS UBYTE, REMOVE AS UBYTE

' Prints the message of DOS.ERROR and ends the program. The kernel gives ERR_BAD_FUNCTION only
' for host files.
SUB STOP_ON_ERROR()
  IF DOS.ERROR = DOS.ERR_CURRENT_DIR THEN
    PRINT "Cannot change the current drive"
  ELSEIF DOS.ERROR = DOS.ERR_BAD_FUNCTION THEN
    PRINT "Host files do not support SUBST"
  ELSE
    PRINT DOS.ERRMSG(DOS.ERROR)
  END IF
  END ARGS.EXIT_CODE.FAILED
END SUB

' ---- the arguments ----
ARGS.HELP_SWITCH("SUBST")
DO
  ARGUMENT = ARGS.PARAMETER()
  IF ARGUMENT = "" THEN EXIT DO
  IF ASC(ARGUMENT) = ASC("-") THEN
    IF LEN(ARGUMENT) <> 2 OR (ASC(MID$(ARGUMENT, 2)) OR $20) <> ASC("d") THEN ARGS.FAIL(BAD_PARAMETER, ARGS.INVALID_SWITCH$)
    REMOVE = 1
  ELSEIF DRIVE_NAME = "" THEN
    DRIVE_NAME = ARGUMENT
  ELSEIF FOLDER = "" THEN
    FOLDER = ARGUMENT
  ELSE
    ARGS.FAIL(BAD_PARAMETER, ARGS.TOO_MANY$)
  END IF
LOOP

' ---- the list ----
IF DRIVE_NAME = "" THEN
  IF REMOVE <> 0 THEN ARGS.FAIL(BAD_PARAMETER, ARGS.MISSING$)
  FOR DRIVE = 0 TO DRIVE_COUNT - 1
    FOLDER = DOS.GET_SUBST(DRIVE)
    IF DOS.ERROR = 0 THEN PRINT CHR$(ASC("A") + DRIVE); ": => "; CARD_DRIVE$; "\"; FOLDER
    IF DOS.ERROR = DOS.ERR_BAD_FUNCTION THEN STOP_ON_ERROR()
  NEXT
  END ARGS.EXIT_CODE.DONE
END IF

' ---- set or remove ----
IF LEN(DRIVE_NAME) <> 2 OR MID$(DRIVE_NAME, 2, 1) <> ":" THEN ARGS.FAIL(BAD_PARAMETER, "Invalid drive")
' A first character other than a letter wraps past H:, which the kernel refuses.
DRIVE = (ASC(DRIVE_NAME) OR $20) - ASC("a")
IF REMOVE <> 0 THEN
  IF FOLDER <> "" THEN ARGS.FAIL(BAD_PARAMETER, ARGS.TOO_MANY$)
ELSEIF FOLDER = "" THEN
  ARGS.FAIL(BAD_PARAMETER, ARGS.MISSING$)
END IF
DOS.SET_SUBST(DRIVE, FOLDER)
IF DOS.ERROR <> 0 THEN STOP_ON_ERROR()
END ARGS.EXIT_CODE.DONE
