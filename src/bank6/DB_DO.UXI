' DB_DO.UXI -- the command files of XBASE.UXB: DO, RETURN, CANCEL, IF, ELSE, ENDIF, DO WHILE,
' ENDDO, PROC, ENDPROC, GOSUB, ON KEY, ACCEPT, INPUT, WAIT and MODIFY COMMAND. XBASE.UXB includes it after DB_INDEX.UXI. A command file is under 64 KB.

CONST DO_LIMIT AS UBYTE = 8
DIM DO_DEPTH AS UBYTE               ' the command files running, 0 at the prompt
DIM DO_FILE AS UBYTE                ' the innermost file's handle
DIM DO_LINE AS UWORD                ' the number of the line the innermost file last read
DIM CALLER_FILE(8) AS UBYTE         ' DO_FILE of each caller, the outermost first
DIM CALLER_LINE(8) AS UWORD         ' DO_LINE of each caller
' The bytes of the innermost file read and not yet run. A DO seeks its caller back past them.
DIM READ_AHEAD(255) AS UBYTE
DIM AHEAD_COUNT AS UBYTE
DIM AHEAD_INDEX AS UBYTE
DIM LINE_BYTES AS UBYTE            ' the bytes of the line READ_DO_LINE read, with its CR and LF
DIM LINES_JOINED AS UBYTE          ' the lines READ_DO_LINE joined to its first
' The IFs open in the lines being skipped, 0 when lines run. An IF has at most one ELSE.
DIM SKIP_DEPTH AS UBYTE
' What the lines being skipped look for. IF_LINES and LOOP_LINES count in SKIP_DEPTH.
ENUM SKIP_KIND
  IF_LINES, LOOP_LINES, PROC_BODY, PROC_SEARCH
END ENUM
DIM SKIP_MODE AS UBYTE             ' a SKIP_KIND
DIM WANTED_PROC AS STRING * 43     ' the name PROC_SEARCH looks for, as TOKEN holds it
' The DO WHILEs and GOSUBs running, the outermost first, DO_LIMIT in all.
DIM LOOP_DEPTH AS UBYTE
DIM LOOP_SPOT(8) AS UWORD           ' where the line to go back to starts in its file
DIM LOOP_LINE(8) AS UWORD           ' that line's number
DIM LOOP_IS_GOSUB(8) AS UBYTE       ' 1 when a GOSUB pushed it, 0 for a DO WHILE
DIM CALLER_LOOPS(8) AS UBYTE        ' LOOP_DEPTH of each caller
' The PROC name ON KEY bound to each of F1 to F10: a length, 0 for none, and the text.
CONST KEY_PROC_SIZE AS UBYTE = 11
DIM KEY_PROCS(110) AS UBYTE
DIM BROWSE_BACK AS UWORD            ' DO_LINE + 1 of the BROWSE an F key left, 0 for none

' Ends the innermost command file, and its caller goes on. The last file's end drops every ON KEY.
' At the prompt it does nothing.
SUB END_DO()
  DIM SLOT AS UBYTE
  IF DO_DEPTH = 0 THEN RETURN
  DOS.REG_X = DO_FILE
  SYS DOS.API_CLOSE
  DO_DEPTH = DO_DEPTH - 1
  DO_FILE = CALLER_FILE(DO_DEPTH)
  DO_LINE = CALLER_LINE(DO_DEPTH)
  LOOP_DEPTH = CALLER_LOOPS(DO_DEPTH)
  SKIP_DEPTH = 0
  SKIP_MODE = SKIP_KIND.IF_LINES
  AHEAD_COUNT = 0
  AHEAD_INDEX = 0
  IF DO_DEPTH = 0
    BROWSE_BACK = 0
    FOR SLOT = 0 TO 9
      ContentsAt(@KEY_PROCS + SLOT * KEY_PROC_SIZE) = 0
    NEXT
  ENDIF
END SUB

' CANCEL: ends every command file.
SUB CANCEL_DO()
  DO WHILE DO_DEPTH > 0
    END_DO()
  LOOP
END SUB

' Copies the next line of the innermost command file into COMMAND_LINE and counts it in DO_LINE.
' A line ends in LF; a CR is dropped. A tab reads as a space, in quoted text too. A line that ends in a space and _ joins the next, which loses
' its leading spaces. A line is cut at 240 characters, joined lines counted together; a DO WHILE
' line is under 256 bytes, joined lines counted together. Returns 1, or 0 at the
' end of the file, which ends the file as RETURN does. A read error is reported, and ends every
' file.
' Trap: a comment that ends in a space and _ joins the next line to the comment.
FUNCT READ_DO_LINE() AS UBYTE
  DIM CODE AS UBYTE, LENGTH AS UBYTE, LEADING AS UBYTE
  LENGTH = 0
  CODE = 0
  LEADING = 0
  LINE_BYTES = 0
  LINES_JOINED = 0
  DO
    IF AHEAD_INDEX = AHEAD_COUNT
      AHEAD_INDEX = 0
      DOS.REG_X = DO_FILE
      DOS.R0 = @READ_AHEAD
      DOS.R1 = 255
      SYS DOS.API_READ
      DOS.READ_ERR_STATUS()
      IF DOS.ERROR
        FILE_ERROR()
        CANCEL_DO()
        RETURN 0
      ENDIF
      AHEAD_COUNT = DOS.R1
      IF AHEAD_COUNT = 0
        ' The last line has no LF when bytes were read.
        IF CODE <> 0 THEN EXIT DO
        IF SKIP_MODE = SKIP_KIND.PROC_SEARCH
          REPORT_ERROR("Proc not found: " + WANTED_PROC)
          CANCEL_DO()
          RETURN 0
        ENDIF
        END_DO()
        RETURN 0
      ENDIF
    ENDIF
    CODE = READ_AHEAD(AHEAD_INDEX)
    IF CODE = 9 THEN CODE = 32
    AHEAD_INDEX = AHEAD_INDEX + 1
    LINE_BYTES = LINE_BYTES + 1
    IF CODE = 10
      IF LENGTH < 2 THEN EXIT DO
      IF ContentsAt(@COMMAND_LINE + 1 + LENGTH) <> 95 OR ContentsAt(@COMMAND_LINE + LENGTH) <> 32 THEN EXIT DO
      LENGTH = LENGTH - 1
      LEADING = 1
      DO_LINE = DO_LINE + 1
      LINES_JOINED = LINES_JOINED + 1
    ELSEIF CODE <> 13 AND LENGTH < 240 AND (LEADING = 0 OR CODE <> 32)
      LEADING = 0
      ContentsAt(@COMMAND_LINE + 2 + LENGTH) = CODE
      LENGTH = LENGTH + 1
    ENDIF
  LOOP
  ContentsAt(@COMMAND_LINE + 1) = LENGTH
  DO_LINE = DO_LINE + 1
  RETURN 1
END FUNCT

' DO name: runs the command file name, with .PRG added when it has no extension. Its lines run
' as if typed at the prompt. The file stays open while it runs. Files nest DO_LIMIT deep.
SUB DO_DO()
  IF REST = ""
    SYNTAX_ERROR()
    RETURN
  ENDIF
  NEXT_WORD()
  IF IS("WHILE")
    DO_WHILE()
    RETURN
  ENDIF
  REST = TRIM$(MID$(TRIM$(COMMAND_LINE), 3))
  RUN_COMMAND_FILE()
END SUB

' Runs the command file named in REST, with .PRG added when it has no extension. Its caller goes
' on when it ends. An error is reported, and nothing runs.
SUB RUN_COMMAND_FILE()
  DIM HANDLE AS UBYTE, BACK AS UWORD
  IF DO_DEPTH = DO_LIMIT
    REPORT_ERROR("Too many DO levels")
    RETURN
  ENDIF
  REST = FIND_FILE(WITH_EXTENSION(REST, ".PRG"))
  DOS.R0 = @REST + 1
  DOS.REG_A = DOS.ACCESS_READ
  SYS DOS.API_OPEN
  DOS.READ_ERR_STATUS()
  IF DOS.ERROR
    FILE_ERROR()
    RETURN
  ENDIF
  HANDLE = DOS.REG_X
  ' At the prompt the read-ahead is empty, and the caller's copy unused.
  BACK = AHEAD_COUNT - AHEAD_INDEX
  IF BACK <> 0
    DOS.REG_X = DO_FILE
    DOS.REG_A = 1
    DOS.R0 = 0 - BACK
    DOS.R1 = $FFFF
    SYS DOS.API_SEEK
  ENDIF
  AHEAD_COUNT = 0
  AHEAD_INDEX = 0
  CALLER_FILE(DO_DEPTH) = DO_FILE
  CALLER_LINE(DO_DEPTH) = DO_LINE
  CALLER_LOOPS(DO_DEPTH) = LOOP_DEPTH
  DO_DEPTH = DO_DEPTH + 1
  DO_FILE = HANDLE
  DO_LINE = 0
END SUB

' IF condition: when the condition is false, the lines up to the ELSE or ENDIF of this IF are
' skipped. An ELSE run skips up to its ENDIF; an ENDIF run does nothing. At the prompt IF is an
' error, and ELSE does nothing.
SUB DO_IF()
  IF AT_PROMPT() THEN RETURN
  IF TEST_CONDITION() = 0 THEN SKIP_DEPTH = 1
END SUB

' 1 at the prompt, with the error printed; 0 in a command file.
FUNCT AT_PROMPT() AS UBYTE
  IF DO_DEPTH THEN RETURN 0
  REPORT_ERROR("Only in a command file")
  RETURN 1
END FUNCT

' The logical in REST: 1 when true or after an error, 0 when false.
FUNCT TEST_CONDITION() AS UBYTE
  CURSOR = 1
  EVALUATE()
  IF FAILED THEN RETURN 1
  IF CURRENT_CHAR() <> 0
    SYNTAX_ERROR()
    RETURN 1
  ENDIF
  IF VALUE_TYPE(0) <> VALUE_KIND.LOGICAL
    TYPE_MISMATCH()
    RETURN 1
  ENDIF
  RETURN VALUE_STACK(0) <> 0
END FUNCT

' DO WHILE condition: when the condition is true, the lines up to its ENDDO run, and ENDDO goes
' back to the DO WHILE. When false, they are skipped. At the prompt DO WHILE is an error.
SUB DO_WHILE()
  IF AT_PROMPT() THEN RETURN
  IF TEST_CONDITION() = 0
    SKIP_DEPTH = 1
    SKIP_MODE = SKIP_KIND.LOOP_LINES
    RETURN
  ENDIF
  IF FAILED THEN RETURN
  PUSH_FRAME(LINE_BYTES, DO_LINE - LINES_JOINED, 0)
END SUB

' Pushes the place BYTES_BACK before the next line to read, numbered LINE_NUMBER, for ENDDO or
' ENDPROC to go back to. More than DO_LIMIT is an error.
SUB PUSH_FRAME(BYTES_BACK AS UBYTE, LINE_NUMBER AS UWORD, IS_GOSUB AS UBYTE)
  IF LOOP_DEPTH = DO_LIMIT
    REPORT_ERROR("Too many DO levels")
    RETURN
  ENDIF
  ' The position API_SEEK gives is past the read-ahead.
  DOS.REG_X = DO_FILE
  DOS.REG_A = 1
  DOS.R0 = 0
  DOS.R1 = 0
  SYS DOS.API_SEEK
  LOOP_SPOT(LOOP_DEPTH) = DOS.R0 - AHEAD_COUNT + AHEAD_INDEX - BYTES_BACK
  LOOP_LINE(LOOP_DEPTH) = LINE_NUMBER
  LOOP_IS_GOSUB(LOOP_DEPTH) = IS_GOSUB
  LOOP_DEPTH = LOOP_DEPTH + 1
END SUB

' Makes the innermost command file read next the line at SPOT, numbered LINE_NUMBER + 1.
SUB GO_TO_LINE(SPOT AS UWORD, LINE_NUMBER AS UWORD)
  DOS.REG_X = DO_FILE
  DOS.REG_A = 0
  DOS.R0 = SPOT
  DOS.R1 = 0
  SYS DOS.API_SEEK
  AHEAD_COUNT = 0
  AHEAD_INDEX = 0
  DO_LINE = LINE_NUMBER
END SUB

' ENDDO: goes back to the DO WHILE of the innermost loop running. Without one it does nothing.
SUB END_LOOP()
  IF LOOP_DEPTH = 0 THEN RETURN
  IF LOOP_IS_GOSUB(LOOP_DEPTH - 1) THEN RETURN
  LOOP_DEPTH = LOOP_DEPTH - 1
  GO_TO_LINE(LOOP_SPOT(LOOP_DEPTH), LOOP_LINE(LOOP_DEPTH) - 1)
END SUB

' PROC name: a line that runs skips to its ENDPROC, so a PROC runs only by GOSUB. A PROC is not
' inside an IF, a DO WHILE or a PROC. At the prompt PROC is an error.
SUB DO_PROC()
  IF AT_PROMPT() THEN RETURN
  SKIP_DEPTH = 1
  SKIP_MODE = SKIP_KIND.PROC_BODY
END SUB

' GOSUB name: runs the first PROC name of this command file, then goes on at the next line. The
' search reads the file from its first line, and a name not found prints Proc not found and ends
' every file. GOSUBs and DO WHILEs nest DO_LIMIT deep. At the prompt GOSUB is an error.
SUB DO_GOSUB()
  IF AT_PROMPT() THEN RETURN
  NEXT_WORD()
  WANTED_PROC = TOKEN
  CALL_PROC(0, DO_LINE + 1)
END SUB

' Searches this command file for PROC WANTED_PROC, and pushes the place for its ENDPROC to go back
' to, as PUSH_FRAME takes it.
SUB CALL_PROC(BYTES_BACK AS UBYTE, LINE_NUMBER AS UWORD)
  PUSH_FRAME(BYTES_BACK, LINE_NUMBER, 1)
  IF FAILED THEN RETURN
  GO_TO_LINE(0, 0)
  SKIP_DEPTH = 1
  SKIP_MODE = SKIP_KIND.PROC_SEARCH
END SUB

' ON KEY Fn GOSUB name: F1 to F10 in a BROWSE leaves it and runs PROC name of the file running the
' BROWSE, and its ENDPROC runs the BROWSE line again. ON KEY Fn drops the key. A name is 10
' characters at most. The last command file's end drops every key. At the prompt ON is an error.
SUB DO_ON()
  DIM SLOT AS UBYTE
  IF AT_PROMPT() THEN RETURN
  NEXT_WORD()
  IF TOKEN = "KEY"
    NEXT_WORD()
    SLOT = VAL(MID$(TOKEN, 2)) - 1
    IF ASC(TOKEN) = 70 AND SLOT < 10
      IF REST <> ""
        NEXT_WORD()
        IF IS("GOSUB") = 0 OR REST = ""
          SYNTAX_ERROR()
          RETURN
        ENDIF
      ENDIF
      NEXT_WORD()
      COPY_BYTES(@KEY_PROCS + SLOT * KEY_PROC_SIZE, @TOKEN + 1, KEY_PROC_SIZE)
      RETURN
    ENDIF
  ENDIF
  SYNTAX_ERROR()
END SUB

' The place in KEY_PROCS of the key PRESSED, as WAITKEY() gives it, or 0 when ON KEY did not bind it.
FUNCT BOUND_PROC(PRESSED AS UWORD) AS UWORD
  DIM SLOT AS UBYTE, SPOT AS UWORD
  SLOT = (PRESSED >> 8) - KEYS.SCAN_F1
  IF SLOT >= 10 THEN RETURN 0
  SPOT = @KEY_PROCS + SLOT * KEY_PROC_SIZE
  IF ContentsAt(SPOT) = 0 THEN RETURN 0
  RETURN SPOT
END FUNCT

' Runs the PROC bound to PRESSED, and its ENDPROC runs the line just read again. The line is under
' 256 bytes, joined lines counted together.
SUB GOSUB_KEY(PRESSED AS UWORD)
  COPY_BYTES(@WANTED_PROC + 1, BOUND_PROC(PRESSED), KEY_PROC_SIZE)
  BROWSE_BACK = DO_LINE + 1
  CALL_PROC(LINE_BYTES, DO_LINE - LINES_JOINED)
END SUB

' RETURN or ENDPROC: goes back after the innermost GOSUB running in this file, and ends the DO
' WHILEs since it. With no GOSUB it ends the innermost command file, and its caller goes on. At
' the prompt it does nothing.
SUB DO_RETURN()
  DIM FRAME AS UBYTE
  IF DO_DEPTH = 0 THEN RETURN
  FRAME = LOOP_DEPTH
  DO WHILE FRAME > CALLER_LOOPS(DO_DEPTH - 1)
    FRAME = FRAME - 1
    IF LOOP_IS_GOSUB(FRAME)
      LOOP_DEPTH = FRAME
      GO_TO_LINE(LOOP_SPOT(FRAME), LOOP_LINE(FRAME) - 1)
      RETURN
    ENDIF
  LOOP
  END_DO()
END SUB

' Takes the line in TOKEN that SKIP_DEPTH skips, by SKIP_MODE: IF_LINES counts IF, ELSE and ENDIF,
' LOOP_LINES counts DO WHILE and ENDDO, PROC_BODY ends at ENDPROC and PROC_SEARCH at PROC WANTED_PROC.
SUB SKIP_LINE()
  IF SKIP_MODE = SKIP_KIND.PROC_BODY
    IF IS("ENDPROC") THEN END_SKIP()
  ELSEIF SKIP_MODE = SKIP_KIND.PROC_SEARCH
    IF IS("PROC")
      NEXT_WORD()
      IF TOKEN = WANTED_PROC THEN END_SKIP()
    ENDIF
  ELSEIF SKIP_MODE = SKIP_KIND.LOOP_LINES
    IF TOKEN = "DO"
      NEXT_WORD()
      IF IS("WHILE") THEN SKIP_DEPTH = SKIP_DEPTH + 1
    ELSEIF IS("ENDDO")
      SKIP_DEPTH = SKIP_DEPTH - 1
      IF SKIP_DEPTH = 0 THEN SKIP_MODE = SKIP_KIND.IF_LINES
    ENDIF
  ELSEIF TOKEN = "IF"
    SKIP_DEPTH = SKIP_DEPTH + 1
  ELSEIF IS("ENDIF")
    SKIP_DEPTH = SKIP_DEPTH - 1
  ELSEIF TOKEN = "ELSE" AND SKIP_DEPTH = 1
    SKIP_DEPTH = 0
  ENDIF
END SUB

' Runs the lines again from the next one.
SUB END_SKIP()
  SKIP_DEPTH = 0
  SKIP_MODE = SKIP_KIND.IF_LINES
END SUB

' Reads [prompt] TO name in REST, for ACCEPT and INPUT. Prints the prompt, a text, and returns
' the name; "" after an error.
FUNCT PROMPT_TO() AS STRING
  DIM START AS UBYTE, NAME AS STRING * 10
  CURSOR = 1
  SKIP_SPACES()
  START = CURSOR
  IF NAME_AT() <> "TO"
    CURSOR = START
    EVALUATE()
    IF FAILED THEN RETURN ""
    IF VALUE_TYPE(0) <> VALUE_KIND.TEXT
      TYPE_MISMATCH()
      RETURN ""
    ENDIF
    SKIP_SPACES()
    IF NAME_AT() <> "TO"
      SYNTAX_ERROR()
      RETURN ""
    ENDIF
    SHOW_VALUE()
  ENDIF
  SKIP_SPACES()
  NAME = VARIABLE_NAME()
  SKIP_SPACES()
  IF NAME = "" OR CURRENT_CHAR() <> 0
    SYNTAX_ERROR()
    RETURN ""
  ENDIF
  RETURN NAME
END FUNCT

' Stores TEXT in the memory variable NAME.
SUB STORE_TEXT(NAME AS STRING, TEXT AS STRING)
  VALUE_COUNT = 0
  TEXT_BUFFER = ""
  PUSH_TEXT(TEXT)
  CURSOR = LEN(REST) + 1
  ASSIGN(NAME, 0)
END SUB

' ACCEPT [prompt] TO name: stores the line typed as a text. INPUT [prompt] TO name, EVALUATED
' 1: stores the value of the expression typed. The prompt is a text.
SUB DO_ACCEPT(EVALUATED AS UBYTE)
  DIM NAME AS STRING * 10
  NAME = PROMPT_TO()
  IF FAILED THEN RETURN
  DOS.CON_LINE(REST)
  IF EVALUATED
    CURSOR = 1
    EVALUATE()
    IF FAILED = 0 THEN ASSIGN(NAME, 0)
  ELSE
    STORE_TEXT(NAME, REST)
  ENDIF
END SUB

' Waits for a key and gives it as WAITKEY() does. LASTKEY() reads it from KEY_PRESSED.
FUNCT WAIT_FOR_KEY() AS UWORD
  KEY_PRESSED = WAITKEY()
  RETURN KEY_PRESSED
END FUNCT

' WAIT [TO name]: prints WAITING and waits for a key. TO stores the key as a text of 1
' character, or "" for an extended key.
SUB DO_WAIT()
  DIM NAME AS STRING * 10, PRESSED AS UWORD, KEY AS UBYTE
  NAME = ""
  IF REST <> ""
    NEXT_WORD()
    CURSOR = 1
    NAME = VARIABLE_NAME()
    SKIP_SPACES()
    IF TOKEN <> "TO" OR NAME = "" OR CURRENT_CHAR() <> 0
      SYNTAX_ERROR()
      RETURN
    ENDIF
  ENDIF
  PRINT "WAITING ";
  PRESSED = WAIT_FOR_KEY()
  PRINT
  IF NAME = "" THEN RETURN
  IF PRESSED < 256
    KEY = PRESSED
    STORE_TEXT(NAME, CHR$(KEY))
  ELSE
    STORE_TEXT(NAME, "")
  ENDIF
END SUB

' MODIFY COMMAND name: runs C:\sys\EDIT.COM on name, with .PRG added when it has no extension.
' The tables, indexes and command files stay open, and each takes one of the files the
' editor could open.
SUB DO_MODIFY()
  NEXT_WORD()
  IF IS("COMMAND") = 0 OR REST = ""
    SYNTAX_ERROR()
    RETURN
  ENDIF
  NEXT_WORD()
  IF REST <> ""
    SYNTAX_ERROR()
    RETURN
  ENDIF
  TOKEN = WITH_EXTENSION(TOKEN, ".PRG")
  DOS.EXEC("C:\sys\EDIT.COM", " " + TOKEN)
  IF DOS.ERROR THEN FILE_ERROR()
END SUB
