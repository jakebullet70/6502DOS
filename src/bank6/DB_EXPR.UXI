' DB_EXPR.UXI -- the expression stacks of XBASE.UXB, their operators, and the reading of text,
' numbers and names for EVALUATE. XBASE.UXB includes it after DO_SKIP, before DB_FUNC.UXI.

' The expression stacks of EVALUATE. An operator is its character, or a code below 7 for a
' unary minus, .NOT., .AND., .OR., <= and >=. An open function call is its BUILT_IN code, with
' the value count under its arguments in CALL_BASE. A value is FP.SIZE bytes, and the value
' stack holds 17. A text value is its start in TEXT_BUFFER, then its length. The texts of the
' stack sit in TEXT_BUFFER in stack order, so the two texts + joins are next to each other,
' and the top value's text is the end of TEXT_BUFFER. A logical value is 0 or 1 in its first
' byte.
CONST STACK_SIZE AS UBYTE = 16
ENUM OPERATION
  NEGATE = 1, LOGICAL_NOT, LOGICAL_AND, LOGICAL_OR, LESS_EQUAL, GREATER_EQUAL
END ENUM
ENUM VALUE_KIND
  NUMBER, TEXT, LOGICAL
END ENUM
DIM OPERATOR_STACK(16) AS UBYTE
DIM CALL_BASE(16) AS UBYTE
DIM VALUE_STACK(85) AS UBYTE
DIM VALUE_TYPE(17) AS UBYTE
DIM OPERATOR_COUNT AS UBYTE, VALUE_COUNT AS UBYTE
DIM TEXT_BUFFER AS STRING * 255

' The character of REST at POSITION, from 1; 0 past the end.
FUNCT CHAR_AT(POSITION AS UBYTE) AS UBYTE
  IF POSITION > LEN(REST) THEN RETURN 0
  RETURN ContentsAt(@REST + 1 + POSITION)
END FUNCT

FUNCT CURRENT_CHAR() AS UBYTE
  RETURN CHAR_AT(CURSOR)
END FUNCT

SUB TYPE_MISMATCH()
  REPORT_ERROR("Type mismatch")
END SUB

SUB OUT_OF_RANGE()
  REPORT_ERROR("Number out of range")
END SUB

SUB SKIP_SPACES()
  DO WHILE CURRENT_CHAR() = 32
    CURSOR = CURSOR + 1
  LOOP
END SUB

' The address of value SLOT of the value stack.
FUNCT VALUE_AT(SLOT AS UBYTE) AS UWORD
  RETURN AddrOf(VALUE_STACK) + SLOT * FP.SIZE
END FUNCT

' The text of value SLOT, a text value.
FUNCT TEXT_OF(SLOT AS UBYTE) AS STRING
  DIM VALUE AS UWORD
  VALUE = VALUE_AT(SLOT)
  RETURN MID$(TEXT_BUFFER, ContentsAt(VALUE), ContentsAt(VALUE + 1))
END FUNCT

FUNCT IS_LETTER(CODE AS UBYTE) AS UBYTE
  RETURN (CODE >= 65 AND CODE <= 90) OR (CODE >= 97 AND CODE <= 122)
END FUNCT

FUNCT IS_DIGIT(CODE AS UBYTE) AS UBYTE
  RETURN CODE >= 48 AND CODE <= 57
END FUNCT

FUNCT PRIORITY(OPERATOR AS UBYTE) AS UBYTE
  SELECT CASE OPERATOR
    CASE OPERATION.NEGATE
      RETURN 7
    CASE 42, 47
      RETURN 6
    CASE 43, 45
      RETURN 5
    CASE 35, 36, 60, 61, 62, OPERATION.LESS_EQUAL, OPERATION.GREATER_EQUAL
      RETURN 4
    CASE OPERATION.LOGICAL_NOT
      RETURN 3
    CASE OPERATION.LOGICAL_AND
      RETURN 2
    CASE OPERATION.LOGICAL_OR
      RETURN 1
  END SELECT
  RETURN 0
END FUNCT

' -1, 0 or 1 as the text at LEFT_VALUE is below, equal to or above the text at RIGHT_VALUE,
' byte by byte over the length of the right one: "ABC" = "AB" is true, "AB" = "ABC" false.
FUNCT COMPARE_TEXT(LEFT_VALUE AS UWORD, RIGHT_VALUE AS UWORD) AS BYTE
  DIM LEFT_AT AS UWORD, RIGHT_AT AS UWORD, INDEX AS UBYTE, LEFT_CODE AS UBYTE, RIGHT_CODE AS UBYTE
  LEFT_AT = @TEXT_BUFFER + 1 + ContentsAt(LEFT_VALUE)
  RIGHT_AT = @TEXT_BUFFER + 1 + ContentsAt(RIGHT_VALUE)
  INDEX = 0
  DO WHILE INDEX < ContentsAt(RIGHT_VALUE + 1)
    IF INDEX = ContentsAt(LEFT_VALUE + 1) THEN RETURN -1
    LEFT_CODE = ContentsAt(LEFT_AT + INDEX)
    RIGHT_CODE = ContentsAt(RIGHT_AT + INDEX)
    IF LEFT_CODE < RIGHT_CODE THEN RETURN -1
    IF LEFT_CODE > RIGHT_CODE THEN RETURN 1
    INDEX = INDEX + 1
  LOOP
  RETURN 0
END FUNCT

' Changes the sign of the number at VALUE. The sign is the top bit of the mantissa. An exponent
' of 0 is the value 0, which keeps its sign.
SUB FLIP_SIGN(VALUE AS UWORD)
  IF ContentsAt(VALUE) <> 0 THEN ContentsAt(VALUE + 1) = ContentsAt(VALUE + 1) XOR 128
END SUB

' Pops the top operator and applies it to the top value, or to the top two.
SUB APPLY_OPERATOR()
  DIM OPERATOR AS UBYTE, LEFT_VALUE AS UWORD, RIGHT_VALUE AS UWORD, KIND AS ENUM.VALUE_KIND
  DIM ORDER AS BYTE, TRUTH AS UBYTE
  OPERATOR_COUNT = OPERATOR_COUNT - 1
  OPERATOR = OPERATOR_STACK(OPERATOR_COUNT)
  RIGHT_VALUE = VALUE_AT(VALUE_COUNT - 1)
  KIND = VALUE_TYPE(VALUE_COUNT - 1)
  IF OPERATOR = OPERATION.LOGICAL_NOT
    IF KIND <> VALUE_KIND.LOGICAL
      TYPE_MISMATCH()
      RETURN
    ENDIF
    ContentsAt(RIGHT_VALUE) = ContentsAt(RIGHT_VALUE) XOR 1
    RETURN
  ENDIF
  IF OPERATOR = OPERATION.NEGATE
    IF KIND <> VALUE_KIND.NUMBER
      TYPE_MISMATCH()
      RETURN
    ENDIF
    FLIP_SIGN(RIGHT_VALUE)
    RETURN
  ENDIF
  VALUE_COUNT = VALUE_COUNT - 1
  LEFT_VALUE = VALUE_AT(VALUE_COUNT - 1)
  IF VALUE_TYPE(VALUE_COUNT - 1) <> KIND
    TYPE_MISMATCH()
    RETURN
  ENDIF
  IF PRIORITY(OPERATOR) = 4
    ' A compare: the two values become one logical value.
    IF KIND = VALUE_KIND.LOGICAL
      TYPE_MISMATCH()
      RETURN
    ENDIF
    TRUTH = 0
    IF OPERATOR = 36
      IF KIND <> VALUE_KIND.TEXT
        TYPE_MISMATCH()
        RETURN
      ENDIF
      IF INSTR(TEXT_OF(VALUE_COUNT), TEXT_OF(VALUE_COUNT - 1)) <> 0 THEN TRUTH = 1
    ELSE
      IF KIND = VALUE_KIND.NUMBER
        ORDER = FP.COMPARE(LEFT_VALUE, RIGHT_VALUE)
      ELSE
        ORDER = COMPARE_TEXT(LEFT_VALUE, RIGHT_VALUE)
      ENDIF
      SELECT CASE OPERATOR
        CASE 61, 35
          IF ORDER = 0 THEN TRUTH = 1
        CASE 60, OPERATION.GREATER_EQUAL
          IF ORDER < 0 THEN TRUTH = 1
        CASE ELSE
          IF ORDER > 0 THEN TRUTH = 1
      END SELECT
      ' #, <= and >= are the opposites of =, > and <.
      IF OPERATOR < 36 THEN TRUTH = TRUTH XOR 1
    ENDIF
    ' The two texts are the last of TEXT_BUFFER, and are spent.
    IF KIND = VALUE_KIND.TEXT THEN TEXT_BUFFER = LEFT$(TEXT_BUFFER, ContentsAt(LEFT_VALUE) - 1)
    ContentsAt(LEFT_VALUE) = TRUTH
    VALUE_TYPE(VALUE_COUNT - 1) = VALUE_KIND.LOGICAL
    RETURN
  ENDIF
  IF KIND = VALUE_KIND.LOGICAL
    IF OPERATOR = OPERATION.LOGICAL_AND
      ContentsAt(LEFT_VALUE) = ContentsAt(LEFT_VALUE) AND ContentsAt(RIGHT_VALUE)
    ELSEIF OPERATOR = OPERATION.LOGICAL_OR
      ContentsAt(LEFT_VALUE) = ContentsAt(LEFT_VALUE) OR ContentsAt(RIGHT_VALUE)
    ELSE
      TYPE_MISMATCH()
    ENDIF
    RETURN
  ENDIF
  IF OPERATOR = OPERATION.LOGICAL_AND OR OPERATOR = OPERATION.LOGICAL_OR
    TYPE_MISMATCH()
    RETURN
  ENDIF
  IF KIND = VALUE_KIND.TEXT
    IF OPERATOR <> 43
      TYPE_MISMATCH()
      RETURN
    ENDIF
    ContentsAt(LEFT_VALUE + 1) = ContentsAt(LEFT_VALUE + 1) + ContentsAt(RIGHT_VALUE + 1)
    RETURN
  ENDIF
  SELECT CASE OPERATOR
    CASE 43
      FP.ADD(LEFT_VALUE, RIGHT_VALUE)
    CASE 45
      FP.SUBTRACT(LEFT_VALUE, RIGHT_VALUE)
    CASE 42
      FP.MULTIPLY(LEFT_VALUE, RIGHT_VALUE)
    CASE ELSE
      IF ContentsAt(RIGHT_VALUE) = 0
        REPORT_ERROR("Division by zero")
        RETURN
      ENDIF
      FP.DIVIDE(LEFT_VALUE, RIGHT_VALUE)
  END SELECT
  IF DOS.ERROR <> 0 THEN OUT_OF_RANGE()
END SUB

' Pushes an operator. Reports a syntax error when the stack is full.
SUB PUSH_OPERATOR(OPERATOR AS UBYTE)
  IF OPERATOR_COUNT = STACK_SIZE
    SYNTAX_ERROR()
    RETURN
  ENDIF
  OPERATOR_STACK(OPERATOR_COUNT) = OPERATOR
  OPERATOR_COUNT = OPERATOR_COUNT + 1
END SUB

' Pushes TEXT on the value stack. Reports an error when the texts of the stack pass 254
' characters.
SUB PUSH_TEXT(TEXT AS STRING)
  DIM TOTAL AS UWORD, VALUE AS UWORD
  TOTAL = LEN(TEXT_BUFFER)
  TOTAL = TOTAL + LEN(TEXT)
  IF TOTAL > 254
    REPORT_ERROR("Text too long")
    RETURN
  ENDIF
  VALUE = VALUE_AT(VALUE_COUNT)
  ContentsAt(VALUE) = LEN(TEXT_BUFFER) + 1
  ContentsAt(VALUE + 1) = LEN(TEXT)
  TEXT_BUFFER = TEXT_BUFFER + TEXT
  VALUE_TYPE(VALUE_COUNT) = VALUE_KIND.TEXT
  VALUE_COUNT = VALUE_COUNT + 1
END SUB

' Pushes the number TEXT starts with, and moves CURSOR past what was read.
SUB PUSH_NUMBER(TEXT AS STRING)
  DIM LENGTH AS UBYTE
  LENGTH = FP.FROM_TEXT(VALUE_AT(VALUE_COUNT), TEXT)
  IF DOS.ERROR <> 0
    OUT_OF_RANGE()
    RETURN
  ENDIF
  CURSOR = CURSOR + LENGTH
  VALUE_TYPE(VALUE_COUNT) = VALUE_KIND.NUMBER
  VALUE_COUNT = VALUE_COUNT + 1
END SUB

' Pushes a logical value, TRUTH 0 or 1.
SUB PUSH_LOGICAL(TRUTH AS UBYTE)
  ContentsAt(VALUE_AT(VALUE_COUNT)) = TRUTH
  VALUE_TYPE(VALUE_COUNT) = VALUE_KIND.LOGICAL
  VALUE_COUNT = VALUE_COUNT + 1
END SUB

' Pushes the whole number NUMBER.
SUB PUSH_WHOLE(NUMBER AS UWORD)
  FP.FROM_LONG(VALUE_AT(VALUE_COUNT), NUMBER)
  VALUE_TYPE(VALUE_COUNT) = VALUE_KIND.NUMBER
  VALUE_COUNT = VALUE_COUNT + 1
END SUB

' Applies the operators down to the innermost ( or function call.
SUB APPLY_TO_BRACKET()
  DO WHILE OPERATOR_COUNT > 0 AND PRIORITY(OPERATOR_STACK(OPERATOR_COUNT - 1)) > 0
    APPLY_OPERATOR()
    IF FAILED THEN RETURN
  LOOP
END SUB

' The letters between the dot at CURSOR and the next dot, in capitals, as in .AND.; "" when
' no dot follows them.
FUNCT DOT_WORD() AS STRING
  DIM FINISH AS UBYTE
  FINISH = CURSOR + 1
  DO WHILE IS_LETTER(CHAR_AT(FINISH)) <> 0
    FINISH = FINISH + 1
  LOOP
  IF CHAR_AT(FINISH) <> 46 THEN RETURN ""
  RETURN UCASE$(MID$(REST, CURSOR + 1, FINISH - CURSOR - 1))
END FUNCT

' Reads the text in quotes at CURSOR, " or ', and pushes it.
SUB READ_TEXT()
  DIM LENGTH AS UBYTE
  LENGTH = INSTR(MID$(REST, CURSOR + 1), CHR$(CURRENT_CHAR())) - 1
  IF LENGTH = 255
    SYNTAX_ERROR()
    RETURN
  ENDIF
  PUSH_TEXT(MID$(REST, CURSOR + 1, LENGTH))
  CURSOR = CURSOR + LENGTH + 2
END SUB

' The letters, digits and _ at CURSOR, in capitals. CURSOR moves past them.
FUNCT NAME_AT() AS STRING
  DIM START AS UBYTE
  START = CURSOR
  DO WHILE IS_LETTER(CURRENT_CHAR()) OR IS_DIGIT(CURRENT_CHAR()) OR CURRENT_CHAR() = 95
    CURSOR = CURSOR + 1
  LOOP
  RETURN UCASE$(MID$(REST, START, CURSOR - START))
END FUNCT

' The name of a memory variable at CURSOR, cut to 10 characters; "" when no letter starts it.
FUNCT VARIABLE_NAME() AS STRING
  IF IS_LETTER(CURRENT_CHAR()) = 0 THEN RETURN ""
  RETURN LEFT$(NAME_AT(), 10)
END FUNCT

' Copies COUNT bytes from SOURCE to TARGET, first byte first.
SUB COPY_BYTES(TARGET AS UWORD, SOURCE AS UWORD, COUNT AS UWORD)
  DO WHILE COUNT > 0
    ContentsAt(TARGET) = ContentsAt(SOURCE)
    TARGET = TARGET + 1
    SOURCE = SOURCE + 1
    COUNT = COUNT - 1
  LOOP
END SUB

' Prints value 0 with no line end: its text, its number, or .T. or .F..
SUB SHOW_VALUE()
  IF VALUE_TYPE(0) = VALUE_KIND.TEXT
    PRINT TEXT_OF(0);
  ELSEIF VALUE_TYPE(0) = VALUE_KIND.LOGICAL
    IF VALUE_STACK(0) = 1
      PRINT ".T.";
    ELSE
      PRINT ".F.";
    ENDIF
  ELSE
    PRINT FP.TO_TEXT(VALUE_AT(0));
  ENDIF
END SUB
