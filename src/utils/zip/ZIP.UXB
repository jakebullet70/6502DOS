'=============================================================================================
' -- ZIP [-r] archive files
' -- adds files to a ZIP archive, and makes the archive when it does not exist. files are up
' -- to 8 names or patterns with * and ?. A folder adds an entry for itself; with -r, the
' -- files and folders in it too, and theirs, down to 16 folders deep. Hidden and system files
' -- are left out. A line each names the entry: adding: NAME (deflated N%), with the saving in
' -- percent. A folder, and a file of up to 32768 bytes that deflate does not shrink, is
' -- stored: adding: NAME (stored 0%).
' -- An entry is named by its path as typed, with / between folders, cut of a drive and of a
' -- leading \, .\ or ..\. A file whose name is in the archive already replaces that entry.
' -- New entries come first, then the old ones kept. The archive and ZIP's two work files,
' -- ZIPTEMP.$$$ and ZIPLIST.$$$ in the archive's folder, are left out when a path names them
' -- as the archive's name does.
' --
' -- An archive name with no . in its last part gets .ZIP added. ZIP writes the new archive
' -- to ZIPTEMP.$$$, then deletes the old one and renames the work file.
' -- -H or -? as the first parameter runs HELP ZIP.
' -- No archive or no files prints Required parameter missing, and a switch but -r prints
' -- Invalid switch, each exit code 1. An old archive that is not a ZIP archive, or is ZIP64
' -- or split, prints its error, as UNZIP does, exit code 2. A name that matches nothing prints
' -- zip warning: name not matched, and a file that does not open zip warning: could not open
' -- for reading; each gives exit code 3 at the end. No file to add prints zip error: Nothing
' -- to do!, and an error in writing prints its message; each ends ZIP with exit code 3 and
' -- leaves the old archive as it was. Exit code 0 otherwise.
' --
' -- From a prompt:
' --     ZIP GAMES *.PRG
' --     ZIP -r C:\BACKUP DOCS SRC\*.UXB
'=============================================================================================
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
#INCLUDE "BANK.UXI"
#INCLUDE "ZIPFILE.UXI"
#INCLUDE "HELPSW.UXI"
CONST TEMP_FILE AS STRING = "ZIPTEMP.$$$", LIST_FILE AS STRING = "ZIPLIST.$$$"
' Version 2.0 made on MS-DOS, so the low byte of the external attributes is the FAT's.
CONST VERSION_MADE AS UBYTE = 20, VERSION_STORED AS UBYTE = 10, VERSION_DEFLATED AS UBYTE = 20
CONST EXTERNAL_AT AS UBYTE = 38, FLAG_DESCRIPTOR AS UBYTE = 8
CONST FULL_DESCRIPTOR AS UBYTE = 16, BARE_DESCRIPTOR AS UBYTE = 12
' The name table: TABLE_SLOTS slots of 8 bytes in TABLE_BANKS banks, at most TABLE_MAX used.
CONST TABLE_BANKS AS UBYTE = 4, TABLE_SLOTS AS UWORD = 4096, TABLE_MAX AS UWORD = 3072
CONST SLOTS_PER_BANK AS UWORD = 1024, SLOT_SIZE AS UBYTE = 8
' A folder search keeps the find buffer's bytes before FIND_ATTR for each folder it is in.
CONST DEPTH_MAX AS UBYTE = 16

DIM ARGUMENT AS STRING * 255, ARCHIVE_NAME AS STRING * 255, ENTRY_NAME AS STRING * 255
DIM TEMP_NAME AS STRING * 255, LIST_NAME AS STRING * 255, WALK_PATH AS STRING * 255
DIM FILE_PATH AS STRING * 255, CHECK_NAME AS STRING * 255, KEY_TEXT AS STRING * 255
DIM ARCHIVE_KEY AS STRING * 255, TEMP_KEY AS STRING * 255, LIST_KEY AS STRING * 255
DIM SLOT AS UBYTE, SWITCH AS UBYTE, RECURSE AS UBYTE, EXIT_CODE AS UBYTE, OLD_EXISTS AS UBYTE
DIM LINE_OPEN AS UBYTE, WRITE_ERROR AS UBYTE
DIM FILE_SLOTS AS UWORD                            ' bit n set: P(n+1)$ is a file to add
DIM TEMP AS UWORD, LIST AS UWORD, SOURCE AS UWORD
DIM TEMP_SIZE AS ULONG, LIST_SIZE AS ULONG, ENTRY_COUNT AS UWORD, ADDED AS UWORD
DIM LENGTH AS ULONG, COUNT AS UWORD, LOCAL_AT AS ULONG
DIM FILE_TIME AS UWORD, FILE_DATE AS UWORD, FILE_ATTRIBUTES AS UBYTE
DIM CHECK(ENTRY_SIZE) AS UBYTE
' The name table holds an entry's name key and its place in LIST, plus 1: 0 is an empty slot.
DIM TABLE_BANK AS UBYTE, CALLER_BANK AS UBYTE, TABLE_COUNT AS UWORD
DIM KEY AS ULONG, FREE_SLOT AS UWORD, SLOT_AT AS UWORD
DIM DEPTH AS UBYTE, PATH_LENGTHS(DEPTH_MAX) AS UBYTE
DIM FIND_STACK(DEPTH_MAX * DOS.FIND_ATTR) AS UBYTE
DIM DATA_AT AS ULONG, PACKED AS ULONG

' Deflate, with fixed Huffman codes only. The file is read 512 bytes at a time into the window,
' 32768 bytes in the 4 RAM banks from WINDOW_BANK to WINDOW_END - 1, a ring: an offset in it
' is 0 to $7FFF. CURSOR is the offset of the next byte to code, with AHEAD bytes read past it.
' The head table, in bank HEAD_BANK, holds for each hash of 3 bytes the offset where they came
' last: the low byte at $A000 + the hash, the high byte at $B000 + the hash. A match is at
' most 31743 bytes back, so the reads ahead never reach it. A block is coded into bank
' OUT_BANK from $A000; it takes 7168 bytes and the match that ends past them at most, so its
' codes fit the bank. BIT_ACC holds the BIT_COUNT bits, 0 to 7, not yet a byte.
CONST WINDOW_BANKS AS UBYTE = 4, DEFLATE_BANKS AS UBYTE = 6
CONST WINDOW_SIZE AS ULONG = 32768
DIM BIT_ACC AS UBYTE AT $59, BIT_COUNT AS UBYTE AT $5A, PUT_VALUE AS ULONG AT $5B
DIM PUT_COUNT AS UBYTE AT $5F, OUT_PTR AS UWORD AT $60, OUT_BANK AS UBYTE AT $62
DIM WINDOW_BANK AS UBYTE AT $63, WINDOW_END AS UBYTE AT $64, HEAD_BANK AS UBYTE AT $65
DIM CURSOR AS UWORD AT $66, AHEAD AS UWORD AT $68, BLOCK_IN AS UWORD AT $6A
DIM CUR_PTR AS UWORD AT $6C, CUR_BANK AS UBYTE AT $6E, SRC_PTR AS UWORD AT $6F
DIM SRC_BANK AS UBYTE AT $71, MATCH_LENGTH AS UWORD AT $72, MAX_LENGTH AS UWORD AT $74
DIM DISTANCE AS UWORD AT $76, HEAD_PTR AS UWORD AT $78, AT_END AS UBYTE AT $7A
DIM HASH_BYTE0 AS UBYTE AT $7B, HASH_BYTE1 AS UBYTE AT $7C, HASH_BYTE2 AS UBYTE AT $7D
' DEF_BLOCK keeps BASIC's X here: X indexes the expression stack, which DEF_REFILL uses.
DIM SAVED_X AS UBYTE AT $7E
' The fixed codes, their bits in the order they are written. A literal's code is 8 bits below
' 144, else 9. LENGTH_SYMBOL gives a length less 3 its length symbol less 257, 0 to 28, whose
' code is 7 bits below 23, else 8. DIST_SMALL gives a distance less 1, below 256, its
' distance symbol, and DIST_LARGE a distance less 1 shifted right 7. A base is less 3 for a
' length, less 1 for a distance.
DIM LIT_CODE_LOW(256) AS UBYTE, LIT_CODE_HIGH(256) AS UBYTE, LENGTH_SYMBOL(256) AS UBYTE
DIM LENGTH_CODE(29) AS UBYTE, LENGTH_BASE(29) AS UBYTE, LENGTH_EXTRA(29) AS UBYTE
DIM DIST_SMALL(256) AS UBYTE, DIST_LARGE(256) AS UBYTE, DIST_CODE(30) AS UBYTE
DIM DIST_BASE_LOW(30) AS UBYTE, DIST_BASE_HIGH(30) AS UBYTE, DIST_EXTRA(30) AS UBYTE

' Closes the files, deletes the work files, prints MESSAGE and ends ZIP with exit code CODE.
SUB ABORT(MESSAGE AS STRING, CODE AS UBYTE)
  IF SOURCE <> NOFILE THEN DOS.CLOSE_FILE(SOURCE)
  IF ARCHIVE <> NOFILE THEN DOS.CLOSE_FILE(ARCHIVE)
  IF TEMP <> NOFILE THEN
    DOS.CLOSE_FILE(TEMP)
    DOS.DELETE(TEMP_NAME)
  END IF
  IF LIST <> NOFILE THEN
    DOS.CLOSE_FILE(LIST)
    DOS.DELETE(LIST_NAME)
  END IF
  IF LINE_OPEN THEN PRINT
  FAIL(MESSAGE, CODE)
END SUB

' Writes the BYTES bytes at AT to HANDLE, TEMP or LIST, and adds them to its size. A write
' that fails ends ZIP with exit code 3.
SUB PUT(HANDLE AS UWORD, AT AS UWORD, BYTES AS UWORD)
  IF DOS.WRITE_FILE(HANDLE, AT, BYTES) <> BYTES THEN
    WRITE_ERROR = DOS.ERROR
    IF WRITE_ERROR = 0 THEN ABORT("Insufficient disk space", 3)
    ABORT(DOS.ERRMSG(WRITE_ERROR), 3)
  END IF
  IF HANDLE = TEMP THEN
    TEMP_SIZE = TEMP_SIZE + BYTES
  ELSE
    LIST_SIZE = LIST_SIZE + BYTES
  END IF
END SUB

' Reads BYTES bytes of HANDLE to AT. A short read ends ZIP with Not a ZIP archive, exit code 2.
SUB GET(HANDLE AS UWORD, AT AS UWORD, BYTES AS UWORD)
  IF DOS.READ_FILE(HANDLE, AT, BYTES) <> BYTES THEN ABORT("Not a ZIP archive", 2)
END SUB

' Copies BYTES bytes of the old archive, from its position, to HANDLE.
SUB COPY_OLD_BYTES(HANDLE AS UWORD, BYTES AS ULONG)
  DIM PART AS UWORD
  DO WHILE BYTES > 0
    PART = BUFFER_SIZE
    IF BYTES < BUFFER_SIZE THEN PART = BYTES
    GET(ARCHIVE, @BUFFER, PART)
    PUT(HANDLE, @BUFFER, PART)
    BYTES = BYTES - PART
  LOOP
END SUB

' The name of the entry for PATH: cut of a drive and of each leading \, / , .\ and ..\, with /
' for \.
FUNCT ENTRY_FOR(PATH AS STRING) AS STRING
  DIM NAME AS STRING * 255, AT AS UWORD
  NAME = PATH
  IF MID$(NAME, 2, 1) = ":" THEN NAME = MID$(NAME, 3)
  DO
    IF LEFT$(NAME, 1) = "\" OR LEFT$(NAME, 1) = "/" THEN
      NAME = MID$(NAME, 2)
    ELSEIF LEFT$(NAME, 2) = ".\" THEN
      NAME = MID$(NAME, 3)
    ELSEIF LEFT$(NAME, 3) = "..\" THEN
      NAME = MID$(NAME, 4)
    ELSE
      EXIT DO
    END IF
  LOOP
  FOR AT = 1 TO LEN(NAME)
    IF ContentsAt(@NAME + 1 + AT) = ASC("\") THEN ContentsAt(@NAME + 1 + AT) = ASC("/")
  NEXT
  RETURN NAME
END FUNCT

' The length of the folder part of PATH: up to its last \ or :, 0 when it has none.
FUNCT FOLDER_LENGTH(PATH AS STRING) AS UBYTE
  DIM AT AS UBYTE, LAST AS UBYTE, CHARACTER AS UBYTE
  LAST = 0
  FOR AT = 1 TO LEN(PATH)
    CHARACTER = ASC(MID$(PATH, AT))
    IF CHARACTER = ASC("\") OR CHARACTER = ASC(":") THEN LAST = AT
  NEXT
  RETURN LAST
END FUNCT

' The CRC-32 of NAME in capitals. Uses CRC.
FUNCT NAME_KEY(NAME AS STRING) AS ULONG
  KEY_TEXT = UCASE$(NAME)
  CRC = $FFFFFFFF
  CRC_DATA = @KEY_TEXT + 2
  CRC_COUNT = LEN(KEY_TEXT)
  CRC_ADD()
  RETURN CRC
END FUNCT

' Selects the bank of name table slot S, and sets SLOT_AT to its address.
SUB TABLE_SLOT(S AS UWORD)
  BANK.USE(TABLE_BANK + (S >> 10))
  SLOT_AT = $A000 + ((S AND (SLOTS_PER_BANK - 1)) << 3)
END SUB

' 1 when the central directory entry at AT in LIST is named NAME, in any case. Leaves LIST's
' position at its end.
FUNCT LISTED_AS(AT AS ULONG, NAME AS STRING) AS UBYTE
  DIM SIZE AS UWORD
  DOS.SEEK(LIST, FROM_START, AT AND $FFFF, AT >> 16)
  GET(LIST, @CHECK, ENTRY_SIZE)
  SIZE = ContentsAtW(@CHECK + NAME_SIZE_AT)
  ContentsAt(@CHECK_NAME + 1) = SIZE
  GET(LIST, @CHECK_NAME + 2, SIZE)
  DOS.SEEK(LIST, FROM_END, 0, 0)
  RETURN UCASE$(CHECK_NAME) = UCASE$(NAME)
END FUNCT

' 1 when the name table holds NAME, in any case. Else 0, with KEY and FREE_SLOT set for
' TABLE_ADD.
FUNCT TABLE_FIND(NAME AS STRING) AS UBYTE
  DIM S AS UWORD, PLACE AS ULONG, STORED AS ULONG
  KEY = NAME_KEY(NAME)
  S = ContentsAtW(@KEY) AND (TABLE_SLOTS - 1)
  DO
    TABLE_SLOT(S)
    ContentsAtW(@STORED) = ContentsAtW(SLOT_AT)
    ContentsAtW(@STORED + 2) = ContentsAtW(SLOT_AT + 2)
    ContentsAtW(@PLACE) = ContentsAtW(SLOT_AT + 4)
    ContentsAtW(@PLACE + 2) = ContentsAtW(SLOT_AT + 6)
    BANK.USE(CALLER_BANK)
    IF PLACE = 0 THEN EXIT DO
    IF STORED = KEY THEN
      IF LISTED_AS(PLACE - 1, NAME) THEN RETURN 1
    END IF
    S = (S + 1) AND (TABLE_SLOTS - 1)
  LOOP
  FREE_SLOT = S
  RETURN 0
END FUNCT

' Puts KEY and the entry at AT in LIST in FREE_SLOT, which TABLE_FIND set.
SUB TABLE_ADD(AT AS ULONG)
  AT = AT + 1
  TABLE_SLOT(FREE_SLOT)
  ContentsAtW(SLOT_AT) = ContentsAtW(@KEY)
  ContentsAtW(SLOT_AT + 2) = ContentsAtW(@KEY + 2)
  ContentsAtW(SLOT_AT + 4) = ContentsAtW(@AT)
  ContentsAtW(SLOT_AT + 6) = ContentsAtW(@AT + 2)
  BANK.USE(CALLER_BANK)
  TABLE_COUNT = TABLE_COUNT + 1
END SUB

' The saving of SMALLER bytes over ORIGINAL, in percent, rounded, as Info-ZIP gives it; 0 when
' there is none.
FUNCT SAVING(ORIGINAL AS ULONG, SMALLER AS ULONG) AS UBYTE
  DO WHILE ORIGINAL > $FFFFFF
    ORIGINAL = (ORIGINAL + $80) >> 8
    SMALLER = (SMALLER + $80) >> 8
  LOOP
  IF ORIGINAL <= SMALLER THEN RETURN 0
  RETURN (1 + 200 * (ORIGINAL - SMALLER) / ORIGINAL) / 2
END FUNCT

' Writes the BYTES bytes of the window from offset FROM to TEMP. Leaves a window bank selected.
SUB WINDOW_PUT(FROM AS UWORD, BYTES AS UWORD)
  DIM PART AS UWORD
  DO WHILE BYTES > 0
    BANK.USE(WINDOW_BANK + (FROM >> 13))
    PART = $2000 - (FROM AND $1FFF)
    IF BYTES < PART THEN PART = BYTES
    PUT(TEMP, $A000 + (FROM AND $1FFF), PART)
    FROM = (FROM + PART) AND $7FFF
    BYTES = BYTES - PART
  LOOP
END SUB

' Writes the codes in bank OUT_BANK, from $A000 to OUT_PTR, to TEMP, and moves OUT_PTR back to
' $A000. Leaves OUT_BANK selected.
SUB OUT_FLUSH()
  BANK.USE(OUT_BANK)
  IF OUT_PTR > $A000 THEN PUT(TEMP, $A000, OUT_PTR - $A000)
  OUT_PTR = $A000
END SUB

' Adds the PUT_COUNT low bits of PUT_VALUE, the lowest first, to the codes at OUT_PTR. The
' bits above them must be 0, and bytes 2 and 3 of PUT_VALUE too; BIT_COUNT plus PUT_COUNT is
' at most 24. Keeps X and Y; selects OUT_BANK.
SUB DEF_PUT_BITS()
  ASM
      phx
      ldx @BIT_COUNT
      beq joined
  shift:
      asl @PUT_VALUE
      rol @PUT_VALUE + 1
      rol @PUT_VALUE + 2
      dex
      bne shift
  joined:
      lda @PUT_VALUE
      ora @BIT_ACC
      sta @PUT_VALUE
      lda @BIT_COUNT
      clc
      adc @PUT_COUNT
      sta @BIT_COUNT
      ldx @OUT_BANK
      stx $00
  emit:
      lda @BIT_COUNT
      cmp #8
      bcc kept
      sbc #8
      sta @BIT_COUNT
      lda @PUT_VALUE
      sta (@OUT_PTR)
      inc @OUT_PTR
      bne moved
      inc @OUT_PTR + 1
  moved:
      lda @PUT_VALUE + 1
      sta @PUT_VALUE
      lda @PUT_VALUE + 2
      sta @PUT_VALUE + 1
      stz @PUT_VALUE + 2
      bra emit
  kept:
      lda @PUT_VALUE
      sta @BIT_ACC
      plx
  END ASM
END SUB

' Adds the BITS low bits of VALUE to the codes, as DEF_PUT_BITS.
SUB PUT_BITS(VALUE AS UWORD, BITS AS UBYTE)
  PUT_VALUE = VALUE
  PUT_COUNT = BITS
  DEF_PUT_BITS()
END SUB

' Sets CUR_PTR and CUR_BANK to the window's offset CURSOR. For DEF_BLOCK: changes X.
SUB DEF_AT_CURSOR()
  ASM
      lda @CURSOR
      sta @CUR_PTR
      lda @CURSOR + 1
      tax
      and #$1F
      ora #$A0
      sta @CUR_PTR + 1
      txa
      lsr a
      lsr a
      lsr a
      lsr a
      lsr a
      clc
      adc @WINDOW_BANK
      sta @CUR_BANK
  END ASM
END SUB

' Moves CUR_PTR, whose low byte has wrapped, to its next page, and at the end of a bank to the
' next, after the last to the first. Keeps X and Y.
SUB DEF_CUR_PAGE()
  ASM
      inc @CUR_PTR + 1
      lda @CUR_PTR + 1
      cmp #$C0
      bne done
      lda #$A0
      sta @CUR_PTR + 1
      inc @CUR_BANK
      lda @CUR_BANK
      cmp @WINDOW_END
      bne done
      lda @WINDOW_BANK
      sta @CUR_BANK
  done:
  END ASM
END SUB

' DEF_CUR_PAGE for SRC_PTR and SRC_BANK.
SUB DEF_SRC_PAGE()
  ASM
      inc @SRC_PTR + 1
      lda @SRC_PTR + 1
      cmp #$C0
      bne done
      lda #$A0
      sta @SRC_PTR + 1
      inc @SRC_BANK
      lda @SRC_BANK
      cmp @WINDOW_END
      bne done
      lda @WINDOW_BANK
      sta @SRC_BANK
  done:
  END ASM
END SUB

' Sets each offset in the head table to 0. Keeps X; selects HEAD_BANK.
SUB DEF_CLEAR_HEAD()
  ASM
      phx
      lda @HEAD_BANK
      sta $00
      stz @HEAD_PTR
      lda #$A0
      sta @HEAD_PTR + 1
      ldy #0
      lda #0
  clear:
      sta (@HEAD_PTR),y
      iny
      bne clear
      inc @HEAD_PTR + 1
      ldx @HEAD_PTR + 1
      cpx #$C0
      bne clear
      plx
  END ASM
END SUB

' Reads up to 512 bytes of SOURCE into the window, after the AHEAD bytes past CURSOR, and adds
' them to CRC, LENGTH and AHEAD. A short read sets AT_END.
SUB DEF_REFILL()
  DIM LOAD_AT AS UWORD
  LOAD_AT = (CURSOR + AHEAD) AND $7FFF
  BANK.USE(WINDOW_BANK + (LOAD_AT >> 13))
  LOAD_AT = $A000 + (LOAD_AT AND $1FFF)
  COUNT = DOS.READ_FILE(SOURCE, LOAD_AT, BUFFER_SIZE)
  IF COUNT < BUFFER_SIZE THEN AT_END = 1
  CRC_DATA = LOAD_AT
  CRC_COUNT = COUNT
  CRC_ADD()
  AHEAD = AHEAD + COUNT
  LENGTH = LENGTH + COUNT
END SUB

' Reads 512 bytes more when fewer than 258 wait past CURSOR and the file has more. Sets
' MAX_LENGTH to AHEAD, at most 258, CUR_PTR and CUR_BANK to CURSOR, and HASH_BYTE0 to
' HASH_BYTE2 to the 3 bytes there, read through SRC_PTR when they cross a page. For
' DEF_BLOCK: changes X.
SUB DEF_LOOK()
  ASM
      lda @AT_END
      bne loaded
      lda @AHEAD + 1
      beq refill
      cmp #2
      bcs loaded
      lda @AHEAD
      cmp #2
      bcs loaded
  refill:
      ldx @SAVED_X
      jsr DEF_REFILL
  loaded:
      lda @AHEAD + 1
      cmp #1
      bcc short
      bne capped
      lda @AHEAD
      cmp #2
      bcc short
  capped:
      lda #2
      sta @MAX_LENGTH
      lda #1
      sta @MAX_LENGTH + 1
      bra limited
  short:
      lda @AHEAD
      sta @MAX_LENGTH
      lda @AHEAD + 1
      sta @MAX_LENGTH + 1
  limited:
      jsr DEF_AT_CURSOR
      lda @CUR_BANK
      sta $00
      lda @CUR_PTR
      cmp #$FE
      bcs crossing
      ldy #0
      lda (@CUR_PTR),y
      sta @HASH_BYTE0
      iny
      lda (@CUR_PTR),y
      sta @HASH_BYTE1
      iny
      lda (@CUR_PTR),y
      sta @HASH_BYTE2
      bra done
  crossing:
      lda @CUR_PTR
      sta @SRC_PTR
      lda @CUR_PTR + 1
      sta @SRC_PTR + 1
      lda @CUR_BANK
      sta @SRC_BANK
      ldx #0
  next_byte:
      lda @SRC_BANK
      sta $00
      lda (@SRC_PTR)
      sta @HASH_BYTE0,x
      inc @SRC_PTR
      bne stepped
      jsr DEF_SRC_PAGE
  stepped:
      inx
      cpx #3
      bne next_byte
  done:
  END ASM
END SUB

' Puts CURSOR in the head table under the hash of the 3 bytes from DEF_LOOK, and sets
' MATCH_LENGTH to the bytes from CURSOR that match those at the offset the head held, up to
' MAX_LENGTH, and DISTANCE to how far back they are. MATCH_LENGTH is 0 when MAX_LENGTH is
' below 3, and when the offset is CURSOR or more than 31743 back. For DEF_BLOCK: changes X.
SUB DEF_FIND()
  ASM
      stz @MATCH_LENGTH
      stz @MATCH_LENGTH + 1
      lda @MAX_LENGTH + 1
      bne hash
      lda @MAX_LENGTH
      cmp #3
      bcs hash
      jmp done
  hash:
      ' HEAD_PTR = $A000 + the hash: (byte 0 << 8 XOR byte 1 << 4 XOR byte 2) AND $FFF.
      lda @HASH_BYTE1
      asl a
      asl a
      asl a
      asl a
      eor @HASH_BYTE2
      sta @HEAD_PTR
      lda @HASH_BYTE1
      lsr a
      lsr a
      lsr a
      lsr a
      eor @HASH_BYTE0
      and #$0F
      ora #$A0
      sta @HEAD_PTR + 1
      ' DISTANCE = the offset in the head, which gets CURSOR.
      lda @HEAD_BANK
      sta $00
      lda (@HEAD_PTR)
      sta @DISTANCE
      lda @CURSOR
      sta (@HEAD_PTR)
      lda @HEAD_PTR + 1
      ora #$10
      sta @HEAD_PTR + 1
      lda (@HEAD_PTR)
      sta @DISTANCE + 1
      lda @CURSOR + 1
      sta (@HEAD_PTR)
      ' SRC_PTR and SRC_BANK at that offset; DISTANCE = CURSOR less it, in the ring.
      lda @DISTANCE
      sta @SRC_PTR
      lda @DISTANCE + 1
      tax
      and #$1F
      ora #$A0
      sta @SRC_PTR + 1
      txa
      lsr a
      lsr a
      lsr a
      lsr a
      lsr a
      clc
      adc @WINDOW_BANK
      sta @SRC_BANK
      sec
      lda @CURSOR
      sbc @DISTANCE
      sta @DISTANCE
      lda @CURSOR + 1
      sbc @DISTANCE + 1
      and #$7F
      sta @DISTANCE + 1
      ' 31743 is $7BFF.
      ora @DISTANCE
      beq done
      lda @DISTANCE + 1
      cmp #$7C
      bcs done
  compare:
      lda @SRC_BANK
      sta $00
      lda (@SRC_PTR)
      ldx @CUR_BANK
      stx $00
      cmp (@CUR_PTR)
      bne compared
      inc @MATCH_LENGTH
      bne counted
      inc @MATCH_LENGTH + 1
  counted:
      lda @MATCH_LENGTH
      cmp @MAX_LENGTH
      bne further
      lda @MATCH_LENGTH + 1
      cmp @MAX_LENGTH + 1
      beq compared
  further:
      inc @SRC_PTR
      bne source_moved
      jsr DEF_SRC_PAGE
  source_moved:
      inc @CUR_PTR
      bne compare
      jsr DEF_CUR_PAGE
      bra compare
  compared:
      lda @MATCH_LENGTH + 1
      bne done
      lda @MATCH_LENGTH
      cmp #3
      bcs done
      stz @MATCH_LENGTH
  done:
  END ASM
END SUB

' Adds the code of the literal HASH_BYTE0, and sets MATCH_LENGTH to 1. For DEF_BLOCK: changes
' X.
SUB DEF_LITERAL()
  ASM
      ldx @HASH_BYTE0
      lda @LIT_CODE_LOW,x
      sta @PUT_VALUE
      lda @LIT_CODE_HIGH,x
      sta @PUT_VALUE + 1
      stz @PUT_VALUE + 2
      lda #8
      cpx #144
      bcc counted
      lda #9
  counted:
      sta @PUT_COUNT
      jsr DEF_PUT_BITS
      lda #1
      sta @MATCH_LENGTH
      stz @MATCH_LENGTH + 1
  END ASM
END SUB

' Adds the codes of a match of MATCH_LENGTH bytes, 3 to 258, DISTANCE back. For DEF_BLOCK:
' changes X.
SUB DEF_MATCH()
  ASM
      ' The length's code, then its extra bits, in one.
      lda @MATCH_LENGTH
      sec
      sbc #3
      tax
      ldy @LENGTH_SYMBOL,x
      txa
      sec
      sbc @LENGTH_BASE,y
      cpy #23
      bcs eight_bits
      lsr a
      sta @PUT_VALUE + 1
      lda #0
      ror a
      ora @LENGTH_CODE,y
      sta @PUT_VALUE
      lda #7
      bra length_bits
  eight_bits:
      sta @PUT_VALUE + 1
      lda @LENGTH_CODE,y
      sta @PUT_VALUE
      lda #8
  length_bits:
      clc
      adc @LENGTH_EXTRA,y
      sta @PUT_COUNT
      stz @PUT_VALUE + 2
      jsr DEF_PUT_BITS
      ' The distance less 1: its code, then its extra bits.
      lda @DISTANCE
      bne lowered
      dec @DISTANCE + 1
  lowered:
      dec @DISTANCE
      lda @DISTANCE + 1
      bne far
      ldx @DISTANCE
      ldy @DIST_SMALL,x
      bra coded
  far:
      lda @DISTANCE
      asl a
      lda @DISTANCE + 1
      rol a
      tax
      ldy @DIST_LARGE,x
  coded:
      lda @DIST_CODE,y
      sta @PUT_VALUE
      stz @PUT_VALUE + 1
      stz @PUT_VALUE + 2
      lda #5
      sta @PUT_COUNT
      jsr DEF_PUT_BITS
      lda @DIST_EXTRA,y
      beq done
      sta @PUT_COUNT
      sec
      lda @DISTANCE
      sbc @DIST_BASE_LOW,y
      sta @PUT_VALUE
      lda @DISTANCE + 1
      sbc @DIST_BASE_HIGH,y
      sta @PUT_VALUE + 1
      stz @PUT_VALUE + 2
      jsr DEF_PUT_BITS
  done:
  END ASM
END SUB

' Codes a block at OUT_PTR: its header, fixed codes and not the last; a code for each literal
' or match from CURSOR on; its end code. The block ends at the end of the file, or at the first
' code that starts 7168 bytes or more into it. Sets BLOCK_IN to the bytes it codes.
SUB DEF_BLOCK()
  ASM
      stx @SAVED_X
      stz @BLOCK_IN
      stz @BLOCK_IN + 1
      lda #2
      sta @PUT_VALUE
      stz @PUT_VALUE + 1
      stz @PUT_VALUE + 2
      lda #3
      sta @PUT_COUNT
      jsr DEF_PUT_BITS
  token:
      ' 7168 is $1C00.
      lda @BLOCK_IN + 1
      cmp #$1C
      bcs closing
      jsr DEF_LOOK
      lda @AHEAD
      ora @AHEAD + 1
      beq closing
      jsr DEF_FIND
      lda @MATCH_LENGTH
      ora @MATCH_LENGTH + 1
      beq literal
      jsr DEF_MATCH
      bra advance
  literal:
      jsr DEF_LITERAL
  advance:
      ' MATCH_LENGTH bytes coded.
      clc
      lda @CURSOR
      adc @MATCH_LENGTH
      sta @CURSOR
      lda @CURSOR + 1
      adc @MATCH_LENGTH + 1
      and #$7F
      sta @CURSOR + 1
      sec
      lda @AHEAD
      sbc @MATCH_LENGTH
      sta @AHEAD
      lda @AHEAD + 1
      sbc @MATCH_LENGTH + 1
      sta @AHEAD + 1
      clc
      lda @BLOCK_IN
      adc @MATCH_LENGTH
      sta @BLOCK_IN
      lda @BLOCK_IN + 1
      adc @MATCH_LENGTH + 1
      sta @BLOCK_IN + 1
      bra token
  closing:
      ' The end code, 256: 7 bits of 0.
      stz @PUT_VALUE
      stz @PUT_VALUE + 1
      stz @PUT_VALUE + 2
      lda #7
      sta @PUT_COUNT
      jsr DEF_PUT_BITS
      ldx @SAVED_X
  END ASM
END SUB

' A = the 8 bits of A in the other order. Keeps X and Y.
SUB DEF_REVERSE()
  ASM
      sta @HASH_BYTE0
      lda #1
  next:
      ' The 1 leaves A after the eighth bit comes in.
      lsr @HASH_BYTE0
      rol a
      bcc next
  END ASM
END SUB

' A = 1 << A, for A 0 to 7. Keeps X and Y.
SUB DEF_POWER()
  ASM
      sta @HASH_BYTE1
      lda #1
  double:
      dec @HASH_BYTE1
      bmi done
      asl a
      bra double
  done:
  END ASM
END SUB

' Fills LIT_CODE_LOW and LIT_CODE_HIGH. A literal below 144 has the 8-bit code $30 + it, else
' the 9-bit code $100 + it.
SUB DEF_LIT_TABLES()
  ASM
      phx
      ldx #0
  next:
      txa
      cpx #144
      bcs nine
      clc
      adc #$30
      jsr DEF_REVERSE
      sta @LIT_CODE_LOW,x
      stz @LIT_CODE_HIGH,x
      bra stepped
  nine:
      jsr DEF_REVERSE
      sec
      rol a
      sta @LIT_CODE_LOW,x
      lda #0
      rol a
      sta @LIT_CODE_HIGH,x
  stepped:
      inx
      bne next
      plx
  END ASM
END SUB

' Fills LENGTH_SYMBOL, LENGTH_BASE, LENGTH_EXTRA and LENGTH_CODE. Symbol 257 + n, n from 8 to
' 27, has (n - 4) >> 2 extra bits; 285, n 28, is 258 alone. A symbol below 280 has the 7-bit
' code n + 1, else the 8-bit code $C0 + n - 23.
SUB DEF_LEN_TABLES()
  ASM
      phx
      ldx #0
      ldy #0
  symbol:
      lda #0
      cpx #8
      bcc extra_set
      txa
      sec
      sbc #4
      lsr a
      lsr a
  extra_set:
      sta @LENGTH_EXTRA,x
      tya
      sta @LENGTH_BASE,x
      lda @LENGTH_EXTRA,x
      jsr DEF_POWER
      sta @HASH_BYTE2
      txa
  fill:
      sta @LENGTH_SYMBOL,y
      iny
      dec @HASH_BYTE2
      bne fill
      inx
      cpx #28
      bne symbol
      lda #28
      sta @LENGTH_SYMBOL + 255
      lda #255
      sta @LENGTH_BASE + 28
      stz @LENGTH_EXTRA + 28
      ldx #0
  code:
      txa
      cpx #23
      bcs eight
      inc a
      jsr DEF_REVERSE
      lsr a
      bra coded
  eight:
      clc
      adc #$A9
      jsr DEF_REVERSE
  coded:
      sta @LENGTH_CODE,x
      inx
      cpx #29
      bne code
      plx
  END ASM
END SUB

' Fills DIST_SMALL, DIST_LARGE, DIST_BASE_LOW, DIST_BASE_HIGH, DIST_EXTRA and DIST_CODE.
' Symbol n from 4 has (n - 2) >> 1 extra bits; its code is n in 5 bits. Symbols 0 to 15 cover
' the distances less 1 below 256, 16 to 29 the rest, 128 to an entry of DIST_LARGE from 2 on.
' Uses DISTANCE for the base.
SUB DEF_DIST_TABLES()
  ASM
      phx
      stz @DISTANCE
      stz @DISTANCE + 1
      ldx #0
      ldy #0
  symbol:
      lda #0
      cpx #4
      bcc extra_set
      txa
      lsr a
      dec a
  extra_set:
      sta @DIST_EXTRA,x
      lda @DISTANCE
      sta @DIST_BASE_LOW,x
      lda @DISTANCE + 1
      sta @DIST_BASE_HIGH,x
      txa
      jsr DEF_REVERSE
      lsr a
      lsr a
      lsr a
      sta @DIST_CODE,x
      lda @DIST_EXTRA,x
      cpx #16
      bcc small
      sbc #7
  small:
      jsr DEF_POWER
      sta @HASH_BYTE2
      txa
  fill:
      cpx #16
      bcs large
      sta @DIST_SMALL,y
      bra filled
  large:
      sta @DIST_LARGE,y
  filled:
      iny
      dec @HASH_BYTE2
      bne fill
      cpx #15
      bne add
      ldy #2
  add:
      ' The base goes up by 1 << the extra bits.
      lda @DIST_EXTRA,x
      cmp #8
      bcs high
      jsr DEF_POWER
      clc
      adc @DISTANCE
      sta @DISTANCE
      bcc added
      inc @DISTANCE + 1
      bra added
  high:
      sbc #8
      jsr DEF_POWER
      clc
      adc @DISTANCE + 1
      sta @DISTANCE + 1
  added:
      inx
      cpx #30
      bne symbol
      plx
  END ASM
END SUB

' Deflates SOURCE to TEMP, and sets LENGTH and CRC. A block whose codes come to more bits than
' its bytes stored goes as a stored block. Leaves the window holding the file's last 32768
' bytes, a file of up to 32768 bytes from offset 0.
SUB DEFLATE_FILE()
  DIM START_CURSOR AS UWORD, START_ACC AS UBYTE, START_BITS AS UBYTE, FINAL AS UBYTE
  DIM CODED_BITS AS UWORD, STORED_BITS AS UWORD
  DEF_CLEAR_HEAD()
  CURSOR = 0
  AHEAD = 0
  AT_END = 0
  BIT_ACC = 0
  BIT_COUNT = 0
  OUT_PTR = $A000
  DO
    START_ACC = BIT_ACC
    START_BITS = BIT_COUNT
    START_CURSOR = CURSOR
    DEF_BLOCK()
    FINAL = 0
    IF AT_END <> 0 AND AHEAD = 0 THEN FINAL = 1
    ' A block's codes fit 8192 bytes, so its bits fit a UWORD. A stored block has 3 bits, 0 to
    ' 7 to reach a byte, the length and its complement, then the bytes.
    CODED_BITS = ((OUT_PTR - $A000) << 3) + BIT_COUNT - START_BITS
    STORED_BITS = (BLOCK_IN << 3) + 35 + ((5 - START_BITS) AND 7)
    IF STORED_BITS < CODED_BITS THEN
      OUT_PTR = $A000
      BIT_ACC = START_ACC
      BIT_COUNT = START_BITS
      PUT_BITS(FINAL, 3)
      IF BIT_COUNT > 0 THEN PUT_BITS(0, 8 - BIT_COUNT)
      PUT_BITS(BLOCK_IN, 16)
      PUT_BITS(BLOCK_IN XOR $FFFF, 16)
      OUT_FLUSH()
      WINDOW_PUT(START_CURSOR, BLOCK_IN)
    ELSE
      ' The block's first bit, in the first byte of the bank, marks the last block.
      IF FINAL THEN
        BANK.USE(OUT_BANK)
        ContentsAt($A000) = ContentsAt($A000) OR (1 << START_BITS)
      END IF
      OUT_FLUSH()
    END IF
  LOOP UNTIL FINAL
  IF BIT_COUNT > 0 THEN
    BUFFER(0) = BIT_ACC
    PUT(TEMP, @BUFFER, 1)
  END IF
END SUB

' Adds the file or folder PATH, with FILE_TIME, FILE_DATE and FILE_ATTRIBUTES, to TEMP and
' its central directory entry to LIST. A name the table holds, and the archive and the work
' files, are left out.
SUB ADD_ENTRY(PATH AS STRING, IS_FOLDER AS UBYTE)
  DIM AT AS UBYTE
  ENTRY_NAME = ENTRY_FOR(PATH)
  IF IS_FOLDER THEN ENTRY_NAME = ENTRY_NAME + "/"
  IF ENTRY_NAME = "/" THEN RETURN
  KEY_TEXT = UCASE$(ENTRY_NAME)
  IF KEY_TEXT = ARCHIVE_KEY OR KEY_TEXT = TEMP_KEY OR KEY_TEXT = LIST_KEY THEN RETURN
  IF TABLE_FIND(ENTRY_NAME) THEN RETURN
  IF TABLE_COUNT = TABLE_MAX THEN
    PRINT "zip warning: too many files: "; PATH
    EXIT_CODE = 3
    RETURN
  END IF
  IF IS_FOLDER = 0 THEN
    SOURCE = DOS.OPEN_FILE(PATH, DOS.ACCESS_READ)
    IF SOURCE = NOFILE THEN
      PRINT "zip warning: could not open for reading: "; PATH
      EXIT_CODE = 3
      RETURN
    END IF
  END IF
  PRINT "  adding: "; ENTRY_NAME;
  LINE_OPEN = 1
  FOR AT = 0 TO ENTRY_SIZE - 1
    RECORD(AT) = 0
  NEXT
  RECORD(0) = SIGNATURE_P
  RECORD(1) = SIGNATURE_K
  RECORD(2) = 1
  RECORD(3) = 2
  RECORD(4) = VERSION_MADE
  RECORD(6) = VERSION_STORED
  IF IS_FOLDER = 0 THEN
    RECORD(6) = VERSION_DEFLATED
    RECORD(ENTRY_METHOD) = METHOD_DEFLATED
  END IF
  ContentsAtW(@RECORD + ENTRY_TIME) = FILE_TIME
  ContentsAtW(@RECORD + ENTRY_DATE) = FILE_DATE
  ContentsAtW(@RECORD + NAME_SIZE_AT) = LEN(ENTRY_NAME)
  RECORD(EXTERNAL_AT) = FILE_ATTRIBUTES
  LOCAL_AT = TEMP_SIZE
  ContentsAtW(@RECORD + ENTRY_LOCAL) = ContentsAtW(@LOCAL_AT)
  ContentsAtW(@RECORD + ENTRY_LOCAL + 2) = ContentsAtW(@LOCAL_AT + 2)
  ' The local header is the central entry's bytes from the version needed to the extra
  ' field's size. A file's is written again after its data, with the method, CRC and sizes.
  HEADER(0) = SIGNATURE_P
  HEADER(1) = SIGNATURE_K
  HEADER(2) = 3
  HEADER(3) = 4
  FOR AT = 4 TO LOCAL_SIZE - 1
    HEADER(AT) = RECORD(AT + 2)
  NEXT
  PUT(TEMP, @HEADER, LOCAL_SIZE)
  PUT(TEMP, @ENTRY_NAME + 2, LEN(ENTRY_NAME))
  DATA_AT = TEMP_SIZE
  CRC = $FFFFFFFF
  LENGTH = 0
  IF IS_FOLDER = 0 THEN
    DEFLATE_FILE()
    BANK.USE(CALLER_BANK)
    DOS.CLOSE_FILE(SOURCE)
    SOURCE = NOFILE
  END IF
  PACKED = TEMP_SIZE - DATA_AT
  IF IS_FOLDER = 0 AND PACKED >= LENGTH AND LENGTH <= WINDOW_SIZE THEN
    ' No saving: the file again, stored, from the window, which holds all of it from offset
    ' 0. The deflated bytes past it are written over by what follows: the central entry and
    ' the end record at least.
    DOS.SEEK(TEMP, FROM_START, DATA_AT AND $FFFF, DATA_AT >> 16)
    TEMP_SIZE = DATA_AT
    WINDOW_PUT(0, LENGTH)
    BANK.USE(CALLER_BANK)
    RECORD(6) = VERSION_STORED
    RECORD(ENTRY_METHOD) = METHOD_STORED
    PACKED = LENGTH
  END IF
  CRC = CRC XOR $FFFFFFFF
  ContentsAtW(@RECORD + ENTRY_CRC) = ContentsAtW(@CRC)
  ContentsAtW(@RECORD + ENTRY_CRC + 2) = ContentsAtW(@CRC + 2)
  ContentsAtW(@RECORD + ENTRY_PACKED) = ContentsAtW(@PACKED)
  ContentsAtW(@RECORD + ENTRY_PACKED + 2) = ContentsAtW(@PACKED + 2)
  ContentsAtW(@RECORD + ENTRY_LENGTH) = ContentsAtW(@LENGTH)
  ContentsAtW(@RECORD + ENTRY_LENGTH + 2) = ContentsAtW(@LENGTH + 2)
  IF IS_FOLDER = 0 THEN
    ' The local header's 22 bytes from 4, the version needed, to the sizes.
    FOR AT = 4 TO LOCAL_SIZE - 5
      HEADER(AT) = RECORD(AT + 2)
    NEXT
    LOCAL_AT = LOCAL_AT + 4
    DOS.SEEK(TEMP, FROM_START, LOCAL_AT AND $FFFF, LOCAL_AT >> 16)
    IF DOS.WRITE_FILE(TEMP, @HEADER + 4, 22) <> 22 THEN ABORT(DOS.ERRMSG(DOS.ERROR), 3)
    DOS.SEEK(TEMP, FROM_START, TEMP_SIZE AND $FFFF, TEMP_SIZE >> 16)
  END IF
  TABLE_ADD(LIST_SIZE)
  PUT(LIST, @RECORD, ENTRY_SIZE)
  PUT(LIST, @ENTRY_NAME + 2, LEN(ENTRY_NAME))
  ENTRY_COUNT = ENTRY_COUNT + 1
  ADDED = ADDED + 1
  IF RECORD(ENTRY_METHOD) = METHOD_DEFLATED THEN
    PRINT " (deflated "; DECIMAL(SAVING(LENGTH, PACKED)); "%)"
  ELSE
    PRINT " (stored 0%)"
  END IF
  LINE_OPEN = 0
END SUB

' Adds the files and folders that ARGUMENT matches, and with -r what each folder holds. The
' find buffer of each folder the search is in waits in FIND_STACK.
SUB ADD_ARGUMENT()
  DIM AT AS UBYTE, IS_FOLDER AS UBYTE
  ' A folder named with a \ at its end is the folder.
  IF LEN(ARGUMENT) > 1 AND RIGHT$(ARGUMENT, 1) = "\" THEN
    IF MID$(ARGUMENT, LEN(ARGUMENT) - 1, 1) <> ":" THEN ARGUMENT = LEFT$(ARGUMENT, LEN(ARGUMENT) - 1)
  END IF
  WALK_PATH = LEFT$(ARGUMENT, FOLDER_LENGTH(ARGUMENT))
  DEPTH = 0
  DOS.FINDFIRST(ARGUMENT, DOS.ATTR_DIRECTORY)
  IF DOS.ERROR <> 0 THEN
    PRINT "zip warning: name not matched: "; ARGUMENT
    EXIT_CODE = 3
    RETURN
  END IF
  DO
    IF DOS.ERROR <> 0 THEN
      ' The end of a folder: back to the search of the folder that holds it.
      IF DEPTH = 0 THEN EXIT DO
      DEPTH = DEPTH - 1
      FOR AT = 0 TO DOS.FIND_ATTR - 1
        DOS.FIND_BUFFER(AT) = FIND_STACK(DEPTH * DOS.FIND_ATTR + AT)
      NEXT
      WALK_PATH = LEFT$(WALK_PATH, PATH_LENGTHS(DEPTH))
      DOS.FINDNEXT()
      CONTINUE
    END IF
    IF DOS.FOUND_NAME = "." OR DOS.FOUND_NAME = ".." THEN
      DOS.FINDNEXT()
      CONTINUE
    END IF
    FILE_PATH = WALK_PATH + DOS.FOUND_NAME
    FILE_TIME = DOS.FOUND_TIME
    FILE_DATE = DOS.FOUND_DATE
    FILE_ATTRIBUTES = DOS.FOUND_ATTRIBUTES
    IS_FOLDER = (FILE_ATTRIBUTES AND DOS.ATTR_DIRECTORY) <> 0
    ADD_ENTRY(FILE_PATH, IS_FOLDER)
    IF IS_FOLDER AND RECURSE THEN
      IF DEPTH = DEPTH_MAX THEN
        PRINT "zip warning: folder too deep: "; FILE_PATH
        EXIT_CODE = 3
      ELSE
        FOR AT = 0 TO DOS.FIND_ATTR - 1
          FIND_STACK(DEPTH * DOS.FIND_ATTR + AT) = DOS.FIND_BUFFER(AT)
        NEXT
        PATH_LENGTHS(DEPTH) = LEN(WALK_PATH)
        DEPTH = DEPTH + 1
        WALK_PATH = FILE_PATH + "\"
        DOS.FINDFIRST(WALK_PATH, DOS.ATTR_DIRECTORY)
        CONTINUE
      END IF
    END IF
    DOS.FINDNEXT()
  LOOP
END SUB

' Copies each entry of the old archive whose name the table does not hold to TEMP, and its
' central directory entry, with the new place of its local header, to LIST. An entry with a
' data descriptor keeps it.
SUB COPY_OLD()
  DIM NAME_SIZE AS UWORD, MORE AS ULONG, TOTAL AS ULONG, NEXT_AT AS ULONG, OLD_AT AS ULONG
  SEEK_TO(DIRECTORY_AT)
  DO WHILE ENTRIES > 0
    ENTRIES = ENTRIES - 1
    GET(ARCHIVE, @RECORD, ENTRY_SIZE)
    IF RECORD(0) <> SIGNATURE_P OR RECORD(1) <> SIGNATURE_K OR RECORD(2) <> 1 OR RECORD(3) <> 2 THEN
      ABORT("Not a ZIP archive", 2)
    END IF
    NAME_SIZE = ContentsAtW(@RECORD + NAME_SIZE_AT)
    IF NAME_SIZE > 255 THEN ABORT("Not a ZIP archive", 2)
    ContentsAt(@ENTRY_NAME + 1) = NAME_SIZE
    GET(ARCHIVE, @ENTRY_NAME + 2, NAME_SIZE)
    MORE = ContentsAtW(@RECORD + EXTRA_SIZE_AT)
    MORE = MORE + ContentsAtW(@RECORD + COMMENT_SIZE_AT)
    DOS.SEEK(ARCHIVE, FROM_POSITION, 0, 0)
    ContentsAtW(@NEXT_AT) = DOS.POSITION_LOW
    ContentsAtW(@NEXT_AT + 2) = DOS.POSITION_HIGH
    IF TABLE_FIND(ENTRY_NAME) THEN
      SEEK_TO(NEXT_AT + MORE)
      CONTINUE
    END IF
    ContentsAtW(@OLD_AT) = ContentsAtW(@RECORD + ENTRY_LOCAL)
    ContentsAtW(@OLD_AT + 2) = ContentsAtW(@RECORD + ENTRY_LOCAL + 2)
    SEEK_TO(OLD_AT)
    GET(ARCHIVE, @HEADER, LOCAL_SIZE)
    IF HEADER(0) <> SIGNATURE_P OR HEADER(1) <> SIGNATURE_K OR HEADER(2) <> 3 OR HEADER(3) <> 4 THEN
      ABORT("Not a ZIP archive", 2)
    END IF
    ContentsAtW(@TOTAL) = ContentsAtW(@RECORD + ENTRY_PACKED)
    ContentsAtW(@TOTAL + 2) = ContentsAtW(@RECORD + ENTRY_PACKED + 2)
    TOTAL = TOTAL + LOCAL_SIZE + ContentsAtW(@HEADER + LOCAL_NAME_SIZE)
    TOTAL = TOTAL + ContentsAtW(@HEADER + LOCAL_EXTRA_SIZE)
    IF RECORD(ENTRY_FLAGS) AND FLAG_DESCRIPTOR THEN
      ' A data descriptor follows the data, with or without its signature PK 7 8.
      SEEK_TO(OLD_AT + TOTAL)
      GET(ARCHIVE, @BUFFER, 4)
      IF BUFFER(0) = SIGNATURE_P AND BUFFER(1) = SIGNATURE_K AND BUFFER(2) = 7 AND BUFFER(3) = 8 THEN
        TOTAL = TOTAL + FULL_DESCRIPTOR
      ELSE
        TOTAL = TOTAL + BARE_DESCRIPTOR
      END IF
    END IF
    SEEK_TO(OLD_AT)
    ContentsAtW(@RECORD + ENTRY_LOCAL) = ContentsAtW(@TEMP_SIZE)
    ContentsAtW(@RECORD + ENTRY_LOCAL + 2) = ContentsAtW(@TEMP_SIZE + 2)
    COPY_OLD_BYTES(TEMP, TOTAL)
    PUT(LIST, @RECORD, ENTRY_SIZE)
    PUT(LIST, @ENTRY_NAME + 2, NAME_SIZE)
    SEEK_TO(NEXT_AT)
    COPY_OLD_BYTES(LIST, MORE)
    ENTRY_COUNT = ENTRY_COUNT + 1
  LOOP
END SUB

' Appends LIST and the end record to TEMP, closes both, and puts TEMP in the archive's place.
SUB FINISH()
  DIM DIRECTORY_START AS ULONG, PART AS UWORD, REST AS ULONG, AT AS UBYTE
  DIRECTORY_START = TEMP_SIZE
  DOS.SEEK(LIST, FROM_START, 0, 0)
  REST = LIST_SIZE
  DO WHILE REST > 0
    PART = BUFFER_SIZE
    IF REST < BUFFER_SIZE THEN PART = REST
    GET(LIST, @BUFFER, PART)
    PUT(TEMP, @BUFFER, PART)
    REST = REST - PART
  LOOP
  FOR AT = 0 TO END_SIZE - 1
    RECORD(AT) = 0
  NEXT
  RECORD(0) = SIGNATURE_P
  RECORD(1) = SIGNATURE_K
  RECORD(2) = 5
  RECORD(3) = 6
  ContentsAtW(@RECORD + END_ENTRIES - 2) = ENTRY_COUNT
  ContentsAtW(@RECORD + END_ENTRIES) = ENTRY_COUNT
  ContentsAtW(@RECORD + END_DIRECTORY - 4) = ContentsAtW(@LIST_SIZE)
  ContentsAtW(@RECORD + END_DIRECTORY - 2) = ContentsAtW(@LIST_SIZE + 2)
  ContentsAtW(@RECORD + END_DIRECTORY) = ContentsAtW(@DIRECTORY_START)
  ContentsAtW(@RECORD + END_DIRECTORY + 2) = ContentsAtW(@DIRECTORY_START + 2)
  PUT(TEMP, @RECORD, END_SIZE)
  DOS.CLOSE_FILE(TEMP)
  DOS.CLOSE_FILE(LIST)
  DOS.DELETE(LIST_NAME)
  IF OLD_EXISTS THEN
    DOS.CLOSE_FILE(ARCHIVE)
    DOS.DELETE(ARCHIVE_NAME)
    IF DOS.ERROR <> 0 THEN FAIL(DOS.ERRMSG(DOS.ERROR), 3)
  END IF
  DOS.RENAME(TEMP_NAME, ARCHIVE_NAME)
  IF DOS.ERROR <> 0 THEN FAIL(DOS.ERRMSG(DOS.ERROR), 3)
END SUB

' ---- the arguments ----
HELP_SWITCH("ZIP")
ARCHIVE = NOFILE
TEMP = NOFILE
LIST = NOFILE
SOURCE = NOFILE
SLOT = SLOT_P1
DO WHILE SLOT <= SLOT_P9
  ARGUMENT = HEAP.SYS_STRINGS_GET(SLOT)
  SLOT = SLOT + 1
  IF ARGUMENT = "" THEN CONTINUE
  IF ASC(ARGUMENT) = ASC("-") THEN
    SWITCH = 0
    IF LEN(ARGUMENT) = 2 THEN SWITCH = ASC(MID$(ARGUMENT, 2)) OR $20
    IF SWITCH = ASC("r") THEN
      RECURSE = 1
    ELSE
      FAIL("Invalid switch", 1)
    END IF
  ELSEIF ARCHIVE_NAME = "" THEN
    ARCHIVE_NAME = ARGUMENT
  ELSE
    FILE_SLOTS = FILE_SLOTS OR (1 << (SLOT - 1))
  END IF
LOOP
IF ARCHIVE_NAME = "" OR FILE_SLOTS = 0 THEN FAIL("Required parameter missing", 1)
IF INSTR(MID$(ARCHIVE_NAME, FOLDER_LENGTH(ARCHIVE_NAME) + 1), ".", 1) = 0 THEN
  ARCHIVE_NAME = ARCHIVE_NAME + ".ZIP"
END IF
TEMP_NAME = LEFT$(ARCHIVE_NAME, FOLDER_LENGTH(ARCHIVE_NAME)) + TEMP_FILE
LIST_NAME = LEFT$(ARCHIVE_NAME, FOLDER_LENGTH(ARCHIVE_NAME)) + LIST_FILE
ARCHIVE_KEY = UCASE$(ENTRY_FOR(ARCHIVE_NAME))
TEMP_KEY = UCASE$(ENTRY_FOR(TEMP_NAME))
LIST_KEY = UCASE$(ENTRY_FOR(LIST_NAME))

' ---- the old archive ----
ARCHIVE = DOS.OPEN_FILE(ARCHIVE_NAME, DOS.ACCESS_READ)
IF ARCHIVE = NOFILE THEN
  IF DOS.ERROR <> DOS.ERR_NOT_FOUND THEN FAIL(DOS.ERRMSG(DOS.ERROR), 2)
ELSE
  OLD_EXISTS = 1
  READ_END()
END IF

' ---- the name table and the work files ----
CRC_TABLES()
CALLER_BANK = BANK.CURRENT()
TABLE_BANK = BANK.ALLOC(TABLE_BANKS)
IF TABLE_BANK = 0 THEN ABORT(DOS.ERRMSG(DOS.ERROR), 3)
FOR SLOT = 0 TO TABLE_BANKS - 1
  BANK.USE(TABLE_BANK + SLOT)
  FOR SLOT_AT = $A000 + 4 TO $C000 - 4 STEP SLOT_SIZE
    ContentsAtW(SLOT_AT) = 0
    ContentsAtW(SLOT_AT + 2) = 0
  NEXT
NEXT
WINDOW_BANK = BANK.ALLOC(DEFLATE_BANKS)
IF WINDOW_BANK = 0 THEN ABORT(DOS.ERRMSG(DOS.ERROR), 3)
WINDOW_END = WINDOW_BANK + WINDOW_BANKS
HEAD_BANK = WINDOW_END
OUT_BANK = WINDOW_END + 1
BANK.USE(CALLER_BANK)
DEF_LIT_TABLES()
DEF_LEN_TABLES()
DEF_DIST_TABLES()
TEMP = DOS.CREATE_FILE(TEMP_NAME, 0)
IF TEMP = NOFILE THEN ABORT(DOS.ERRMSG(DOS.ERROR), 3)
LIST = DOS.CREATE_FILE(LIST_NAME, 0)
IF LIST = NOFILE THEN ABORT(DOS.ERRMSG(DOS.ERROR), 3)

' ---- the files ----
FOR SLOT = SLOT_P1 TO SLOT_P9
  IF FILE_SLOTS AND (1 << SLOT) THEN
    ARGUMENT = HEAP.SYS_STRINGS_GET(SLOT)
    ADD_ARGUMENT()
  END IF
NEXT
IF ADDED = 0 THEN ABORT("zip error: Nothing to do! (" + ARCHIVE_NAME + ")", 3)
IF OLD_EXISTS THEN COPY_OLD()
FINISH()
END EXIT_CODE
