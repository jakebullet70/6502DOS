'=============================================================================================
' -- GUIDEMO
' -- shows what GUI Forms does. The main form has a menu bar and a button for each demo; the
' -- menu item and the button open the same demo. After a demo, the status line, the screen's
' -- last row, tells how it ended and what it returned.
' --     F10, Alt+letter   open a menu
' --     Alt+letter        press a button of the main form
' --     Esc               end the program
' -- Program, Memory shows how the program uses memory: the low RAM it fills, the RAM banks of
' -- the system, of GUIDEMO, of the programs that ran it and of programs kept, the free bytes
' -- of the string heap, and a map of the banks.
' -- The demos:
' --     Forms     fields with captions, sections in one and two columns, a mask, the
' --               PASSWORD, READ_ONLY, UPPER, LOWER and PROPER flags, and a VALIDATE field
' --               that REFUSE holds until it takes two digits
' --     Controls  check boxes in two columns, two sets of radio buttons, a combo box, and
' --               the buttons OK, Show and Cancel; Show reports the choices and keeps the form
' -- Exit code 0.
' --
' -- From a prompt:
' --     GUIDEMO
'=============================================================================================
#INCLUDE "DOS.UXI"
#INCLUDE "KEYS.UXI"
#INCLUDE "CONS.UXI"
#INCLUDE "VERA.UXI"
#INCLUDE "GUI.UXI"
#INCLUDE "BANK.UXI"
#INCLUDE "HEAP.UXI"

' The ids of the menu items and the buttons.
CONST ID_EXIT AS UBYTE = 1, ID_MEMORY AS UBYTE = 2, ID_FORMS AS UBYTE = 10
CONST ID_CONTROLS AS UBYTE = 11
' The Controls demo's Show button.
CONST ID_SHOW AS UBYTE = 3
' The choices of the Controls demo's radio buttons and combo box. A form keeps their addresses.
CONST SIZES$ = "Small|Medium|Large", ALIGNS$ = "Left|Center|Right"
CONST INKS$ = "Black|Red|Green|Yellow|Blue|Magenta|Cyan|White"

' The kernel's table of bank owners, in RAM bank 0, as src/asm/mem.inc and banks.s lay it out.
' Trap: a change to BANK_OWNER or its owner codes there must change these.
CONST OWNER_TABLE AS UWORD = $AC00, OWNER_SYSTEM AS UBYTE = $FF, OWNER_KEPT AS UBYTE = $FE
CONST OWNER_FIRST AS UBYTE = $80, OWNER_DEPTH AS UBYTE = $7F
' The PSP's last page of the program, and the end of the program area.
CONST PSP_TOP AS UWORD = $0702, PROGRAM_START AS UWORD = $0801, PROGRAM_LAST AS UWORD = $9EFF

DIM MAIN_FORM AS UBYTE, EVENT AS UBYTE, START_COLOR AS UBYTE
DIM MESSAGE AS STRING * 79

' The Forms demo's fields. A form keeps the addresses of its targets, so they are global.
DIM PERSON_NAME AS STRING * 24, SECRET AS STRING * 12, PHONE AS STRING * 14
DIM AGE AS STRING * 2, SHOWN_ONLY AS STRING * 24
DIM SHOUT AS STRING * 12, QUIET AS STRING * 12, PROPER_NAME AS STRING * 12, PLAIN AS STRING * 12

' The Controls demo's choices: 1 for a checked box, and a choice's number from 0.
DIM BOLD AS UBYTE, ITALIC AS UBYTE, UNDERLINE AS UBYTE, BLINKING AS UBYTE
DIM TEXT_SIZE AS UBYTE, TEXT_ALIGN AS UBYTE, INK_CHOICE AS UBYTE

' The Memory popup's lines, and a row of the bank map for each 64 banks.
DIM PROGRAM_LINE AS STRING * 68, LOW_FREE_LINE AS STRING * 68, BANKS_LINE AS STRING * 68
DIM SYSTEM_LINE AS STRING * 68, FREE_BANKS_LINE AS STRING * 68, OWN_LINE AS STRING * 68
DIM CALLERS_LINE AS STRING * 68, KEPT_LINE AS STRING * 68, HEAP_LINE AS STRING * 68
DIM MAP_ROW0 AS STRING * 68, MAP_ROW1 AS STRING * 68, MAP_ROW2 AS STRING * 68
DIM MAP_ROW3 AS STRING * 68

' Shows MESSAGE on the status line.
SUB REPORT()
  GUI.STATUS_LINE(MESSAGE)
END SUB

' NUMBER in decimal, with no space in front.
FUNCTION DECIMAL(NUMBER AS UWORD) AS STRING
  RETURN MID$(STR$(NUMBER), 2)
END FUNCTION

' NUMBER as $ and four hex digits.
FUNCTION HEX_WORD(NUMBER AS UWORD) AS STRING
  DIM TEXT AS STRING * 5, SHIFT AS UBYTE
  TEXT = "$"
  FOR SHIFT = 12 TO 0 STEP -4
    TEXT = TEXT + MID$("0123456789ABCDEF", ((NUMBER >> SHIFT) AND 15) + 1, 1)
  NEXT
  RETURN TEXT
END FUNCTION

' The owner of RAM bank NUMBER in the kernel's table.
FUNCTION OWNER_OF(NUMBER AS UBYTE) AS UBYTE
  RETURN BANK.GET_BYTE(0, OWNER_TABLE + NUMBER)
END FUNCTION



' The Memory popup. A bank's owner is the exec depth of the program that took it, plus 1, so
' GUIDEMO's banks have the deepest owner, and the programs that ran it own the ones below.
SUB MEMORY_INFO()
  DIM FORM AS UBYTE, NUMBER AS UBYTE, OWNER AS UBYTE, OWN_DEPTH AS UBYTE, MARK AS STRING * 1
  DIM BANK_COUNT AS UWORD, PROGRAM_END AS UWORD, SYSTEM_BANKS AS UWORD, FREE_BANKS AS UWORD
  DIM OWN_BANKS AS UWORD, OWN_RUNS AS UWORD, CALLER_BANKS AS UWORD, KEPT_BANKS AS UWORD
  DIM SYSTEM_LIST AS STRING * 40, OWN_LIST AS STRING * 40, MAP AS STRING * 64
  ' Low RAM: the program runs from $0801 to the end of the page in PSP_TOP.
  PROGRAM_END = ContentsAt(PSP_TOP)
  PROGRAM_END = (PROGRAM_END << 8) OR 255
  PROGRAM_LINE = "  GUIDEMO  $0801-" + HEX_WORD(PROGRAM_END) + "  " + DECIMAL(PROGRAM_END - PROGRAM_START + 1) + " bytes, code and variables"
  IF PROGRAM_END < PROGRAM_LAST THEN
    LOW_FREE_LINE = "  Free     " + HEX_WORD(PROGRAM_END + 1) + "-$9EFF  " + DECIMAL(PROGRAM_LAST - PROGRAM_END) + " bytes"
  ELSE
    LOW_FREE_LINE = "  Free     none"
  ENDIF
  ' A machine has 64, 128 or 256 banks. The banks it lacks are the system's.
  BANK_COUNT = 64
  OWN_DEPTH = 0
  FOR NUMBER = 0 TO 255
    OWNER = OWNER_OF(NUMBER)
    IF OWNER <> OWNER_SYSTEM THEN
      IF NUMBER >= 128 THEN
        BANK_COUNT = 256
      ELSEIF NUMBER >= 64 AND BANK_COUNT = 64 THEN
        BANK_COUNT = 128
      ENDIF
      IF OWNER <> OWNER_KEPT AND (OWNER AND OWNER_DEPTH) > OWN_DEPTH THEN OWN_DEPTH = OWNER AND OWNER_DEPTH
    ENDIF
  NEXT
  ' Counts each kind of bank and draws the map, a mark for each bank.
  MAP_ROW0 = ""
  MAP_ROW1 = ""
  MAP_ROW2 = ""
  MAP_ROW3 = ""
  MAP = ""
  SYSTEM_BANKS = 0
  FREE_BANKS = 0
  OWN_BANKS = 0
  OWN_RUNS = 0
  CALLER_BANKS = 0
  KEPT_BANKS = 0
  FOR NUMBER = 0 TO BANK_COUNT - 1
    OWNER = OWNER_OF(NUMBER)
    IF OWNER = OWNER_SYSTEM THEN
      MARK = "S"
      SYSTEM_BANKS = SYSTEM_BANKS + 1
      SYSTEM_LIST = SYSTEM_LIST + " " + DECIMAL(NUMBER)
    ELSEIF OWNER = 0 THEN
      MARK = "."
      FREE_BANKS = FREE_BANKS + 1
    ELSEIF OWNER = OWNER_KEPT THEN
      MARK = "K"
      KEPT_BANKS = KEPT_BANKS + 1
    ELSEIF (OWNER AND OWNER_DEPTH) = OWN_DEPTH THEN
      MARK = "G"
      OWN_BANKS = OWN_BANKS + 1
      OWN_LIST = OWN_LIST + " " + DECIMAL(NUMBER)
      IF (OWNER AND OWNER_FIRST) <> 0 THEN OWN_RUNS = OWN_RUNS + 1
    ELSE
      MARK = "C"
      CALLER_BANKS = CALLER_BANKS + 1
    ENDIF
    MAP = MAP + MARK
    IF (NUMBER AND 63) = 63 THEN
      SELECT CASE NUMBER >> 6
        CASE 0
          MAP_ROW0 = "  0 " + MAP
        CASE 1
          MAP_ROW1 = " 64 " + MAP
        CASE 2
          MAP_ROW2 = "128 " + MAP
        CASE 3
          MAP_ROW3 = "192 " + MAP
      END SELECT
      MAP = ""
    ENDIF
  NEXT
  BANKS_LINE = "RAM banks  " + DECIMAL(BANK_COUNT) + " banks of 8 KB at $A000-$BFFF, " + DECIMAL(BANK_COUNT * 8) + " KB"
  SYSTEM_LINE = "  System   " + DECIMAL(SYSTEM_BANKS) + " banks:" + SYSTEM_LIST
  FREE_BANKS_LINE = "  Free     " + DECIMAL(FREE_BANKS) + " banks, " + DECIMAL(FREE_BANKS * 8) + " KB"
  OWN_LINE = "  GUIDEMO  " + DECIMAL(OWN_BANKS) + " banks in " + DECIMAL(OWN_RUNS) + " runs:" + OWN_LIST
  CALLERS_LINE = "  Callers  " + DECIMAL(CALLER_BANKS) + " banks of the programs that ran GUIDEMO"
  KEPT_LINE = "  Kept     " + DECIMAL(KEPT_BANKS) + " banks of programs that ended with keep"
  HEAP_LINE = "Strings    " + DECIMAL(HEAP.STR_GC()) + " bytes free in the string heap, bank " + DECIMAL(ContentsAt(HEAP.PSP_HEAP))

  FORM = GUI.CREATEFORM("Memory", GUI.CENTER, GUI.CENTER, 74, 23, GUI.FRAMED)
  GUI.SAY(1, 2, "Low RAM    $0801-$9EFF  38655 bytes")
  GUI.SAY(2, 2, PROGRAM_LINE)
  GUI.SAY(3, 2, LOW_FREE_LINE)
  GUI.SAY(5, 2, BANKS_LINE)
  GUI.SAY(6, 2, SYSTEM_LINE)
  GUI.SAY(7, 2, FREE_BANKS_LINE)
  GUI.SAY(8, 2, OWN_LINE)
  GUI.SAY(9, 2, CALLERS_LINE)
  GUI.SAY(10, 2, KEPT_LINE)
  GUI.SAY(12, 2, HEAP_LINE)
  GUI.SAY(14, 2, "Bank map   S system  . free  G GUIDEMO  C callers  K kept")
  GUI.SAY(15, 2, MAP_ROW0)
  GUI.SAY(16, 2, MAP_ROW1)
  GUI.SAY(17, 2, MAP_ROW2)
  GUI.SAY(18, 2, MAP_ROW3)
  GUI.BUTTON(20, 33, "&OK", 1)
  GUI.SHOW(FORM)
  GUI.FREE(FORM)
  MESSAGE = "Memory: " + DECIMAL(FREE_BANKS) + " banks free, GUIDEMO has " + DECIMAL(OWN_BANKS)
  REPORT()
END SUB



' The Forms demo: a form of two sections over the buttons OK and Cancel. Leaving the Age field
' with a space in it is refused.
SUB FORMS_DEMO()
  DIM FORM AS UBYTE, AGE_FIELD AS UBYTE, RESULT AS UBYTE
  FORM = GUI.CREATEFORM("Forms", GUI.CENTER, GUI.CENTER, 56, 17, GUI.FRAMED)
  GUI.SAY(GUI.AUTO, 2, "Tab, Up and Down move. Esc cancels.")
  GUI.STARTSECTION(FORM, "Fields", GUI.FRAMED)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Name", PERSON_NAME, 24, "", GUI.PROPER)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Password", SECRET, 12, "", GUI.PASSWORD)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Phone", PHONE, 14, "(###)-###-####")
  AGE_FIELD = GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Age", AGE, 2, "##", GUI.VALIDATE)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Read only", SHOWN_ONLY, 24, "", GUI.READ_ONLY)
  GUI.STARTSECTION(FORM, "Case", GUI.FRAMED OR GUI.TWO_COL)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Upper", SHOUT, 12, "", GUI.UPPER)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Lower", QUIET, 12, "", GUI.LOWER)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Proper", PROPER_NAME, 12, "", GUI.PROPER)
  GUI.SAYGET(GUI.AUTO, GUI.AUTO, "Plain", PLAIN, 12)
  GUI.ENDSECTION()
  GUI.BUTTON(15, 17, "&OK", 1)
  GUI.BUTTON(15, 27, "&Cancel", 2)
  DO
    RESULT = GUI.SHOW(FORM)
    IF RESULT <> GUI.EV_LEAVE THEN EXIT DO
    IF GUI.LEFT_FIELD = AGE_FIELD AND INSTR(AGE, " ") > 0 THEN GUI.REFUSE("Age takes two digits.")
  LOOP
  GUI.FREE(FORM)
  IF RESULT = 1 THEN
    MESSAGE = "Forms: OK. " + PERSON_NAME + ", " + AGE + ", " + PHONE
  ELSE
    MESSAGE = "Forms: cancelled, event " + STR$(RESULT)
  ENDIF
  REPORT()
END SUB

' Choice NUMBER of CHOICES$, whose choices have | between them, counted from 0.
FUNCTION CHOICE_NAME(CHOICES$ AS CONST, NUMBER AS UBYTE) AS STRING
  DIM START AS UBYTE, FINISH AS UBYTE
  START = 1
  REPEAT NUMBER
    START = INSTR(CHOICES$, "|", START) + 1
  END REPEAT
  FINISH = INSTR(CHOICES$, "|", START)
  IF FINISH = 0 THEN FINISH = LEN(CHOICES$) + 1
  RETURN MID$(CHOICES$, START, FINISH - START)
END FUNCTION

' The Controls demo's choices as words: the checked boxes, the size, the alignment and the ink.
FUNCTION CONTROLS_TEXT() AS STRING
  DIM TEXT AS STRING * 60
  TEXT = ""
  IF BOLD THEN TEXT = "Bold "
  IF ITALIC THEN TEXT = TEXT + "Italic "
  IF UNDERLINE THEN TEXT = TEXT + "Underline "
  IF BLINKING THEN TEXT = TEXT + "Blink "
  IF TEXT = "" THEN TEXT = "Plain "
  RETURN TEXT + CHOICE_NAME(SIZES$, TEXT_SIZE) + ", " + CHOICE_NAME(ALIGNS$, TEXT_ALIGN) + ", " + CHOICE_NAME(INKS$, INK_CHOICE) + " ink"
END FUNCTION

' The Controls demo: four check boxes in a section of two columns, then two sets of radio
' buttons and a combo box, over the buttons OK, Show and Cancel. Show reports the choices on the
' status line and the form stays.
SUB CONTROLS_DEMO()
  DIM FORM AS UBYTE, RESULT AS UBYTE
  FORM = GUI.CREATEFORM("Controls", GUI.CENTER, GUI.CENTER, 56, 15, GUI.FRAMED)
  GUI.SAY(GUI.AUTO, 2, "Space checks a box and opens the Ink list. Left and")
  GUI.SAY(GUI.AUTO, 2, "Right choose a size and an alignment. Show reports.")
  GUI.STARTSECTION(FORM, "Style", GUI.FRAMED OR GUI.TWO_COL)
  GUI.CHECK(GUI.AUTO, GUI.AUTO, "Bold", @BOLD)
  GUI.CHECK(GUI.AUTO, GUI.AUTO, "Italic", @ITALIC)
  GUI.CHECK(GUI.AUTO, GUI.AUTO, "Underline", @UNDERLINE)
  GUI.CHECK(GUI.AUTO, GUI.AUTO, "Blink", @BLINKING)
  GUI.STARTSECTION(FORM, "Choices", GUI.FRAMED)
  GUI.RADIO(GUI.AUTO, GUI.AUTO, "Size", SIZES$, @TEXT_SIZE)
  GUI.RADIO(GUI.AUTO, GUI.AUTO, "Align", ALIGNS$, @TEXT_ALIGN)
  GUI.CBO(GUI.AUTO, GUI.AUTO, "Ink", INKS$, @INK_CHOICE, 10)
  GUI.ENDSECTION()
  GUI.BUTTON(13, 12, "&OK", 1)
  GUI.BUTTON(13, 21, "&Show", ID_SHOW)
  GUI.BUTTON(13, 32, "&Cancel", 2)
  DO
    RESULT = GUI.SHOW(FORM)
    IF RESULT <> ID_SHOW THEN EXIT DO
    MESSAGE = "Controls: " + CONTROLS_TEXT()
    REPORT()
  LOOP
  GUI.FREE(FORM)
  IF RESULT = 1 THEN
    MESSAGE = "Controls: OK. " + CONTROLS_TEXT()
  ELSE
    MESSAGE = "Controls: cancelled, event " + STR$(RESULT)
  ENDIF
  REPORT()
END SUB

SUb SEED_demo()
  PERSON_NAME = "Ada Lovelace"
  PHONE = "(555)-010-1815"
  AGE = "36"
  SHOWN_ONLY = "This field reads only"
  BOLD = 1
  TEXT_SIZE = 1
end sub


START_COLOR = DOS.GET_COLOR()
GUI.THEME(GRAY)
GUI.USE_COLOR(GUI.ROLE.PAGE)
CONS.CLS()
SEED_demo()

' The main form fills the screen between the menu bar and the status line.
MAIN_FORM = GUI.CREATEFORM("6502DOS GUI Demo", 1, 0, 80, 28, GUI.FRAMED OR GUI.NO_SHADOW)
GUI.SAY(2, 3, "F10, or Alt with a menu's letter, opens the menus. Esc ends the program.")
GUI.SAY(3, 3, "Each button opens the demo of the menu item with its name.")
GUI.BUTTON(5, 3, "&Forms", ID_FORMS)
GUI.BUTTON(5, 14, "&Controls", ID_CONTROLS)
GUI.BUTTON(5, 56, "&Memory", ID_MEMORY)
GUI.BUTTON(5, 68, "E&xit", ID_EXIT)
GUI.MENUBAR(MAIN_FORM)
GUI.BEGINMENU("&Program")
GUI.MENUITEM("&Memory", ID_MEMORY)
GUI.MENUITEM("E&xit", ID_EXIT)
GUI.ENDMENU()
GUI.BEGINMENU("&Demos")
GUI.MENUITEM("&Forms", ID_FORMS)
GUI.MENUITEM("&Controls", ID_CONTROLS)
GUI.ENDMENU()
MESSAGE = "Ready."
REPORT()
DO
  EVENT = GUI.SHOW(MAIN_FORM)
  SELECT CASE EVENT
    CASE ID_FORMS
      FORMS_DEMO()
    CASE ID_CONTROLS
      CONTROLS_DEMO()
    CASE ID_MEMORY
      MEMORY_INFO()
    CASE ID_EXIT, GUI.EV_CANCEL
      EXIT DO
  END SELECT
LOOP

// --- END of prg
DOS.SET_COLOR(START_COLOR)
CONS.CLS()
PRINT "End GUI Demo... Bye!"
END
