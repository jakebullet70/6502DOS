' ROM3TEST.UXB -- runs from ROM bank 3: tools/build.py puts its code there and ROM3TEST.COM
' starts it. It writes each kind of RAM a program uses and runs a child.
#INCLUDE "DOS.UXI"
#ORG $C000
#DATA $0801
DIM VISITOR AS STRING * 20, READ_BACK$ * 20, SQUARES(5) AS UWORD, INDEX AS UBYTE
DIM BIG AS LONG, FILE_HANDLE AS UWORD

FUNCTION GREETING(WHO AS STRING) AS STRING
  DIM GREETING_TEXT AS STRING * 30
  GREETING_TEXT = "HELLO, " + WHO + "!"
  RETURN GREETING_TEXT
END FUNCTION

INPUT "NAME"; VISITOR
PRINT GREETING(VISITOR)
FOR INDEX = 0 TO 4
  SQUARES(INDEX) = INDEX * INDEX
NEXT
PRINT SQUARES(3); SQUARES(4)
BIG = 100000
PRINT BIG * 3
FILE_HANDLE = OPEN("ROM3.TXT", O.WRITE)
PRINT #FILE_HANDLE, "FROM ROM"
CLOSE FILE_HANDLE
FILE_HANDLE = OPEN("ROM3.TXT", O.READ)
LINPUT #FILE_HANDLE, READ_BACK$
CLOSE FILE_HANDLE
PRINT "["; READ_BACK$; "]"
DOS.EXEC("ARGS.COM", "CHILD")
PRINT "BACK IN BANK"; PEEK($01)
