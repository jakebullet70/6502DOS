' ROM3TEST.UXB -- runs from ROM banks 3 and 4: tools/build.py puts its code there and
' ROM3TEST.COM starts it. It writes each kind of RAM a program uses and runs a child. FAR_BYTE
' and the SUBs after it run from bank 4; they call bank 3 and are called from it.
#INCLUDE "DOS.UXI"
#ORG $C000
#DATA $0801
#ROMBANKS 3, 4, FAR_BYTE
DIM VISITOR AS STRING * 20, READ_BACK$ * 20, SQUARES(5) AS UWORD, INDEX AS UBYTE
DIM BIG AS LONG, FILE_HANDLE AS UWORD

FUNCTION GREETING(WHO AS STRING) AS STRING
  DIM GREETING_TEXT AS STRING * 30
  GREETING_TEXT = "HELLO, " + WHO + "!"
  RETURN GREETING_TEXT
END FUNCTION

FUNCTION NEAR_ADD(VALUE AS UWORD) AS UWORD
  RETURN FAR_WORD(VALUE) + 1
END FUNCTION

FUNCTION FAR_BYTE(VALUE AS UBYTE) AS UBYTE
  RETURN VALUE + 1
END FUNCTION

FUNCTION FAR_WORD(VALUE AS UWORD) AS UWORD
  RETURN VALUE * 2
END FUNCTION

FUNCTION FAR_LONG(VALUE AS LONG) AS LONG
  RETURN VALUE * 10
END FUNCTION

FUNCTION FAR_TEXT(WHO AS STRING) AS STRING
  RETURN GREETING(WHO) + " BANK" + STR$(PEEK($01))
END FUNCTION

FUNCTION FAR_DEEP(VALUE AS UWORD) AS UWORD
  RETURN NEAR_ADD(VALUE) + 100
END FUNCTION

SUB FAR_SHOW(LABEL AS STRING)
  PRINT LABEL; " IN BANK"; PEEK($01)
END SUB

INPUT "NAME"; VISITOR
PRINT GREETING(VISITOR)
FOR INDEX = 0 TO 4
  SQUARES(INDEX) = INDEX * INDEX
NEXT
PRINT SQUARES(3); SQUARES(4)
BIG = 100000
PRINT BIG * 3
FILE_HANDLE = OPEN("ROM3.TXT", O.WRITE)
PRINT #FILE_HANDLE, "FROM ROM"
CLOSE FILE_HANDLE
FILE_HANDLE = OPEN("ROM3.TXT", O.READ)
LINPUT #FILE_HANDLE, READ_BACK$
CLOSE FILE_HANDLE
PRINT "["; READ_BACK$; "]"
PRINT FAR_BYTE(41); FAR_WORD(1000); FAR_LONG(BIG)
PRINT 5 + FAR_WORD(3) * 2 + FAR_BYTE(1) * 100
PRINT FAR_TEXT(VISITOR)
PRINT FAR_DEEP(7)
FAR_SHOW("SUB")
DOS.EXEC("ARGS.COM", "CHILD")
PRINT "BACK IN BANK"; PEEK($01)
