' ENDCHILD: the program the ENDCODE test runs. It ends with an exit code picked by the second
' character of its command tail, which exec puts in the PSP at $0780.
DIM LETTER AS UBYTE AT $0782
DIM CODE AS UBYTE

SUB QUIT(VALUE AS UBYTE)
  END VALUE
END SUB

CODE = 7
' A is 65.
IF LETTER = 65 THEN END
IF LETTER = 66 THEN END 20
IF LETTER = 67 THEN END 253
IF LETTER = 68 THEN QUIT(30)
END CODE + 1
