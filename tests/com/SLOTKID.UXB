' SLOTKID: a program the SHRUN test runs. Prints its command tail, the slots P1$, P2$ and P9$,
' and PATH$. Then sets P1$ to DONE and P2$ empty, and ends with exit code 5.
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
DIM TAIL_LENGTH AS UBYTE AT $0780
DIM INDEX AS UBYTE

PRINT "TAIL [";
FOR INDEX = 1 TO TAIL_LENGTH
  PRINT CHR$(PEEK($0780 + INDEX));
NEXT
PRINT "]"
PRINT "P1$ "; HEAP.STR_GET(HEAP.SYS_STRINGS_BASE)
PRINT "P2$ "; HEAP.STR_GET(HEAP.SYS_STRINGS_BASE + 2)
PRINT "P9$ "; HEAP.STR_GET(HEAP.SYS_STRINGS_BASE + 16)
PRINT "PATH$ "; HEAP.STR_GET(HEAP.PATH_STRING)
HEAP.STR_SET(HEAP.SYS_STRINGS_BASE, "DONE")
HEAP.STR_FREE(HEAP.SYS_STRINGS_BASE + 2)
END 5
