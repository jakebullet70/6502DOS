' FONTHEX file code: prints the file's size and the 8 bytes of glyph code, in decimal, each
' byte in hex, for the test FONTED.
#INCLUDE "DOS.UXI"
#INCLUDE "HEAP.UXI"
CONST DIGITS$ = "0123456789ABCDEF"
DIM FONT(2049) AS UBYTE, FONT_FILE AS UWORD, COUNT AS UWORD, AT AS UWORD, ROW AS UBYTE

FONT_FILE = DOS.OPEN_FILE(HEAP.SYS_STRINGS_GET(0), DOS.ACCESS_READ)
IF FONT_FILE = NOFILE THEN
  PRINT DOS.ERRMSG(DOS.ERROR)
  END 1
END IF
COUNT = DOS.READ_FILE(FONT_FILE, @FONT, 2049)
DOS.CLOSE_FILE(FONT_FILE)
PRINT COUNT;
AT = VAL(HEAP.SYS_STRINGS_GET(1)) * 8
FOR ROW = 0 TO 7
  PRINT " "; MID$(DIGITS$, FONT(AT + ROW) / 16 + 1, 1); MID$(DIGITS$, (FONT(AT + ROW) AND 15) + 1, 1);
NEXT
PRINT
END 0
