' VERABOX: VERA.UXI. The screen is scrolled 3 lines first, so the map does not start at row 0.
' Line 1: MAP_TOP against the scroll registers (1), the Q printed at 5, 3 (81), PUT_CELL's cell
' at 6, 10 (8001), FILL's cells at 9, 9 (11842) and at 9, 10 (32). Line 2: SAVE_RECT of 5, 0,
' 12 by 6 (1), of 6, 2, 3 by 2 inside it (1), a cell inside the inner box after FILLs over both
' and one RESTORE_RECT (88), then after the second the Q, the PUT_CELL cell and the FILL cell
' (81, 8001, 11842). Line 3: SAVE_RECT with width 0 and 128 (0, 0), the full screens that fit
' the stack (13), and the Q after they are all restored and one more RESTORE_RECT (81).
#INCLUDE "VERA.UXI"
DIM SCROLL_LOW AS UBYTE AT $9F39, SCROLL_HIGH AS UBYTE AT $9F3A
DIM TOP_OK AS UBYTE, PRINTED AS UWORD, PUT AS UWORD, FILLED AS UWORD, BESIDE AS UWORD
DIM OUTER AS UBYTE, INNER AS UBYTE, AFTER_INNER AS UWORD, BACK_Q AS UWORD, BACK_PUT AS UWORD
DIM BACK_FILL AS UWORD, NARROW AS UBYTE, WIDE AS UBYTE, COUNT AS UBYTE, LAST_Q AS UWORD

PRINT "{CLS}";
POS(1) = 29
POS(0) = 0
PRINT
PRINT
PRINT
TOP_OK = VERA.MAP_TOP() = ((SCROLL_LOW / 8 + SCROLL_HIGH * 32) AND 63)
POS(1) = 5
POS(0) = 3
PRINT "Q";
PRINTED = VERA.GET_CELL(5, 3) AND 255
VERA.PUT_CELL(6, 10, 65, $1F)
PUT = VERA.GET_CELL(6, 10)
VERA.FILL(8, 0, 10, 2, 66, $2E)
FILLED = VERA.GET_CELL(9, 9)
BESIDE = VERA.GET_CELL(9, 10) AND 255

OUTER = VERA.SAVE_RECT(5, 0, 12, 6)
VERA.FILL(5, 0, 12, 6, 88, $40)
INNER = VERA.SAVE_RECT(6, 2, 3, 2)
VERA.FILL(6, 2, 3, 2, 89, $50)
VERA.RESTORE_RECT()
AFTER_INNER = VERA.GET_CELL(7, 4) AND 255
VERA.RESTORE_RECT()
BACK_Q = VERA.GET_CELL(5, 3) AND 255
BACK_PUT = VERA.GET_CELL(6, 10)
BACK_FILL = VERA.GET_CELL(9, 9)

NARROW = VERA.SAVE_RECT(0, 0, 0, 1)
WIDE = VERA.SAVE_RECT(0, 0, 128, 1)
COUNT = 0
DO WHILE VERA.SAVE_RECT(0, 0, 80, 30) = 1
  COUNT = COUNT + 1
LOOP
VERA.FILL(0, 0, 80, 29, 90, $30)
REPEAT COUNT
  VERA.RESTORE_RECT()
END REPEAT
VERA.RESTORE_RECT()
LAST_Q = VERA.GET_CELL(5, 3) AND 255

POS(1) = 20
POS(0) = 0
PRINT TOP_OK; " "; PRINTED; " "; PUT; " "; FILLED; " "; BESIDE
PRINT OUTER; " "; INNER; " "; AFTER_INNER; " "; BACK_Q; " "; BACK_PUT; " "; BACK_FILL
PRINT NARROW; " "; WIDE; " "; COUNT; " "; LAST_Q
