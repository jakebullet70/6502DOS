N = 0
REPEAT 3
  N = N + 1
  PRINT "R"; N
ENDREP
REPEAT 2
  REPEAT 2
    PRINT "IN";
  ENDREP
  PRINT
ENDREP
REPEAT 0
  PRINT "SKIPPED"
  REPEAT 2
    PRINT "SKIPPED"
  ENDREP
ENDREP
repeat -1
  print "SKIPPED"
endrep
REPEAT 2
  IF N = 3
    REPEAT 1
      PRINT "ONCE"
    ENDREP
  ENDIF
  IF N = 4
    PRINT "SKIPPED"
    REPEAT 3
    ENDREP
  ENDIF
ENDREP
REPEAT 3
  GOSUB LOOPSUB
ENDREP
PRINT "N"; N
ONERROR(1)
REPEAT 256
ENDREP
GOSUB BADSUB
PRINT "AFTER"
REPEAT 2
END
LOOPSUB:
REPEAT 5
  N = N + 1
  IF N > 4 RETURN
ENDREP
PRINT "NOT HERE"
BADSUB:
ENDREP
RETURN
