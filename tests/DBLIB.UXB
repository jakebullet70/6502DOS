' DBLIB: lib/DB.UXI on PEOPLE.DB and its PNAME.IDX and PID.IDX from tools/db.py's make, and
' NEW.DB, made here, with NEWIX.IDX.
#INCLUDE "DOS.UXI"
#INCLUDE "DB.UXI"
DIM PEOPLE AS UBYTE, FRESH AS UBYTE, N AS UBYTE, RECORD AS UWORD, SLOT AS UBYTE
DIM FIELDS(48) AS UBYTE

' Prints the NAME field, 1, of each record of the order.
SUB WALK()
  RECORD = DB.FIRST_RECORD()
  DO WHILE RECORD <> 0
    PRINT RECORD; " "; DB.GET(1); "|";
    RECORD = DB.NEXT_RECORD()
  LOOP
  PRINT
END SUB

' Appends a record to NEW.DB and writes it.
SUB ADD(NAME AS STRING, CITY AS STRING, AGE AS STRING)
  PRINT DB.APPEND();
  DB.PUT(1, NAME)
  DB.PUT(2, CITY)
  DB.PUT(3, AGE)
  DB.WRITE_RECORD()
  PRINT DOS.ERROR;
END SUB

' 1: open, the header, the fields, a name to a number
PEOPLE = DB.OPEN_TABLE("PEOPLE.DB")
PRINT "1"; PEOPLE <> 0; DOS.ERROR; DB.WORKSPACE = PEOPLE; DB.RECORD_COUNT(); DB.FIELD_COUNT()
FOR N = 1 TO DB.FIELD_COUNT()
  PRINT "1 "; DB.FIELD_NAME(N); " "; CHR$(DB.FIELD_TYPE(N)); DB.FIELD_LENGTH(N); DB.FIELD_DECIMALS(N)
NEXT
PRINT "1"; DB.FIELD_NUMBER("city"); DB.FIELD_NUMBER("JOINED"); DB.FIELD_NUMBER("NOPE")
PRINT "1 ["; DB.FIELD_NAME(8); "]"; DOS.ERROR; DB.FIELD_TYPE(0); DB.FIELD_TYPE(8); DOS.ERROR

' 2: go and get; a deleted record; a record and a field past the last
DB.GO(1)
PRINT "2 ["; DB.GET(2); "] ["; DB.GET(5); "]"; DB.DELETED
DB.GO(6)
PRINT "2 "; DB.GET(2); DB.DELETED
DB.GO(41)
PRINT "2"; DOS.ERROR
DB.GO(3)
PRINT "2 ["; DB.GET(8); "]"; DOS.ERROR

' 3: an index: first, next, last, previous, find
SLOT = DB.INDEX_OPEN("PNAME.IDX")
PRINT "3"; SLOT; DOS.ERROR
DB.ORDER(SLOT)
RECORD = DB.FIRST_RECORD()
PRINT "3"; RECORD; " "; DB.GET(2)
RECORD = DB.NEXT_RECORD()
PRINT "3"; RECORD; " "; DB.GET(2)
RECORD = DB.LAST_RECORD()
PRINT "3"; RECORD; " "; DB.GET(2)
RECORD = DB.PREVIOUS_RECORD()
PRINT "3"; RECORD; " "; DB.GET(2)
RECORD = DB.FIND("HAL")
PRINT "3"; RECORD; DOS.ERROR; " "; DB.GET(2)
RECORD = DB.FIND("HAM")
PRINT "3"; RECORD; DOS.ERROR; " "; DB.GET(2)
RECORD = DB.FIND("ZZZ")
PRINT "3"; RECORD; DOS.ERROR

' 4: a second index; the record order; a missing table keeps the workspace
PRINT "4"; DB.INDEX_OPEN("PID.IDX"); DOS.ERROR
DB.ORDER(DB.RECORD_ORDER)
PRINT "4"; DB.NEXT_RECORD(); DB.NEXT_RECORD(); DB.DELETED
PRINT "4"; DB.OPEN_TABLE("NOSUCH.DB"); DOS.ERROR; DB.WORKSPACE = PEOPLE

' 5: create, append, put, write; an index on two fields; delete and pack
DB.DEFINE(@FIELDS, 1, "NAME", "C", 10, 0)
DB.DEFINE(@FIELDS, 2, "CITY", "C", 8, 0)
DB.DEFINE(@FIELDS, 3, "AGE", "N", 3, 0)
FRESH = DB.CREATE("NEW.DB", @FIELDS, 3)
PRINT "5"; FRESH <> 0; FRESH <> PEOPLE; DOS.ERROR; DB.WORKSPACE = FRESH; DB.RECORD_COUNT(); DB.FIELD_COUNT()
ADD("ZOE", "PARIS", "30")
ADD("AMY", "ROME", "-5")
ADD("BOB", "PARIS", "7")
PRINT
DB.GO(2)
DB.PUT(2, "AMSTERDAM")
PRINT "5"; DOS.ERROR; " ["; DB.GET(3); "]"; DB.RECORD_COUNT()
PRINT "5"; DB.INDEX_CREATE("BAD.IDX", "CITY+NOPE", 0); DOS.ERROR
PRINT "5"; DB.INDEX_CREATE("BAD.IDX", "A+B+C+D+E", 0); DOS.ERROR
PRINT "5"; DB.INDEX_CREATE("NEWIX.IDX", "city+NAME", 0); DOS.ERROR
WALK()
DB.GO(1)
DB.DELETE()
DB.WRITE_RECORD()
DB.GO(1)
PRINT "5"; DB.DELETED
DB.RECALL()
DB.WRITE_RECORD()
DB.GO(1)
PRINT "5"; DB.DELETED
DB.GO(3)
DB.DELETE()
DB.WRITE_RECORD()
PRINT "5"; DB.PACK(); DOS.ERROR
WALK()

' 6: two tables open; the workspace picks one
DB.WORKSPACE = PEOPLE
DB.GO(2)
PRINT "6 "; DB.GET(2)
DB.WORKSPACE = FRESH
DB.GO(1)
PRINT "6 "; DB.GET(1)

' 7: close both
DB.CLOSE_TABLE()
PRINT "7"; DOS.ERROR; DB.WORKSPACE
DB.WORKSPACE = PEOPLE
DB.CLOSE_TABLE()
PRINT "7"; DOS.ERROR; DB.WORKSPACE
