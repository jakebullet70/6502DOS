RUN CMDSHELL.COM
PATH$ = "C:\DOS"
TAIL NOSUCH.TXT
TAIL A B
TAIL -x A
TAIL -n
TAIL -n 1X A
TAIL -n 65536 A
TAIL DOCS\README.TXT
TAIL DOCS\LONG.TXT
TAIL -n 3 DOCS\LONG.TXT
TAIL -n 0 DOCS\LONG.TXT
TAIL -n 60 DOCS\LONG.TXT
LIST DOCS\LONG.TXT | TAIL -N 2
PRINT "A" TO T.TXT
PRINT "B" APPEND T.TXT
PRINT "C" APPEND T.TXT
TAIL -n 2 FROM T.TXT
TAIL
END
