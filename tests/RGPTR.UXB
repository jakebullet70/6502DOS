' RGPTR: pointers to SUBs with regions. @ of a SUB in a region is its veneer in low RAM, so a
' pointer holds a low address wherever the SUB is and wherever the @ is. A pointer call in a
' region goes through the region's gate, so a SUB in low RAM that selects another bank returns
' to the region.
DECLARE FUNCTION STAGE(VALUE AS UBYTE) AS UBYTE
DIM DOUBLER AS STAGE, SQUARER AS STAGE, ADDER AS STAGE, FLIPPER AS STAGE
DIM BANK_ONE AS UBYTE, BANK_THREE AS UBYTE

FUNCTION PLUS_ONE(VALUE AS UBYTE) AS UBYTE
  RETURN VALUE + 1
END FUNCTION

FUNCTION FLIP(VALUE AS UBYTE) AS UBYTE
  POKE 0, BANK_ONE
  RETURN VALUE
END FUNCTION

#REGION_SLOT 1
FUNCTION DOUBLE(VALUE AS UBYTE) AS UBYTE
  BANK_ONE = PEEK(0)
  RETURN VALUE * 2
END FUNCTION

#REGION_SLOT 3
FUNCTION SQUARE(VALUE AS UBYTE) AS UBYTE
  RETURN VALUE * VALUE
END FUNCTION

SUB RUN_THREE()
  DIM CHOSEN AS STAGE
  BANK_THREE = PEEK(0)
  CHOSEN = @DOUBLE
  PRINT "THREE"; CALL CHOSEN WITH (5); CALL SQUARER WITH (4); CALL ADDER WITH (6)
  PRINT "FLIP"; CALL FLIPPER WITH (7); PEEK(0) = BANK_THREE
  PRINT CHOSEN = DOUBLER; CHOSEN < $A000
END SUB
#REGION_SLOT 0

DOUBLER = @DOUBLE
SQUARER = @SQUARE
ADDER = @PLUS_ONE
FLIPPER = @FLIP
PRINT "LOW"; CALL DOUBLER WITH (3); CALL SQUARER WITH (3); CALL ADDER WITH (3)
PRINT DOUBLER < $A000; SQUARER < $A000; BANK_ONE <> 0
RUN_THREE()
