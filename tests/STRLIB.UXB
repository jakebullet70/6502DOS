' STRLIB: the BINDs of STR.UXI and STR.INSTR_REV.
#INCLUDE "STR.UXI"
DIM TEXT AS STRING * 20, NUMBER AS ULONG
TEXT = "ABCABC"
PRINT STR.LEN(TEXT); STR.ASC(TEXT); STR.VAL("42"); STR.INSTR(TEXT, "C")
NUMBER = STR.LVAL("3000000000")
PRINT NUMBER
PRINT STR.CHR$(65); STR.STR$(7); STR.MID$(TEXT, 2, 3); STR.LEFT$(TEXT, 2); STR.RIGHT$(TEXT, 2)
PRINT STR.AddressOf(TEXT) = AddrOf(TEXT)
PRINT STR.INSTR_REV(TEXT, "C", 0); STR.INSTR_REV(TEXT, "C", 5); STR.INSTR_REV(TEXT, "BC", 0)
PRINT STR.INSTR_REV(TEXT, "BC", 4); STR.INSTR_REV(TEXT, "X", 0); STR.INSTR_REV(TEXT, "", 0)
PRINT STR.INSTR_REV("AB", "ABC", 0); STR.INSTR_REV(TEXT, "ABCABC", 0)
