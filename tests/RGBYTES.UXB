' RGBYTES: REGION_BYTES(n), the bytes of the region of slot n, or of all regions for 0, read
' from low RAM and from a region, in an expression and compared.
DIM TOTAL AS UWORD

#REGION_SLOT 1
FUNCT ONE() AS UWORD
  RETURN REGION_BYTES(1)
END FUNCT
#REGION_SLOT 3
SUB THREE()
  PRINT REGION_BYTES(3) > 0; REGION_BYTES(1) = ONE()
END SUB
#REGION_SLOT 0

PRINT REGION_BYTES(1); REGION_BYTES(3); REGION_BYTES(0)
TOTAL = REGION_BYTES(1) + REGION_BYTES(3)
PRINT TOTAL = REGION_BYTES(0); REGION_BYTES(2); REGION_BYTES(0) - 1 = TOTAL - 1
PRINT ONE() = REGION_BYTES(1)
THREE()
