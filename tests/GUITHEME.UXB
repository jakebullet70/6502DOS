' GUITHEME: GUI.THEME and GUI.USE_COLOR. Each line prints the current theme's 13 colors.
' 1: the console color USE_COLOR sets before any THEME. 2 to 4: DARK, LIGHT and GRAY.
' 5: a theme file of 13 bytes. 6: a file of 3 bytes. 7: a missing file. 8: USE_COLOR(TITLE).
#INCLUDE "KEYS.UXI"
#INCLUDE "DOS.UXI"
#INCLUDE "GUI.UXI"
DIM KEPT AS UBYTE, F AS UWORD, B(13) AS UBYTE, I AS UBYTE

SUB SHOW()
  FOR I = 1 TO 13
    PRINT ASC(MID$(GUI.COLORS$, I, 1));
  NEXT I
  PRINT
END SUB

KEPT = DOS.GET_COLOR()
GUI.USE_COLOR(FIELD_FOCUS)
I = DOS.GET_COLOR()
DOS.SET_COLOR(KEPT)
PRINT I
GUI.THEME(DARK)
SHOW()
GUI.THEME(LIGHT)
SHOW()
GUI.THEME(GRAY)
SHOW()
FOR I = 0 TO 12
  B(I) = I + 1
NEXT I
F = OPEN("T13.GTH", O.WRITE)
WRITE F, @B, 13
CLOSE F
F = OPEN("T3.GTH", O.WRITE)
WRITE F, @B, 3
CLOSE F
GUI.THEME(FILE, "T13.GTH")
SHOW()
GUI.THEME(FILE, "T3.GTH")
SHOW()
GUI.THEME(GRAY)
GUI.THEME(FILE, "NONE.GTH")
SHOW()
GUI.USE_COLOR(TITLE)
I = DOS.GET_COLOR()
DOS.SET_COLOR(KEPT)
PRINT I
