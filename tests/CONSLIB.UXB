' CONSLIB: the SUBs and BINDs of CONS.UXI, and KEYS.GETKEY. The colors before and after
' CONS.PRINTAT with a color match.
#INCLUDE "CONS.UXI"
#INCLUDE "DOS.UXI"
#INCLUDE "KEYS.UXI"
DIM ROW AS UBYTE, COLUMN AS UBYTE
CONS.CLS()
CONS.PRINT "A";
CONS.NEWLINE
CONS.LOCATE(5, 10)
ROW = CONS.POS(1)
COLUMN = CONS.POS(0)
PRINT ROW; COLUMN
CONS.PRINTAT(7, 3, "AT")
ROW = CONS.POS(1)
COLUMN = CONS.POS(0)
PRINT ROW; COLUMN
PRINT DOS.GET_COLOR()
CONS.PRINTAT(8, 3, "IN", $1F)
ROW = CONS.POS(1)
COLUMN = CONS.POS(0)
PRINT ROW; COLUMN
PRINT DOS.GET_COLOR()
CONS.PRINT_BOOL(1)
CONS.PRINT_BOOL(0)
CONS.NEWLINE
PRINT KEYS.GETKEY()
