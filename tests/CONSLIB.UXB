' CONSLIB: the SUBs and BINDs of CONS.UXI, and KEYS.GETKEY.
#INCLUDE "CONS.UXI"
#INCLUDE "KEYS.UXI"
DIM ROW AS UBYTE, COLUMN AS UBYTE
CONS.PRINT "A";
CONS.NEWLINE
CONS.LOCATE(5, 10)
ROW = CONS.POS(1)
COLUMN = CONS.POS(0)
PRINT ROW; COLUMN
CONS.PRINT_AT(7, 3, "AT")
ROW = CONS.POS(1)
COLUMN = CONS.POS(0)
PRINT ROW; COLUMN
CONS.PRINT_BOOL(1)
CONS.PRINT_BOOL(0)
CONS.NEWLINE
PRINT KEYS.GETKEY()
