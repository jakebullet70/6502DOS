' OPENMANY: 15 files open at once, each with its own position; the 16th is refused.
' HELLO.TXT is "Hello from the SD card." and CR LF, 25 bytes.
#INCLUDE "DOS.UXI"
DIM HANDLES(20) AS UWORD, OPENED AS UBYTE, INDEX AS UBYTE
DIM COUNT AS UWORD, STEP_COUNT AS UBYTE, BUFFER(8) AS UBYTE

' Reads 1 byte from HANDLE and prints it.
SUB TAKE(HANDLE AS UWORD)
  COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 1)
  PRINT CHR$(BUFFER(0));
END SUB

OPENED = 0
FOR INDEX = 1 TO 17
  HANDLES(INDEX) = DOS.OPEN_FILE("HELLO.TXT", DOS.ACCESS_READ)
  IF DOS.ERROR <> 0
    PRINT "OPEN"; INDEX; " E"; DOS.ERROR
    EXIT FOR
  ENDIF
  OPENED = INDEX
NEXT
PRINT "OPENED"; OPENED

' File n reads n bytes, so each file's position is its own.
FOR INDEX = 1 TO OPENED
  FOR STEP_COUNT = 1 TO INDEX
    TAKE(HANDLES(INDEX))
  NEXT
  PRINT
NEXT
FOR INDEX = 1 TO OPENED
  TAKE(HANDLES(INDEX))
NEXT
PRINT

FOR INDEX = 1 TO OPENED
  DOS.CLOSE_FILE(HANDLES(INDEX))
NEXT
HANDLES(1) = DOS.OPEN_FILE("HELLO.TXT", DOS.ACCESS_READ)
PRINT "OPEN AFTER E"; DOS.ERROR; " H"; HANDLES(1)
DOS.CLOSE_FILE(HANDLES(1))
