RUN CMDSHELL.COM
PRINT "A TO B" TO OUT.TXT
LIST OUT.TXT
print 1;2 to "OUT.TXT"
LIST OUT.TXT
FILES HELLO.TXT TO F.TXT
LIST F.TXT
A = 1
IF A = 2 PRINT "NO" TO N.TXT
LIST N.TXT
IF A = 1 PRINT "YES" TO N.TXT
LIST N.TXT
LIST NONE.TXT TO E.TXT
FILES E.TXT
PRINT 1 TO
PRINT 1 TO A B
PRINT 1 TO X:\A.TXT
BIND S=PRINT "S" TO S.TXT
S
LIST S.TXT
ARGS ONE TO A.TXT
LIST A.TXT
PRINT "ONE" APPEND P.TXT
PRINT "TWO" append "P.TXT"
FILES HELLO.TXT APPEND P.TXT
LIST P.TXT
PRINT "APPEND X"
PRINT 1 TO X APPEND
PRINT "BOB" TO Q.TXT
PRINT 42 APPEND Q.TXT
INPUT N$ FROM Q.TXT
PRINT N$
ASK FROM Q.TXT
INPUT A FROM NONE.TXT
PRINT "FROM"
VERSION TO V.TXT
LIST V.TXT
PRINT "BOB" | INPUT N$
PRINT N$
PRINT "A|B"|ASK
PRINT "AL" | ASK | INPUT N$
PRINT N$
BIND T=PRINT "T" | ASK
T | INPUT N$
PRINT N$
PRINT 1 | PRINT 2 TO
PRINT 1 TO | PRINT 2
FILES C:\PIPE*.*
IF A = 2 PRINT "NO" | INPUT N$
PRINT N$
PRINT "Q" | INPUT N$ TO Q.TXT
LIST Q.TXT
MD TMP
TEMP$ = "C:\TMP"
PRINT 1 | FILES C:\TMP
TEMP$ = "C:\TMP\"
PRINT "T" | ASK | FILES C:\TMP
FILES C:\TMP
TEMP$ = "C:\NONE"
PRINT 1 | ASK
X$ = "C:\0123456789012345678901234567890123456789"
TEMP$ = X$ + X$ + X$
PRINT 1 | ASK
TEMP$ = ""
RD TMP
PRINT "B" | ASK
VERSION
END
