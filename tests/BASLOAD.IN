MSBASIC
10 PRINT "SAVED"
20 FOR I=1 TO 2:PRINT I;:NEXT
SAVE "T.BAS"
NEW
LIST
LOAD "T.BAS"
LIST
RUN
LOAD "NOSUCH.BAS"
LIST
30 LOAD "HELLO.BAS"
RUN
LIST
HELP SAVE
NEW
10 OPEN 1,"T.BAS":OPEN 2,"HELLO.BAS"
20 FOR L=1 TO 2:A$="":B$=""
30 GET#1,C$:GET#2,D$:IF C$<>CHR$(13) THEN A$=A$+C$:B$=B$+D$:GOTO 30
40 PRINT A$:PRINT B$:NEXT:CLOSE 1:CLOSE 2
RUN
QUIT
TYPE T.BAS
VER
