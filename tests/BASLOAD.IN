MSBASIC
10 PRINT "SAVED"
20 FOR I=1 TO 2:PRINT I;:NEXT
SAVE "T.BAS"
NEW
LIST
LOAD "T.BAS"
LIST
RUN
LOAD "NOSUCH.BAS"
LIST
30 LOAD "HELLO.BAS"
RUN
LIST
HELP SAVE
NEW
10 OPEN 1,"T.BAS":OPEN 2,"HELLO.BAS"
20 FOR L=1 TO 2:A$="":B$=""
30 GET#1,C$:GET#2,D$:IF C$<>CHR$(13) THEN A$=A$+C$:B$=B$+D$:GOTO 30
40 PRINT A$:PRINT B$:NEXT:CLOSE 1:CLOSE 2
RUN
NEW
10 PRINT "NEW TEXT"
SAVE "T.BAS"
NAME "T.BAS" AS "U.BAS"
NAME "U.BAS" AS "HELLO.BAS"
NAME "NOSUCH.BAS" AS "V.BAS"
LOAD "T.BAS"
LOAD "U.BAS"
LIST
KILL "U.BAS"
KILL "U.BAS"
HELP NAME
HELP KILL
QUIT
TYPE HELLO.BAS
VER
