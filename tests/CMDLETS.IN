RUN CMDSHELL.COM
EXIST HELLO.TXT
PATH$ = "C:\DOS"
EXIST HELLO.TXT
PRINT P1$
EXIST NOSUCH.TXT
PRINT P1$
EXIST DOCS
PRINT P1$
EXIST
PRINT "[" + P1$ + "]"
DISKFREE
DISKFREE C:
DISKFREE c
DISKFREE A:
DISKFREE @
DISKFREE CC
PRINT "[" + P1$ + "]"
DISKFREE SILENT
PRINT P1$
DISKFREE C: SILENT
PRINT P1$
DISKFREE Q: SILENT
PRINT "[" + P1$ + "]"
DISKFREE
PRINT P1$
DISKINFO
DISKINFO C: SILENT
PRINT P1$ + " " + P2$ + " " + P3$ + " " + P4$ + " " + P5$
DISKINFO Q:
PRINT "[" + P1$ + "]"
HELP
HELP diskfree
HELP NOSUCH
END
