10 OPEN 1,"T.BAS":OPEN 2,"HELLO.BAS"
20 FOR L=1 TO 2:A$="":B$=""
30 GET#1,C$:GET#2,D$:IF C$<>CHR$(13) THEN A$=A$+C$:B$=B$+D$:GOTO 30
40 PRINT A$:PRINT B$:NEXT:CLOSE 1:CLOSE 2
