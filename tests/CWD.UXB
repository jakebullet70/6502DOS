' CWD: the current directory, . and .. in paths, CHDIR and GETCWD.
#INCLUDE "DOS.UXI"
DIM HANDLE AS UWORD

SUB SHOW(LABEL AS STRING)
  PRINT LABEL; " E"; DOS.ERROR
END SUB

SUB SHOW_CWD()
  PRINT "CWD ["; DOS.GETCWD(0); "]"
END SUB

SUB GO(PATH AS STRING)
  DIM CWD AS STRING * 80
  DOS.CHDIR(PATH)
  PRINT "CD "; PATH; " E"; DOS.ERROR;
  CWD = DOS.GETCWD(0)
  PRINT " ["; CWD; "] E"; DOS.ERROR
END SUB

SUB FIND(PATTERN AS STRING)
  DOS.FINDFIRST(PATTERN, DOS.ATTR_DIRECTORY)
  IF DOS.ERROR = 0
    PRINT "FIND "; PATTERN; " "; DOS.FOUND_NAME
  ELSE
    SHOW("FIND " + PATTERN)
  ENDIF
END SUB

' 1: the root
SHOW_CWD()
GO("..")
GO(".")
GO("NOPE")
GO("HELLO.TXT")

' 2: down and up
GO("DOCS")
FIND("README.TXT")
HANDLE = DOS.OPEN_FILE("LONG.TXT", DOS.ACCESS_READ)
SHOW("OPEN LONG.TXT")
DOS.CLOSE_FILE(HANDLE)
FIND("..\HELLO.TXT")
FIND(".\LONG.TXT")
FIND("\MANY\F01.TXT")
FIND("HELLO.TXT")
GO("..\MANY\SUB.DIR\INNER")
FIND("DEEP.TXT")
FIND("..\..\F02.TXT")
GO("..")
GO("C:/MANY/./SUB.DIR/INNER/")
GO("\")
GO("MANY/SUB.DIR/../../DOCS/.")

' 3: drives
PRINT "GETCWD C: ["; DOS.GETCWD(3); "]"
PRINT "GETCWD A: ["; DOS.GETCWD(1); "]"
SHOW("GETCWD A:")
PRINT "GETCWD E: ["; DOS.GETCWD(5); "]"
SHOW("GETCWD E:")
GO("A:\")
GO("C:\")
