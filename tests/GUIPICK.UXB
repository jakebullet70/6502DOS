' GUIPICK: GUI.PICKFILE in the folder PICKT, which it makes. The last lines give each result,
' then TARGET$ for a 1, then the current folder, which the dialogs leave as it was, then the
' names in PICKT and in PICKT\Sub.
' PICKT holds zed.TXT, Alpha.TXT, beta.TXT, C.DAT and the folders Sub, which holds in.TXT,
' and aFold. The list of folders starts .., aFold, Sub, then the drives.
' 1: Tab, Tab, Down and Enter choose beta.TXT. 2: 5 Backspaces, NEW.TXT and Enter return
' C:\PICKT\NEW.TXT. 3: \X.TXT the same way returns C:\X.TXT, and 4: D:\Z.TXT returns D:\Z.TXT.
' 5: the mask *.DAT, Enter, Tab, Tab and Enter choose C.DAT. 6: Tab, Down, Down and Enter
' open Sub, then Tab and Enter choose in.TXT. 7: Tab, Down and Enter open aFold, Enter on ..
' goes back, then Tab and Enter choose Alpha.TXT. 8: Sub, then Down and Enter on [-C-] go back
' to PICKT, then Tab and Enter choose Alpha.TXT. 9: Esc returns 0. 10: 4 Tabs and Enter on
' Cancel return 0.
' 11 and 12 call GUI.PICKMANAGE. 11: F7 makes the folder NewF; in the list of files F2
' renames beta.TXT to gamma.TXT; F5 and Enter on Alpha.TXT, a copy onto itself, show DOS error
' 5; F5 copies Alpha.TXT to Sub\Al2.TXT; Del and Yes delete Alpha.TXT; Esc returns 0. 12: in
' the list of folders Del and Yes delete aFold; Del on .. does nothing; F2 renames NewF to
' Fold2; Tab and Enter choose gamma.TXT.
' GUIPICK2 types paths.
#INCLUDE "KEYS.UXI"
#INCLUDE "DOS.UXI"
#INCLUDE "BANK.UXI"
#INCLUDE "VERA.UXI"
#INCLUDE "GUI.UXI"
#INCLUDE "PICKFILE.UXI"
DIM PICKED AS STRING * 80, SHOWN AS STRING * 255

SUB MAKE(PATH AS STRING)
  DOS.CLOSE_FILE(DOS.CREATE_FILE(PATH, 0))
END SUB

SUB TRY(MANAGED AS UBYTE)
  DIM RESULT AS UBYTE
  IF MANAGED THEN
    RESULT = GUI.PICKMANAGE("Open", "*.TXT", PICKED)
  ELSE
    RESULT = GUI.PICKFILE("Open", "*.TXT", PICKED)
  ENDIF
  SHOWN = SHOWN + STR$(RESULT)
  IF RESULT = 1 THEN SHOWN = SHOWN + " " + PICKED
  SHOWN = SHOWN + ";"
END SUB

SUB NAMES(PATTERN AS STRING)
  DOS.FINDFIRST(PATTERN, DOS.ATTR_DIRECTORY)
  DO WHILE DOS.ERROR = 0
    PRINT DOS.FOUND_NAME; " ";
    DOS.FINDNEXT()
  LOOP
  PRINT
END SUB

DOS.MKDIR("PICKT")
DOS.CHDIR("PICKT")
DOS.MKDIR("Sub")
DOS.MKDIR("aFold")
MAKE("zed.TXT")
MAKE("Alpha.TXT")
MAKE("beta.TXT")
MAKE("C.DAT")
MAKE("Sub\in.TXT")
REPEAT 10
  TRY(0)
END REPEAT
TRY(1)
TRY(1)
POS(1) = 20
POS(0) = 0
PRINT SHOWN
PRINT DOS.GETCWD(0)
NAMES("*.*")
NAMES("Sub\*.*")
