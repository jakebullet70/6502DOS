RUN CMDSHELL.COM
ARGS
ARGS ONE "TWO  2" 3
args.com lower
A$ = "XYZ"
ARGS A$ CURDIR$
NOSUCH 1
RUN FILES
TO*
MKDIR BIN
COPY ARGS.COM BIN\TOOL.CBIN
TOOL 1
PATH$ = "C:\NONE;;C:\BIN"
PRINT PATH$
TOOL 2
RUN "TO" + "OL" 3
C:\BIN\TOOL 4
BIN\TOOL.CBIN 5
SLOTKID A B 3 4 5 6 7 8 9 10
PRINT P1$; "|"; P2$; "|"; P3$; "|"; P9$; "|"
P2$ = "OLD"
SLOTKID P2$
PRINT P1$; "|"; P2$; "|"
END
