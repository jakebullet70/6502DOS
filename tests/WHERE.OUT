UXDOS16 V0.1.0
For the Commander X16
>>RUN CMDSHELL.COM
C>PATH$ = "C:\DOS"
C>WHERE
Required parameter missing
C>WHERE ARGS
C:\ARGS.COM
C>WHERE args.com
C:\ARGS.COM
C>WHERE HEAD
C:\DOS\HEAD.COM
C>WHERE EXIST
C:\DOS\EXIST.CBIN
C>WHERE DOS\TREE
DOS\TREE.COM
C>WHERE NOSUCH
File not found
C>WHERE T*.COM
File not found
C>PRINT "REM" TO RUNME.CMD
C>WHERE RUNME
C:\RUNME.CMD
C>WHERE HEAD SILENT
C>PRINT P1$
C:\DOS\HEAD.COM
C>WHERE NOSUCH SILENT
C>PRINT "[" + P1$ + "]"
[]
C>CD DOS
C>WHERE TREE
C:\DOS\TREE.COM
C>CD \
C>PATH$ = "C:\NONE;;C:\DOS\"
C>WHERE HEAD
C:\DOS\HEAD.COM
C>END

>>