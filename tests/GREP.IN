RUN CMDSHELL.COM
PATH$ = "C:\DOS"
PRINT "apple pie" TO T.TXT
PRINT "Banana split" APPEND T.TXT
PRINT "cherry tart" APPEND T.TXT
PRINT "C:\DOS\HEAD.COM" APPEND T.TXT
PRINT "a.b*c" APPEND T.TXT
PRINT "xyz" APPEND T.TXT
PRINT "" APPEND T.TXT
GREP
GREP -x A
GREP A B C
GREP "[ab" T.TXT
GREP A NOSUCH.TXT
GREP an T.TXT
GREP -i APPLE T.TXT
GREP "^c" T.TXT
GREP -i "^c" T.TXT
GREP "t$" T.TXT
GREP "C:\DOS" T.TXT
GREP "a\.b\*c" T.TXT
GREP "a.b" T.TXT
GREP "^[^a-c]" T.TXT
GREP "[]x]" T.TXT
GREP "^x*y" T.TXT
GREP "^b*a" T.TXT
GREP -n a T.TXT
GREP -n "^$" T.TXT
GREP -vc a T.TXT
GREP -c zzz T.TXT
GREP -c "^Line" DOCS\LONG.TXT
LIST DOCS\LONG.TXT | GREP "Line 4[89]"
DELETE T.TXT
END
