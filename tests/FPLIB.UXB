' FPLIB: lib/FLOAT.UXI, each routine and its errors.
#INCLUDE "DOS.UXI"
#INCLUDE "FLOAT.UXI"
DIM A(FP.SIZE) AS UBYTE, B(FP.SIZE) AS UBYTE, ZERO(FP.SIZE) AS UBYTE
DIM PA AS UWORD, PB AS UWORD, PZ AS UWORD
PA = AddrOf(A)
PB = AddrOf(B)
PZ = AddrOf(ZERO)

' 1: text in and out; text that is not a number
PRINT "1"; FP.FROM_TEXT(PA, "  12.5"); DOS.ERROR; " "; FP.TO_TEXT(PA)
PRINT "1"; FP.FROM_TEXT(PB, "7E2X"); DOS.ERROR; " "; FP.TO_TEXT(PB)
PRINT "1"; FP.FROM_TEXT(PZ, "ABC"); DOS.ERROR

' 2: the four operations; division by 0 leaves the value
FP.FROM_TEXT(PB, "-3")
FP.ADD(PA, PB)
PRINT "2 "; FP.TO_TEXT(PA); DOS.ERROR
FP.SUBTRACT(PA, PB)
PRINT "2 "; FP.TO_TEXT(PA); DOS.ERROR
FP.MULTIPLY(PA, PB)
PRINT "2 "; FP.TO_TEXT(PA); DOS.ERROR
FP.DIVIDE(PA, PB)
PRINT "2 "; FP.TO_TEXT(PA); DOS.ERROR
FP.FROM_TEXT(PZ, "0")
FP.DIVIDE(PA, PZ)
PRINT "2"; DOS.ERROR; " "; FP.TO_TEXT(PA)

' 3: compare
PRINT "3"; FP.COMPARE(PA, PB); FP.COMPARE(PB, PA); FP.COMPARE(PA, PA)

' 4: floor; to and from a LONG; a value past a LONG
FP.FROM_TEXT(PA, "-2.5")
PRINT "4"; FP.TO_LONG(PA); DOS.ERROR
FP.FLOOR(PA)
PRINT "4 "; FP.TO_TEXT(PA); FP.TO_LONG(PA)
FP.FROM_LONG(PA, -100000)
PRINT "4 "; FP.TO_TEXT(PA); FP.TO_LONG(PA)
FP.FROM_TEXT(PA, "1E10")
PRINT "4"; FP.TO_LONG(PA); DOS.ERROR

' 5: fixed decimals
FP.FROM_TEXT(PA, "2")
FP.FROM_TEXT(PB, "3")
FP.DIVIDE(PA, PB)
PRINT "5 "; FP.FIXED(PA, 2); " "; FP.FIXED(PA, 0); " "; FP.FIXED(PA, 9)
FP.FROM_TEXT(PA, "-1234.5")
PRINT "5 "; FP.FIXED(PA, 1); " ["; FP.FIXED(PA, 10); "]"; DOS.ERROR
