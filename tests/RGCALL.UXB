' RGCALL: SUBs and FUNCTs in region 1, a RAM bank at $A000. Calls in from low RAM with another
' bank selected, calls within the region, results of each type across the edge, a call inside
' an expression, a call out to a low SUB that selects another bank, and END in the region.
#INCLUDE "DOS.UXI"
#INCLUDE "BANK.UXI"
DIM CALLER AS UBYTE, OTHER AS UBYTE, INSIDE AS UBYTE, AFTER AS UBYTE

SUB SWITCH_BANK()
  BANK.USE(OTHER)
END SUB

#REGION_SLOT 1
FUNCT MY_BANK() AS UBYTE
  RETURN ContentsAt(0)
END FUNCT

FUNCT TWICE(N AS UWORD) AS UWORD
  RETURN N + N
END FUNCT

FUNCT QUAD(N AS UWORD) AS UWORD
  RETURN TWICE(TWICE(N))
END FUNCT

FUNCT BIG(N AS LONG) AS LONG
  RETURN N * 1000
END FUNCT

FUNCT WRAP(T AS STRING) AS STRING
  RETURN "[" + T + "]"
END FUNCT

SUB CALL_OUT()
  INSIDE = ContentsAt(0)
  SWITCH_BANK()
  AFTER = ContentsAt(0)
END SUB

SUB STOP_HERE()
  PRINT "END"
  END
END SUB
#REGION_SLOT 0

CALLER = BANK.CURRENT()
OTHER = BANK.ALLOC(1)
BANK.USE(OTHER)
PRINT MY_BANK() <> OTHER; MY_BANK() <> 0; BANK.CURRENT() = OTHER
PRINT TWICE(21); QUAD(5); 1 + TWICE(3) * 2
PRINT BIG(123456)
PRINT WRAP("A") + WRAP("B")
CALL_OUT()
PRINT INSIDE = MY_BANK(); AFTER = INSIDE; BANK.CURRENT() = OTHER
BANK.USE(CALLER)
STOP_HERE()
PRINT "NOT HERE"
