' CLOCK: the RTC calls getdate, setdate, gettime and settime, and the 32-bit ticks.
#INCLUDE "DOS.UXI"
DIM START AS ULONG

SUB SET_DATE(YEAR AS UWORD, MONTH AS UBYTE, DAY AS UBYTE)
  DOS.SETDATE(YEAR, MONTH, DAY)
  PRINT "SETDATE"; YEAR; MONTH; DAY; " E"; DOS.ERROR
END SUB

SUB SET_TIME(HOURS AS UBYTE, MINUTES AS UBYTE, SECONDS AS UBYTE)
  DOS.SETTIME(HOURS, MINUTES, SECONDS)
  PRINT "SETTIME"; HOURS; MINUTES; SECONDS; " E"; DOS.ERROR
END SUB

SUB SHOW_DATE()
  DOS.GETDATE()
  PRINT "DATE"; DOS.YEAR; DOS.MONTH; DOS.DAY; " WEEKDAY"; DOS.WEEKDAY
END SUB

' 1: valid dates, with their weekdays
SET_DATE(2026, 10, 18)
SHOW_DATE()
SET_DATE(2000, 1, 1)
SHOW_DATE()
SET_DATE(2000, 2, 29)
SHOW_DATE()
SET_DATE(2024, 2, 29)
SHOW_DATE()
SET_DATE(2099, 12, 31)
SHOW_DATE()

' 2: invalid dates leave the date as it is
SET_DATE(2023, 2, 29)
SET_DATE(2026, 4, 31)
SET_DATE(2026, 13, 1)
SET_DATE(2026, 0, 1)
SET_DATE(2026, 1, 0)
SET_DATE(1999, 12, 31)
SET_DATE(2100, 1, 1)
SHOW_DATE()

' 3: the time
SET_TIME(13, 45, 0)
DOS.GETTIME()
PRINT "TIME"; DOS.HOURS; DOS.MINUTES;
IF DOS.SECONDS < 3
  PRINT " SECONDS OK"
ELSE
  PRINT " SECONDS"; DOS.SECONDS
ENDIF
SET_TIME(24, 0, 0)
SET_TIME(0, 60, 0)
SET_TIME(0, 0, 60)

' 4: the ticks
START = DOS.TICKS_LONG()
IF START > 0
  PRINT "TICKS OK"
ELSE
  PRINT "TICKS 0"
ENDIF
IF DOS.TICKS_LONG() >= START THEN PRINT "TICKS ON"
