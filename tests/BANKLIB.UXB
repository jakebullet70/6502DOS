' BANKLIB: the calls of BANK.UXI. Takes 2 banks, writes and reads a byte in each, selects one,
' calls a routine put at $A000, frees the banks, and asks for more banks than there are.
#INCLUDE "DOS.UXI"
#INCLUDE "BANK.UXI"
DIM FREE_BEFORE AS UBYTE, FIRST AS UBYTE, SECOND AS UBYTE, CALLER AS UBYTE, RESULT AS UBYTE
CALLER = BANK.CURRENT()
FREE_BEFORE = BANK.FREE_COUNT()
FIRST = BANK.ALLOC(2)
SECOND = FIRST + 1
PRINT FIRST <> 0; FREE_BEFORE - BANK.FREE_COUNT()
BANK.PUT_BYTE(FIRST, $A000, 7)
BANK.PUT_BYTE(SECOND, $A000, 9)
PRINT BANK.GET_BYTE(FIRST, $A000); BANK.GET_BYTE(SECOND, $A000); BANK.CURRENT() = CALLER
BANK.USE(SECOND)
PRINT BANK.CURRENT() = SECOND; ContentsAt($A000)
BANK.USE(CALLER)
' The routine: LDA $00, INX, LDY #$5A, SEC, RTS.
BANK.PUT_BYTE(FIRST, $A000, $A5)
BANK.PUT_BYTE(FIRST, $A001, $00)
BANK.PUT_BYTE(FIRST, $A002, $E8)
BANK.PUT_BYTE(FIRST, $A003, $A0)
BANK.PUT_BYTE(FIRST, $A004, $5A)
BANK.PUT_BYTE(FIRST, $A005, $38)
BANK.PUT_BYTE(FIRST, $A006, $60)
RESULT = BANK.FAR_CALL(FIRST, $A000, $41)
PRINT RESULT = FIRST; DOS.REG_X; DOS.REG_Y; DOS.REG_P AND 1; BANK.CURRENT() = CALLER
BANK.FREE(FIRST)
PRINT DOS.ERROR; FREE_BEFORE - BANK.FREE_COUNT()
BANK.FREE(FIRST)
PRINT DOS.ERROR
PRINT BANK.ALLOC(255); DOS.ERROR
