' SEEK: moving a handle from each origin, across clusters, past the end, and errors.
' LONG.TXT is 3200 bytes of 64-byte lines; the test card has 512-byte clusters.
#INCLUDE "DOS.UXI"
DIM HANDLE AS UWORD, COUNT AS UWORD, BUFFER(20) AS UBYTE

SUB SHOW(LABEL AS STRING)
  PRINT LABEL; " E"; DOS.ERROR
END SUB

' Moves HANDLE, then reads 8 bytes. Prints the new position and the bytes, a control code as
' a dot.
SUB GO(FROM AS UBYTE, OFFSET_LOW AS UWORD, OFFSET_HIGH AS UWORD)
  DIM INDEX AS UWORD
  DOS.SEEK(HANDLE, FROM, OFFSET_LOW, OFFSET_HIGH)
  PRINT "SEEK"; FROM; OFFSET_HIGH; OFFSET_LOW; " E"; DOS.ERROR; " AT"; DOS.POSITION_HIGH; DOS.POSITION_LOW;
  COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 8)
  PRINT " READ"; COUNT; " [";
  FOR INDEX = 1 TO COUNT
    IF BUFFER(INDEX - 1) < 32
      PRINT ".";
    ELSE
      PRINT CHR$(BUFFER(INDEX - 1));
    ENDIF
  NEXT
  PRINT "]"
END SUB

' 1: from the start, the position and the end
HANDLE = DOS.OPEN_FILE("\DOCS\LONG.TXT", DOS.ACCESS_READ)
SHOW("OPEN")
GO(0, 0, 0)
GO(0, 512, 0)
GO(1, 504, 0)
GO(1, $FFF8, $FFFF)
GO(1, $FDF8, $FFFF)
GO(0, 508, 0)
GO(0, 3072, 0)
GO(2, $FFF8, $FFFF)

' 2: at and past the end
GO(2, 0, 0)
GO(2, 100, 0)
GO(0, 0, 1)
GO(1, 0, 0)
GO(0, 1, 0)

' 3: errors and devices
GO(3, 0, 0)
DOS.SEEK(1, 0, 5, 0)
PRINT "SEEK CON E"; DOS.ERROR; " AT"; DOS.POSITION_HIGH; DOS.POSITION_LOW
DOS.SEEK(15, 0, 0, 0)
SHOW("SEEK 15")
DOS.CLOSE_FILE(HANDLE)
DOS.SEEK(HANDLE, 0, 0, 0)
SHOW("SEEK CLOSED")
