' DIRS: MKDIR, RMDIR, RENAME, DELETE and DISKFREE.
#INCLUDE "DOS.UXI"
DIM HANDLE AS UWORD, COUNT AS UWORD, INDEX AS UBYTE, BUFFER(16) AS UBYTE, TEXT AS STRING * 4

SUB SHOW(LABEL AS STRING)
  PRINT LABEL; " E"; DOS.ERROR
END SUB

SUB FREE(LABEL AS STRING)
  DOS.DISKFREE(0)
  PRINT LABEL; " E"; DOS.ERROR; " FREE"; DOS.FREE_HIGH; DOS.FREE_LOW
END SUB

SUB GO(PATH AS STRING)
  DIM CWD AS STRING * 80
  DOS.CHDIR(PATH)
  PRINT "CD "; PATH; " E"; DOS.ERROR;
  CWD = DOS.GETCWD(0)
  PRINT " ["; CWD; "]"
END SUB

' Prints the first bytes of the file at PATH.
SUB SHOW_FILE(PATH AS STRING)
  HANDLE = DOS.OPEN_FILE(PATH, DOS.ACCESS_READ)
  IF DOS.ERROR <> 0
    SHOW("OPEN " + PATH)
    RETURN
  ENDIF
  COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 16)
  PRINT PATH; " [";
  FOR INDEX = 1 TO COUNT
    PRINT CHR$(BUFFER(INDEX - 1));
  NEXT
  PRINT "]"
  DOS.CLOSE_FILE(HANDLE)
END SUB

' Makes an empty file at PATH.
SUB MAKE(PATH AS STRING, ATTRIBUTES AS UBYTE)
  HANDLE = DOS.CREATE_FILE(PATH, ATTRIBUTES)
  IF DOS.ERROR <> 0
    SHOW("CREATE " + PATH)
    RETURN
  ENDIF
  DOS.CLOSE_FILE(HANDLE)
END SUB

' 1: the size of the drive
DOS.DISKFREE(0)
PRINT "DISKFREE E"; DOS.ERROR; " SECTORS"; DOS.CLUSTER_SECTORS; " BYTES"; DOS.SECTOR_BYTES;
PRINT " TOTAL"; DOS.TOTAL_HIGH; DOS.TOTAL_LOW
FREE("START")
DOS.DISKFREE(3)
SHOW("DISKFREE C:")
DOS.DISKFREE(1)
SHOW("DISKFREE A:")

' 2: making directories
DOS.MKDIR("D1")
SHOW("MKDIR D1")
FREE("AFTER D1")
DOS.MKDIR("D1\D2")
SHOW("MKDIR D1\D2")
GO("D1\D2")
GO("..")
GO("..")
DOS.MKDIR("D1")
SHOW("MKDIR D1 AGAIN")
DOS.MKDIR("HELLO.TXT")
SHOW("MKDIR HELLO.TXT")
DOS.MKDIR("X*")
SHOW("MKDIR X*")
DOS.MKDIR("NOPE\X")
SHOW("MKDIR NOPE\X")
DOS.MKDIR("..")
SHOW("MKDIR ..")

' 3: renaming
HANDLE = DOS.CREATE_FILE("D1\A.TXT", 0)
TEXT = "ABC"
COUNT = DOS.WRITE_FILE(HANDLE, @TEXT + 2, 3)
DOS.CLOSE_FILE(HANDLE)
DOS.RENAME("D1\A.TXT", "B.TXT")
SHOW("RENAME D1\A.TXT B.TXT")
SHOW_FILE("B.TXT")
SHOW_FILE("D1\A.TXT")
DOS.RENAME("B.TXT", "D1\D2\C.TXT")
SHOW("RENAME B.TXT D1\D2\C.TXT")
SHOW_FILE("D1\D2\C.TXT")
DOS.RENAME("D1\D2", "D1\D3")
SHOW("RENAME D1\D2 D1\D3")
SHOW_FILE("D1\D3\C.TXT")
GO("D1\D3")
GO("\")
DOS.RENAME("D1\D3", "D4")
SHOW("RENAME D1\D3 D4")
DOS.RENAME("NOPE.TXT", "X.TXT")
SHOW("RENAME NOPE.TXT")
DOS.RENAME("HELLO.TXT", "DOCS")
SHOW("RENAME ONTO DOCS")
DOS.RENAME("HELLO.TXT", "HELLO.TXT")
SHOW("RENAME ONTO ITSELF")
DOS.RENAME("HELLO.TXT", "NOPE\X")
SHOW("RENAME NOPE\X")
DOS.RENAME("HELLO.TXT", "X?.TXT")
SHOW("RENAME X?.TXT")
DOS.RENAME("HELLO.TXT", "Q:X")
SHOW("RENAME Q:X")
SHOW_FILE("HELLO.TXT")

' 4: removing
DOS.RMDIR("D1")
SHOW("RMDIR D1 FULL")
DOS.RMDIR("D1\D3")
SHOW("RMDIR D1\D3 FULL")
DOS.DELETE("D1\D3\C.TXT")
SHOW("DELETE D1\D3\C.TXT")
DOS.RMDIR("D1\D3")
SHOW("RMDIR D1\D3")
GO("D1")
DOS.RMDIR("\D1")
SHOW("RMDIR CURRENT")
GO("\")
DOS.RMDIR("D1")
SHOW("RMDIR D1")
DOS.RMDIR("D1")
SHOW("RMDIR D1 AGAIN")
DOS.RMDIR("HELLO.TXT")
SHOW("RMDIR HELLO.TXT")
DOS.RMDIR("\")
SHOW("RMDIR \")
DOS.DELETE("DOCS")
SHOW("DELETE DOCS")
DOS.DELETE("NOPE.TXT")
SHOW("DELETE NOPE.TXT")
MAKE("RO.TXT", DOS.ATTR_READ_ONLY)
DOS.DELETE("RO.TXT")
SHOW("DELETE RO.TXT")
FREE("AFTER REMOVING")

' 5: a directory that grows past its first cluster
DOS.MKDIR("BIG")
FOR INDEX = 1 TO 31
  MAKE("BIG\F" + MID$(STR$(INDEX), 2), 0)
NEXT
FREE("BIG HOLDS 31")
DOS.RMDIR("BIG")
SHOW("RMDIR BIG FULL")
FOR INDEX = 1 TO 31
  DOS.DELETE("BIG\F" + MID$(STR$(INDEX), 2))
NEXT
SHOW("DELETE 31")
DOS.RMDIR("BIG")
SHOW("RMDIR BIG")
FREE("END")
