RUN CMDSHELL.COM
PATH$ = "C:\DOS"
WHERE
WHERE ARGS
WHERE args.com
WHERE HEAD
WHERE EXIST
WHERE DOS\TREE
WHERE NOSUCH
WHERE T*.COM
PRINT "REM" TO RUNME.CMD
WHERE RUNME
WHERE HEAD SILENT
PRINT P1$
WHERE NOSUCH SILENT
PRINT "[" + P1$ + "]"
CD DOS
WHERE TREE
CD \
PATH$ = "C:\NONE;;C:\DOS\"
WHERE HEAD
END
