UXDOS16 V0.1.0
For the Commander X16
>>RUN CMDSHELL.COM
C>PATH$ = "C:\DOS"
C>PRINT "apple pie" TO T.TXT
C>PRINT "Banana split" APPEND T.TXT
C>PRINT "cherry tart" APPEND T.TXT
C>PRINT "C:\DOS\HEAD.COM" APPEND T.TXT
C>PRINT "a.b*c" APPEND T.TXT
C>PRINT "xyz" APPEND T.TXT
C>PRINT "" APPEND T.TXT
C>GREP
Required parameter missing
C>GREP -x A
Invalid switch
C>GREP A B C
Too many parameters
C>GREP "[ab" T.TXT
Invalid parameter
C>GREP A NOSUCH.TXT
File not found
C>GREP an T.TXT
Banana split
C>GREP -i APPLE T.TXT
apple pie
C>GREP "^c" T.TXT
cherry tart
C>GREP -i "^c" T.TXT
cherry tart
C:\DOS\HEAD.COM
C>GREP "t$" T.TXT
Banana split
cherry tart
C>GREP "C:\DOS" T.TXT
C:\DOS\HEAD.COM
C>GREP "a\.b\*c" T.TXT
a.b*c
C>GREP "a.b" T.TXT
a.b*c
C>GREP "^[^a-c]" T.TXT
Banana split
C:\DOS\HEAD.COM
xyz
C>GREP "[]x]" T.TXT
xyz
C>GREP "^x*y" T.TXT
xyz
C>GREP "^b*a" T.TXT
apple pie
a.b*c
C>GREP -n a T.TXT
1:apple pie
2:Banana split
3:cherry tart
5:a.b*c
C>GREP -n "^$" T.TXT
7:
C>GREP -vc a T.TXT
3
C>GREP -c zzz T.TXT
0
C>GREP -c "^Line" DOCS\LONG.TXT
50
C>LIST DOCS\LONG.TXT | GREP "Line 4[89]"
Line 48 of LONG.TXT: abcdefghijklmnopqrstuvwxyz0123456789.....
Line 49 of LONG.TXT: abcdefghijklmnopqrstuvwxyz0123456789.....
C>DELETE T.TXT
C>END

>>