UXDOS16 V0.1.0
For the Commander X16
>>RUN CMDSHELL.COM
C>ARGS
HELLO FROM UXCBASIC
TAIL []
C>ARGS ONE "TWO  2" 3
HELLO FROM UXCBASIC
TAIL [ ONE TWO  2 3]
C>args.com lower
HELLO FROM UXCBASIC
TAIL [ lower]
C>A$ = "XYZ"
C>ARGS A$ CURDIR$
HELLO FROM UXCBASIC
TAIL [ XYZ C:\]
C>NOSUCH 1
Bad command or file name
C>RUN FILES
Bad command or file name
C>TO*
Bad command or file name
C>MKDIR BIN
C>COPY ARGS.COM BIN\TOOL.SCOM
     1 File(s) copied
C>TOOL 1
Bad command or file name
C>PATH$ = "C:\NONE;;C:\BIN"
C>PRINT PATH$
C:\NONE;;C:\BIN
C>TOOL 2
HELLO FROM UXCBASIC
TAIL [ 2]
C>RUN "TO" + "OL" 3
HELLO FROM UXCBASIC
TAIL [ 3]
C>C:\BIN\TOOL 4
HELLO FROM UXCBASIC
TAIL [ 4]
C>BIN\TOOL.SCOM 5
HELLO FROM UXCBASIC
TAIL [ 5]
C>SLOTKID A B 3 4 5 6 7 8 9 10
TAIL [ A B 3 4 5 6 7 8 9 10]
P1$ A
P2$ B
P9$ 9
PATH$ C:\NONE;;C:\BIN
C>PRINT P1$; "|"; P2$; "|"; P3$; "|"; P9$; "|"
DONE||3|9|
C>P2$ = "OLD"
C>SLOTKID P2$
TAIL [ ]
P1$ 
P2$ 
P9$ 
PATH$ C:\NONE;;C:\BIN
C>PRINT P1$; "|"; P2$; "|"
DONE||
C>END

>>