' DOSAPI: each call of DOS.UXI, with its results and errors.
#INCLUDE "DOS.UXI"
DIM HANDLE AS UWORD, COUNT AS UWORD, BUFFER(100) AS UBYTE, LINE AS STRING * 40, TEXT AS STRING * 20

SUB SHOW(LABEL AS STRING)
  PRINT LABEL; " E"; DOS.ERROR
END SUB

' Prints COUNT bytes of BUFFER in brackets.
SUB SHOW_BUFFER(COUNT AS UWORD)
  DIM INDEX AS UWORD
  PRINT "[";
  FOR INDEX = 1 TO COUNT
    IF BUFFER(INDEX - 1) = 13
      PRINT "<CR>";
    ELSE
      PRINT CHR$(BUFFER(INDEX - 1));
    ENDIF
  NEXT
  PRINT "]"
END SUB

SUB SHOW_FOUND()
  PRINT DOS.FOUND_NAME; DOS.FOUND_SIZE_HIGH; DOS.FOUND_SIZE_LOW; DOS.FOUND_ATTRIBUTES; DOS.FOUND_DATE; DOS.FOUND_TIME
END SUB

SUB FIND_ALL(PATTERN AS STRING, ATTRIBUTES AS UBYTE)
  PRINT "FIND "; PATTERN
  DOS.FINDFIRST(PATTERN, ATTRIBUTES)
  DO WHILE DOS.ERROR = 0
    SHOW_FOUND()
    DOS.FINDNEXT()
  LOOP
  SHOW("END")
END SUB

' 1: drives
PRINT "DRIVE"; DOS.GETDRIVE()
DOS.SETDRIVE(3)
SHOW("SETDRIVE 3")
PRINT "CWD ["; DOS.GETCWD(0); "]"
TEXT = DOS.GETCWD(1)
SHOW("GETCWD 1")

' 2: reading
HANDLE = DOS.OPEN_FILE("C:\HELLO.TXT", DOS.ACCESS_READ)
PRINT "OPEN"; HANDLE
COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 100)
SHOW_BUFFER(COUNT)
COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 100)
PRINT "AGAIN"; COUNT
COUNT = DOS.WRITE_FILE(HANDLE, @BUFFER, 1)
SHOW("WRITE TO READ")
DOS.CLOSE_FILE(HANDLE)
SHOW("CLOSE")
DOS.CLOSE_FILE(HANDLE)
SHOW("CLOSE AGAIN")
HANDLE = DOS.OPEN_FILE("/DOCS/README.TXT", DOS.ACCESS_READ)
COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 16)
SHOW_BUFFER(COUNT)
DOS.CLOSE_FILE(HANDLE)
HANDLE = DOS.OPEN_FILE("NOPE.TXT", DOS.ACCESS_READ)
SHOW("NOPE")
PRINT DOS.ERRMSG(DOS.ERROR)
HANDLE = DOS.OPEN_FILE("D:\HELLO.TXT", DOS.ACCESS_READ)
SHOW("D:")
HANDLE = DOS.OPEN_FILE("*.TXT", DOS.ACCESS_READ)
SHOW("WILDCARD")
HANDLE = DOS.OPEN_FILE("HELLO.TXT", DOS.ACCESS_READWRITE)
SHOW("ACCESS 2")
COUNT = DOS.READ_FILE(9, @BUFFER, 1)
SHOW("READ 9")

' 3: writing
HANDLE = DOS.CREATE_FILE("NEW.TXT", 0)
LINE = "ABC" + CHR$(13)
COUNT = DOS.WRITE_FILE(HANDLE, @LINE + 2, LEN(LINE))
PRINT "WROTE"; COUNT
DOS.CLOSE_FILE(HANDLE)
HANDLE = DOS.OPEN_FILE("NEW.TXT", DOS.ACCESS_WRITE)
DOS.SEEK(HANDLE, 2, 0, 0)
SHOW("SEEK END")
DOS.SEEK(HANDLE, 0, 0, 0)
SHOW("SEEK START")
LINE = "DEF"
COUNT = DOS.WRITE_FILE(HANDLE, @LINE + 2, LEN(LINE))
DOS.CLOSE_FILE(HANDLE)
HANDLE = DOS.OPEN_FILE("NEW.TXT", DOS.ACCESS_READ)
COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 100)
SHOW_BUFFER(COUNT)
DOS.CLOSE_FILE(HANDLE)
HANDLE = DOS.CREATE_FILE("\DOCS\NEW.TXT", 0)
SHOW("CREATE IN DOCS")
DOS.CLOSE_FILE(HANDLE)

' 4: names
DOS.RENAME("NEW.TXT", "OLD.TXT")
SHOW("RENAME")
DOS.RENAME("NEW.TXT", "OLD.TXT")
SHOW("RENAME MISSING")
DOS.RENAME("HELLO.TXT", "OLD.TXT")
SHOW("RENAME ONTO")
DOS.RENAME("\DOCS\NEW.TXT", "\DOCS\MOVED.TXT")
SHOW("RENAME IN DOCS")
DOS.DELETE("OLD.TXT")
SHOW("DELETE")
DOS.DELETE("OLD.TXT")
SHOW("DELETE AGAIN")
DOS.DELETE("C:/DOCS/MOVED.TXT")
SHOW("DELETE IN DOCS")
DOS.DELETE("*.TXT")
SHOW("DELETE WILDCARD")

' 5: directories
DOS.MKDIR("C:\SUB")
SHOW("MKDIR")
DOS.MKDIR("SUB")
SHOW("MKDIR AGAIN")
DOS.MKDIR("\SUB\INNER")
SHOW("MKDIR INNER")
DOS.CHDIR("SUB")
SHOW("CHDIR")
DOS.CHDIR("INNER")
PRINT "CWD ["; DOS.GETCWD(3); "]"
DOS.CHDIR("..")
PRINT "CWD ["; DOS.GETCWD(0); "]"
DOS.CHDIR("\")
PRINT "CWD ["; DOS.GETCWD(0); "]"
DOS.CHDIR("NOPE")
SHOW("CHDIR NOPE")
DOS.RMDIR("SUB")
SHOW("RMDIR FULL")
DOS.RMDIR("SUB\INNER")
SHOW("RMDIR INNER")
DOS.RMDIR("SUB")
SHOW("RMDIR")
DOS.RMDIR("SUB")
SHOW("RMDIR AGAIN")

' 6: finding
FIND_ALL("C:\DOCS\*.TXT", 0)
FIND_ALL("*.", DOS.ATTR_DIRECTORY)
FIND_ALL("\DOCS\*O*.TXT", 0)
FIND_ALL("\DOCS\", DOS.ATTR_DIRECTORY)
FIND_ALL("H?LLO.*", 0)
FIND_ALL("*.XYZ", 0)
DOS.FINDNEXT()
SHOW("FINDNEXT AFTER")

' 7: whole files
PRINT "EXISTS"; DOS.EXISTS("HELLO.TXT"); DOS.EXISTS("DOCS"); DOS.EXISTS("H*.TXT"); DOS.EXISTS("NOPE.TXT")
SHOW("EXISTS NOPE")
PRINT "SIZE"; DOS.SIZE("HELLO.TXT"); DOS.SIZE("\DOCS\LONG.TXT"); DOS.SIZE("DOCS")
SHOW("SIZE DOCS")
DOS.COPY("\DOCS\LONG.TXT", "COPY.TXT")
SHOW("COPY")
PRINT "SIZE"; DOS.SIZE("COPY.TXT")
HANDLE = DOS.OPEN_FILE("COPY.TXT", DOS.ACCESS_READ)
DOS.SEEK(HANDLE, 2, $FFF0, $FFFF)
COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 100)
SHOW_BUFFER(COUNT)
DOS.CLOSE_FILE(HANDLE)
DOS.COPY("NOPE.TXT", "X.TXT")
SHOW("COPY NOPE")
DOS.COPY("HELLO.TXT", "\NODIR\X.TXT")
SHOW("COPY NO PATH")
DOS.DELETE("COPY.TXT")
SHOW("DELETE COPY")

' 8: devices and the console
HANDLE = DOS.OPEN_FILE("NUL", DOS.ACCESS_WRITE)
COUNT = DOS.WRITE_FILE(HANDLE, @BUFFER, 5)
PRINT "NUL"; HANDLE; COUNT; DOS.READ_FILE(HANDLE, @BUFFER, 5)
HANDLE = DOS.OPEN_FILE("C:\DOCS\CON.TXT", DOS.ACCESS_WRITE)
LINE = "VIA CON" + CHR$(13)
COUNT = DOS.WRITE_FILE(HANDLE, @LINE + 2, LEN(LINE))
DOS.CLOSE_FILE(HANDLE)
LINE = "VIA 1" + CHR$(13)
COUNT = DOS.WRITE_FILE(1, @LINE + 2, LEN(LINE))
DOS.EXEC("X.COM", LINE)
SHOW("EXEC")
PRINT "VERSION "; DOS.VERSION(); DOS.EXITCODE()
TEXT = DOS.ERRMSG(7)
SHOW("ERRMSG 7")
DOS.CON_LINE(LINE)
PRINT "["; LINE; "]"
