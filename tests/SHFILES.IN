RUN CMDSHELL.COM
FILES DOCS
files "\MANY\F3" + "?.*"
FILES \MANY\Z*.*
FILES Q:
FILES DOCS EXTRA
PRINT CURDIR$
CHDIR DOCS
PRINT CURDIR$; "|"
FILES
LIST README.TXT
CHDIR ..
LIST HELLO.TXT
LIST NOPE.TXT
LIST
MKDIR NEW
MD NEW
COPY HELLO.TXT NEW
COPY \MANY\F3?.TXT NEW\
COPY \MANY\F3?.TXT X.TXT
COPY NOPE.TXT NEW
COPY HELLO.TXT
FILES NEW
RENAME NEW\HELLO.TXT NEW\HI.TXT
LIST NEW\HI.TXT
REN NEW\HI.TXT NEW\HO.TXT
DELETE NEW\HO.TXT
RD NEW
DELETE NEW\F30.TXT
DEL NEW\F31.TXT
DELETE NEW\F32.TXT
DELETE NEW\F33.TXT
RMDIR NEW
FILES N*.*
CHDIR NOPE
A$ = "MANY"
CHDIR A$
PRINT CURDIR$
LIST F30.TXT
CHDIR \
PRINT CURDIR$
CD C:/DOCS
PRINT CURDIR$
cd \
PRINT CURDIR$
DELETE
END
