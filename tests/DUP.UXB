' DUP: DUP, DUP2, and IOCTL's input status.
' HELLO.TXT is "Hello from the SD card." and CR LF, 25 bytes.
#INCLUDE "DOS.UXI"
DIM FIRST AS UWORD, SECOND AS UWORD, THIRD AS UWORD, SAVED AS UWORD
DIM COUNT AS UWORD, INDEX AS UBYTE, BUFFER(8) AS UBYTE, TEXT AS STRING * 8
DIM HANDLES(21) AS UWORD

SUB SHOW(LABEL AS STRING)
  PRINT LABEL; " E"; DOS.ERROR
END SUB

' Reads 5 bytes from HANDLE and prints them.
SUB TAKE(LABEL AS STRING, HANDLE AS UWORD)
  COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 5)
  PRINT LABEL; " E"; DOS.ERROR; " [";
  FOR INDEX = 1 TO COUNT
    PRINT CHR$(BUFFER(INDEX - 1));
  NEXT
  PRINT "]"
END SUB

SUB STATUS(LABEL AS STRING, HANDLE AS UWORD)
  DIM VALUE AS UWORD
  VALUE = DOS.IOCTL(HANDLE, DOS.IOCTL_IN_STATUS)
  PRINT LABEL; " E"; DOS.ERROR; " STATUS"; VALUE
END SUB

' 1: DUP, the position shared
FIRST = DOS.OPEN_FILE("HELLO.TXT", DOS.ACCESS_READ)
PRINT "OPEN E"; DOS.ERROR; " H"; FIRST
SECOND = DOS.DUP(FIRST)
PRINT "DUP E"; DOS.ERROR; " H"; SECOND
TAKE("READ FIRST", FIRST)
TAKE("READ SECOND", SECOND)
DOS.CLOSE_FILE(FIRST)
SHOW("CLOSE FIRST")
TAKE("READ SECOND", SECOND)
STATUS("FILE", SECOND)
DOS.SEEK(SECOND, 2, $FFFF, $FFFF)
STATUS("FILE 1 BEFORE END", SECOND)
TAKE("READ SECOND", SECOND)
STATUS("FILE AT END", SECOND)
DOS.CLOSE_FILE(SECOND)
SHOW("CLOSE SECOND")
STATUS("CLOSED", SECOND)
THIRD = DOS.DUP(SECOND)
SHOW("DUP CLOSED")
THIRD = DOS.DUP(20)
SHOW("DUP 20")

' 2: DUP2
FIRST = DOS.OPEN_FILE("HELLO.TXT", DOS.ACCESS_READ)
THIRD = DOS.OPEN_FILE("\DOCS\README.TXT", DOS.ACCESS_READ)
PRINT "OPEN H"; FIRST; " H"; THIRD
DOS.DUP2(FIRST, THIRD)
SHOW("DUP2 OVER OPEN")
TAKE("READ THIRD", THIRD)
TAKE("READ FIRST", FIRST)
DOS.DUP2(FIRST, FIRST)
SHOW("DUP2 ITSELF")
TAKE("READ FIRST", FIRST)
DOS.DUP2(FIRST, 20)
SHOW("DUP2 TO 20")
DOS.DUP2(19, FIRST)
SHOW("DUP2 FROM CLOSED")
TAKE("READ FIRST", FIRST)
DOS.DUP2(FIRST, 12)
SHOW("DUP2 TO CLOSED")
TAKE("READ 12", 12)
DOS.CLOSE_FILE(12)
DOS.CLOSE_FILE(THIRD)
DOS.CLOSE_FILE(FIRST)
SHOW("CLOSE ALL")

' 3: handle 1 sent to a file, then back to the console
SAVED = DOS.DUP(1)
FIRST = DOS.CREATE_FILE("OUT.TXT", 0)
DOS.DUP2(FIRST, 1)
DOS.CLOSE_FILE(FIRST)
TEXT = "TO FILE"
COUNT = DOS.WRITE_FILE(1, @TEXT + 2, 7)
DOS.DUP2(SAVED, 1)
DOS.CLOSE_FILE(SAVED)
TEXT = "SCREEN"
COUNT = DOS.WRITE_FILE(1, @TEXT + 2, 6)
PRINT
FIRST = DOS.OPEN_FILE("OUT.TXT", DOS.ACCESS_READ)
TAKE("OUT.TXT", FIRST)
TAKE("OUT.TXT", FIRST)
DOS.CLOSE_FILE(FIRST)

' 4: devices and subfunctions
STATUS("CON", 0)
FIRST = DOS.OPEN_FILE("NUL", DOS.ACCESS_READ)
STATUS("NUL", FIRST)
DOS.CLOSE_FILE(FIRST)
COUNT = DOS.IOCTL(0, 0)
SHOW("IOCTL 0")
COUNT = DOS.IOCTL(0, 7)
SHOW("IOCTL 7")

' 5: every handle open
FOR INDEX = 3 TO 20
  HANDLES(INDEX) = DOS.DUP(0)
  IF DOS.ERROR <> 0
    PRINT "DUP"; INDEX; " E"; DOS.ERROR
    EXIT FOR
  ENDIF
NEXT
FOR INDEX = 3 TO 19
  DOS.CLOSE_FILE(HANDLES(INDEX))
NEXT
SECOND = DOS.DUP(0)
PRINT "DUP AFTER E"; DOS.ERROR; " H"; SECOND
DOS.CLOSE_FILE(SECOND)
