' WRITE: creating files, writing across cluster edges, appending, writing past the end,
' emptying, read-only files, errors, and a directory that grows by a cluster.
' The test card has 1024-byte clusters. \DOCS holds 4 entries in a cluster of 32.
#INCLUDE "DOS.UXI"
DIM HANDLE AS UWORD, COUNT AS UWORD, INDEX AS UWORD, BUFFER(20) AS UBYTE, LINE AS STRING * 64

SUB SHOW(LABEL AS STRING)
  PRINT LABEL; " E"; DOS.ERROR
END SUB

' Prints the size and the attributes of the file at PATH.
SUB SIZE(PATH AS STRING)
  DOS.FINDFIRST(PATH, DOS.ATTR_HIDDEN)
  PRINT PATH; " E"; DOS.ERROR; " SIZE"; DOS.FOUND_SIZE_HIGH; DOS.FOUND_SIZE_LOW; " ATTR"; DOS.FOUND_ATTRIBUTES
END SUB

' Writes LINE to HANDLE and prints the count.
SUB PUT(LABEL AS STRING)
  COUNT = DOS.WRITE_FILE(HANDLE, @LINE + 2, LEN(LINE))
  PRINT LABEL; " E"; DOS.ERROR; " WROTE"; COUNT
END SUB

' Moves HANDLE to OFFSET from the start, then reads 8 bytes and prints them, a control code as
' a dot.
SUB SHOW_AT(OFFSET AS UWORD)
  DIM INDEX AS UWORD
  DOS.SEEK(HANDLE, 0, OFFSET, 0)
  COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 8)
  PRINT "AT"; OFFSET; " E"; DOS.ERROR; " READ"; COUNT; " [";
  FOR INDEX = 1 TO COUNT
    IF BUFFER(INDEX - 1) < 32
      PRINT ".";
    ELSE
      PRINT CHR$(BUFFER(INDEX - 1));
    ENDIF
  NEXT
  PRINT "]"
END SUB

' 1: create, write, read back through the same handle
HANDLE = DOS.CREATE_FILE("NEW.TXT", 0)
SHOW("CREATE")
LINE = "HELLO" + CHR$(13) + CHR$(10)
PUT("PUT")
SHOW_AT(0)
DOS.CLOSE_FILE(HANDLE)
SHOW("CLOSE")
SIZE("NEW.TXT")

' 2: 50 lines of 64 bytes, then reads across the cluster edges
HANDLE = DOS.CREATE_FILE("\DOCS\BIG.TXT", 0)
FOR INDEX = 1 TO 50
  LINE = "LINE" + STR$(INDEX)
  DO WHILE LEN(LINE) < 62
    LINE = LINE + "."
  LOOP
  LINE = LINE + CHR$(13) + CHR$(10)
  COUNT = DOS.WRITE_FILE(HANDLE, @LINE + 2, 64)
NEXT
SHOW("BIG")
DOS.CLOSE_FILE(HANDLE)
SIZE("\DOCS\BIG.TXT")
HANDLE = DOS.OPEN_FILE("\DOCS\BIG.TXT", DOS.ACCESS_READ)
SHOW_AT(1020)
SHOW_AT(2048)
SHOW_AT(3192)
DOS.CLOSE_FILE(HANDLE)

' 3: append at the end, and write over the middle
HANDLE = DOS.OPEN_FILE("\DOCS\BIG.TXT", DOS.ACCESS_READWRITE)
DOS.SEEK(HANDLE, 2, 0, 0)
LINE = "END"
PUT("APPEND")
DOS.SEEK(HANDLE, 0, 1022, 0)
LINE = "MIDDLE"
PUT("MIDDLE")
SHOW_AT(1020)
SHOW_AT(3196)
DOS.CLOSE_FILE(HANDLE)
SIZE("\DOCS\BIG.TXT")

' 4: a write past the end
HANDLE = DOS.OPEN_FILE("NEW.TXT", DOS.ACCESS_WRITE)
DOS.SEEK(HANDLE, 0, 5000, 0)
LINE = "GAP"
PUT("GAP")
COUNT = DOS.READ_FILE(HANDLE, @BUFFER, 1)
SHOW("READ WRITE-ONLY")
DOS.CLOSE_FILE(HANDLE)
SIZE("NEW.TXT")
HANDLE = DOS.OPEN_FILE("NEW.TXT", DOS.ACCESS_READ)
SHOW_AT(0)
SHOW_AT(5000)
DOS.CLOSE_FILE(HANDLE)

' 5: create empties a file
HANDLE = DOS.CREATE_FILE("NEW.TXT", DOS.ATTR_HIDDEN)
SHOW("CREATE AGAIN")
DOS.CLOSE_FILE(HANDLE)
SIZE("NEW.TXT")

' 6: a read-only file
HANDLE = DOS.CREATE_FILE("RO.TXT", DOS.ATTR_READ_ONLY)
LINE = "FIXED"
PUT("READ-ONLY")
DOS.CLOSE_FILE(HANDLE)
SIZE("RO.TXT")
HANDLE = DOS.OPEN_FILE("RO.TXT", DOS.ACCESS_WRITE)
SHOW("OPEN TO WRITE")
HANDLE = DOS.CREATE_FILE("RO.TXT", 0)
SHOW("CREATE OVER")
HANDLE = DOS.OPEN_FILE("RO.TXT", DOS.ACCESS_READ)
SHOW_AT(0)
DOS.CLOSE_FILE(HANDLE)

' 7: errors and a device
HANDLE = DOS.CREATE_FILE("DOCS", 0)
SHOW("CREATE DOCS")
HANDLE = DOS.CREATE_FILE("*.TXT", 0)
SHOW("CREATE WILDCARD")
HANDLE = DOS.CREATE_FILE("\NOPE\X.TXT", 0)
SHOW("CREATE NOPE")
HANDLE = DOS.CREATE_FILE("Q:X.TXT", 0)
SHOW("CREATE Q:")
HANDLE = DOS.CREATE_FILE("CON", 0)
LINE = "VIA CON" + CHR$(13)
PUT("CON")
DOS.CLOSE_FILE(HANDLE)

' 8: 30 files in \DOCS: the directory grows by a cluster
FOR INDEX = 1 TO 30
  HANDLE = DOS.CREATE_FILE("\DOCS\F" + MID$(STR$(INDEX), 2) + ".TXT", 0)
  DOS.CLOSE_FILE(HANDLE)
NEXT
SHOW("30 FILES")
COUNT = 0
DOS.FINDFIRST("\DOCS\*.*", 0)
DO WHILE DOS.ERROR = 0
  COUNT = COUNT + 1
  DOS.FINDNEXT()
LOOP
PRINT "FOUND"; COUNT
SIZE("\DOCS\F30.TXT")
SIZE("\DOCS\LONG.TXT")
