RUN CMDSHELL.COM
LIST HEL\X09
list docs\re\X09
VER\X09\X09
VER\X09\X09\X09
PRI\X09 "TAB"
CD DO\X09
PRINT CURDIR$
CD \
CD DO\X09\X09
PRINT CURDIR$
CD \
XYZ\X09
PATH$ = "C:\DOS"
TRE\X09 -?
WHE\X09 HEAD
COPY HELLO.TXT "Q R.TXT"
TYPE Q\X09
TYPE "Q \X09
DEL "Q R.TXT"
MD "Z DIR"
CD Z\X09
PRINT CURDIR$
CD \
RD "Z DIR"
END
