' VERA.UXI: direct reads and writes of the text screen in VERA, in namespace VERA, a stack of
' saved screen boxes in VRAM, call 61's VRAM, sprite and palette functions, and call 62's
' screens and drawing.
'
' The code runs from region 3, a RAM bank of its own at $A000. A SUB or FUNCTION adds bytes
' only when called. ROW and COLUMN count from 0 at the screen's top left. The screen map is at
' VRAM $10000: 64 rows of 256 bytes, 128 cells a row, each a character then its color. A color
' is the background times 16 plus the foreground. The map row of a screen row follows layer 1's
' vertical scroll. The saved boxes lie in VRAM from the end of the bitmap to $0FFFF: from $00000
' on screen 0, from $09600 on screens 1 and 2, from $0FA00 on screen 3. SCREEN empties the stack.
'
' DIM CELL AS UWORD
' VERA.PUT_CELL(2, 5, 65, $1F)    ' an A, white on blue, at row 2, column 5
' CELL = VERA.GET_CELL(2, 5)      ' 65 in the low byte, $1F in the high byte
' VERA.PRINTAT(3, 5, "READY", $1F)
' IF VERA.SAVE_RECT(1, 1, 20, 5) THEN
'   VERA.FILL(1, 1, 20, 5, 32, $70)
'   VERA.RESTORE_RECT()
' ENDIF

#REGION_SLOT 3
NAMESPACE VERA
  ' VERA's address of the data port that CONTROL selects, its data ports 0 and 1, and layer
  ' 1's vertical scroll. CONTROL's bit 0 selects port 1. Each routine here, and the console,
  ' leaves CONTROL 0. Trap: bit 7 of CONTROL resets VERA.
  DIM ADDRESS_LOW AS UBYTE AT $9F20, ADDRESS_MIDDLE AS UBYTE AT $9F21
  DIM ADDRESS_HIGH AS UBYTE AT $9F22, DATA0 AS UBYTE AT $9F23, DATA1 AS UBYTE AT $9F24
  DIM CONTROL AS UBYTE AT $9F25, SCROLL_LOW AS UBYTE AT $9F39, SCROLL_HIGH AS UBYTE AT $9F3A

  ' The VRAM address of the stack's first free byte, STACK_BASE times 256 when the stack is
  ' empty. A box on the stack is its cells, row by row, then 6 bytes: the address of its cells,
  ' low byte first, then its row, column, width and height.
  DIM STACK_TOP AS UWORD

  ' The high byte of the stack's first VRAM address. SCREEN sets it.
  DIM STACK_BASE AS UBYTE

  ' A pointer for (zp),Y. It is the runtime's temporary, free inside an ASM block.
  DIM POINTER AS UWORD AT $24

  ' $03F7, call 61, vera, runs function Y with r0 to r2. A VRAM address is 0 to $1FFFF. A
  ' sprite is 0 to 127.
  DIM R0 AS UWORD AT $02, R1 AS UWORD AT $04, R2 AS UWORD AT $06, R3 AS UWORD AT $08

  ' The fields of SPRITE_SET. DEPTH 0 hides the sprite, 1 to 3 put it behind layer 0, between
  ' the layers, and in front. FLIP: bit 0 across, bit 1 down. MASK: the collision groups, 0 to
  ' 15. PALETTE: the palette offset, 0 to 15. WIDTH and HEIGHT: 0 for 8 pixels to 3 for 64.
  ' MODE: 0 for 4 bits a pixel, 1 for 8.
  ENUM SPRITE_FIELD
    DEPTH, FLIP, MASK, PALETTE, WIDTH, HEIGHT, MODE
  END ENUM

  ' VLOAD sets it: 0, or the DOS error number of the read.
  DIM ERROR AS UBYTE

  ' Returns the map row of screen row 0: the vertical scroll over 8, AND 63.
  FUNCTION MAP_TOP() AS UBYTE
    DIM TOP AS UBYTE
    ASM
        lda @SCROLL_HIGH
        lsr                     ' bit 0, worth 32 map rows, to carry
        lda @SCROLL_LOW
        ror
        lsr
        lsr
        sta @TOP
    END ASM
    RETURN TOP
  END FUNCTION

  ' Returns the cell at ROW and COLUMN: its character in the low byte, its color in the high.
  FUNCTION GET_CELL(ROW AS UBYTE, COLUMN AS UBYTE) AS UWORD
    DIM CELL AS UWORD
    ASM
        lda @SCROLL_HIGH
        lsr
        lda @SCROLL_LOW
        ror
        lsr
        lsr                     ' the map row of screen row 0
        clc
        adc @ROW
        and #63
        sta @ADDRESS_MIDDLE     ' a map row is 256 bytes
        lda @COLUMN
        asl
        sta @ADDRESS_LOW
        lda #$11                ' increment 1, VRAM $1xxxx
        sta @ADDRESS_HIGH
        lda @DATA0
        sta @CELL
        lda @DATA0
        sta @CELL + 1
    END ASM
    RETURN CELL
  END FUNCTION

  ' Writes CHARACTER in COLOR to the cell at ROW and COLUMN. The console's cursor does not move.
  SUB PUT_CELL(ROW AS UBYTE, COLUMN AS UBYTE, CHARACTER AS UBYTE, COLOR AS UBYTE)
    ASM
        lda @SCROLL_HIGH
        lsr
        lda @SCROLL_LOW
        ror
        lsr
        lsr
        clc
        adc @ROW
        and #63
        sta @ADDRESS_MIDDLE
        lda @COLUMN
        asl
        sta @ADDRESS_LOW
        lda #$11
        sta @ADDRESS_HIGH
        lda @CHARACTER
        sta @DATA0
        lda @COLOR
        sta @DATA0
    END ASM
  END SUB

  ' Writes TEXT$ in COLOR from the cell at ROW and COLUMN to the right. Each byte is a character
  ' code; a control code draws its glyph. Cells past column 127 are not written. The console's
  ' cursor does not move.
  SUB PRINTAT(ROW AS UBYTE, COLUMN AS UBYTE, TEXT$ AS CONST, COLOR AS UBYTE)
    DIM LAST AS UBYTE
    POINTER = @TEXT$            ' TEXT$'s block: its size, its length, then its characters
    ASM
        ldy #1
        lda (@POINTER),y
        beq done
        sta @LAST
        sec                     ' the cells left in the row
        lda #128
        sbc @COLUMN
        bcc done
        beq done
        cmp @LAST
        bcs fits
        sta @LAST
    fits: clc                   ' Y's end: the characters start at Y = 2
        lda @LAST
        adc #2
        sta @LAST
        lda @SCROLL_HIGH
        lsr
        lda @SCROLL_LOW
        ror
        lsr
        lsr
        clc
        adc @ROW
        and #63
        sta @ADDRESS_MIDDLE
        lda @COLUMN
        asl
        sta @ADDRESS_LOW
        lda #$11
        sta @ADDRESS_HIGH
        phx
        ldx @COLOR
        ldy #2
    cell: lda (@POINTER),y
        sta @DATA0
        stx @DATA0
        iny
        cpy @LAST
        bne cell
        plx
    done:
    END ASM
  END SUB

  ' Fills the box of WIDTH by HEIGHT cells from ROW and COLUMN with CHARACTER in COLOR. A WIDTH
  ' or HEIGHT of 1 draws a line. WIDTH 0 or over 127, or HEIGHT 0, draws nothing. The console's
  ' cursor does not move.
  SUB FILL(ROW AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, HEIGHT AS UBYTE, CHARACTER AS UBYTE, COLOR AS UBYTE)
    DIM TOP AS UBYTE
    ASM
        lda @WIDTH
        beq done
        bmi done                ' over 127
        lda @HEIGHT
        beq done
        phx
        lda @SCROLL_HIGH
        lsr
        lda @SCROLL_LOW
        ror
        lsr
        lsr
        clc
        adc @ROW
        sta @TOP                ' the map row of ROW
        lda @COLUMN
        asl
        sta @COLUMN             ' now the cell's byte in its map row
        ldx @COLOR
    row: lda @TOP
        and #63
        sta @ADDRESS_MIDDLE
        lda @COLUMN
        sta @ADDRESS_LOW
        lda #$11
        sta @ADDRESS_HIGH
        lda @CHARACTER
        ldy @WIDTH
    cell: sta @DATA0
        stx @DATA0
        dey
        bne cell
        inc @TOP
        dec @HEIGHT
        bne row
        plx
    done:
    END ASM
  END SUB


  ' Pushes the box of WIDTH by HEIGHT cells from ROW and COLUMN onto the stack. Returns 1, or 0
  ' when WIDTH or HEIGHT is 0, WIDTH is over 127, or the stack has no room for 2 bytes a cell
  ' and 6 more. Only a 1 has a box for RESTORE_RECT.
  FUNCTION SAVE_RECT(ROW AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, HEIGHT AS UBYTE) AS UBYTE
    DIM RESULT AS UBYTE, TOP AS UBYTE, BYTES AS UBYTE, LINES AS UBYTE, PLACE AS UWORD
    ASM
        stz @RESULT
        lda @WIDTH
        beq out
        bmi out                 ' over 127
        asl
        sta @BYTES
        lda @HEIGHT
        bne start
    out: jmp done
    start: sta @LINES
        lda @SCROLL_HIGH
        lsr
        lda @SCROLL_LOW
        ror
        lsr
        lsr
        clc
        adc @ROW
        sta @TOP
        lda @STACK_TOP
        sta @PLACE
        lda @STACK_TOP + 1
        sta @PLACE + 1
        lda #1                  ' port 1 at the stack top
        sta @CONTROL
        lda @PLACE
        sta @ADDRESS_LOW
        lda @PLACE + 1
        sta @ADDRESS_MIDDLE
        lda #$10                ' increment 1, VRAM $0xxxx
        sta @ADDRESS_HIGH
        stz @CONTROL
    row: clc                    ' PLACE past the row, or the stack is full
        lda @PLACE
        adc @BYTES
        sta @PLACE
        bcc room
        inc @PLACE + 1
        beq done
    room: lda @TOP              ' port 0 at the row's first cell
        and #63
        sta @ADDRESS_MIDDLE
        lda @COLUMN
        asl
        sta @ADDRESS_LOW
        lda #$11
        sta @ADDRESS_HIGH
        ldy @BYTES
    copy: lda @DATA0
        sta @DATA1
        dey
        bne copy
        inc @TOP
        dec @LINES
        bne row
        clc                     ' PLACE past the header, or the stack is full
        lda @PLACE
        adc #6
        sta @PLACE
        bcc header
        inc @PLACE + 1
        beq done
    header: lda @STACK_TOP
        sta @DATA1
        lda @STACK_TOP + 1
        sta @DATA1
        lda @ROW
        sta @DATA1
        lda @COLUMN
        sta @DATA1
        lda @WIDTH
        sta @DATA1
        lda @HEIGHT
        sta @DATA1
        lda @PLACE
        sta @STACK_TOP
        lda @PLACE + 1
        sta @STACK_TOP + 1
        inc @RESULT
    done:
    END ASM
    RETURN RESULT
  END FUNCTION

  ' Pops the last box SAVE_RECT pushed and writes it back where it was on the screen. An empty
  ' stack does nothing.
  SUB RESTORE_RECT()
    DIM ROW AS UBYTE, COLUMN AS UBYTE, HEIGHT AS UBYTE, TOP AS UBYTE, BYTES AS UBYTE
    ASM
        lda @STACK_TOP          ' empty when STACK_TOP is the stack's base
        bne pop
        lda @STACK_TOP + 1
        cmp @STACK_BASE
        bne pop
        jmp done
    pop: sec                    ' port 0 at the header
        lda @STACK_TOP
        sbc #6
        sta @ADDRESS_LOW
        lda @STACK_TOP + 1
        sbc #0
        sta @ADDRESS_MIDDLE
        lda #$10
        sta @ADDRESS_HIGH
        lda @DATA0              ' the box's cells are the new stack top
        sta @STACK_TOP
        lda @DATA0
        sta @STACK_TOP + 1
        lda @DATA0
        sta @ROW
        lda @DATA0
        asl
        sta @COLUMN             ' now the cell's byte in its map row
        lda @DATA0
        asl
        sta @BYTES
        lda @DATA0
        sta @HEIGHT
        lda @STACK_TOP          ' port 0 at the box's cells
        sta @ADDRESS_LOW
        lda @STACK_TOP + 1
        sta @ADDRESS_MIDDLE
        lda @SCROLL_HIGH
        lsr
        lda @SCROLL_LOW
        ror
        lsr
        lsr
        clc
        adc @ROW
        sta @TOP
    row: lda #1                 ' port 1 at the row's first cell
        sta @CONTROL
        lda @TOP
        and #63
        sta @ADDRESS_MIDDLE
        lda @COLUMN
        sta @ADDRESS_LOW
        lda #$11
        sta @ADDRESS_HIGH
        stz @CONTROL
        ldy @BYTES
    copy: lda @DATA0
        sta @DATA1
        dey
        bne copy
        inc @TOP
        dec @HEIGHT
        bne row
    done:
    END ASM
  END SUB

  ' Returns the VRAM byte at ADDRESS.
  FUNCTION VPEEK(ADDRESS AS ULONG) AS UBYTE
    DIM VALUE AS UBYTE
    ASM
        phx
        lda @ADDRESS
        sta @R0
        lda @ADDRESS + 1
        sta @R0 + 1
        ldx @ADDRESS + 2
        ldy #0                  ' vpeek
        jsr $03F7
        sta @VALUE
        plx
    END ASM
    RETURN VALUE
  END FUNCTION

  ' Writes VALUE to the VRAM byte at ADDRESS.
  SUB VPOKE(ADDRESS AS ULONG, VALUE AS UBYTE)
    ASM
        phx
        lda @ADDRESS
        sta @R0
        lda @ADDRESS + 1
        sta @R0 + 1
        ldx @ADDRESS + 2
        lda @VALUE
        ldy #1                  ' vpoke
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Writes VALUE to COUNT VRAM bytes from ADDRESS. COUNT 0 writes none.
  SUB VMEMSET(ADDRESS AS ULONG, VALUE AS UBYTE, COUNT AS UWORD)
    ASM
        phx
        lda @ADDRESS
        sta @R0
        lda @ADDRESS + 1
        sta @R0 + 1
        lda @COUNT
        sta @R1
        lda @COUNT + 1
        sta @R1 + 1
        ldx @ADDRESS + 2
        lda @VALUE
        ldy #2                  ' vfill
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Copies COUNT bytes from RAM at SOURCE to VRAM at ADDRESS. COUNT 0 copies none.
  SUB MEMCPYMV(SOURCE AS UWORD, ADDRESS AS ULONG, COUNT AS UWORD)
    ASM
        phx
        lda @ADDRESS
        sta @R0
        lda @ADDRESS + 1
        sta @R0 + 1
        lda @SOURCE
        sta @R1
        lda @SOURCE + 1
        sta @R1 + 1
        lda @COUNT
        sta @R2
        lda @COUNT + 1
        sta @R2 + 1
        ldx @ADDRESS + 2
        ldy #3                  ' vwrite
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Copies COUNT bytes from VRAM at ADDRESS to RAM at TARGET. COUNT 0 copies none.
  SUB MEMCPYVM(ADDRESS AS ULONG, TARGET AS UWORD, COUNT AS UWORD)
    ASM
        phx
        lda @ADDRESS
        sta @R0
        lda @ADDRESS + 1
        sta @R0 + 1
        lda @TARGET
        sta @R1
        lda @TARGET + 1
        sta @R1 + 1
        lda @COUNT
        sta @R2
        lda @COUNT + 1
        sta @R2 + 1
        ldx @ADDRESS + 2
        ldy #4                  ' vread
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Reads up to COUNT bytes of the open file HANDLE into VRAM from ADDRESS. Returns the bytes
  ' read, fewer at the end of the file, and sets ERROR. HANDLE must be a file, not a device.
  FUNCTION VLOAD(HANDLE AS UWORD, ADDRESS AS ULONG, COUNT AS UWORD) AS UWORD
    ASM
        phx
        stz @ERROR
        lda @ADDRESS
        sta @R0
        lda @ADDRESS + 1
        sta @R0 + 1
        lda @COUNT
        sta @R1
        lda @COUNT + 1
        sta @R1 + 1
        ldx @HANDLE
        lda @ADDRESS + 2
        ldy #5                  ' vload
        jsr $03F7
        bcc read
        sta @ERROR
        stz @R1                 ' an error reads none
        stz @R1 + 1
    read: plx
    END ASM
    RETURN R1
  END FUNCTION

  ' Sets field FIELD of SPRITE to VALUE. The sprite's other fields stay.
  SUB SPRITE_SET(SPRITE AS UBYTE, FIELD AS ENUM.SPRITE_FIELD, VALUE AS UBYTE)
    ASM
        phx
        lda @VALUE
        sta @R0
        ldx @SPRITE
        lda @FIELD
        ldy #6                  ' sprset
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Puts the top left of SPRITE at LEFT and TOP, in pixels.
  SUB SPRITE_MOVE(SPRITE AS UBYTE, LEFT AS WORD, TOP AS WORD)
    ASM
        phx
        lda @LEFT
        sta @R0
        lda @LEFT + 1
        sta @R0 + 1
        lda @TOP
        sta @R1
        lda @TOP + 1
        sta @R1 + 1
        ldx @SPRITE
        ldy #7                  ' sprmove
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Points SPRITE at the shape at VRAM address SHAPE times 32. The mode stays.
  SUB SPRITE_SHAPE(SPRITE AS UBYTE, SHAPE AS UWORD)
    ASM
        phx
        lda @SHAPE
        sta @R0
        lda @SHAPE + 1
        sta @R0 + 1
        ldx @SPRITE
        ldy #8                  ' sprshape
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Returns the collision groups hit since the last CLEAR_HITS, in bits 0 to 3.
  FUNCTION SPRITE_HITS() AS UBYTE
    DIM HITS AS UBYTE
    ASM
        phx
        ldy #9                  ' sprhits
        jsr $03F7
        sta @HITS
        plx
    END ASM
    RETURN HITS
  END FUNCTION

  ' Clears the collision groups hit.
  SUB CLEAR_HITS()
    ASM
        phx
        ldy #10                 ' sprclear
        jsr $03F7
        plx
    END ASM
  END SUB

  ' Sets palette entry ENTRY to COLOR, $0RGB.
  SUB PALETTE(ENTRY AS UBYTE, COLOR AS UWORD)
    ASM
        phx
        lda @COLOR
        sta @R0
        lda @COLOR + 1
        sta @R0 + 1
        ldx @ENTRY
        ldy #11                 ' palette
        jsr $03F7
        plx
    END ASM
  END SUB

  ' $03FA, call 62, gfx, runs function Y with A and r0 to r3. Screen 1 is 640 by 240 pixels of
  ' 4 colors, screen 2 320 by 240 of 16, screen 3 320 by 200 of 256. X counts from 0 at the
  ' left, Y from 0 at the top. COLOR is 0 to 3 on screen 1, 0 to 15 on screen 2, 0 to 255 on
  ' screen 3. A shape lies wholly on the bitmap.

  ' Shows screen MODE: 0 the 80 by 30 text alone, 1 to 3 the text over a bitmap. The text is
  ' cleared and the cursor home; screens 1 to 3 clear the bitmap to color 0. The stack of saved
  ' boxes is emptied, and starts past the bitmap.
  SUB SCREEN(MODE AS UBYTE)
    ASM
        phx
        lda @MODE
        ldy #0                  ' mode
        jsr $03FA
        plx
        lda @MODE               ' the stack's base: $0000 on screen 0
        beq based
        cmp #3
        lda #$96                ' $9600 on screens 1 and 2, past 38400 bytes
        bcc based
        lda #$FA                ' $FA00 on screen 3, past 64000 bytes
    based: sta @STACK_BASE
        sta @STACK_TOP + 1
        stz @STACK_TOP
    END ASM
  END SUB

  ' Sets the whole bitmap to COLOR.
  SUB CLEAR(COLOR AS UBYTE)
    ASM
        phx
        lda @COLOR
        ldy #1                  ' clear
        jsr $03FA
        plx
    END ASM
  END SUB

  ' Sets the pixel at X and Y to COLOR.
  SUB PSET(X AS UWORD, Y AS UBYTE, COLOR AS UBYTE)
    ASM
        phx
        lda @X
        sta @R0
        lda @X + 1
        sta @R0 + 1
        lda @Y
        sta @R1
        lda @COLOR
        ldy #2                  ' pset
        jsr $03FA
        plx
    END ASM
  END SUB

  ' Returns the color of the pixel at X and Y.
  FUNCTION POINT(X AS UWORD, Y AS UBYTE) AS UBYTE
    DIM VALUE AS UBYTE
    ASM
        phx
        lda @X
        sta @R0
        lda @X + 1
        sta @R0 + 1
        lda @Y
        sta @R1
        ldy #3                  ' point
        jsr $03FA
        sta @VALUE
        plx
    END ASM
    RETURN VALUE
  END FUNCTION

  ' Draws the line from X1 and Y1 to X2 and Y2 in COLOR, both ends included.
  SUB LINE(X1 AS UWORD, Y1 AS UBYTE, X2 AS UWORD, Y2 AS UBYTE, COLOR AS UBYTE)
    ASM
        phx
        lda @X1
        sta @R0
        lda @X1 + 1
        sta @R0 + 1
        lda @Y1
        sta @R1
        lda @X2
        sta @R2
        lda @X2 + 1
        sta @R2 + 1
        lda @Y2
        sta @R3
        lda @COLOR
        ldy #4                  ' line
        jsr $03FA
        plx
    END ASM
  END SUB

  ' Draws the edge of the box from X1 and Y1 to X2 and Y2 in COLOR. X2 is not below X1, and Y2
  ' not below Y1.
  SUB FRAME(X1 AS UWORD, Y1 AS UBYTE, X2 AS UWORD, Y2 AS UBYTE, COLOR AS UBYTE)
    ASM
        phx
        lda @X1
        sta @R0
        lda @X1 + 1
        sta @R0 + 1
        lda @Y1
        sta @R1
        lda @X2
        sta @R2
        lda @X2 + 1
        sta @R2 + 1
        lda @Y2
        sta @R3
        lda @COLOR
        ldy #5                  ' frame
        jsr $03FA
        plx
    END ASM
  END SUB

  ' Fills the box from X1 and Y1 to X2 and Y2 with COLOR. X2 is not below X1, and Y2 not below
  ' Y1.
  SUB RECT(X1 AS UWORD, Y1 AS UBYTE, X2 AS UWORD, Y2 AS UBYTE, COLOR AS UBYTE)
    ASM
        phx
        lda @X1
        sta @R0
        lda @X1 + 1
        sta @R0 + 1
        lda @Y1
        sta @R1
        lda @X2
        sta @R2
        lda @X2 + 1
        sta @R2 + 1
        lda @Y2
        sta @R3
        lda @COLOR
        ldy #6                  ' rect
        jsr $03FA
        plx
    END ASM
  END SUB

  ' Draws the circle of RADIUS around X and Y in COLOR. Radius 0 is one pixel.
  SUB CIRCLE(X AS UWORD, Y AS UBYTE, RADIUS AS UBYTE, COLOR AS UBYTE)
    ASM
        phx
        lda @X
        sta @R0
        lda @X + 1
        sta @R0 + 1
        lda @Y
        sta @R1
        lda @RADIUS
        sta @R2
        lda @COLOR
        ldy #7                  ' circle
        jsr $03FA
        plx
    END ASM
  END SUB

  ' Draws the 8 by 8 glyph of CHARACTER, from the font in use, with its top left at X and Y in
  ' COLOR. The glyph's clear pixels keep the bitmap.
  SUB CHAR(X AS UWORD, Y AS UBYTE, CHARACTER AS UBYTE, COLOR AS UBYTE)
    ASM
        phx
        lda @X
        sta @R0
        lda @X + 1
        sta @R0 + 1
        lda @Y
        sta @R1
        lda @CHARACTER
        sta @R2
        lda @COLOR
        ldy #8                  ' char
        jsr $03FA
        plx
    END ASM
  END SUB
END NAMESPACE
