' KEYS.UXI: the codes the 6502DOS console gives for keys, and the modifier bits.
'
' GETEXTKEY() and WAITKEY() give a key as one UWORD: a plain key gives its character, 1 to 255,
' and an extended key gives its IBM PC BIOS scan code * 256. GETEXTKEY() gives 0 when no key
' waits. A key over 255 is extended. The KEY_ names are those UWORDs. KEYMODS() gives the
' modifier bits of the last GETEXTKEY() or WAITKEY().
'
' GETKEY() gives one character a call: 0 for an extended key, then its scan code at the next
' GETKEY(). The SCAN_ names are those scan codes.
'
' It holds constants and BINDs only, so it adds no bytes to a program. Include it in any file, with or
' without DOS.UXI.
'
' Checklist: the codes come from kbd_get and its tables in src/asm/console.s. Change both
' together.

NAMESPACE KEYS
  ' The key functions under KEYS.
  BIND GETKEY GETKEY
  BIND GETEXTKEY GETEXTKEY
  BIND WAITKEY WAITKEY
  BIND KEYMODS KEYMODS

  ' One-character keys. Ctrl+A to Ctrl+Z give 1 to 26, Ctrl+[ 27, Ctrl+\ 28, Ctrl+] 29,
  ' Ctrl+6 30, Ctrl+- 31.
  CONST EXTENDED AS UBYTE = 0
  CONST BACKSPACE AS UBYTE = 8, TAB AS UBYTE = 9, ENTER AS UBYTE = 13, ESC AS UBYTE = 27
  CONST SPACE AS UBYTE = 32
  CONST CTRL_A AS UBYTE = 1, CTRL_6 AS UBYTE = 30, CTRL_MINUS AS UBYTE = 31

  ' The modifier bits that KEYMODS() gives and API_CON_STATUS returns in X.
  CONST MOD_SHIFT AS UBYTE = $01, MOD_CAPS AS UBYTE = $04, MOD_ALT AS UBYTE = $40
  CONST MOD_CTRL AS UBYTE = $80

  ' Scan codes: the cursor keys and the editing keys.
  CONST SCAN_HOME AS UBYTE = $47, SCAN_UP AS UBYTE = $48, SCAN_PGUP AS UBYTE = $49
  CONST SCAN_LEFT AS UBYTE = $4B, SCAN_RIGHT AS UBYTE = $4D
  CONST SCAN_END AS UBYTE = $4F, SCAN_DOWN AS UBYTE = $50, SCAN_PGDN AS UBYTE = $51
  CONST SCAN_INSERT AS UBYTE = $52, SCAN_DELETE AS UBYTE = $53

  ' Scan codes: the cursor keys with Ctrl. Ctrl+Up, Ctrl+Down, Ctrl+Insert and Ctrl+Delete
  ' give the scan code without Ctrl.
  CONST SCAN_CTRL_LEFT AS UBYTE = $73, SCAN_CTRL_RIGHT AS UBYTE = $74
  CONST SCAN_CTRL_END AS UBYTE = $75, SCAN_CTRL_PGDN AS UBYTE = $76
  CONST SCAN_CTRL_HOME AS UBYTE = $77, SCAN_CTRL_PGUP AS UBYTE = $84

  ' Scan codes: F1 to F10 are SCAN_F1 to SCAN_F1 + 9, and the same with each modifier. Alt
  ' wins over Ctrl, and Ctrl over Shift.
  CONST SCAN_F1 AS UBYTE = $3B, SCAN_F10 AS UBYTE = $44
  CONST SCAN_SHIFT_F1 AS UBYTE = $54, SCAN_SHIFT_F10 AS UBYTE = $5D
  CONST SCAN_CTRL_F1 AS UBYTE = $5E, SCAN_CTRL_F10 AS UBYTE = $67
  CONST SCAN_ALT_F1 AS UBYTE = $68, SCAN_ALT_F10 AS UBYTE = $71

  ' Scan codes: Alt+1 to Alt+0 are SCAN_ALT_1 to SCAN_ALT_1 + 9, then Alt+- and Alt+=.
  CONST SCAN_ALT_1 AS UBYTE = $78, SCAN_ALT_0 AS UBYTE = $81
  CONST SCAN_ALT_MINUS AS UBYTE = $82, SCAN_ALT_EQUALS AS UBYTE = $83

  ' Scan codes: Ctrl+2 gives 0, then SCAN_CTRL_2.
  CONST SCAN_CTRL_2 AS UBYTE = 3

  ' Scan codes: Alt+letter.
  CONST SCAN_ALT_Q AS UBYTE = $10, SCAN_ALT_W AS UBYTE = $11, SCAN_ALT_E AS UBYTE = $12
  CONST SCAN_ALT_R AS UBYTE = $13, SCAN_ALT_T AS UBYTE = $14, SCAN_ALT_Y AS UBYTE = $15
  CONST SCAN_ALT_U AS UBYTE = $16, SCAN_ALT_I AS UBYTE = $17, SCAN_ALT_O AS UBYTE = $18
  CONST SCAN_ALT_P AS UBYTE = $19
  CONST SCAN_ALT_A AS UBYTE = $1E, SCAN_ALT_S AS UBYTE = $1F, SCAN_ALT_D AS UBYTE = $20
  CONST SCAN_ALT_F AS UBYTE = $21, SCAN_ALT_G AS UBYTE = $22, SCAN_ALT_H AS UBYTE = $23
  CONST SCAN_ALT_J AS UBYTE = $24, SCAN_ALT_K AS UBYTE = $25, SCAN_ALT_L AS UBYTE = $26
  CONST SCAN_ALT_Z AS UBYTE = $2C, SCAN_ALT_X AS UBYTE = $2D, SCAN_ALT_C AS UBYTE = $2E
  CONST SCAN_ALT_V AS UBYTE = $2F, SCAN_ALT_B AS UBYTE = $30, SCAN_ALT_N AS UBYTE = $31
  CONST SCAN_ALT_M AS UBYTE = $32

  ' The keys as GETEXTKEY() and WAITKEY() give them: KEY_name is SCAN_name * 256.
  CONST KEY_HOME AS UWORD = SCAN_HOME * 256, KEY_UP AS UWORD = SCAN_UP * 256
  CONST KEY_PGUP AS UWORD = SCAN_PGUP * 256, KEY_LEFT AS UWORD = SCAN_LEFT * 256
  CONST KEY_RIGHT AS UWORD = SCAN_RIGHT * 256, KEY_END AS UWORD = SCAN_END * 256
  CONST KEY_DOWN AS UWORD = SCAN_DOWN * 256, KEY_PGDN AS UWORD = SCAN_PGDN * 256
  CONST KEY_INSERT AS UWORD = SCAN_INSERT * 256, KEY_DELETE AS UWORD = SCAN_DELETE * 256
  CONST KEY_CTRL_LEFT AS UWORD = SCAN_CTRL_LEFT * 256
  CONST KEY_CTRL_RIGHT AS UWORD = SCAN_CTRL_RIGHT * 256
  CONST KEY_CTRL_END AS UWORD = SCAN_CTRL_END * 256, KEY_CTRL_PGDN AS UWORD = SCAN_CTRL_PGDN * 256
  CONST KEY_CTRL_HOME AS UWORD = SCAN_CTRL_HOME * 256
  CONST KEY_CTRL_PGUP AS UWORD = SCAN_CTRL_PGUP * 256, KEY_F1 AS UWORD = SCAN_F1 * 256
  CONST KEY_F10 AS UWORD = SCAN_F10 * 256, KEY_SHIFT_F1 AS UWORD = SCAN_SHIFT_F1 * 256
  CONST KEY_SHIFT_F10 AS UWORD = SCAN_SHIFT_F10 * 256, KEY_CTRL_F1 AS UWORD = SCAN_CTRL_F1 * 256
  CONST KEY_CTRL_F10 AS UWORD = SCAN_CTRL_F10 * 256, KEY_ALT_F1 AS UWORD = SCAN_ALT_F1 * 256
  CONST KEY_ALT_F10 AS UWORD = SCAN_ALT_F10 * 256, KEY_ALT_1 AS UWORD = SCAN_ALT_1 * 256
  CONST KEY_ALT_0 AS UWORD = SCAN_ALT_0 * 256, KEY_ALT_MINUS AS UWORD = SCAN_ALT_MINUS * 256
  CONST KEY_ALT_EQUALS AS UWORD = SCAN_ALT_EQUALS * 256, KEY_CTRL_2 AS UWORD = SCAN_CTRL_2 * 256
  CONST KEY_ALT_Q AS UWORD = SCAN_ALT_Q * 256, KEY_ALT_W AS UWORD = SCAN_ALT_W * 256
  CONST KEY_ALT_E AS UWORD = SCAN_ALT_E * 256, KEY_ALT_R AS UWORD = SCAN_ALT_R * 256
  CONST KEY_ALT_T AS UWORD = SCAN_ALT_T * 256, KEY_ALT_Y AS UWORD = SCAN_ALT_Y * 256
  CONST KEY_ALT_U AS UWORD = SCAN_ALT_U * 256, KEY_ALT_I AS UWORD = SCAN_ALT_I * 256
  CONST KEY_ALT_O AS UWORD = SCAN_ALT_O * 256, KEY_ALT_P AS UWORD = SCAN_ALT_P * 256
  CONST KEY_ALT_A AS UWORD = SCAN_ALT_A * 256, KEY_ALT_S AS UWORD = SCAN_ALT_S * 256
  CONST KEY_ALT_D AS UWORD = SCAN_ALT_D * 256, KEY_ALT_F AS UWORD = SCAN_ALT_F * 256
  CONST KEY_ALT_G AS UWORD = SCAN_ALT_G * 256, KEY_ALT_H AS UWORD = SCAN_ALT_H * 256
  CONST KEY_ALT_J AS UWORD = SCAN_ALT_J * 256, KEY_ALT_K AS UWORD = SCAN_ALT_K * 256
  CONST KEY_ALT_L AS UWORD = SCAN_ALT_L * 256, KEY_ALT_Z AS UWORD = SCAN_ALT_Z * 256
  CONST KEY_ALT_X AS UWORD = SCAN_ALT_X * 256, KEY_ALT_C AS UWORD = SCAN_ALT_C * 256
  CONST KEY_ALT_V AS UWORD = SCAN_ALT_V * 256, KEY_ALT_B AS UWORD = SCAN_ALT_B * 256
  CONST KEY_ALT_N AS UWORD = SCAN_ALT_N * 256, KEY_ALT_M AS UWORD = SCAN_ALT_M * 256
END NAMESPACE
