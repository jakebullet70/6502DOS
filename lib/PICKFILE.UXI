' PICKFILE.UXI: GUI.PICKFILE, a dialog that picks a file, laid out as the Open dialog of MS-DOS's
' EDIT.
'
' A program includes KEYS.UXI, DOS.UXI, BANK.UXI, VERA.UXI, GUI.UXI, then PICKFILE.UXI. The
' dialog runs from region 3, and the helpers that reach its names' RAM bank from low RAM.

NAMESPACE GUI
  ERRORS OFF
  ' The helpers run from low RAM, as they select the names' RAM bank.
#REGION_SLOT 0
  ' Selects RAM bank BANK, and returns 1 when the record at FIRST sorts before the record at
  ' SECOND, case ignored, else 0. A name sorts before a longer name that starts with it.
  ' Trap: the bank stays selected.
  FUNCTION SORTS_BEFORE(FIRST AS UWORD, SECOND AS UWORD, BANK AS UBYTE) AS UBYTE
    DIM SPOT AS UBYTE, MINE AS UBYTE, THEIRS AS UBYTE
    ContentsAt(0) = BANK
    FOR SPOT = 0 TO 31
      MINE = ContentsAt(FIRST + SPOT)
      THEIRS = ContentsAt(SECOND + SPOT)
      ' AND $DF makes a to z A to Z.
      IF MINE >= 97 THEN MINE = MINE AND $DF
      IF THEIRS >= 97 THEN THEIRS = THEIRS AND $DF
      IF MINE <> THEIRS THEN RETURN MINE < THEIRS
    NEXT
    RETURN 0
  END FUNCTION

  ' Selects RAM bank BANK, and copies the 32 bytes at SOURCE to DESTINATION.
  ' Trap: the bank stays selected.
  SUB COPY_RECORD(SOURCE AS UWORD, DESTINATION AS UWORD, BANK AS UBYTE)
    DIM SPOT AS UBYTE
    ContentsAt(0) = BANK
    FOR SPOT = 0 TO 31
      ContentsAt(DESTINATION + SPOT) = ContentsAt(SOURCE + SPOT)
    NEXT
  END SUB

#REGION_SLOT 3
  ' PICKFILE calls PICK_HANDLER, when it is not 0, for a key that leaves a list or the field.
  ' PICKMANAGE sets it to MANAGE for its call of PICKFILE, so a program with no PICKMANAGE
  ' carries no file manager code.
  DECLARE FUNCTION PICK_KEY_HANDLER(SCAN AS UBYTE, ITEM AS UBYTE) AS UBYTE
  DIM PICK_HANDLER AS PICK_KEY_HANDLER
  ' The lists' rows.
  CONST PICK_ROWS AS UBYTE = 10
  ' PICKFILE's names are records of 32 bytes in RAM bank PICK_BANK from $A000, PICK_COUNT of
  ' them: PICK_DIRS folders, then the drives, PICK_FOLDERS in all, then PICK_FILES files.
  ' PICK_ORDER(N) is the record that sorts Nth. PICK_DRIVES has bit 0 set for A:, bit 1 for B:,
  ' and so on, for each drive the dialog lists.
  ' Checklist: record 255 is PLACE_RECORDS's spare, so the records stop at 255.
  DIM PICK_BANK AS UBYTE, PICK_COUNT AS UBYTE, PICK_ORDER(255) AS UBYTE
  DIM PICK_DIRS AS UBYTE, PICK_FOLDERS AS UBYTE, PICK_FILES AS UBYTE, PICK_DRIVES AS UBYTE
  ' The path shown, cut to the dialog's width.
  DIM PICK_PATH AS STRING * 68

  ' The address of record NUMBER, 0 for the first.
  FUNCTION RECORD_AT(NUMBER AS UBYTE) AS UWORD
    DIM AT AS UWORD
    AT = NUMBER
    RETURN $A000 + AT * 32
  END FUNCTION

  ' Adds DOS.FOUND_NAME as the next record, unless there are 255. PICK_ORDER keeps the records
  ' from FIRST sorted, case ignored, after the others.
  SUB ADD_NAME(FIRST AS UBYTE)
    DIM LOW AS UBYTE, HIGH AS UBYTE, MIDDLE AS UBYTE, NEW_AT AS UWORD
    IF PICK_COUNT = 255 THEN RETURN
    ' The name, padded with zeros to 32 bytes, becomes the next record.
    LOW = LEN(DOS.FOUND_NAME)
    DO WHILE LOW < 32
      ContentsAt(@DOS.FOUND_NAME + 2 + LOW) = 0
      LOW = LOW + 1
    LOOP
    NEW_AT = RECORD_AT(PICK_COUNT)
    COPY_RECORD(@DOS.FOUND_NAME + 2, NEW_AT, PICK_BANK)
    ' A binary search for the place of the new record among the records from FIRST.
    LOW = FIRST
    HIGH = PICK_COUNT
    DO WHILE LOW < HIGH
      MIDDLE = LOW + ((HIGH - LOW) >> 1)
      IF SORTS_BEFORE(NEW_AT, RECORD_AT(PICK_ORDER(MIDDLE)), PICK_BANK) THEN
        HIGH = MIDDLE
      ELSE
        LOW = MIDDLE + 1
      ENDIF
    LOOP
    HIGH = PICK_COUNT
    DO WHILE HIGH > LOW
      PICK_ORDER(HIGH) = PICK_ORDER(HIGH - 1)
      HIGH = HIGH - 1
    LOOP
    PICK_ORDER(LOW) = PICK_COUNT
    PICK_COUNT = PICK_COUNT + 1
  END SUB

  ' Adds as records the names that PATTERN$ matches: with ATTRIBUTES DOS.ATTR_DIRECTORY the
  ' folders but ".", with 0 the files, as ADD_NAME adds them. Returns the number added.
  FUNCTION READ_NAMES(PATTERN$ AS CONST, ATTRIBUTES AS UBYTE) AS UBYTE
    DIM FIRST AS UBYTE
    FIRST = PICK_COUNT
    DOS.FINDFIRST(PATTERN$, ATTRIBUTES)
    DO WHILE DOS.ERROR = 0
      ' The files' search finds no folder. $2E01 is the length and first character of ".".
      IF (DOS.FOUND_ATTRIBUTES AND DOS.ATTR_DIRECTORY) = ATTRIBUTES AND ContentsAtW(@DOS.FOUND_NAME + 1) <> $2E01 THEN ADD_NAME(FIRST)
      DOS.FINDNEXT()
    LOOP
    RETURN PICK_COUNT - FIRST
  END FUNCTION

  ' Moves each record to its place in PICK_ORDER, one cycle of places at a time, with record 255,
  ' at $BFE0, as the spare.
  SUB PLACE_RECORDS()
    DIM SPOT AS UBYTE, HOLE AS UBYTE, TAKEN AS UBYTE
    SPOT = 0
    REPEAT PICK_COUNT
      IF PICK_ORDER(SPOT) <> SPOT THEN
        COPY_RECORD(RECORD_AT(SPOT), $BFE0, PICK_BANK)
        HOLE = SPOT
        DO
          TAKEN = PICK_ORDER(HOLE)
          PICK_ORDER(HOLE) = HOLE
          IF TAKEN = SPOT THEN EXIT DO
          COPY_RECORD(RECORD_AT(TAKEN), RECORD_AT(HOLE), PICK_BANK)
          HOLE = TAKEN
        LOOP
        COPY_RECORD($BFE0, RECORD_AT(HOLE), PICK_BANK)
      ENDIF
      SPOT = SPOT + 1
    END REPEAT
  END SUB

  ' Reads into the records, in order, the folders in the folder that DOS.CALL_TEXT names, the
  ' drives in PICK_DRIVES, then the files there that MASK$ matches.
  SUB READ_ALL(MASK$ AS CONST)
    DIM DRIVES AS UBYTE, LETTER AS UBYTE
    PICK_COUNT = 0
    PICK_DIRS = READ_NAMES(DOS.CALL_TEXT + "*.*", DOS.ATTR_DIRECTORY)
    ' A drive's record is [-A-] for A:.
    DRIVES = PICK_DRIVES
    LETTER = ASC("A")
    DO WHILE DRIVES <> 0
      IF DRIVES AND 1 THEN
        DOS.FOUND_NAME = "[-A-]"
        ContentsAt(@DOS.FOUND_NAME + 4) = LETTER
        ADD_NAME(PICK_COUNT)
      ENDIF
      DRIVES = DRIVES >> 1
      LETTER = LETTER + 1
    LOOP
    PICK_FOLDERS = PICK_COUNT
    PICK_FILES = READ_NAMES(DOS.CALL_TEXT + MASK$, 0)
    PLACE_RECORDS()
  END SUB

  ' Puts the name of record NUMBER in DOS.FOUND_NAME. A name ends at its first zero, or at 32
  ' characters.
  SUB NAME_OF(NUMBER AS UBYTE)
    DIM LENGTH AS UBYTE
    COPY_RECORD(RECORD_AT(NUMBER), @DOS.FOUND_NAME + 2, PICK_BANK)
    LENGTH = 0
    DO WHILE LENGTH < 32
      IF ContentsAt(@DOS.FOUND_NAME + 2 + LENGTH) = 0 THEN EXIT DO
      LENGTH = LENGTH + 1
    LOOP
    ContentsAt(@DOS.FOUND_NAME + 1) = LENGTH
  END SUB

  ' Puts in DOS.CALL_TEXT the path of the current folder of DRIVE, 1 for A:, from the drive
  ' letter to a closing \. A drive GETCWD does not know gets its root.
  SUB SET_PATH(DRIVE AS UBYTE)
    DOS.GETCWD(DRIVE)
    IF DOS.ERROR <> 0 THEN DOS.CALL_TEXT = ""
    IF DOS.CALL_TEXT <> "" THEN DOS.CALL_TEXT = DOS.CALL_TEXT + "\"
    DOS.CALL_TEXT = CHR$(DRIVE + ASC("@")) + ":\" + DOS.CALL_TEXT
  END SUB

  ' Takes out of DOS.CALL_TEXT, a path from the drive letter to a closing \, each empty name,
  ' each name . and each name .. with the name before it. A .. at the root goes.
  SUB TIDY_PATH()
    DIM TAKEN_AT AS UBYTE, KEPT_AT AS UBYTE, START AS UBYTE, CHARACTER AS UBYTE
    ' Character N, from 1, is at @DOS.CALL_TEXT + 1 + N. X:\ stays. Each pass copies a name and
    ' its \ back to KEPT_AT.
    TAKEN_AT = 3
    KEPT_AT = 3
    DO WHILE TAKEN_AT < LEN(DOS.CALL_TEXT)
      START = KEPT_AT
      DO
        TAKEN_AT = TAKEN_AT + 1
        KEPT_AT = KEPT_AT + 1
        CHARACTER = ContentsAt(@DOS.CALL_TEXT + 1 + TAKEN_AT)
        ContentsAt(@DOS.CALL_TEXT + 1 + KEPT_AT) = CHARACTER
      LOOP UNTIL CHARACTER = ASC("\")
      ' CHARACTER is the name's length and 1 for its \.
      CHARACTER = KEPT_AT - START
      IF CHARACTER = 1 THEN KEPT_AT = START
      IF ContentsAt(@DOS.CALL_TEXT + 1 + START + 1) = ASC(".") THEN
        IF CHARACTER = 2 THEN KEPT_AT = START
        IF CHARACTER = 3 AND ContentsAt(@DOS.CALL_TEXT + 1 + START + 2) = ASC(".") THEN
          KEPT_AT = START
          IF KEPT_AT > 3 THEN
            DO
              KEPT_AT = KEPT_AT - 1
            LOOP UNTIL ContentsAt(@DOS.CALL_TEXT + 1 + KEPT_AT) = ASC("\")
          ENDIF
        ENDIF
      ENDIF
    LOOP
    ContentsAt(@DOS.CALL_TEXT + 1) = KEPT_AT
  END SUB

  ' Returns 1 when TEXT$ holds * or ?, a mask, and adds 2 when it holds \ or :, a path.
  FUNCTION WILD(TEXT$ AS CONST) AS UBYTE
    DIM SPOT AS UBYTE, CHARACTER AS UBYTE, FOUND AS UBYTE, AT AS UWORD
    AT = AddrOf(TEXT$) + 1
    FOUND = 0
    FOR SPOT = 1 TO LEN(TEXT$)
      CHARACTER = ContentsAt(AT + SPOT)
      IF CHARACTER = ASC("*") OR CHARACTER = ASC("?") THEN FOUND = FOUND OR 1
      IF CHARACTER = ASC("\") OR CHARACTER = ASC(":") THEN FOUND = FOUND OR 2
    NEXT
    RETURN FOUND
  END FUNCTION

  ' Takes TYPED$, what the field holds, as a path from the folder DOS.CALL_TEXT names: from the
  ' root of that drive after a first \, from the current folder of drive A: after A:, and from
  ' its root after A:\. Returns 2, with nothing changed, for a mask with no \ and no :. Else
  ' DOS.CALL_TEXT gets the folder, TIDY_PATH's way, and it returns 1 for a file, TYPED$ then its
  ' full path. It returns 0 for a mask, TYPED$ then the mask, and for a folder, which
  ' DOS.CALL_TEXT then names, TYPED$ then MASK$.
  FUNCTION TAKE_TYPED(TYPED$, MASK$ AS CONST) AS UBYTE
    DIM SPOT AS UBYTE, LENGTH AS UBYTE, AT AS UWORD
    IF WILD(TYPED$) = 1 THEN RETURN 2
    ' Character N, from 1, is at AT + N.
    AT = AddrOf(TYPED$) + 1
    SPOT = 1
    IF ContentsAt(AT + 2) = ASC(":") THEN
      ' AND $DF makes a to z A to Z.
      SET_PATH((ContentsAt(AT + 1) AND $DF) - ASC("@"))
      SPOT = 3
    ENDIF
    ' A \ at SPOT is the root's.
    IF ContentsAt(AT + SPOT) = ASC("\") AND SPOT <= LEN(TYPED$) THEN ContentsAt(@DOS.CALL_TEXT + 1) = 3
    ' TIDY_PATH takes the names typed, the last one with a closing \ too.
    DOS.CALL_TEXT = DOS.CALL_TEXT + MID$(TYPED$, SPOT) + "\"
    TIDY_PATH()
    ' The last name starts after the \ at SPOT.
    LENGTH = LEN(DOS.CALL_TEXT)
    TYPED$ = MASK$
    IF LENGTH = 3 THEN RETURN 0
    SPOT = LENGTH - 1
    DO
      SPOT = SPOT - 1
    LOOP UNTIL ContentsAt(@DOS.CALL_TEXT + 1 + SPOT) = ASC("\")
    ' The path loses its closing \.
    LENGTH = LENGTH - 1
    ContentsAt(@DOS.CALL_TEXT + 1) = LENGTH
    IF WILD(DOS.CALL_TEXT) AND 1 THEN
      TYPED$ = MID$(DOS.CALL_TEXT, SPOT + 1)
      ContentsAt(@DOS.CALL_TEXT + 1) = SPOT
      RETURN 0
    ENDIF
    DOS.FINDFIRST(DOS.CALL_TEXT, DOS.ATTR_DIRECTORY)
    IF DOS.ERROR = 0 AND (DOS.FOUND_ATTRIBUTES AND DOS.ATTR_DIRECTORY) <> 0 THEN
      ContentsAt(@DOS.CALL_TEXT + 1) = LENGTH + 1
      RETURN 0
    ENDIF
    TYPED$ = DOS.CALL_TEXT
    RETURN 1
  END FUNCTION

  ' Copies 256 bytes from FROM to DESTINATION, one of them in the names' bank.
  SUB KEEP_PATH(FROM AS UWORD, DESTINATION AS UWORD)
    REPEAT 8
      COPY_RECORD(FROM, DESTINATION, PICK_BANK)
      FROM = FROM + 32
      DESTINATION = DESTINATION + 32
    END REPEAT
  END SUB

  ' Runs, for SCAN F2, F5 or F7, the rename, the copy or the folder made of PICKMANAGE's
  ' keys, to NEW$, from the file or folder DOS.CALL_TEXT names. A copy onto the same path is
  ' not made, and sets DOS.ERROR to ERR_ACCESS. A copy keeps DOS.CALL_TEXT, which DOS.COPY
  ' takes as its buffer, in the names' bank from $A000, over the records.
  SUB MOVE_FILE(SCAN AS UBYTE, NEW$)
    ' F1 to F10 are the scan codes KEYS.SCAN_F1 to KEYS.SCAN_F1 + 9.
    IF SCAN = KEYS.SCAN_F1 + 1 THEN
      DOS.RENAME(DOS.CALL_TEXT, NEW$)
    ELSEIF SCAN = KEYS.SCAN_F1 + 6 THEN
      DOS.MKDIR(NEW$)
    ELSEIF UCASE$(NEW$) = UCASE$(DOS.CALL_TEXT) THEN
      DOS.ERROR = DOS.ERR_ACCESS
    ELSE
      KEEP_PATH(@DOS.CALL_TEXT + 1, $A000)
      DOS.COPY(DOS.CALL_TEXT, NEW$)
      KEEP_PATH($A000, @DOS.CALL_TEXT + 1)
    ENDIF
  END SUB

  ' Runs the PICKMANAGE key of scan code SCAN on record ITEM - 1, a folder up to PICK_DIRS,
  ' or on none for 0, in the folder shown. Del deletes the file or folder after a YESNO. F2
  ' renames it, and F5 copies a file, to the name asked with an INPUTBOX. F7 makes the folder
  ' named in an INPUTBOX. A name asked is a name or a path from the folder shown, or a path from
  ' a drive, 32 characters at most. .. is not deleted or renamed. Returns 1 when it called DOS,
  ' with a DOS error shown on the status line, else 0. It is the PICK_KEY_HANDLER.
  FUNCTION MANAGE(SCAN AS UBYTE, ITEM AS UBYTE) AS UBYTE
    DIM FOCUS AS UBYTE, FORM AS UBYTE, SCREEN AS UBYTE, SHOWN AS UBYTE, LENGTH AS UBYTE
    DIM DONE AS UBYTE, ANSWER AS UBYTE
    ' Trap: the dialogs here take over DIALOG_FORM and what PUT_DIALOG kept for PICKFILE.
    FOCUS = KEPT_FOCUS
    FORM = KEPT_FORM
    SCREEN = KEPT_SCREEN
    SHOWN = DIALOG_FORM
    ' DOS.CALL_TEXT holds the item's path, and LENGTH the length of the folder's.
    LENGTH = LEN(DOS.CALL_TEXT)
    IF ITEM <> 0 THEN
      NAME_OF(ITEM - 1)
      IF DOS.FOUND_NAME = ".." THEN ITEM = 0
      DOS.CALL_TEXT = DOS.CALL_TEXT + DOS.FOUND_NAME
    ENDIF
    DONE = 0
    IF SCAN = KEYS.SCAN_DELETE AND ITEM <> 0 THEN
      DONE = YESNO("Delete", DOS.FOUND_NAME + "?")
      IF DONE <> 0 AND ITEM > PICK_DIRS THEN DOS.DELETE(DOS.CALL_TEXT)
      IF DONE <> 0 AND ITEM <= PICK_DIRS THEN DOS.RMDIR(DOS.CALL_TEXT)
    ENDIF
    ANSWER = 0
    IF SCAN = KEYS.SCAN_F1 + 1 AND ITEM <> 0 THEN ANSWER = INPUTBOX("Rename", "New name:", DOS.FOUND_NAME, 32)
    IF SCAN = KEYS.SCAN_F1 + 4 AND ITEM > PICK_DIRS THEN ANSWER = INPUTBOX("Copy", "Copy to:", DOS.FOUND_NAME, 32)
    IF SCAN = KEYS.SCAN_F1 + 6 THEN
      DOS.FOUND_NAME = ""
      ANSWER = INPUTBOX("New folder", "Name:", DOS.FOUND_NAME, 32)
    ENDIF
    IF ANSWER = 1 THEN
      ' The characters of a string start at its address + 2.
      IF ContentsAt(@DOS.FOUND_NAME + 3) = ASC(":") THEN
        MOVE_FILE(SCAN, DOS.FOUND_NAME)
      ELSE
        MOVE_FILE(SCAN, LEFT$(DOS.CALL_TEXT, LENGTH) + DOS.FOUND_NAME)
      ENDIF
      DONE = 1
    ENDIF
    ContentsAt(@DOS.CALL_TEXT + 1) = LENGTH
    KEPT_FOCUS = FOCUS
    KEPT_FORM = FORM
    KEPT_SCREEN = SCREEN
    DIALOG_FORM = SHOWN
    IF DONE <> 0 AND DOS.ERROR <> 0 THEN REFUSE("DOS error" + STR$(DOS.ERROR))
    RETURN DONE
  END FUNCTION

  ' Shows a dialog as MSGBOX does, titled TITLE$, laid out as the Open dialog of MS-DOS's EDIT:
  ' the field File name, which edits TARGET$; the path of the folder shown; the files there that
  ' the mask matches beside the folders there and the drives, each list sorted with case ignored;
  ' then the buttons &OK and &Cancel. The dialog opens on the current folder, with the field
  ' holding MASK$, the mask, and the focus on the field. OK and Enter in the field take what the
  ' field holds, as TAKE_TYPED reads it: a file returns 1, with TARGET$ its full path; a folder
  ' opens, the field then holding MASK$; a mask, a name with * or ?, becomes the mask, and opens
  ' the folder before it. An empty field gets MASK$ back. OK on a mask with no folder, and Enter
  ' in the list of files, return 1 with TARGET$ the full path of the file chosen in the list.
  ' Enter in the list of folders opens the folder or the drive chosen: .. opens the folder
  ' above, and a drive, [-A-] for A:, its current folder. Returns 0 for Cancel, for Esc, with
  ' no file chosen, or when no RAM bank is free. The current drive and folder do not change.
  ' The dialog is 72 columns wide, and a path past 68 characters shows as its drive, ... and
  ' its end. It takes a RAM bank while it is open. The lists hold 255 names in all. It changes
  ' DOS.CALL_TEXT and the DOS.FOUND_ variables.
  FUNCTION PICKFILE(TITLE$ AS CONST, MASK$ AS CONST, TARGET$) AS UBYTE
    DIM FOLDER AS UBYTE, CHOSEN AS UBYTE, FIELD AS UBYTE, FOLDERS AS UBYTE, FILES AS UBYTE
    DIM RESULT AS UBYTE, DRIVE AS UBYTE, ITEM AS UBYTE, TAKEN AS UBYTE
    PICK_BANK = BANK.ALLOC(1)
    IF PICK_BANK = 0 THEN RETURN 0
    ' The drives GETCWD knows, H: first, so A: ends in bit 0.
    PICK_DRIVES = 0
    FOR DRIVE = 8 TO 1 STEP -1
      PICK_DRIVES = PICK_DRIVES + PICK_DRIVES
      DOS.GETCWD(DRIVE)
      IF DOS.ERROR = 0 THEN PICK_DRIVES = PICK_DRIVES + 1
    NEXT
    ' DOS.CALL_TEXT holds the path of the folder shown.
    SET_PATH(DOS.GETDRIVE() + 1)
    TARGET$ = MASK$
    RESULT = 0
    ' Each pass reads the names and makes the form; the first saves the screen.
    DO
      IF WILD(TARGET$) = 1 THEN
        READ_ALL(TARGET$)
      ELSE
        READ_ALL(MASK$)
      ENDIF
      ' A compare gives 1 for true.
      CHOSEN = PICK_FILES <> 0
      FOLDER = PICK_FOLDERS <> 0
      DIALOG_WIDTH = 68
      OPEN_DIALOG(TITLE$, PICK_ROWS + 3, "&OK", "&Cancel")
      FIELD = SAYGET(1, 2, "File name:", TARGET$, 57, "", VALIDATE)
      ' A path past 68 characters shows as its drive, ... and its last 62 characters.
      IF LEN(DOS.CALL_TEXT) > 68 THEN
        PICK_PATH = LEFT$(DOS.CALL_TEXT, 3) + "..." + RIGHT$(DOS.CALL_TEXT, 62)
      ELSE
        PICK_PATH = DOS.CALL_TEXT
      ENDIF
      SAY(2, 2, PICK_PATH)
      SAY(3, 2, "Files")
      SAY(3, 37, "Folders")
      FOLDERS = LIST(4, 37, "", $A000, PICK_BANK, 32, PICK_FOLDERS, @FOLDER, PICK_ROWS, 33, VALIDATE)
      FILES = LIST(4, 2, "", RECORD_AT(PICK_FOLDERS), PICK_BANK, 32, PICK_FILES, @CHOSEN, PICK_ROWS, 33, VALIDATE)
      ' The form made again takes the same control numbers, so the focus goes back where it was.
      IF RESULT = 0 THEN
        PUT_DIALOG(FIELD)
      ELSE
        NEXT_FOCUS = LEFT_FIELD
      ENDIF
      ' Tab and the other keys that leave a control let SHOW go on, unless PICK_HANDLER's key
      ' called DOS.
      DO
        RESULT = SHOW(DIALOG_FORM)
        IF RESULT <> EV_LEAVE OR LEFT_KEY = KEYS.ENTER THEN EXIT DO
        IF PICK_HANDLER <> 0 THEN
          ITEM = 0
          IF LEFT_FIELD = FOLDERS AND FOLDER <= PICK_DIRS THEN ITEM = FOLDER
          IF LEFT_FIELD = FILES AND CHOSEN <> 0 THEN ITEM = PICK_FOLDERS + CHOSEN
          ' The scan code is LEFT_KEY's high byte. ITEM then holds 1 when the key called DOS.
          ITEM = CALL PICK_HANDLER WITH (ContentsAt(@LEFT_KEY + 1), ITEM)
          IF ITEM <> 0 THEN EXIT DO
        ENDIF
      LOOP
      ' TAKEN is 1 for the file the field names, and 2 for the file chosen in the list. OK and
      ' Enter in the field take what the field holds, and OK on a mask with no folder the file
      ' chosen. Else the names are read again.
      TAKEN = 0
      IF RESULT = 1 OR (RESULT = EV_LEAVE AND LEFT_KEY = KEYS.ENTER AND LEFT_FIELD = FIELD) THEN
        IF TARGET$ = "" THEN TARGET$ = MASK$
        TAKEN = TAKE_TYPED(TARGET$, MASK$)
        IF RESULT = EV_LEAVE AND TAKEN = 2 THEN TAKEN = 0
      ELSEIF RESULT <> EV_LEAVE THEN
        EXIT DO
      ELSEIF LEFT_KEY = KEYS.ENTER THEN
        IF LEFT_FIELD = FILES THEN
          TAKEN = 2
        ELSE
          NAME_OF(FOLDER - 1)
          IF FOLDER > PICK_DIRS THEN
            ' The letter is the third character of [-A-].
            SET_PATH(ContentsAt(@DOS.FOUND_NAME + 4) - ASC("@"))
          ELSE
            DOS.CALL_TEXT = DOS.CALL_TEXT + DOS.FOUND_NAME + "\"
            TIDY_PATH()
          ENDIF
        ENDIF
      ENDIF
      IF TAKEN <> 0 THEN
        RESULT = EV_DONE
        EXIT DO
      ENDIF
      FREE(DIALOG_FORM)
    LOOP
    RESULT = SHUT_DIALOG(RESULT)
    IF TAKEN = 2 THEN
      RESULT = CHOSEN <> 0
      IF RESULT <> 0 THEN
        NAME_OF(PICK_FOLDERS + CHOSEN - 1)
        TARGET$ = DOS.CALL_TEXT + DOS.FOUND_NAME
      ENDIF
    ENDIF
    BANK.FREE(PICK_BANK)
    RETURN RESULT = 1
  END FUNCTION

  ' Shows PICKFILE's dialog with the keys of a file manager, and returns as PICKFILE does. Del,
  ' F2 and F5 in a list, and F7 in a list or the field, work as MANAGE runs them, and the names
  ' are read again after each that calls DOS.
  FUNCTION PICKMANAGE(TITLE$ AS CONST, MASK$ AS CONST, TARGET$) AS UBYTE
    DIM RESULT AS UBYTE
    PICK_HANDLER = @MANAGE
    RESULT = PICKFILE(TITLE$, MASK$, TARGET$)
    PICK_HANDLER = 0
    RETURN RESULT
  END FUNCTION
  ERRORS ON
END NAMESPACE
