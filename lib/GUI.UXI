' GUI.UXI: GUI Forms, the text-mode user interface library of 6502DOS's utilities.
'
' A program includes KEYS.UXI, then GUI.UXI. The code runs from region 1, a RAM bank of its
' own at $A000, and a SUB or FUNCTION adds bytes only when called.

#REGION_SLOT 1
NAMESPACE GUI
  ' INPUT2's mode: 0 inserts a typed character, 1 types over the character at the cursor.
  ' Insert switches it, and it holds from one call to the next.
  DIM OVERWRITE_MODE AS UBYTE

  ' The text INPUT2 started with, put back by Esc.
  DIM ORIGINAL$ * 255

  ' INPUT2's FLAGS, added together. PASSWORD shows each character as *. READ_ONLY lets the
  ' cursor move and the field end, but not the text change. UPPER and LOWER set the case of a
  ' typed letter. PROPER makes a typed letter upper case at the start of the text or after a
  ' space, and lower case elsewhere.
  CONST PASSWORD AS UBYTE = 1, READ_ONLY AS UBYTE = 2, UPPER AS UBYTE = 4, LOWER AS UBYTE = 8
  CONST PROPER AS UBYTE = 16

  ' The color roles of a theme, in the order of a theme's bytes. A color is the background
  ' times 16 plus the foreground, as DOS.SET_COLOR takes it.
  ENUM ROLE
    PAGE, FRAME, TITLE, TEXT, FIELD, FIELD_FOCUS, BUTTON, BUTTON_FOCUS
    HOT_KEY, DISABLED, MENU, MENU_SELECTED, STATUS
  END ENUM

  ' The themes THEME selects. FILE reads one from a file.
  ENUM THEMES
    DARK, LIGHT, GRAY, FILE
  END ENUM

  ' The current theme: one color a member of ROLE, in its order. It is empty until the first
  ' THEME or USE_COLOR.
  DIM COLORS$ * 13

  ' The built-in themes, one color a role. As background, foreground:
  ' DARK  0,0 0,11 0,1 0,15 15,0 7,0 15,0 7,0 0,2 0,12 6,1 7,0 6,1
  ' LIGHT 1,1 1,11 1,6 1,0 0,1 7,0 0,1 7,0 1,2 1,12 15,0 7,0 15,0
  ' GRAY  11,11 11,14 11,7 11,1 14,1 7,11 14,1 7,11 11,2 11,12 12,1 7,11 12,1
  CONST DARK_COLORS$ = !"\&h00\&h0B\&h01\&h0F\&hF0\&h70\&hF0\&h70\&h02\&h0C\&h61\&h70\&h61"
  CONST LIGHT_COLORS$ = !"\&h11\&h1B\&h16\&h10\&h01\&h70\&h01\&h70\&h12\&h1C\&hF0\&h70\&hF0"
  CONST GRAY_COLORS$ = !"\&hBB\&hBE\&hB7\&hB1\&hE1\&h7B\&hE1\&h7B\&hB2\&hBC\&hC1\&h7B\&hC1"

  ' The console color call.
  ' Checklist: tools/genapi.py writes the same address into lib/DOS.UXI as API_CON_COLOUR.
  ' Change this one when that one moves.
  CONST CON_COLOR_CALL AS UWORD = $03CA
  ' SYS loads A and P from these bytes before the call. DOS.UXI names them REG_A and REG_P.
  DIM CALL_A AS UBYTE AT $030C, CALL_P AS UBYTE AT $030F
  ' Edits TARGET$ in a field at ROW and COLUMN, counted from 0, WIDTH characters wide.
  ' TARGET$ takes at most its own size in characters. The text scrolls inside the field when it
  ' is longer than WIDTH. Left, Right, Home, End, Backspace, Delete and Insert edit. Enter, Tab,
  ' Esc and every other extended key end the edit, and INPUT2 returns that key as WAITKEY()
  ' gives it; KEYMODS() tells Shift+Tab from Tab. Esc puts back the text the field started
  ' with. The field is drawn again from its first character at the end, and the cursor is left
  ' after the field. FLAGS changes the field as the CONSTs above give.
  ' MASK$ fixes the field's length, at most TARGET$'s size. In the mask, # takes a digit, A a
  ' letter and X any character. TARGET$ is cut or padded to the mask's length. The padding is
  ' the mask's other characters, and a space where the mask takes a character. The cursor skips
  ' the mask's other characters. A masked field types over, and Delete and Backspace put a
  ' space. "(###)-###-####" is a phone number.
  ' Trap: a field that ends in the screen's last column moves the cursor to the next line.
  FUNCTION INPUT2(ROW AS UBYTE, COLUMN AS UBYTE, TARGET$, WIDTH AS UBYTE, MASK$ = "", FLAGS AS UBYTE = 0) AS UWORD
    DIM MOST AS UBYTE, CURSOR AS UBYTE, FIRST AS UBYTE, SHOWN AS UBYTE, TAIL AS UBYTE
    DIM ADDED AS UBYTE, CHANGE AS UBYTE, TYPED AS UBYTE
    DIM FIXED AS UBYTE, SPOT AS UBYTE, MASK_CHAR AS UBYTE, BACKWARD AS UBYTE
    DIM PRESSED AS UWORD, ENDING AS UWORD, MASK_AT AS UWORD, TEXT_AT AS UWORD
    MOST = ContentsAt(AddrOf(TARGET$))
    ORIGINAL$ = TARGET$
    CURSOR = LEN(TARGET$)
    FIRST = 0
    ENDING = 0
    BACKWARD = 0
    ' With no mask, MASK_CHAR stays X.
    MASK_CHAR = ASC("X")
    MASK_AT = AddrOf(MASK$) + 2
    TEXT_AT = AddrOf(TARGET$) + 2
    FIXED = LEN(MASK$)
    IF FIXED > MOST THEN FIXED = MOST
    SPOT = CURSOR
    DO WHILE SPOT < FIXED
      MASK_CHAR = ContentsAt(MASK_AT + SPOT)
      IF MASK_CHAR = ASC("#") OR MASK_CHAR = ASC("A") OR MASK_CHAR = ASC("X") THEN MASK_CHAR = 32
      ContentsAt(TEXT_AT + SPOT) = MASK_CHAR
      SPOT = SPOT + 1
    LOOP
    ' The length byte is before the characters.
    IF FIXED > 0 THEN ContentsAt(TEXT_AT - 1) = FIXED
    DO
      ' In a masked field the cursor moves off the mask's own characters: back after Left or
      ' Backspace while there is a character to type before it, else forward. BACKWARD is 1
      ' after Left and 2 after Backspace, and 2 still set below deletes at the cursor.
      DO WHILE CURSOR < FIXED
        MASK_CHAR = ContentsAt(MASK_AT + CURSOR)
        IF MASK_CHAR = ASC("#") OR MASK_CHAR = ASC("A") OR MASK_CHAR = ASC("X") THEN EXIT DO
        IF BACKWARD > 0 AND CURSOR > 0 THEN
          CURSOR = CURSOR - 1
        ELSE
          BACKWARD = 0
          CURSOR = CURSOR + 1
        ENDIF
      LOOP
      ' Scroll the text so that the cursor is inside the field, then draw the field.
      IF CURSOR < FIRST THEN FIRST = CURSOR
      IF CURSOR - FIRST >= WIDTH THEN FIRST = CURSOR - WIDTH + 1
      POS(1) = ROW
      POS(0) = COLUMN
      SHOWN = LEN(TARGET$) - FIRST
      IF SHOWN > WIDTH THEN SHOWN = WIDTH
      IF FLAGS AND PASSWORD THEN
        REPEAT SHOWN
          PRINT "*";
        END REPEAT
      ELSE
        PRINT MID$(TARGET$, FIRST + 1, SHOWN);
      ENDIF
      REPEAT WIDTH - SHOWN
        PRINT " ";
      END REPEAT
      IF ENDING <> 0 THEN RETURN ENDING
      POS(0) = COLUMN + CURSOR - FIRST
      PRESSED = KEYS.KEY_DELETE
      IF BACKWARD < 2 THEN PRESSED = WAITKEY()
      BACKWARD = 0
      ' Backspace moves left, then deletes once the cursor is off the mask's own characters.
      IF PRESSED = KEYS.BACKSPACE AND CURSOR > 0 THEN
        CURSOR = CURSOR - 1
        BACKWARD = 2
        CONTINUE
      ENDIF
      TAIL = LEN(TARGET$) - CURSOR
      SELECT CASE PRESSED
        CASE KEYS.KEY_LEFT
          IF CURSOR > 0 THEN CURSOR = CURSOR - 1
          BACKWARD = 1
        CASE KEYS.KEY_RIGHT
          IF TAIL > 0 THEN CURSOR = CURSOR + 1
        CASE KEYS.KEY_HOME
          CURSOR = 0
        CASE KEYS.KEY_END
          CURSOR = LEN(TARGET$)
        CASE KEYS.KEY_INSERT
          OVERWRITE_MODE = OVERWRITE_MODE XOR 1
        CASE KEYS.KEY_DELETE, 32 TO 255
          IF FLAGS AND READ_ONLY THEN CONTINUE
          ADDED = 0
          IF PRESSED < 256 THEN
            ADDED = 1
            CHANGE = FLAGS
            IF FLAGS AND PROPER THEN
              CHANGE = LOWER
              IF CURSOR = 0 OR ContentsAt(TEXT_AT + CURSOR - 1) = 32 THEN CHANGE = UPPER
            ENDIF
            ' A letter OR 32 is its lower case, 97 to 122.
            TYPED = PRESSED OR 32
            IF TYPED - 97 < 26 THEN
              IF CHANGE AND UPPER THEN PRESSED = TYPED - 32
              IF CHANGE AND LOWER THEN PRESSED = TYPED
            ENDIF
            IF MASK_CHAR = ASC("#") AND PRESSED - 48 >= 10 THEN CONTINUE
            IF MASK_CHAR = ASC("A") AND TYPED - 97 >= 26 THEN CONTINUE
          ENDIF
          IF FIXED > 0 THEN
            ' A masked field keeps its length: a character types over the one at the cursor,
            ' and Delete puts a space.
            IF TAIL = 0 THEN CONTINUE
            IF ADDED = 0 THEN PRESSED = 32
            ContentsAt(TEXT_AT + CURSOR) = PRESSED
            CURSOR = CURSOR + ADDED
            CONTINUE
          ENDIF
          ' One splice deletes the character at the cursor, types over it, or inserts one.
          ' ADDED is 0 for Delete and 1 for a character. ADDED <= OVERWRITE_MODE holds for
          ' Delete and for a character typed over another: both drop the character at the cursor.
          IF TAIL > 0 AND ADDED <= OVERWRITE_MODE THEN
            TAIL = TAIL - 1
          ELSEIF LEN(TARGET$) = MOST THEN
            CONTINUE
          ENDIF
          TARGET$ = LEFT$(TARGET$, CURSOR) + LEFT$(CHR$(PRESSED), ADDED) + RIGHT$(TARGET$, TAIL)
          CURSOR = CURSOR + ADDED
        CASE ELSE
          IF PRESSED > 255 OR PRESSED = KEYS.ENTER OR PRESSED = KEYS.TAB OR PRESSED = KEYS.ESC THEN
            IF PRESSED = KEYS.ESC THEN TARGET$ = ORIGINAL$
            ENDING = PRESSED
            CURSOR = 0
            ' The cursor stays at 0 for the last draw.
            FIXED = 0
          ENDIF
      END SELECT
    LOOP
  END FUNCTION

  ' Makes KIND the current theme. FILE reads up to 13 bytes from the file FILE_NAME$, one color
  ' a role in ROLE's order. A role past the file's end takes DARK's color, and so does every
  ' role when the file cannot be opened.
  SUB THEME(KIND AS ENUM.THEMES, FILE_NAME$ = "")
    DIM HANDLE AS UWORD, COUNT AS UWORD
    COLORS$ = DARK_COLORS$
    IF KIND = THEMES.LIGHT THEN COLORS$ = LIGHT_COLORS$
    IF KIND = THEMES.GRAY THEN COLORS$ = GRAY_COLORS$
    IF KIND = THEMES.FILE THEN
      HANDLE = OPEN(FILE_NAME$, O.READ)
      IF HANDLE <> NOFILE THEN
        COUNT = READ(HANDLE, @COLORS$ + 2, 13)
        CLOSE HANDLE
      ENDIF
    ENDIF
  END SUB

  ' Sets the console color to the current theme's color for WHICH, for the characters written
  ' from now on. Before the first THEME the theme is DARK.
  SUB USE_COLOR(WHICH AS ENUM.ROLE)
    IF LEN(COLORS$) = 0 THEN COLORS$ = DARK_COLORS$
    CALL_A = ContentsAt(@COLORS$ + 2 + WHICH)
    CALL_P = 0
    SYS CON_COLOR_CALL
  END SUB
END NAMESPACE
