' GUI.UXI: GUI Forms, the text-mode user interface library of 6502DOS's utilities.
'
' A program includes KEYS.UXI, VERA.UXI, then GUI.UXI. The code runs from region 1, a RAM bank
' of its own at $A000, a CBO's list, the menus and the dialogs from region 2, the lists from
' region 3, beside VERA.UXI, and the memo from region 4. A SUB or FUNCTION adds bytes only when
' called. A CBO's list, a menu and a dialog save the screen under them on VERA.UXI's stack, and
' put it back when they close.

#REGION_SLOT 1
NAMESPACE GUI
  ' INPUT2's mode: 0 inserts a typed character, 1 types over the character at the cursor.
  ' Insert switches it, and it holds from one call to the next.
  DIM OVERWRITE_MODE AS UBYTE

  ' The text INPUT2 started with, put back by Esc.
  DIM ORIGINAL$ * 255

  ' INPUT2's FLAGS, added together. PASSWORD shows each character as *. READ_ONLY lets the
  ' cursor move and the field end, but not the text change. UPPER and LOWER set the case of a
  ' typed letter. PROPER makes a typed letter upper case at the start of the text or after a
  ' space, and lower case elsewhere.
  CONST PASSWORD AS UBYTE = 1, READ_ONLY AS UBYTE = 2, UPPER AS UBYTE = 4, LOWER AS UBYTE = 8
  CONST PROPER AS UBYTE = 16
  ' GET's FLAGS add VALIDATE: SHOW returns EV_LEAVE when the user leaves the field. DRAW_ONLY
  ' makes INPUT2 draw the field from its first character and return DRAW_ONLY, with no key read.
  CONST VALIDATE AS UBYTE = 32, DRAW_ONLY AS UBYTE = 64

  ' The color roles of a theme, in the order of a theme's bytes. A color is the background
  ' times 16 plus the foreground, as DOS.SET_COLOR takes it.
  ENUM ROLE
    PAGE, FRAME, TITLE, TEXT, FIELD, FIELD_FOCUS, BUTTON, BUTTON_FOCUS
    HOT_KEY, DISABLED, MENU, MENU_SELECTED, STATUS
  END ENUM

  ' The built-in themes THEME selects.
  ENUM THEMES
    DARK, LIGHT, GRAY
  END ENUM

  ' The current theme: one color a member of ROLE, in its order. It is empty until the first
  ' THEME, THEME_FILE or USE_COLOR.
  DIM COLORS$ * 13

  ' The built-in themes, one color a role. As background, foreground:
  ' DARK  0,0 0,12 0,2 0,15 15,0 1,0 12,0 1,0 0,2 0,12 11,1 12,0 11,1
  ' LIGHT 1,1 1,11 1,6 1,0 15,0 12,1 6,12 6,1 1,14 1,12 15,0 6,1 6,1
  ' GRAY  11,0 14,0 14,0 14,1 15,0 1,0 11,1 1,0 0,2 14,12 12,1 14,1 12,0
  CONST DARK_COLORS$ = !"\&h00\&h0C\&h02\&h0F\&hF0\&h10\&hC0\&h10\&h02\&h0C\&hB1\&hC0\&hB1"
  CONST LIGHT_COLORS$ = !"\&h11\&h1B\&h16\&h10\&hF0\&hC1\&h6C\&h61\&h1E\&h1C\&hF0\&h61\&h61"
  CONST GRAY_COLORS$ = !"\&hB0\&hE0\&hE0\&hE1\&hF0\&h10\&hB1\&h10\&h02\&hEC\&hC1\&hE1\&hC0"

  ' The console color call.
  ' Checklist: tools/genapi.py writes the same address into lib/DOS.UXI as API_CON_COLOUR.
  ' Change this one when that one moves.
  CONST CON_COLOR_CALL AS UWORD = $03CA
  ' SYS loads A and P from these bytes before the call. DOS.UXI names them REG_A and REG_P.
  DIM CALL_A AS UBYTE AT $030C, CALL_P AS UBYTE AT $030F

  ' The line styles of BOX, HLINE and VLINE: CP437's single and double lines.
  ENUM LINES
    SINGLE, DOUBLE
  END ENUM
  ' The characters of the current style, set by PICK_LINES.
  DIM LINE_ACROSS AS UBYTE, LINE_DOWN AS UBYTE, LINE_TOP_LEFT AS UBYTE, LINE_TOP_RIGHT AS UBYTE
  DIM LINE_LOW_LEFT AS UBYTE, LINE_LOW_RIGHT AS UBYTE
  ' Where SPAN prints its next row, and the row's length.
  DIM SPAN_ROW AS UBYTE, SPAN_COLUMN AS UBYTE, SPAN_LENGTH AS UBYTE

  ' CREATEFORM's ROW or COLUMN that centers the form on the screen.
  CONST CENTER AS UBYTE = 255
  ' PLACE's ROW or COLUMN that lays the control out on the form's next automatic line.
  CONST AUTO AS UBYTE = 254
  ' The FLAGS of CREATEFORM and STARTSECTION. FRAMED draws a form in a box of double lines, and
  ' a section in a box of single lines. TWO_COL puts a section's automatic controls in two
  ' columns, left then right. NO_SHADOW leaves out a form's shadow; a section has none.
  CONST FRAMED AS UBYTE = 1, ONE_COL AS UBYTE = 0, TWO_COL AS UBYTE = 2, NO_SHADOW AS UBYTE = 4
  ' The forms and their sections, one panel each, 1 to MOST_PANELS. A form's handle is its
  ' panel. PANEL_OWNER is the form's handle, for the form and for each of its sections, and 0
  ' for a free panel; element 0 is never used. PANEL_TITLE_AT is the address of the caller's
  ' title string. PANEL_LAYOUT is a form's next automatic line, and a section's longest
  ' caption.
  ' Checklist: the arrays hold MOST_PANELS + 1 elements.
  CONST MOST_PANELS AS UBYTE = 12
  DIM PANEL_OWNER(13) AS UBYTE, PANEL_ROW(13) AS UBYTE, PANEL_COLUMN(13) AS UBYTE
  DIM PANEL_WIDTH(13) AS UBYTE, PANEL_HEIGHT(13) AS UBYTE, PANEL_FLAGS(13) AS UBYTE
  DIM PANEL_LAYOUT(13) AS UBYTE, PANEL_TITLE_AT(13) AS UWORD
  ' The form the controls go in, its open section or 0, and 1 when a TWO_COL section's next
  ' control goes in the right column.
  DIM CURRENT_FORM AS UBYTE, OPEN_SECTION AS UBYTE, LAYOUT_SIDE AS UBYTE
  ' Where PLACE put the control: its screen row and column, and its section, 0 for none.
  DIM PLACED_ROW AS UBYTE, PLACED_COLUMN AS UBYTE, PLACED_SECTION AS UBYTE
  ' The controls, 1 to MOST_CONTROLS. CONTROL_OWNER is the form's handle, and 0 for a free
  ' control; element 0 is never used. A form's controls take the focus in the order of their
  ' numbers, which is the order they were made in. CONTROL_ROW and CONTROL_COLUMN are the
  ' caption's place. CONTROL_WIDTH is the field's, and 0 for a SAY, which takes no focus.
  ' CONTROL_SECTION is the section whose captions the field lines up on, or 0. CONTROL_KIND is
  ' one of the KIND_ CONSTs below.
  ' CONTROL_LABEL_AT, CONTROL_TEXT_AT and CONTROL_MASK_AT are the addresses of the caller's
  ' caption, target and mask strings. For a CHECK, a RADIO or a CBO, CONTROL_TEXT_AT is the
  ' address of the caller's UBYTE, and CONTROL_MASK_AT of its choices. For a BUTTON, CONTROL_TEXT_AT is
  ' its id, and CONTROL_MASK_AT the address of its caption. For a MEMO, CONTROL_TEXT_AT is its
  ' height.
  ' Checklist: the arrays hold MOST_CONTROLS + 1 elements.
  CONST MOST_CONTROLS AS UBYTE = 48
  DIM CONTROL_OWNER(49) AS UBYTE, CONTROL_ROW(49) AS UBYTE, CONTROL_COLUMN(49) AS UBYTE
  DIM CONTROL_WIDTH(49) AS UBYTE, CONTROL_FLAGS(49) AS UBYTE, CONTROL_SECTION(49) AS UBYTE
  DIM CONTROL_KIND(49) AS UBYTE
  DIM CONTROL_LABEL_AT(49) AS UWORD, CONTROL_TEXT_AT(49) AS UWORD, CONTROL_MASK_AT(49) AS UWORD
  ' The kinds of control. A SAY is a KIND_FIELD of WIDTH 0.
  ' Checklist: KIND_EDITOR holds the last kind + 1 elements.
  CONST KIND_FIELD AS UBYTE = 0, KIND_CHECK AS UBYTE = 1, KIND_RADIO AS UBYTE = 2
  CONST KIND_BUTTON AS UBYTE = 3, KIND_CBO AS UBYTE = 4, KIND_MEMO AS UBYTE = 5
  CONST KIND_LIST AS UBYTE = 6
  ' A control's editor, which EDIT_FIELD calls with the column of CONTROL's field. With
  ' MORE_FLAGS DRAW_ONLY it draws the field and returns DRAW_ONLY. Else it edits the control and
  ' returns the key that ended the edit.
  DECLARE FUNCTION EDITOR(CONTROL AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
  ' The EDITOR of each kind, set by the routine that makes a control of that kind, so a program
  ' carries only the editors of the kinds it makes.
  DIM KIND_EDITOR(7) AS EDITOR
  ' LIST's FLAGS add LIST_MULTI: Space marks and unmarks the item under the focus.
  CONST LIST_MULTI AS UBYTE = 128
  ' SHOW's events. A button's id is below them.
  CONST EV_DONE AS UBYTE = 253, EV_LEAVE AS UBYTE = 254, EV_CANCEL AS UBYTE = 255
  ' A field and the memo show the cursor with CURSOR ON; the other controls hide it with
  ' CURSOR OFF.
  ' The form SHOW runs, 0 when the next SHOW starts a form afresh. The control SHOW gives the
  ' focus to next, 0 to return EV_DONE. The VALIDATE field of the last EV_LEAVE, and the key that
  ' left it. 1 while REFUSE's message is on the status line.
  DIM SHOWN_FORM AS UBYTE, NEXT_FOCUS AS UBYTE, LEFT_FIELD AS UBYTE, STATUS_SHOWN AS UBYTE
  DIM LEFT_KEY AS UWORD

  ' Edits TARGET$ in a field at ROW and COLUMN, counted from 0, WIDTH characters wide.
  ' TARGET$ takes at most its own size in characters. The text scrolls inside the field when it
  ' is longer than WIDTH. Left, Right, Home, End, Backspace, Delete and Insert edit. Enter, Tab,
  ' Esc and every other extended key end the edit, and INPUT2 returns that key as WAITKEY()
  ' gives it; KEYMODS() tells Shift+Tab from Tab. Esc puts back the text the field started
  ' with. The field is drawn again from its first character at the end, and the cursor is left
  ' after the field. FLAGS changes the field as the CONSTs above give.
  ' MASK$ fixes the field's length, at most TARGET$'s size. In the mask, # takes a digit, A a
  ' letter and X any character. TARGET$ is cut or padded to the mask's length. The padding is
  ' the mask's other characters, and a space where the mask takes a character. The cursor starts
  ' at the end of the text, or at the start when the text fills the mask, and skips the mask's
  ' other characters. A masked field types over, and Delete and Backspace put a
  ' space. "(###)-###-####" is a phone number.
  ' Trap: a field that ends in the screen's last column moves the cursor to the next line.
  FUNCTION INPUT2(ROW AS UBYTE, COLUMN AS UBYTE, TARGET$, WIDTH AS UBYTE, MASK$ AS CONST = "", FLAGS AS UBYTE = 0) AS UWORD
    DIM MOST AS UBYTE, CURSOR AS UBYTE, FIRST AS UBYTE, SHOWN AS UBYTE, TAIL AS UBYTE
    DIM ADDED AS UBYTE, CHANGE AS UBYTE, TYPED AS UBYTE
    DIM FIXED AS UBYTE, SPOT AS UBYTE, MASK_CHAR AS UBYTE, BACKWARD AS UBYTE
    DIM PRESSED AS UWORD, ENDING AS UWORD, MASK_AT AS UWORD, TEXT_AT AS UWORD
    MOST = ContentsAt(AddrOf(TARGET$))
    ORIGINAL$ = TARGET$
    CURSOR = LEN(TARGET$)
    FIRST = 0
    ' DRAW_ONLY ends INPUT2 after the first draw.
    ENDING = FLAGS AND DRAW_ONLY
    BACKWARD = 0
    ' With no mask, MASK_CHAR stays X.
    MASK_CHAR = ASC("X")
    MASK_AT = AddrOf(MASK$) + 2
    TEXT_AT = AddrOf(TARGET$) + 2
    FIXED = LEN(MASK$)
    IF FIXED > MOST THEN FIXED = MOST
    SPOT = CURSOR
    DO WHILE SPOT < FIXED
      MASK_CHAR = ContentsAt(MASK_AT + SPOT)
      IF MASK_CHAR = ASC("#") OR MASK_CHAR = ASC("A") OR MASK_CHAR = ASC("X") THEN MASK_CHAR = 32
      ContentsAt(TEXT_AT + SPOT) = MASK_CHAR
      SPOT = SPOT + 1
    LOOP
    IF FIXED > 0 THEN
      ' The length byte is before the characters.
      ContentsAt(TEXT_AT - 1) = FIXED
      ' Nothing types at the end of a full masked field, as SHOW leaves one.
      IF CURSOR >= FIXED THEN CURSOR = 0
    ENDIF
    IF ENDING <> 0 THEN
      CURSOR = 0
      FIXED = 0
    ENDIF
    DO
      ' In a masked field the cursor moves off the mask's own characters: back after Left or
      ' Backspace while there is a character to type before it, else forward. BACKWARD is 1
      ' after Left and 2 after Backspace, and 2 still set below deletes at the cursor.
      DO WHILE CURSOR < FIXED
        MASK_CHAR = ContentsAt(MASK_AT + CURSOR)
        IF MASK_CHAR = ASC("#") OR MASK_CHAR = ASC("A") OR MASK_CHAR = ASC("X") THEN EXIT DO
        IF BACKWARD > 0 AND CURSOR > 0 THEN
          CURSOR = CURSOR - 1
        ELSE
          BACKWARD = 0
          CURSOR = CURSOR + 1
        ENDIF
      LOOP
      ' Scroll the text so that the cursor is inside the field, then draw the field.
      IF CURSOR < FIRST THEN FIRST = CURSOR
      IF CURSOR - FIRST >= WIDTH THEN FIRST = CURSOR - WIDTH + 1
      POS(1) = ROW
      POS(0) = COLUMN
      SHOWN = LEN(TARGET$) - FIRST
      IF SHOWN > WIDTH THEN SHOWN = WIDTH
      IF FLAGS AND PASSWORD THEN
        REPEAT SHOWN
          PRINT "*";
        END REPEAT
      ELSE
        PRINT MID$(TARGET$, FIRST + 1, SHOWN);
      ENDIF
      REPEAT WIDTH - SHOWN
        PRINT " ";
      END REPEAT
      IF ENDING <> 0 THEN RETURN ENDING
      POS(0) = COLUMN + CURSOR - FIRST
      CURSOR ON
      PRESSED = KEYS.KEY_DELETE
      IF BACKWARD < 2 THEN PRESSED = WAITKEY()
      BACKWARD = 0
      ' Backspace moves left, then deletes once the cursor is off the mask's own characters.
      IF PRESSED = KEYS.BACKSPACE AND CURSOR > 0 THEN
        CURSOR = CURSOR - 1
        BACKWARD = 2
        CONTINUE
      ENDIF
      TAIL = LEN(TARGET$) - CURSOR
      SELECT CASE PRESSED
        CASE KEYS.KEY_LEFT
          IF CURSOR > 0 THEN CURSOR = CURSOR - 1
          BACKWARD = 1
        CASE KEYS.KEY_RIGHT
          IF TAIL > 0 THEN CURSOR = CURSOR + 1
        CASE KEYS.KEY_HOME
          CURSOR = 0
        CASE KEYS.KEY_END
          CURSOR = LEN(TARGET$)
        CASE KEYS.KEY_INSERT
          OVERWRITE_MODE = OVERWRITE_MODE XOR 1
        CASE KEYS.KEY_DELETE, 32 TO 255
          IF FLAGS AND READ_ONLY THEN CONTINUE
          ADDED = 0
          IF PRESSED < 256 THEN
            ADDED = 1
            CHANGE = FLAGS
            IF FLAGS AND PROPER THEN
              CHANGE = LOWER
              IF CURSOR = 0 OR ContentsAt(TEXT_AT + CURSOR - 1) = 32 THEN CHANGE = UPPER
            ENDIF
            ' A letter OR 32 is its lower case, 97 to 122.
            TYPED = PRESSED OR 32
            IF TYPED - 97 < 26 THEN
              IF CHANGE AND UPPER THEN PRESSED = TYPED - 32
              IF CHANGE AND LOWER THEN PRESSED = TYPED
            ENDIF
            IF MASK_CHAR = ASC("#") AND PRESSED - 48 >= 10 THEN CONTINUE
            IF MASK_CHAR = ASC("A") AND TYPED - 97 >= 26 THEN CONTINUE
          ENDIF
          IF FIXED > 0 THEN
            ' A masked field keeps its length: a character types over the one at the cursor,
            ' and Delete puts a space.
            IF TAIL = 0 THEN CONTINUE
            IF ADDED = 0 THEN PRESSED = 32
            ContentsAt(TEXT_AT + CURSOR) = PRESSED
            CURSOR = CURSOR + ADDED
            CONTINUE
          ENDIF
          ' One splice deletes the character at the cursor, types over it, or inserts one.
          ' ADDED is 0 for Delete and 1 for a character. ADDED <= OVERWRITE_MODE holds for
          ' Delete and for a character typed over another: both drop the character at the cursor.
          IF TAIL > 0 AND ADDED <= OVERWRITE_MODE THEN
            TAIL = TAIL - 1
          ELSEIF LEN(TARGET$) = MOST THEN
            CONTINUE
          ENDIF
          TARGET$ = LEFT$(TARGET$, CURSOR) + LEFT$(CHR$(PRESSED), ADDED) + RIGHT$(TARGET$, TAIL)
          CURSOR = CURSOR + ADDED
        CASE ELSE
          IF PRESSED > 255 OR PRESSED = KEYS.ENTER OR PRESSED = KEYS.TAB OR PRESSED = KEYS.ESC THEN
            IF PRESSED = KEYS.ESC THEN TARGET$ = ORIGINAL$
            ENDING = PRESSED
            CURSOR = 0
            ' The cursor stays at 0 for the last draw.
            FIXED = 0
          ENDIF
      END SELECT
    LOOP
  END FUNCTION

  ' Makes the built-in theme KIND the current theme.
  SUB THEME(KIND AS ENUM.THEMES)
    COLORS$ = DARK_COLORS$
    IF KIND = THEMES.LIGHT THEN COLORS$ = LIGHT_COLORS$
    IF KIND = THEMES.GRAY THEN COLORS$ = GRAY_COLORS$
  END SUB

  ' Makes the theme in the file FILE_NAME$ the current theme. The file holds up to 13 bytes,
  ' one color a role in ROLE's order. A role past the file's end takes DARK's color, and so
  ' does every role when the file cannot be opened.
  SUB THEME_FILE(FILE_NAME$)
    DIM HANDLE AS UWORD, COUNT AS UWORD
    COLORS$ = DARK_COLORS$
    HANDLE = OPEN(FILE_NAME$, O.READ)
    IF HANDLE <> NOFILE THEN
      COUNT = READ(HANDLE, @COLORS$ + 2, 13)
      CLOSE HANDLE
    ENDIF
  END SUB

  ' Sets the console color to the current theme's color for WHICH, for the characters written
  ' from now on. Before the first THEME the theme is DARK.
  SUB USE_COLOR(WHICH AS ENUM.ROLE)
    IF LEN(COLORS$) = 0 THEN COLORS$ = DARK_COLORS$
    CALL_A = ContentsAt(@COLORS$ + 2 + WHICH)
    CALL_P = 0
    SYS CON_COLOR_CALL
  END SUB

  ' Puts the CP437 characters of STYLE's lines in the LINE_ variables.
  SUB PICK_LINES(STYLE AS ENUM.LINES)
    LINE_ACROSS = 196
    LINE_DOWN = 179
    LINE_TOP_LEFT = 218
    LINE_TOP_RIGHT = 191
    LINE_LOW_LEFT = 192
    LINE_LOW_RIGHT = 217
    IF STYLE = LINES.DOUBLE THEN
      LINE_ACROSS = 205
      LINE_DOWN = 186
      LINE_TOP_LEFT = 201
      LINE_TOP_RIGHT = 187
      LINE_LOW_LEFT = 200
      LINE_LOW_RIGHT = 188
    ENDIF
  END SUB

  ' Prints SPAN_LENGTH characters at SPAN_ROW and SPAN_COLUMN: OPENING, then FILLER, then
  ' CLOSING as the last. SPAN_LENGTH is at least 2. SPAN_ROW moves down a row.
  SUB SPAN(OPENING AS UBYTE, FILLER AS UBYTE, CLOSING AS UBYTE)
    POS(1) = SPAN_ROW
    POS(0) = SPAN_COLUMN
    SPAN_ROW = SPAN_ROW + 1
    PRINT CHR$(OPENING);
    REPEAT SPAN_LENGTH - 2
      PRINT CHR$(FILLER);
    END REPEAT
    PRINT CHR$(CLOSING);
  END SUB

  ' Draws a box of STYLE's lines, WIDTH columns by HEIGHT rows, its top left corner at ROW and
  ' COLUMN, counted from 0. The inside is cleared to spaces. WIDTH and HEIGHT are at least 2.
  ' The box takes the current console color.
  ' Trap: a box that ends in the screen's last column moves the cursor to the next line, and on
  ' the last row that scrolls the screen.
  SUB BOX(ROW AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, HEIGHT AS UBYTE, STYLE AS ENUM.LINES = SINGLE)
    PICK_LINES(STYLE)
    SPAN_ROW = ROW
    SPAN_COLUMN = COLUMN
    SPAN_LENGTH = WIDTH
    SPAN(LINE_TOP_LEFT, LINE_ACROSS, LINE_TOP_RIGHT)
    REPEAT HEIGHT - 2
      SPAN(LINE_DOWN, 32, LINE_DOWN)
    END REPEAT
    SPAN(LINE_LOW_LEFT, LINE_ACROSS, LINE_LOW_RIGHT)
  END SUB

  ' Draws a line of STYLE across, LENGTH columns from ROW and COLUMN. LENGTH is at least 2.
  SUB HLINE(ROW AS UBYTE, COLUMN AS UBYTE, LENGTH AS UBYTE, STYLE AS ENUM.LINES = SINGLE)
    PICK_LINES(STYLE)
    SPAN_ROW = ROW
    SPAN_COLUMN = COLUMN
    SPAN_LENGTH = LENGTH
    SPAN(LINE_ACROSS, LINE_ACROSS, LINE_ACROSS)
  END SUB

  ' Draws a line of STYLE down, LENGTH rows from ROW and COLUMN.
  SUB VLINE(ROW AS UBYTE, COLUMN AS UBYTE, LENGTH AS UBYTE, STYLE AS ENUM.LINES = SINGLE)
    PICK_LINES(STYLE)
    REPEAT LENGTH
      POS(1) = ROW
      POS(0) = COLUMN
      PRINT CHR$(LINE_DOWN);
      ROW = ROW + 1
    END REPEAT
  END SUB

  ' Returns the gap before SIZE that centers it in SPACE.
  FUNCTION HALF_GAP(SPACE AS UBYTE, SIZE AS UBYTE) AS UBYTE
    RETURN (SPACE - SIZE) / 2
  END FUNCTION

  ' The forms' handles are not checked: a handle is one that CREATEFORM returned, or 0.
  ERRORS OFF

  ' Takes a free panel and fills it. Its owner is CURRENT_FORM, or the panel itself when
  ' CURRENT_FORM is 0, and CURRENT_FORM is then that owner. Returns the panel, or 0 when
  ' MOST_PANELS panels are in use.
  FUNCTION NEW_PANEL(TITLE_AT AS UWORD, ROW AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, HEIGHT AS UBYTE, FLAGS AS UBYTE) AS UBYTE
    DIM PANEL AS UBYTE
    PANEL = MOST_PANELS
    DO WHILE PANEL_OWNER(PANEL) <> 0
      PANEL = PANEL - 1
    LOOP
    IF PANEL = 0 THEN RETURN 0
    IF CURRENT_FORM = 0 THEN CURRENT_FORM = PANEL
    PANEL_OWNER(PANEL) = CURRENT_FORM
    PANEL_ROW(PANEL) = ROW
    PANEL_COLUMN(PANEL) = COLUMN
    PANEL_WIDTH(PANEL) = WIDTH
    PANEL_HEIGHT(PANEL) = HEIGHT
    PANEL_FLAGS(PANEL) = FLAGS
    PANEL_LAYOUT(PANEL) = 0
    PANEL_TITLE_AT(PANEL) = TITLE_AT
    RETURN PANEL
  END FUNCTION

  ' Ends the open section: its height runs to the form's next automatic line, which moves below
  ' the section. With no section open it does nothing.
  SUB ENDSECTION()
    DIM SECTION AS UBYTE, BELOW AS UBYTE
    SECTION = OPEN_SECTION
    IF SECTION = 0 THEN RETURN
    ' FRAMED is 1: a framed section takes a row for its bottom line.
    BELOW = PANEL_LAYOUT(CURRENT_FORM) + LAYOUT_SIDE + (PANEL_FLAGS(SECTION) AND FRAMED)
    PANEL_LAYOUT(CURRENT_FORM) = BELOW
    PANEL_HEIGHT(SECTION) = BELOW - PANEL_ROW(SECTION)
    OPEN_SECTION = 0
    LAYOUT_SIDE = 0
  END SUB

  ' Makes a form WIDTH columns by HEIGHT rows, its top left corner at ROW and COLUMN, counted
  ' from 0, and returns its handle. CENTER as ROW or COLUMN centers the form on the screen.
  ' FLAGS changes the form as the CONSTs above give. WIDTH is at least 6 and HEIGHT at least 2.
  ' The form keeps the address of TITLE$, not a copy. A section still open is ended first, and
  ' the controls laid out from now on go in the new form. CREATEFORM returns 0 when
  ' MOST_PANELS panels are in use.
  FUNCTION CREATEFORM(TITLE$ AS CONST, ROW AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, HEIGHT AS UBYTE, FLAGS AS UBYTE = 0) AS UBYTE
    DIM HANDLE AS UBYTE
    ENDSECTION()
    IF ROW = CENTER THEN ROW = HALF_GAP(POS(2), HEIGHT)
    IF COLUMN = CENTER THEN COLUMN = HALF_GAP(POS(3), WIDTH)
    CURRENT_FORM = 0
    HANDLE = NEW_PANEL(AddrOf(TITLE$), ROW, COLUMN, WIDTH, HEIGHT, FLAGS)
    PANEL_LAYOUT(HANDLE) = ROW + 1
    RETURN HANDLE
  END FUNCTION

  ' Frees the form HANDLE, its sections and its controls for the next CREATEFORM and GET. A
  ' handle of 0 does nothing. The next SHOW starts its form afresh, its focus on its first
  ' control.
  SUB FREE(HANDLE AS UBYTE)
    DIM PANEL AS UBYTE
    PANEL = MOST_PANELS
    REPEAT MOST_PANELS
      IF PANEL_OWNER(PANEL) = HANDLE THEN PANEL_OWNER(PANEL) = 0
      PANEL = PANEL - 1
    END REPEAT
    PANEL = MOST_CONTROLS
    REPEAT MOST_CONTROLS
      IF CONTROL_OWNER(PANEL) = HANDLE THEN CONTROL_OWNER(PANEL) = 0
      PANEL = PANEL - 1
    END REPEAT
    SHOWN_FORM = 0
    NEXT_FOCUS = 0
  END SUB

  ' Opens a section in the form HANDLE, on the form's next automatic line, 1 column in from each
  ' side of the form. Its top row holds the title, and the controls laid out with AUTO until
  ' ENDSECTION go below it. FLAGS changes the section as the CONSTs above give. A section still
  ' open is ended first. The section keeps the address of TITLE$, as CREATEFORM does. With
  ' MOST_PANELS panels in use, no section opens, and the controls go on the form's lines.
  SUB STARTSECTION(HANDLE AS UBYTE, TITLE$ AS CONST, FLAGS AS UBYTE = 0)
    DIM TOP AS UBYTE
    ENDSECTION()
    CURRENT_FORM = HANDLE
    TOP = PANEL_LAYOUT(HANDLE)
    OPEN_SECTION = NEW_PANEL(AddrOf(TITLE$), TOP, PANEL_COLUMN(HANDLE) + 1, PANEL_WIDTH(HANDLE) - 2, 1, FLAGS)
    PANEL_LAYOUT(HANDLE) = TOP + 1
  END SUB

  ' Lays out a control of the current form whose caption is CAPTION_LENGTH characters, and puts
  ' the place in PLACED_ROW, PLACED_COLUMN and PLACED_SECTION. ROW and COLUMN count from the
  ' form's top left corner. AUTO as ROW takes the form's next automatic line and moves it down.
  ' AUTO as COLUMN takes the column 3 in from the form's edge, or in a TWO_COL section that
  ' column and the form's middle in turn; the control is then the open section's, and its
  ' caption counts toward the section's longest. A control with another column has no section.
  SUB PLACE(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION_LENGTH AS UBYTE)
    DIM FORM AS UBYTE, SECTION AS UBYTE
    FORM = CURRENT_FORM
    SECTION = OPEN_SECTION
    PLACED_SECTION = 0
    IF COLUMN = AUTO THEN
      PLACED_SECTION = SECTION
      COLUMN = 3
      IF LAYOUT_SIDE <> 0 THEN COLUMN = PANEL_WIDTH(FORM) / 2
      ' With no section open this sets element 0, which nothing reads.
      IF CAPTION_LENGTH > PANEL_LAYOUT(SECTION) THEN PANEL_LAYOUT(SECTION) = CAPTION_LENGTH
    ENDIF
    PLACED_COLUMN = PANEL_COLUMN(FORM) + COLUMN
    IF ROW = AUTO THEN
      PLACED_ROW = PANEL_LAYOUT(FORM)
      IF PANEL_FLAGS(SECTION) AND TWO_COL THEN LAYOUT_SIDE = LAYOUT_SIDE XOR 1
      IF LAYOUT_SIDE = 0 THEN PANEL_LAYOUT(FORM) = PLACED_ROW + 1
    ELSE
      PLACED_ROW = PANEL_ROW(FORM) + ROW
    ENDIF
  END SUB

  ' Draws PANEL: when FRAMED, its box in the theme's FRAME color, of double lines for a form and
  ' single lines for a section; else its area cleared in the PAGE color. Then its title, between
  ' spaces, centered on its top row in the TITLE color. A title too long for the row is cut. An
  ' empty title draws nothing.
  SUB DRAW_PANEL(PANEL AS UBYTE)
    DIM TITLE_AT AS UWORD, SHOWN AS UBYTE, SPOT AS UBYTE, TOP AS UBYTE, STYLE AS ENUM.LINES
    TOP = PANEL_ROW(PANEL)
    SPAN_ROW = TOP
    SPAN_COLUMN = PANEL_COLUMN(PANEL)
    SPAN_LENGTH = PANEL_WIDTH(PANEL)
    SPOT = PANEL_HEIGHT(PANEL)
    IF PANEL_FLAGS(PANEL) AND FRAMED THEN
      USE_COLOR(FRAME)
      STYLE = LINES.SINGLE
      IF PANEL_OWNER(PANEL) = PANEL THEN STYLE = LINES.DOUBLE
      BOX(TOP, SPAN_COLUMN, SPAN_LENGTH, SPOT, STYLE)
    ELSE
      USE_COLOR(PAGE)
      REPEAT SPOT
        SPAN(32, 32, 32)
      END REPEAT
    ENDIF
    ' The string's length byte is at +1, its characters from +2.
    TITLE_AT = PANEL_TITLE_AT(PANEL)
    SHOWN = ContentsAt(TITLE_AT + 1)
    SPOT = SPAN_LENGTH - 4
    IF SHOWN > SPOT THEN SHOWN = SPOT
    IF SHOWN > 0 THEN
      USE_COLOR(TITLE)
      POS(1) = TOP
      POS(0) = SPAN_COLUMN + HALF_GAP(SPAN_LENGTH, SHOWN + 2)
      PRINT " ";
      SPOT = 2
      REPEAT SHOWN
        PRINT CHR$(ContentsAt(TITLE_AT + SPOT));
        SPOT = SPOT + 1
      END REPEAT
      PRINT " ";
    ENDIF
  END SUB

  ' Draws the form HANDLE and its shadow, unless its FLAGS hold NO_SHADOW, then its sections,
  ' each as DRAW_PANEL draws it.
  SUB DRAW_FORM(HANDLE AS UBYTE)
    DIM PANEL AS UBYTE
    IF (PANEL_FLAGS(HANDLE) AND NO_SHADOW) = 0 THEN DRAW_SHADOW(HANDLE)
    DRAW_PANEL(HANDLE)
    PANEL = MOST_PANELS
    REPEAT MOST_PANELS
      IF PANEL_OWNER(PANEL) = HANDLE AND PANEL <> HANDLE THEN DRAW_PANEL(PANEL)
      PANEL = PANEL - 1
    END REPEAT
  END SUB

  ' Returns the first control after FROM, counted in DIRECTION, 1 or 255, whose owner is HANDLE
  ' and that takes the focus. The count wraps from MOST_CONTROLS to 1 and from 1 to
  ' MOST_CONTROLS, and ends at FROM. Returns 0 when there is none. FROM is 0 for the first, and
  ' HANDLE 0 for a free control.
  FUNCTION NEXT_CONTROL(HANDLE AS UBYTE, FROM AS UBYTE, DIRECTION AS UBYTE) AS UBYTE
    REPEAT MOST_CONTROLS
      FROM = FROM + DIRECTION
      IF FROM = 0 THEN FROM = MOST_CONTROLS
      IF FROM > MOST_CONTROLS THEN FROM = 1
      IF CONTROL_OWNER(FROM) = HANDLE THEN
        IF HANDLE = 0 OR CONTROL_WIDTH(FROM) <> 0 THEN RETURN FROM
      ENDIF
    END REPEAT
    RETURN 0
  END FUNCTION

  ' Makes a field of the current form with the caption CAPTION$ before it, and returns its
  ' control number. The field edits TARGET$ with INPUT2, WIDTH characters wide. ROW and COLUMN
  ' place the caption as PLACE does. The field starts a space after the caption; in a section,
  ' with AUTO as COLUMN, a space after the section's longest caption. MASK$ and FLAGS are
  ' INPUT2's, and FLAGS may add VALIDATE. The form keeps the addresses of CAPTION$, TARGET$ and
  ' MASK$, not copies. SAYGET returns 0 when MOST_CONTROLS controls are in use. A WIDTH of 0
  ' makes a SAY.
  FUNCTION SAYGET(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, TARGET$, WIDTH AS UBYTE, MASK$ AS CONST = "", FLAGS AS UBYTE = 0) AS UBYTE
    DIM CONTROL AS UBYTE, LENGTH AS UBYTE
    CONTROL = NEXT_CONTROL(0, 0, 1)
    IF CONTROL = 0 THEN RETURN 0
    ' A SAY's caption does not move the section's fields.
    LENGTH = 0
    IF WIDTH <> 0 THEN LENGTH = LEN(CAPTION$)
    PLACE(ROW, COLUMN, LENGTH)
    CONTROL_OWNER(CONTROL) = CURRENT_FORM
    CONTROL_ROW(CONTROL) = PLACED_ROW
    CONTROL_COLUMN(CONTROL) = PLACED_COLUMN
    CONTROL_SECTION(CONTROL) = PLACED_SECTION
    CONTROL_WIDTH(CONTROL) = WIDTH
    CONTROL_FLAGS(CONTROL) = FLAGS
    CONTROL_KIND(CONTROL) = KIND_FIELD
    KIND_EDITOR(KIND_FIELD) = @EDIT_TEXT
    CONTROL_LABEL_AT(CONTROL) = AddrOf(CAPTION$)
    CONTROL_TEXT_AT(CONTROL) = AddrOf(TARGET$)
    CONTROL_MASK_AT(CONTROL) = AddrOf(MASK$)
    RETURN CONTROL
  END FUNCTION

  ' SAYGET with no caption.
  FUNCTION GET(ROW AS UBYTE, COLUMN AS UBYTE, TARGET$, WIDTH AS UBYTE, MASK$ AS CONST = "", FLAGS AS UBYTE = 0) AS UBYTE
    RETURN SAYGET(ROW, COLUMN, "", TARGET$, WIDTH, MASK$, FLAGS)
  END FUNCTION

  ' Makes a caption of the current form, CAPTION$ with no field, and returns its control
  ' number, as SAYGET does. It takes no focus.
  FUNCTION SAY(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST) AS UBYTE
    ' ORIGINAL$ stands in for the target, which a SAY never edits.
    RETURN SAYGET(ROW, COLUMN, CAPTION$, ORIGINAL$, 0)
  END FUNCTION

  ' Makes CONTROL, made by SAYGET, of KIND, edited by HANDLER, with the choice in the UBYTE at
  ' VALUE_AT. Returns CONTROL. A CONTROL of 0 sets element 0, which nothing reads.
  FUNCTION MAKE_CHOICE(CONTROL AS UBYTE, VALUE_AT AS UWORD, KIND AS UBYTE, HANDLER AS EDITOR) AS UBYTE
    CONTROL_TEXT_AT(CONTROL) = VALUE_AT
    CONTROL_KIND(CONTROL) = KIND
    KIND_EDITOR(KIND) = HANDLER
    RETURN CONTROL
  END FUNCTION

  ' Makes a check box of the current form, [X] or [ ] with CAPTION$ after it, and returns its
  ' control number, as SAYGET does. The UBYTE at VALUE_AT is 1 when checked and 0 when clear;
  ' pass it as @NAME. ROW and COLUMN place the box as SAYGET places a field with no caption.
  ' FLAGS may be VALIDATE. Space, Left and Right check and clear it.
  FUNCTION CHECK(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, VALUE_AT AS UWORD, FLAGS AS UBYTE = 0) AS UBYTE
    DIM CONTROL AS UBYTE
    CONTROL = SAYGET(ROW, COLUMN, "", ORIGINAL$, 1, CAPTION$, FLAGS)
    RETURN MAKE_CHOICE(CONTROL, VALUE_AT, KIND_CHECK, @PICK_CHOICE)
  END FUNCTION

  ' Makes a set of radio buttons of the current form with the caption CAPTION$ before it, and
  ' returns its control number, as SAYGET does. CHOICES$ holds the choices with | between
  ' them: "Red|Green|Blue" draws (*) Red ( ) Green ( ) Blue. The UBYTE at VALUE_AT is the
  ' chosen one, 0 for the first; pass it as @NAME. ROW, COLUMN and FLAGS are SAYGET's, and the
  ' choices start where SAYGET's field would. Space and Right choose the next, wrapping to the
  ' first, and Left the one before, wrapping to the last. The form keeps the address of
  ' CHOICES$, not a copy.
  FUNCTION RADIO(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, CHOICES$ AS CONST, VALUE_AT AS UWORD, FLAGS AS UBYTE = 0) AS UBYTE
    DIM CONTROL AS UBYTE
    CONTROL = SAYGET(ROW, COLUMN, CAPTION$, ORIGINAL$, 1, CHOICES$, FLAGS)
    RETURN MAKE_CHOICE(CONTROL, VALUE_AT, KIND_RADIO, @PICK_CHOICE)
  END FUNCTION

  ' Makes a button of the current form, < CAPTION$ >, and returns its control number, as SAYGET
  ' does. Enter on the button, or its hot key from any control of the form, makes SHOW return
  ' ID, which is below EV_DONE; the next SHOW gives the button the focus. An & in CAPTION$ marks
  ' the letter after it, and Alt with that letter is the hot key: "&Save" draws < Save >, its S
  ' in the HOT_KEY color, and Alt+S presses it. ROW and COLUMN place the button as SAYGET
  ' places a field with no caption. The form keeps the address of CAPTION$, not a copy.
  FUNCTION BUTTON(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, ID AS UBYTE) AS UBYTE
    DIM CONTROL AS UBYTE
    CONTROL = SAYGET(ROW, COLUMN, "", ORIGINAL$, 1, CAPTION$)
    RETURN MAKE_CHOICE(CONTROL, ID, KIND_BUTTON, @PUSH_BUTTON)
  END FUNCTION

  ' Makes a combo box of the current form, a field WIDTH columns wide with a list that drops
  ' down, and returns its control number, as SAYGET does. CHOICES$ holds the choices with |
  ' between them, as RADIO's does. The UBYTE at VALUE_AT is the chosen one, 0 for the first;
  ' pass it as @NAME. The field shows the choice and a down arrow in its last column. Space
  ' opens the list, and the form is drawn again when it closes. ROW, COLUMN, CAPTION$ and
  ' FLAGS are SAYGET's. The form keeps the address of CHOICES$, not a copy.
  FUNCTION CBO(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, CHOICES$ AS CONST, VALUE_AT AS UWORD, WIDTH AS UBYTE, FLAGS AS UBYTE = 0) AS UBYTE
    DIM CONTROL AS UBYTE
    CONTROL = SAYGET(ROW, COLUMN, CAPTION$, ORIGINAL$, WIDTH, CHOICES$, FLAGS)
    RETURN MAKE_CHOICE(CONTROL, VALUE_AT, KIND_CBO, @EDIT_CBO)
  END FUNCTION

  ' Makes a memo of the current form, a field of lines WIDTH columns by HEIGHT rows with the
  ' caption CAPTION$ before its first row, and returns its control number, as SAYGET does. The
  ' memo edits the text that MEMO_LOAD reads, MEMO_SAVE writes and MEMO_CLEAR empties: one text
  ' a program, at most MEMO_SIZE bytes. In the memo Enter starts a new line and Up and Down
  ' move through the text; Tab, Shift+Tab and Esc leave it. Esc does not put the text back. A
  ' memo on the screen shows text MEMO_LOAD or MEMO_CLEAR changed when it next takes the focus.
  ' ROW, COLUMN and FLAGS are SAYGET's. With AUTO as ROW, the form's next automatic line is
  ' below the memo.
  FUNCTION MEMO(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, WIDTH AS UBYTE, HEIGHT AS UBYTE, FLAGS AS UBYTE = 0) AS UBYTE
    DIM CONTROL AS UBYTE
    CONTROL = TALL_FIELD(ROW, COLUMN, CAPTION$, WIDTH, HEIGHT, FLAGS)
    RETURN MAKE_CHOICE(CONTROL, HEIGHT, KIND_MEMO, @EDIT_MEMO)
  END FUNCTION

  ' Makes a field of the current form, WIDTH columns by HEIGHT rows, for MEMO and LIST, and
  ' returns its control number, as SAYGET does. With AUTO as ROW, the form's next automatic
  ' line is below the field.
  FUNCTION TALL_FIELD(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, WIDTH AS UBYTE, HEIGHT AS UBYTE, FLAGS AS UBYTE) AS UBYTE
    DIM CONTROL AS UBYTE
    CONTROL = SAYGET(ROW, COLUMN, CAPTION$, ORIGINAL$, WIDTH, "", FLAGS)
    IF ROW = AUTO THEN PANEL_LAYOUT(CURRENT_FORM) = PANEL_LAYOUT(CURRENT_FORM) + HEIGHT - 1
    RETURN CONTROL
  END FUNCTION

  ' Returns the list slot of CONTROL when it is a LIST in use, else 0.
  FUNCTION LIST_SLOT_OF(CONTROL AS UBYTE) AS UBYTE
    IF CONTROL_OWNER(CONTROL) <> 0 AND CONTROL_KIND(CONTROL) = KIND_LIST THEN RETURN CONTROL_TEXT_AT(CONTROL)
    RETURN 0
  END FUNCTION

  ' Returns the screen column of CONTROL's field, as SAYGET gives it.
  FUNCTION FIELD_COLUMN(CONTROL AS UBYTE) AS UBYTE
    DIM GAP AS UBYTE, SECTION AS UBYTE
    ' The caption's length byte is at +1.
    GAP = ContentsAt(CONTROL_LABEL_AT(CONTROL) + 1)
    SECTION = CONTROL_SECTION(CONTROL)
    IF SECTION <> 0 THEN GAP = PANEL_LAYOUT(SECTION)
    IF GAP <> 0 THEN GAP = GAP + 1
    RETURN CONTROL_COLUMN(CONTROL) + GAP
  END FUNCTION

  ' Draws the choices of CONTROL, a CHECK or a RADIO, from COLUMN. With MORE_FLAGS DRAW_ONLY it
  ' returns DRAW_ONLY. Else it changes the choice by the keys CHECK and RADIO give, and returns
  ' any other key.
  FUNCTION PICK_CHOICE(CONTROL AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    DIM VALUE_AT AS UWORD, CHOICES_AT AS UWORD, PRESSED AS UWORD
    DIM VALUE AS UBYTE, FIRST AS UBYTE, ITEM AS UBYTE, SPOT AS UBYTE
    DIM CHARACTER AS UBYTE, OPENING AS UBYTE, CLOSING AS UBYTE, CHOSEN AS UBYTE, MARK AS UBYTE
    DIM CURSOR AS UBYTE
    VALUE_AT = CONTROL_TEXT_AT(CONTROL)
    CHOICES_AT = CONTROL_MASK_AT(CONTROL)
    ' A RADIO's choices count from 0, and a CHECK's one choice is 1: the choice whose number is
    ' the UBYTE is marked, and the UBYTE runs from 0 to the last number.
    FIRST = 0
    OPENING = ASC("(")
    CLOSING = ASC(")")
    CHOSEN = ASC("*")
    IF CONTROL_KIND(CONTROL) = KIND_CHECK THEN
      FIRST = 1
      OPENING = ASC("[")
      CLOSING = ASC("]")
      CHOSEN = ASC("X")
    ENDIF
    DO
      VALUE = ContentsAt(VALUE_AT)
      POS(1) = CONTROL_ROW(CONTROL)
      POS(0) = COLUMN
      CURSOR = COLUMN + 1
      ' The loop takes a | before the first character, which starts the first choice.
      ITEM = FIRST - 1
      CHARACTER = ASC("|")
      SPOT = 2
      REPEAT ContentsAt(CHOICES_AT + 1) + 1
        IF CHARACTER = ASC("|") THEN
          ITEM = ITEM + 1
          IF ITEM <> FIRST THEN PRINT " ";
          MARK = 32
          IF ITEM = VALUE THEN
            MARK = CHOSEN
            CURSOR = POS(0) + 1
          ENDIF
          PRINT CHR$(OPENING); CHR$(MARK); CHR$(CLOSING); " ";
        ELSE
          PRINT CHR$(CHARACTER);
        ENDIF
        CHARACTER = ContentsAt(CHOICES_AT + SPOT)
        SPOT = SPOT + 1
      END REPEAT
      IF MORE_FLAGS <> 0 THEN RETURN MORE_FLAGS
      POS(0) = CURSOR
      CURSOR OFF
      PRESSED = WAITKEY()
      ' ITEM is the last choice's number, so adding ITEM + 1 wraps to the same choice, and
      ' adding ITEM to the choice before.
      IF PRESSED = KEYS.KEY_LEFT THEN VALUE = VALUE + ITEM
      IF PRESSED = 32 OR PRESSED = KEYS.KEY_RIGHT THEN VALUE = VALUE + 1
      IF VALUE = ContentsAt(VALUE_AT) THEN RETURN PRESSED
      IF VALUE > ITEM THEN VALUE = VALUE - ITEM - 1
      ContentsAt(VALUE_AT) = VALUE
    LOOP
  END FUNCTION

  ' PRINT_HOT runs from region 2, beside the menus. It reads the theme, so COLORS$ is in low RAM.
#REGION_SLOT 2
  ' Prints the caption at CAPTION_AT in WHICH's color, which is the console's color. The & is
  ' not printed, and the letter after it takes WHICH's background and the HOT_KEY color's
  ' foreground. Returns that letter in lower case with bit 7 set, or 0 for a caption with no &.
  FUNCTION PRINT_HOT(CAPTION_AT AS UWORD, WHICH AS ENUM.ROLE) AS UBYTE
    DIM HOT AS UBYTE, LETTER AS UBYTE, CHARACTER AS UBYTE, SPOT AS UBYTE
    HOT = (ContentsAt(@COLORS$ + 2 + WHICH) AND $F0) OR (ContentsAt(@COLORS$ + 2 + ROLE.HOT_KEY) AND 15)
    LETTER = 0
    SPOT = 2
    REPEAT ContentsAt(CAPTION_AT + 1)
      CHARACTER = ContentsAt(CAPTION_AT + SPOT)
      SPOT = SPOT + 1
      IF CHARACTER = ASC("&") THEN
        LETTER = ContentsAt(CAPTION_AT + SPOT) OR $A0
        CALL_A = HOT
        CALL_P = 0
        SYS CON_COLOR_CALL
      ELSE
        PRINT CHR$(CHARACTER);
        USE_COLOR(WHICH)
      ENDIF
    END REPEAT
    RETURN LETTER
  END FUNCTION

  ' Returns the letter of PRESSED, as WAITKEY() gives it, when it is Alt with a letter: in lower
  ' case with bit 7 set, as PRINT_HOT returns a hot letter. Returns 0 for any other key.
  ' LETTERS$ is the letter of each Alt+letter key, from scan code $10; the console gives no Alt
  ' key at a -.
  FUNCTION ALT_LETTER(PRESSED AS UWORD, LETTERS$ AS CONST = "qwertyuiop----asdfghjkl-----zxcvbnm") AS UBYTE
    DIM SPOT AS UBYTE
    ' The scan code is the high byte. A plain key's is 0, which wraps past 34.
    SPOT = ContentsAt(@PRESSED + 1) - $10
    IF SPOT > 34 THEN RETURN 0
    RETURN ContentsAt(AddrOf(LETTERS$) + 2 + SPOT) OR $A0
  END FUNCTION
#REGION_SLOT 1

  ' Draws CONTROL, a BUTTON, at COLUMN in the BUTTON_FOCUS color, or the BUTTON color when
  ' MORE_FLAGS is DRAW_ONLY. The caption is printed as PRINT_HOT prints it. With MORE_FLAGS
  ' DRAW_ONLY it returns DRAW_ONLY; else it returns the next key.
  FUNCTION PUSH_BUTTON(CONTROL AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    DIM WHICH AS ENUM.ROLE, LETTER AS UBYTE
    WHICH = ROLE.BUTTON_FOCUS
    IF MORE_FLAGS <> 0 THEN WHICH = ROLE.BUTTON
    USE_COLOR(WHICH)
    POS(1) = CONTROL_ROW(CONTROL)
    POS(0) = COLUMN
    PRINT "< ";
    LETTER = PRINT_HOT(CONTROL_MASK_AT(CONTROL), WHICH)
    IF LETTER <> 0 THEN CONTROL_WIDTH(CONTROL) = LETTER
    PRINT " >";
    IF MORE_FLAGS <> 0 THEN RETURN MORE_FLAGS
    POS(0) = COLUMN + 2
    CURSOR OFF
    RETURN WAITKEY()
  END FUNCTION

  ' Returns the button of the form HANDLE whose hot key is PRESSED, as WAITKEY() gives it, or 0.
  ' The form is drawn.
  FUNCTION HOT_BUTTON(HANDLE AS UBYTE, PRESSED AS UWORD) AS UBYTE
    DIM CONTROL AS UBYTE, LETTER AS UBYTE
    LETTER = ALT_LETTER(PRESSED)
    IF LETTER = 0 THEN RETURN 0
    ' PUSH_BUTTON keeps a button's hot letter in its CONTROL_WIDTH, as PRINT_HOT returns it.
    ' A field is never that wide.
    CONTROL = MOST_CONTROLS
    REPEAT MOST_CONTROLS
      IF CONTROL_OWNER(CONTROL) = HANDLE AND CONTROL_WIDTH(CONTROL) = LETTER THEN RETURN CONTROL
      CONTROL = CONTROL - 1
    END REPEAT
    RETURN 0
  END FUNCTION

#REGION_SLOT 2
  ' The shadow runs from region 2. Its code names the forms' places and sizes, so those tables
  ' are in low RAM.

  ' Draws the shadow of the form HANDLE in black on black: 2 columns down its right side from
  ' its second row, and the row under it from its third column. The shadow is trimmed at the
  ' screen's edges, and leaves out the screen's last cell, whose print scrolls the screen.
  SUB DRAW_SHADOW(HANDLE AS UBYTE)
    DIM ROW AS UBYTE, COLUMN AS UBYTE, RIGHT AS UBYTE, BOTTOM AS UBYTE, LIMIT AS UBYTE
    CALL_A = 0
    CALL_P = 0
    SYS CON_COLOR_CALL
    ROW = PANEL_ROW(HANDLE)
    BOTTOM = ROW + PANEL_HEIGHT(HANDLE)
    RIGHT = PANEL_COLUMN(HANDLE) + PANEL_WIDTH(HANDLE) + 1
    LIMIT = POS(3)
    REPEAT PANEL_HEIGHT(HANDLE)
      ROW = ROW + 1
      COLUMN = RIGHT - 1
      IF ROW = BOTTOM THEN COLUMN = PANEL_COLUMN(HANDLE) + 2
      IF ROW >= POS(2) THEN RETURN
      IF ROW + 1 = POS(2) THEN LIMIT = LIMIT - 1
      DO WHILE COLUMN <= RIGHT AND COLUMN < LIMIT
        POS(1) = ROW
        POS(0) = COLUMN
        PRINT " ";
        COLUMN = COLUMN + 1
      LOOP
    END REPEAT
  END SUB

  ' The drop-down list runs from region 2. It reaches the form's tables only through its
  ' parameters, so the tables stay in region 1.
  ' Prints choice NUMBER of the choices at CHOICES_AT, cut or padded with spaces to WIDTH
  ' characters, and returns the last choice's number.
  FUNCTION PRINT_ITEM(CHOICES_AT AS UWORD, NUMBER AS UBYTE, WIDTH AS UBYTE) AS UBYTE
    DIM ITEM AS UBYTE, SPOT AS UBYTE, CHARACTER AS UBYTE
    ITEM = 0
    SPOT = 2
    REPEAT ContentsAt(CHOICES_AT + 1)
      CHARACTER = ContentsAt(CHOICES_AT + SPOT)
      SPOT = SPOT + 1
      IF CHARACTER = ASC("|") THEN
        ITEM = ITEM + 1
      ELSEIF ITEM = NUMBER AND WIDTH <> 0 THEN
        PRINT CHR$(CHARACTER);
        WIDTH = WIDTH - 1
      ENDIF
    END REPEAT
    REPEAT WIDTH
      PRINT " ";
    END REPEAT
    RETURN ITEM
  END FUNCTION

  ' Draws a CBO's field, WIDTH columns at ROW and COLUMN: the chosen one of the choices at
  ' CHOICES_AT, then a down arrow. The UBYTE at VALUE_AT is the choice, 0 for the first. With
  ' MORE_FLAGS DRAW_ONLY it returns DRAW_ONLY. Else Space or Enter opens the list under the
  ' field: Up and Down move through it, wrapping, Enter chooses and Esc leaves the choice as it
  ' was; the screen under the list is put back, and DROP_LIST returns 0, a key SHOW skips. It
  ' returns any other key. When VERA.SAVE_RECT has no room, the list is cleared in its place, and
  ' SHOWN_FORM is set to 0 for SHOW to draw the form again.
  ' Trap: the list takes the rows from ROW + 1 to ROW + 2 + the number of choices, and the
  ' columns from COLUMN - 1 to COLUMN + WIDTH. It does not scroll.
  FUNCTION DROP_LIST(ROW AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, CHOICES_AT AS UWORD, VALUE_AT AS UWORD, MORE_FLAGS AS UBYTE) AS UWORD
    DIM PRESSED AS UWORD, VALUE AS UBYTE, LAST AS UBYTE, ITEM AS UBYTE, SAVED AS UBYTE
    POS(1) = ROW
    POS(0) = COLUMN
    VALUE = ContentsAt(VALUE_AT)
    LAST = PRINT_ITEM(CHOICES_AT, VALUE, WIDTH - 1)
    PRINT CHR$(31);
    IF MORE_FLAGS <> 0 THEN RETURN MORE_FLAGS
    POS(0) = COLUMN
    CURSOR OFF
    PRESSED = WAITKEY()
    IF PRESSED <> KEYS.SPACE AND PRESSED <> KEYS.ENTER THEN RETURN PRESSED
    SAVED = VERA.SAVE_RECT(ROW + 1, COLUMN - 1, WIDTH + 2, LAST + 3)
    USE_COLOR(MENU)
    BOX(ROW + 1, COLUMN - 1, WIDTH + 2, LAST + 3)
    DO
      ITEM = 0
      REPEAT LAST + 1
        USE_COLOR(MENU)
        IF ITEM = VALUE THEN USE_COLOR(MENU_SELECTED)
        POS(1) = ROW + 2 + ITEM
        POS(0) = COLUMN
        PRINT_ITEM(CHOICES_AT, ITEM, WIDTH)
        ITEM = ITEM + 1
      END REPEAT
      POS(1) = ROW + 2 + VALUE
      POS(0) = COLUMN
      PRESSED = WAITKEY()
      ' LAST is the last choice's number, so adding LAST + 1 wraps to the same choice, and
      ' adding LAST to the choice before.
      IF PRESSED = KEYS.KEY_UP THEN VALUE = VALUE + LAST
      IF PRESSED = KEYS.KEY_DOWN THEN VALUE = VALUE + 1
      IF VALUE > LAST THEN VALUE = VALUE - LAST - 1
    LOOP UNTIL PRESSED = KEYS.ENTER OR PRESSED = KEYS.ESC
    IF PRESSED = KEYS.ENTER THEN ContentsAt(VALUE_AT) = VALUE
    IF SAVED THEN
      VERA.RESTORE_RECT()
    ELSE
      ' Each theme's PAGE color has the same foreground as background, so the box clears.
      USE_COLOR(PAGE)
      BOX(ROW + 1, COLUMN - 1, WIDTH + 2, LAST + 3)
      SHOWN_FORM = 0
    ENDIF
    RETURN 0
  END FUNCTION

  ' The memo runs from region 4, with its text.
#REGION_SLOT 4
  ' The memo's text: the bytes from MEMO_TEXT up to MEMO_END, in region 4's bank past the
  ' region's code and data. A line ends in LF. MEMO_CURSOR is the cursor's address in the text,
  ' MEMO_TOP the address of the line on the memo's top row, and MEMO_LEFT the first column
  ' shown. MEMO_END is 0 until the first MEMO_CLEAR.
  ' Trap: region 4's code and data must end below MEMO_TEXT, 6144 bytes. The compile's REGION 4
  ' line gives their size.
  ' Trap: a read that fills $BFFF returns with the next RAM bank selected, and the region's code
  ' is gone. The text stops at $BFFE.
  CONST MEMO_TEXT AS UWORD = $B800, MEMO_SIZE AS UWORD = 2047
  DIM MEMO_END AS UWORD, MEMO_CURSOR AS UWORD, MEMO_TOP AS UWORD, MEMO_LEFT AS UWORD
  ' MEMO_LOAD's and MEMO_SAVE's results but 0.
  CONST MEMO_MISSING AS UBYTE = 1, MEMO_CUT AS UBYTE = 2

  ' Returns the address of the start of the memo's line that holds address AT.
  FUNCTION LINE_START(AT AS UWORD) AS UWORD
    DO WHILE AT > MEMO_TEXT
      IF ContentsAt(AT - 1) = 10 THEN EXIT DO
      AT = AT - 1
    LOOP
    RETURN AT
  END FUNCTION

  ' Returns the address of the LF that ends the memo's line that holds address AT, or MEMO_END
  ' for the last line. An AT past MEMO_END is returned as it is.
  FUNCTION LINE_END(AT AS UWORD) AS UWORD
    DO WHILE AT < MEMO_END
      IF ContentsAt(AT) = 10 THEN EXIT DO
      AT = AT + 1
    LOOP
    RETURN AT
  END FUNCTION

  ' Puts the memo's cursor in the line that starts at START, COLUMN in, or at the line's end
  ' when the line is shorter.
  SUB CURSOR_TO(START AS UWORD, COLUMN AS UWORD)
    MEMO_CURSOR = LINE_END(START)
    IF START + COLUMN < MEMO_CURSOR THEN MEMO_CURSOR = START + COLUMN
  END SUB

  ' Draws the memo, WIDTH columns by HEIGHT rows from ROW and COLUMN, scrolled down and across
  ' so that the cursor shows. A character below 32 shows as a space. With MORE_FLAGS DRAW_ONLY
  ' it returns DRAW_ONLY. Else a character or Enter inserts at the cursor, Backspace and Delete
  ' delete, and Left, Right, Up, Down, Home, End, PgUp and PgDn move the cursor; Left and Right
  ' go on across the line's end. A full memo takes no more. It returns any other key.
  FUNCTION MEMO_EDIT(ROW AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, HEIGHT AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    DIM PRESSED AS UWORD, START AS UWORD, SPOT AS UWORD, FINISH AS UWORD, CURSOR_COLUMN AS UWORD
    DIM DRAWN_ROW AS UBYTE, CURSOR_ROW AS UBYTE, CHARACTER AS UBYTE, STEPS AS UBYTE, SCAN AS UBYTE
    IF MEMO_END = 0 THEN MEMO_CLEAR()
    DO
      ' Scroll the cursor's line, from START, into the memo's rows, and its column into WIDTH.
      START = LINE_START(MEMO_CURSOR)
      CURSOR_COLUMN = MEMO_CURSOR - START
      IF START < MEMO_TOP THEN MEMO_TOP = START
      SPOT = START
      REPEAT HEIGHT - 1
        IF SPOT > MEMO_TOP THEN SPOT = LINE_START(SPOT - 1)
      END REPEAT
      IF SPOT > MEMO_TOP THEN MEMO_TOP = SPOT
      IF CURSOR_COLUMN < MEMO_LEFT THEN MEMO_LEFT = CURSOR_COLUMN
      IF CURSOR_COLUMN - MEMO_LEFT >= WIDTH THEN MEMO_LEFT = CURSOR_COLUMN - WIDTH + 1
      ' Each row draws a line from MEMO_TOP on. Past the text's end SPOT runs on, and a row is
      ' spaces.
      SPOT = MEMO_TOP
      DRAWN_ROW = ROW
      REPEAT HEIGHT
        IF SPOT = START THEN CURSOR_ROW = DRAWN_ROW
        POS(1) = DRAWN_ROW
        POS(0) = COLUMN
        DRAWN_ROW = DRAWN_ROW + 1
        FINISH = LINE_END(SPOT)
        SPOT = SPOT + MEMO_LEFT
        REPEAT WIDTH
          CHARACTER = ContentsAt(SPOT)
          IF SPOT >= FINISH OR CHARACTER < 32 THEN CHARACTER = 32
          PRINT CHR$(CHARACTER);
          SPOT = SPOT + 1
        END REPEAT
        SPOT = FINISH + 1
      END REPEAT
      IF MORE_FLAGS <> 0 THEN RETURN MORE_FLAGS
      POS(1) = CURSOR_ROW
      POS(0) = COLUMN + CURSOR_COLUMN - MEMO_LEFT
      CURSOR ON
      PRESSED = WAITKEY()
      ' The scan code is the high byte, 0 for a plain key. PgUp and PgDn are Up and Down + 1.
      CHARACTER = PRESSED
      SCAN = ContentsAt(@PRESSED + 1)
      STEPS = 1
      IF SCAN = KEYS.SCAN_PGUP OR SCAN = KEYS.SCAN_PGDN THEN
        SCAN = SCAN - 1
        STEPS = HEIGHT
      ENDIF
      SELECT CASE SCAN
        CASE KEYS.SCAN_LEFT
          IF MEMO_CURSOR > MEMO_TEXT THEN MEMO_CURSOR = MEMO_CURSOR - 1
        CASE KEYS.SCAN_RIGHT
          IF MEMO_CURSOR < MEMO_END THEN MEMO_CURSOR = MEMO_CURSOR + 1
        CASE KEYS.SCAN_HOME
          MEMO_CURSOR = START
        CASE KEYS.SCAN_END
          MEMO_CURSOR = LINE_END(START)
        CASE KEYS.SCAN_UP
          REPEAT STEPS
            IF START > MEMO_TEXT THEN START = LINE_START(START - 1)
          END REPEAT
          CURSOR_TO(START, CURSOR_COLUMN)
        CASE KEYS.SCAN_DOWN
          REPEAT STEPS
            FINISH = LINE_END(START)
            IF FINISH < MEMO_END THEN START = FINISH + 1
          END REPEAT
          CURSOR_TO(START, CURSOR_COLUMN)
        CASE KEYS.SCAN_DELETE, 0
          ' Backspace is a Delete after Left.
          IF CHARACTER = KEYS.BACKSPACE THEN
            IF MEMO_CURSOR = MEMO_TEXT THEN CONTINUE
            MEMO_CURSOR = MEMO_CURSOR - 1
            SCAN = KEYS.SCAN_DELETE
          ENDIF
          IF SCAN <> 0 THEN
            IF MEMO_CURSOR = MEMO_END THEN CONTINUE
            MEMO_END = MEMO_END - 1
            SPOT = MEMO_CURSOR
            DO WHILE SPOT < MEMO_END
              ContentsAt(SPOT) = ContentsAt(SPOT + 1)
              SPOT = SPOT + 1
            LOOP
            CONTINUE
          ENDIF
          IF CHARACTER = KEYS.ENTER THEN
            CHARACTER = 10
          ELSEIF CHARACTER < 32 THEN
            RETURN PRESSED
          ENDIF
          IF MEMO_END = MEMO_TEXT + MEMO_SIZE THEN CONTINUE
          SPOT = MEMO_END
          DO WHILE SPOT > MEMO_CURSOR
            ContentsAt(SPOT) = ContentsAt(SPOT - 1)
            SPOT = SPOT - 1
          LOOP
          ContentsAt(SPOT) = CHARACTER
          MEMO_END = MEMO_END + 1
          MEMO_CURSOR = MEMO_CURSOR + 1
        CASE ELSE
          RETURN PRESSED
      END SELECT
    LOOP
  END FUNCTION

  ' Empties the memo and puts its cursor at the start.
  SUB MEMO_CLEAR()
    MEMO_END = MEMO_TEXT
    MEMO_CURSOR = MEMO_TEXT
    MEMO_TOP = MEMO_TEXT
    MEMO_LEFT = 0
  END SUB

  ' Reads the file FILE_NAME$ into the memo, each CR dropped, and puts the cursor at the start.
  ' Returns 0; MEMO_MISSING when the file does not open, and the memo is then empty; or MEMO_CUT
  ' when the file is longer than MEMO_SIZE bytes, and the memo then holds the first MEMO_SIZE.
  FUNCTION MEMO_LOAD(FILE_NAME$ AS CONST) AS UBYTE
    DIM HANDLE AS UWORD, SPOT AS UWORD, FINISH AS UWORD, CHARACTER AS UBYTE, RESULT AS UBYTE
    MEMO_CLEAR()
    HANDLE = OPEN(FILE_NAME$, O.READ)
    IF HANDLE = NOFILE THEN RETURN MEMO_MISSING
    FINISH = MEMO_TEXT + READ(HANDLE, MEMO_TEXT, MEMO_SIZE)
    RESULT = 0
    IF READ(HANDLE, @CHARACTER, 1) <> 0 THEN RESULT = MEMO_CUT
    CLOSE HANDLE
    SPOT = MEMO_TEXT
    DO WHILE SPOT < FINISH
      CHARACTER = ContentsAt(SPOT)
      IF CHARACTER <> 13 THEN
        ContentsAt(MEMO_END) = CHARACTER
        MEMO_END = MEMO_END + 1
      ENDIF
      SPOT = SPOT + 1
    LOOP
    RETURN RESULT
  END FUNCTION

  ' Writes the memo's text to the file FILE_NAME$, made or emptied first, each line ending in
  ' LF. Returns 0, or MEMO_MISSING when the file does not open.
  FUNCTION MEMO_SAVE(FILE_NAME$ AS CONST) AS UBYTE
    DIM HANDLE AS UWORD
    IF MEMO_END = 0 THEN MEMO_CLEAR()
    HANDLE = OPEN(FILE_NAME$, O.WRITE)
    IF HANDLE = NOFILE THEN RETURN MEMO_MISSING
    WRITE HANDLE, MEMO_TEXT, MEMO_END - MEMO_TEXT
    CLOSE HANDLE
    RETURN 0
  END FUNCTION

#REGION_SLOT 2
  ' The menu bar. MENU_FORM is the form that shows it, 0 for none. The menus are 1 to
  ' MENU_COUNT: MENU_TITLE_AT is the address of a menu's title, and MENU_FIRST its first item;
  ' a menu's items run up to the next menu's first. DRAW_BAR puts a menu's column on the bar in
  ' MENU_COLUMN, and its hot letter, as PRINT_HOT returns it, in MENU_HOT. The items are 1 to
  ' ITEM_COUNT: ITEM_CAPTION_AT is the address of an item's caption, and ITEM_ID its id.
  ' Checklist: the MENU_ arrays hold MOST_MENUS + 2 elements, and the ITEM_ arrays MOST_ITEMS + 1.
  CONST MOST_MENUS AS UBYTE = 8, MOST_ITEMS AS UBYTE = 40
  DIM MENU_FORM AS UBYTE, MENU_COUNT AS UBYTE, ITEM_COUNT AS UBYTE
  DIM MENU_TITLE_AT(10) AS UWORD, MENU_FIRST(10) AS UBYTE, MENU_COLUMN(10) AS UBYTE
  DIM MENU_HOT(10) AS UBYTE
  DIM ITEM_CAPTION_AT(41) AS UWORD, ITEM_ID(41) AS UBYTE
  ' The menu bar's handler, which SHOW calls with each key a control returns, and DRAW_WHOLE
  ' with DRAW_MENU_BAR. MENUBAR sets RUN_MENU to PULL_MENU, so a program with no MENUBAR carries
  ' no menu code. RUN_MENU is 0 until the first MENUBAR.
  DECLARE FUNCTION MENU_HANDLER(HANDLE AS UBYTE, PRESSED AS UWORD) AS UBYTE
  DIM RUN_MENU AS MENU_HANDLER
  CONST DRAW_MENU_BAR AS UWORD = $FFFF

  ' Gives the form HANDLE an empty menu bar on the screen's top row, and takes it from the form
  ' that had it. MENUBAR(0) takes the bar away. The menus made from now on go on the bar. SHOW
  ' draws the bar after the form.
  ' Trap: FREE leaves the bar to the handle, and the next form made may take that handle.
  SUB MENUBAR(HANDLE AS UBYTE)
    RUN_MENU = @PULL_MENU
    MENU_FORM = HANDLE
    MENU_COUNT = 0
    ITEM_COUNT = 0
    MENU_FIRST(1) = 1
  END SUB

  ' Adds a menu titled TITLE$ to the bar, after the menus before it. The & marks its hot letter,
  ' as in "&File". The items made from now on go in it, up to ENDMENU. The bar keeps the address
  ' of TITLE$, not a copy. Past MOST_MENUS menus BEGINMENU does nothing, and the items go in the
  ' last menu.
  SUB BEGINMENU(TITLE$ AS CONST)
    IF MENU_COUNT = MOST_MENUS THEN RETURN
    MENU_COUNT = MENU_COUNT + 1
    MENU_TITLE_AT(MENU_COUNT) = AddrOf(TITLE$)
  END SUB

  ' Adds the item CAPTION$ to the menu BEGINMENU opened, after the items before it. Choosing the
  ' item makes SHOW return ID, as a button's id; ID is 1 to 252. The & marks its hot letter. The menu keeps the
  ' address of CAPTION$, not a copy. Past MOST_ITEMS items MENUITEM does nothing.
  SUB MENUITEM(CAPTION$ AS CONST, ID AS UBYTE)
    IF ITEM_COUNT = MOST_ITEMS THEN RETURN
    ITEM_COUNT = ITEM_COUNT + 1
    ITEM_CAPTION_AT(ITEM_COUNT) = AddrOf(CAPTION$)
    ITEM_ID(ITEM_COUNT) = ID
  END SUB

  ' Ends the menu BEGINMENU opened.
  SUB ENDMENU()
    MENU_FIRST(MENU_COUNT + 1) = ITEM_COUNT + 1
  END SUB

  ' Prints menu NUMBER's title at the cursor in WHICH's color, between spaces, as PRINT_HOT
  ' prints it, and returns its hot letter.
  FUNCTION DRAW_TITLE(NUMBER AS UBYTE, WHICH AS ENUM.ROLE) AS UBYTE
    DIM LETTER AS UBYTE
    USE_COLOR(WHICH)
    PRINT " ";
    LETTER = PRINT_HOT(MENU_TITLE_AT(NUMBER), WHICH)
    PRINT " ";
    RETURN LETTER
  END FUNCTION

  ' Draws the menu bar: the screen's top row in the MENU color, and each menu's title from
  ' column 2, as DRAW_TITLE prints it.
  SUB DRAW_BAR()
    DIM NUMBER AS UBYTE
    USE_COLOR(ROLE.MENU)
    POS(1) = 0
    POS(0) = 0
    REPEAT POS(3)
      PRINT " ";
    END REPEAT
    POS(1) = 0
    POS(0) = 1
    NUMBER = 1
    REPEAT MENU_COUNT
      MENU_COLUMN(NUMBER) = POS(0)
      MENU_HOT(NUMBER) = DRAW_TITLE(NUMBER, ROLE.MENU)
      NUMBER = NUMBER + 1
    END REPEAT
  END SUB

  ' Opens a menu of the bar of the form HANDLE when PRESSED, as WAITKEY() gives it, is F10 or
  ' Alt with a menu's hot letter; F10 opens the first menu. Returns 0 at once for any other key.
  ' The open menu's title takes the MENU_SELECTED color, and its items drop down under it in a
  ' box, the selected item in MENU_SELECTED. Up and Down move through the items, wrapping, and
  ' Left and Right open the menu before or after, wrapping. Enter, or an item's hot letter,
  ' chooses the item; Esc closes the menu. Then the screen under the menu is put back, its title
  ' drawn again, and PULL_MENU returns the item's id, or 0 after Esc. When VERA.SAVE_RECT has no
  ' room, the menu is cleared in its place, and SHOWN_FORM is set to 0 for SHOW to draw the form
  ' again. With DRAW_MENU_BAR as
  ' PRESSED it draws the bar, as DRAW_BAR draws it, and returns 0. It is the MENU_HANDLER.
  ' Trap: a menu takes the rows from 1 to 2 + its number of items, and does not scroll. A menu
  ' needs one item at least.
  FUNCTION PULL_MENU(HANDLE AS UBYTE, PRESSED AS UWORD) AS UBYTE
    DIM NUMBER AS UBYTE, LETTER AS UBYTE, FIRST AS UBYTE, LAST AS UBYTE, ITEM AS UBYTE
    DIM SPOT AS UBYTE, CHOSEN AS UBYTE, COLUMN AS UBYTE, WIDTH AS UBYTE, WHICH AS ENUM.ROLE
    DIM COUNT AS UBYTE, LENGTH AS UBYTE, SAVED AS UBYTE
    IF HANDLE <> MENU_FORM THEN RETURN 0
    IF PRESSED = DRAW_MENU_BAR THEN
      DRAW_BAR()
      RETURN 0
    ENDIF
    NUMBER = 0
    IF PRESSED = KEYS.KEY_F10 THEN NUMBER = 1
    LETTER = ALT_LETTER(PRESSED)
    SPOT = MENU_COUNT
    REPEAT MENU_COUNT
      IF LETTER <> 0 AND MENU_HOT(SPOT) = LETTER THEN NUMBER = SPOT
      SPOT = SPOT - 1
    END REPEAT
    IF NUMBER = 0 OR NUMBER > MENU_COUNT THEN RETURN 0
    CURSOR OFF
    CHOSEN = 0
    ' No key yet: a plain key's low byte with bit 7 set is a hot letter.
    PRESSED = 0
    DO
      ' Menu NUMBER's items are FIRST to LAST. Its box is 3 columns wider than its longest
      ' caption, and stays off the screen's last column.
      FIRST = MENU_FIRST(NUMBER)
      LAST = MENU_FIRST(NUMBER + 1) - 1
      COUNT = LAST - FIRST + 1
      WIDTH = 0
      SPOT = FIRST
      REPEAT COUNT
        LENGTH = ContentsAt(ITEM_CAPTION_AT(SPOT) + 1)
        IF LENGTH > WIDTH THEN WIDTH = LENGTH
        SPOT = SPOT + 1
      END REPEAT
      WIDTH = WIDTH + 3
      COLUMN = MENU_COLUMN(NUMBER)
      IF COLUMN + WIDTH >= POS(3) THEN COLUMN = POS(3) - 1 - WIDTH
      POS(1) = 0
      POS(0) = MENU_COLUMN(NUMBER)
      DRAW_TITLE(NUMBER, ROLE.MENU_SELECTED)
      SAVED = VERA.SAVE_RECT(1, COLUMN, WIDTH, COUNT + 2)
      USE_COLOR(ROLE.MENU)
      BOX(1, COLUMN, WIDTH, COUNT + 2)
      ITEM = FIRST
      DO
        LETTER = ContentsAt(@PRESSED) OR $A0
        SPOT = FIRST
        REPEAT COUNT
          WHICH = ROLE.MENU
          IF SPOT = ITEM THEN WHICH = ROLE.MENU_SELECTED
          USE_COLOR(WHICH)
          POS(1) = SPOT - FIRST + 2
          POS(0) = COLUMN + 1
          PRINT " ";
          IF PRINT_HOT(ITEM_CAPTION_AT(SPOT), WHICH) = LETTER THEN CHOSEN = SPOT
          REPEAT COLUMN + WIDTH - 1 - POS(0)
            PRINT " ";
          END REPEAT
          SPOT = SPOT + 1
        END REPEAT
        IF PRESSED = KEYS.ENTER THEN CHOSEN = ITEM
        IF CHOSEN <> 0 THEN EXIT DO
        PRESSED = WAITKEY()
        IF PRESSED = KEYS.KEY_UP THEN ITEM = ITEM - 1
        IF PRESSED = KEYS.KEY_DOWN THEN ITEM = ITEM + 1
        IF ITEM < FIRST THEN ITEM = LAST
        IF ITEM > LAST THEN ITEM = FIRST
      LOOP UNTIL PRESSED = KEYS.ESC OR PRESSED = KEYS.KEY_LEFT OR PRESSED = KEYS.KEY_RIGHT
      IF SAVED THEN
        VERA.RESTORE_RECT()
      ELSE
        ' Each theme's PAGE color has the same foreground as background, so the box clears.
        USE_COLOR(ROLE.PAGE)
        BOX(1, COLUMN, WIDTH, COUNT + 2)
        SHOWN_FORM = 0
      ENDIF
      POS(1) = 0
      POS(0) = MENU_COLUMN(NUMBER)
      DRAW_TITLE(NUMBER, ROLE.MENU)
      IF PRESSED = KEYS.KEY_LEFT THEN NUMBER = NUMBER - 1
      IF PRESSED = KEYS.KEY_RIGHT THEN NUMBER = NUMBER + 1
      IF NUMBER = 0 THEN NUMBER = MENU_COUNT
      IF NUMBER > MENU_COUNT THEN NUMBER = 1
    LOOP UNTIL PRESSED <> KEYS.KEY_LEFT AND PRESSED <> KEYS.KEY_RIGHT
    IF CHOSEN = 0 THEN RETURN 0
    RETURN ITEM_ID(CHOSEN)
  END FUNCTION
#REGION_SLOT 1

  ' The EDITOR of a field: INPUT2 on CONTROL's target, its FLAGS with MORE_FLAGS added.
  FUNCTION EDIT_TEXT(CONTROL AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    DIM TARGET_AT AS UWORD, MASK_AT AS UWORD
    TARGET_AT = CONTROL_TEXT_AT(CONTROL)
    MASK_AT = CONTROL_MASK_AT(CONTROL)
    RETURN INPUT2(CONTROL_ROW(CONTROL), COLUMN, StringAt(TARGET_AT), CONTROL_WIDTH(CONTROL), StringAt(MASK_AT), CONTROL_FLAGS(CONTROL) OR MORE_FLAGS)
  END FUNCTION

  ' The EDITOR of a CBO: DROP_LIST on CONTROL's choices.
  FUNCTION EDIT_CBO(CONTROL AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    RETURN DROP_LIST(CONTROL_ROW(CONTROL), COLUMN, CONTROL_WIDTH(CONTROL), CONTROL_MASK_AT(CONTROL), CONTROL_TEXT_AT(CONTROL), MORE_FLAGS)
  END FUNCTION

  ' The EDITOR of a MEMO: MEMO_EDIT in CONTROL's rows.
  FUNCTION EDIT_MEMO(CONTROL AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    RETURN MEMO_EDIT(CONTROL_ROW(CONTROL), COLUMN, CONTROL_WIDTH(CONTROL), CONTROL_TEXT_AT(CONTROL), MORE_FLAGS)
  END FUNCTION

  ' The EDITOR of a LIST: LIST_EDIT on CONTROL's list slot.
  FUNCTION EDIT_LIST(CONTROL AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    RETURN LIST_EDIT(CONTROL_TEXT_AT(CONTROL), CONTROL_ROW(CONTROL), COLUMN, MORE_FLAGS)
  END FUNCTION

  ' Runs the EDITOR of CONTROL's kind and returns its key. A field, CHECK, RADIO, CBO, MEMO or
  ' LIST takes the FIELD_FOCUS color, or the FIELD color when MORE_FLAGS is DRAW_ONLY.
  FUNCTION EDIT_FIELD(CONTROL AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    DIM COLUMN AS UBYTE
    IF MORE_FLAGS = 0 THEN
      USE_COLOR(FIELD_FOCUS)
    ELSE
      USE_COLOR(FIELD)
    ENDIF
    COLUMN = FIELD_COLUMN(CONTROL)
    RETURN CALL KIND_EDITOR(CONTROL_KIND(CONTROL)) WITH (CONTROL, COLUMN, MORE_FLAGS)
  END FUNCTION

  ' Clears the screen's last row in the STATUS color, all but its last column, and prints
  ' MESSAGE$ there, cut to fit.
  SUB STATUS_LINE(MESSAGE$ AS CONST)
    USE_COLOR(STATUS)
    SPAN_ROW = POS(2) - 1
    SPAN_COLUMN = 0
    SPAN_LENGTH = POS(3) - 1
    SPAN(32, 32, 32)
    ' Printing in the screen's last cell scrolls the screen, so VERA writes that cell.
    VERA.PUT_CELL(SPAN_ROW - 1, SPAN_LENGTH, 32, ContentsAt(@COLORS$ + 2 + ROLE.STATUS))
    POS(1) = SPAN_ROW - 1
    POS(0) = 0
    PRINT LEFT$(MESSAGE$, SPAN_LENGTH);
  END SUB

  ' Draws the form HANDLE whole: the form, its menu bar when MENUBAR gave it one, and each
  ' control's caption and field, none in focus. SHOWN_FORM becomes HANDLE.
  SUB DRAW_WHOLE(HANDLE AS UBYTE)
    DIM CONTROL AS UBYTE, LABEL_AT AS UWORD
    SHOWN_FORM = HANDLE
    DRAW_FORM(HANDLE)
    IF RUN_MENU <> 0 THEN CALL RUN_MENU WITH (HANDLE, DRAW_MENU_BAR)
    CONTROL = MOST_CONTROLS
    REPEAT MOST_CONTROLS
      IF CONTROL_OWNER(CONTROL) = HANDLE THEN
        USE_COLOR(TEXT)
        POS(1) = CONTROL_ROW(CONTROL)
        POS(0) = CONTROL_COLUMN(CONTROL)
        LABEL_AT = CONTROL_LABEL_AT(CONTROL)
        PRINT StringAt(LABEL_AT);
        IF CONTROL_WIDTH(CONTROL) <> 0 THEN EDIT_FIELD(CONTROL, DRAW_ONLY)
      ENDIF
      CONTROL = CONTROL - 1
    END REPEAT
  END SUB

  ' Shows the form HANDLE and lets the user edit its controls, then returns an event. A form new
  ' to SHOW is drawn whole, as DRAW_WHOLE draws it, and the focus goes to its first control. Tab,
  ' Down and Enter move the focus to the next control, and Shift+Tab and Up to the one before;
  ' the focus wraps from the last control to the first and back, and skips each SAY. Enter on
  ' the last control returns EV_DONE, and so does a form with no control but SAYs. Enter on a
  ' CBO opens its list instead. Esc returns
  ' EV_CANCEL. A button pressed returns its id, as BUTTON gives. F10, or Alt with a menu's hot
  ' letter, opens a menu of the form's bar, as PULL_MENU runs it; the item chosen returns its
  ' id, as MENUITEM gives, and the focus stays. A CBO's list that closes leaves the focus on the
  ' CBO. Leaving a VALIDATE field returns EV_LEAVE, with the field in
  ' LEFT_FIELD and the key in LEFT_KEY; the next SHOW moves the focus on, or back to the field after REFUSE.
  ' Any other key that a VALIDATE field passes on, such as F2, returns EV_LEAVE too, and the
  ' next SHOW keeps the focus on the field. A form is new to SHOW after EV_DONE, EV_CANCEL or FREE, and
  ' when another form was shown last. A form shown again after a MSGBOX keeps its focus, and is
  ' not drawn again. SHOW(0) returns EV_CANCEL.
  FUNCTION SHOW(HANDLE AS UBYTE) AS UBYTE
    DIM FOCUS AS UBYTE, DIRECTION AS UBYTE, PUSHED AS UBYTE, PRESSED AS UWORD
    IF HANDLE = 0 THEN RETURN EV_CANCEL
    IF HANDLE <> SHOWN_FORM THEN
      SHOWN_FORM = 0
      ' A dialog puts back the focus it found, so it may be a control of this form.
      IF CONTROL_OWNER(NEXT_FOCUS) <> HANDLE THEN NEXT_FOCUS = NEXT_CONTROL(HANDLE, 0, 1)
    ENDIF
    FOCUS = NEXT_FOCUS
    DO
      ' A form new to SHOW, or one a CBO's list has covered, is drawn whole.
      IF SHOWN_FORM = 0 THEN DRAW_WHOLE(HANDLE)
      IF FOCUS = 0 THEN EXIT DO
      PRESSED = EDIT_FIELD(FOCUS, 0)
      EDIT_FIELD(FOCUS, DRAW_ONLY)
      IF STATUS_SHOWN <> 0 THEN
        STATUS_SHOWN = 0
        STATUS_LINE("")
      ENDIF
      DIRECTION = 1
      ' Enter on a button, or a button's hot key, presses it. Control 0 is a KIND_FIELD.
      PUSHED = FOCUS
      IF PRESSED <> KEYS.ENTER THEN PUSHED = HOT_BUTTON(HANDLE, PRESSED)
      IF CONTROL_KIND(PUSHED) = KIND_BUTTON THEN
        NEXT_FOCUS = PUSHED
        RETURN CONTROL_TEXT_AT(PUSHED)
      ENDIF
      ' F10, or Alt with a menu's hot letter, opens a menu. The item chosen returns its id; Esc
      ' leaves the key to the CASE ELSE below.
      IF RUN_MENU <> 0 THEN
        PUSHED = CALL RUN_MENU WITH (HANDLE, PRESSED)
        IF PUSHED <> 0 THEN RETURN PUSHED
      ENDIF
      SELECT CASE PRESSED
        CASE KEYS.ESC
          SHOWN_FORM = 0
          NEXT_FOCUS = 0
          RETURN EV_CANCEL
        CASE KEYS.ENTER, KEYS.KEY_DOWN
        CASE KEYS.TAB
          IF KEYMODS() AND KEYS.MOD_SHIFT THEN DIRECTION = 255
        CASE KEYS.KEY_UP
          DIRECTION = 255
        CASE ELSE
          ' The focus stays. NEXT_CONTROL with a DIRECTION of 0 returns FOCUS.
          DIRECTION = 0
      END SELECT
      NEXT_FOCUS = NEXT_CONTROL(HANDLE, FOCUS, DIRECTION)
      IF PRESSED = KEYS.ENTER AND NEXT_FOCUS <= FOCUS THEN NEXT_FOCUS = 0
      IF CONTROL_FLAGS(FOCUS) AND VALIDATE THEN
        LEFT_FIELD = FOCUS
        LEFT_KEY = PRESSED
        RETURN EV_LEAVE
      ENDIF
      FOCUS = NEXT_FOCUS
    LOOP
    SHOWN_FORM = 0
    RETURN EV_DONE
  END FUNCTION

  ' Puts the focus back on LEFT_FIELD at the next SHOW, after EV_LEAVE, and shows MESSAGE$ on the
  ' status line, the screen's last row, until the user leaves the field.
  SUB REFUSE(MESSAGE$ AS CONST)
    NEXT_FOCUS = LEFT_FIELD
    STATUS_LINE(MESSAGE$)
    STATUS_SHOWN = 1
  END SUB

  ' The dialogs run from region 2, and reach the forms only through the SUBs of region 1.
#REGION_SLOT 2
  ' The widest line of the dialog being made. The dialog's form.
  DIM DIALOG_WIDTH AS UBYTE, DIALOG_FORM AS UBYTE

  ' Raises DIALOG_WIDTH to the length of TEXT$, and returns the length.
  FUNCTION WIDEN(TEXT$ AS CONST) AS UBYTE
    DIM LENGTH AS UBYTE
    LENGTH = LEN(TEXT$)
    IF LENGTH > DIALOG_WIDTH THEN DIALOG_WIDTH = LENGTH
    RETURN LENGTH
  END FUNCTION

  ' Makes a framed form centered on the screen, titled TITLE$, with ROWS rows for its lines, then
  ' a blank row, then the button BUTTON1$, id 1, and BUTTON2$ beside it, id 2, when it is not
  ' empty. Puts the form's handle in DIALOG_FORM. The form is 6 columns wider than DIALOG_WIDTH,
  ' its title or its buttons, whichever is widest. A blank row runs above the lines and below the
  ' buttons. The lines go in from row 2, column 3.
  SUB OPEN_DIALOG(TITLE$ AS CONST, ROWS AS UBYTE, BUTTON1$ AS CONST, BUTTON2$ AS CONST)
    DIM FIRST AS UBYTE, SECOND AS UBYTE, BUTTONS AS UBYTE, COLUMN AS UBYTE
    ' A button is its caption less the &, between "< " and " >". Two have 2 columns between.
    FIRST = LEN(BUTTON1$) + 3
    SECOND = LEN(BUTTON2$)
    BUTTONS = FIRST
    IF SECOND <> 0 THEN BUTTONS = FIRST + SECOND + 5
    IF BUTTONS > DIALOG_WIDTH THEN DIALOG_WIDTH = BUTTONS
    WIDEN(TITLE$)
    DIALOG_FORM = CREATEFORM(TITLE$, CENTER, CENTER, DIALOG_WIDTH + 6, ROWS + 6, FRAMED)
    COLUMN = HALF_GAP(DIALOG_WIDTH, BUTTONS) + 3
    ROWS = ROWS + 3
    BUTTON(ROWS, COLUMN, BUTTON1$, 1)
    IF SECOND <> 0 THEN BUTTON(ROWS, COLUMN + FIRST + 2, BUTTON2$, 2)
  END SUB

  ' What PUT_DIALOG keeps for SHUT_DIALOG: the focus and the form SHOW had, and 1 when the screen
  ' was saved.
  DIM KEPT_FOCUS AS UBYTE, KEPT_FORM AS UBYTE, KEPT_SCREEN AS UBYTE

  ' Saves the screen under the dialog DIALOG_FORM and its shadow, and puts the focus of its first
  ' SHOW on the control FOCUS, or on the form's first control for 0. SHUT_DIALOG ends the dialog.
  ' Trap: one dialog at a time. A dialog run between PUT_DIALOG and SHUT_DIALOG loses what
  ' PUT_DIALOG kept.
  SUB PUT_DIALOG(FOCUS AS UBYTE)
    KEPT_FOCUS = NEXT_FOCUS
    KEPT_FORM = SHOWN_FORM
    NEXT_FOCUS = FOCUS
    KEPT_SCREEN = VERA.SAVE_RECT(PANEL_ROW(DIALOG_FORM), PANEL_COLUMN(DIALOG_FORM), PANEL_WIDTH(DIALOG_FORM) + 2, PANEL_HEIGHT(DIALOG_FORM) + 1)
  END SUB

  ' Frees DIALOG_FORM, puts back the screen and the focus PUT_DIALOG kept, and returns RESULT,
  ' SHOW's event, with EV_DONE as 1. A form shown before keeps its focus, and is not drawn
  ' again. When VERA.SAVE_RECT had no room, the screen is not put back, and that form's next
  ' SHOW draws it whole.
  FUNCTION SHUT_DIALOG(RESULT AS UBYTE) AS UBYTE
    FREE(DIALOG_FORM)
    NEXT_FOCUS = KEPT_FOCUS
    IF KEPT_SCREEN THEN
      VERA.RESTORE_RECT()
      SHOWN_FORM = KEPT_FORM
    ENDIF
    IF RESULT = EV_DONE THEN RESULT = 1
    RETURN RESULT
  END FUNCTION

  ' Shows the dialog DIALOG_FORM, the focus first on the control FOCUS, or on the form's first
  ' control for 0, then frees the form and returns SHOW's event, with EV_DONE, Enter in the last
  ' field, as 1. The screen is put back as SHUT_DIALOG puts it back.
  FUNCTION RUN_DIALOG(FOCUS AS UBYTE) AS UBYTE
    PUT_DIALOG(FOCUS)
    RETURN SHUT_DIALOG(SHOW(DIALOG_FORM))
  END FUNCTION

  ' Shows a framed form centered on the screen, titled TITLE$, with the lines LINE1$ to LINE3$,
  ' then the button BUTTON1$, and BUTTON2$ beside it when it is not empty. Returns 1 or 2 for the
  ' button pressed, by Enter or its hot key, or EV_CANCEL for Esc. The form is 6 columns wider
  ' than its widest line, its title or its buttons. It is freed before MSGBOX returns, and the
  ' screen under it is put back, as RUN_DIALOG puts it back.
  FUNCTION MSGBOX(TITLE$ AS CONST, LINE1$ AS CONST, LINE2$ AS CONST = "", LINE3$ AS CONST = "", BUTTON1$ AS CONST = "&OK", BUTTON2$ AS CONST = "") AS UBYTE
    DIM ROWS AS UBYTE
    DIALOG_WIDTH = LEN(LINE1$)
    ROWS = 1
    IF WIDEN(LINE2$) <> 0 THEN ROWS = 2
    IF WIDEN(LINE3$) <> 0 THEN ROWS = 3
    OPEN_DIALOG(TITLE$, ROWS, BUTTON1$, BUTTON2$)
    ' An empty line's SAY prints nothing.
    SAY(2, 3, LINE1$)
    SAY(3, 3, LINE2$)
    SAY(4, 3, LINE3$)
    RETURN RUN_DIALOG(0)
  END FUNCTION

  ' MSGBOX with the buttons &Yes and &No. Returns 1 for Yes, and 0 for No or Esc.
  FUNCTION YESNO(TITLE$ AS CONST, LINE1$ AS CONST, LINE2$ AS CONST = "", LINE3$ AS CONST = "") AS UBYTE
    IF MSGBOX(TITLE$, LINE1$, LINE2$, LINE3$, "&Yes", "&No") = 1 THEN RETURN 1
    RETURN 0
  END FUNCTION

  ' Shows a dialog as MSGBOX does, titled TITLE$, with PROMPT$ over a field that edits TARGET$,
  ' WIDTH characters wide, then the buttons &OK and &Cancel. MASK$ and FLAGS are INPUT2's. The
  ' focus starts in the field. Returns 1 for OK, or for Enter in the field, 2 for Cancel, or
  ' EV_CANCEL for Esc. Esc puts back the text of the field it is pressed in, as INPUT2 does;
  ' TARGET$ keeps what was typed otherwise.
  FUNCTION INPUTBOX(TITLE$ AS CONST, PROMPT$ AS CONST, TARGET$, WIDTH AS UBYTE, MASK$ AS CONST = "", FLAGS AS UBYTE = 0) AS UBYTE
    DIALOG_WIDTH = WIDTH
    WIDEN(PROMPT$)
    OPEN_DIALOG(TITLE$, 2, "&OK", "&Cancel")
    SAY(2, 3, PROMPT$)
    ' The buttons come first, so Enter in the field, the last control, returns EV_DONE.
    RETURN RUN_DIALOG(GET(3, 3, TARGET$, WIDTH, MASK$, FLAGS))
  END FUNCTION

  ' INPUTBOX with two fields, TARGET1$ after PROMPT1$ and TARGET2$ after PROMPT2$ under it. The
  ' prompts end in the same column, so the fields line up. Both fields take WIDTH, MASK$ and
  ' FLAGS. Enter in the first field moves to the second, and Enter in the second is OK.
  FUNCTION INPUTBOX2(TITLE$ AS CONST, PROMPT1$ AS CONST, TARGET1$, PROMPT2$ AS CONST, TARGET2$, WIDTH AS UBYTE, MASK$ AS CONST = "", FLAGS AS UBYTE = 0) AS UBYTE
    DIM FIRST AS UBYTE, ENDS AS UBYTE
    DIALOG_WIDTH = LEN(PROMPT1$)
    WIDEN(PROMPT2$)
    ENDS = DIALOG_WIDTH + 3
    DIALOG_WIDTH = DIALOG_WIDTH + WIDTH + 1
    OPEN_DIALOG(TITLE$, 2, "&OK", "&Cancel")
    FIRST = SAYGET(2, ENDS - LEN(PROMPT1$), PROMPT1$, TARGET1$, WIDTH, MASK$, FLAGS)
    SAYGET(3, ENDS - LEN(PROMPT2$), PROMPT2$, TARGET2$, WIDTH, MASK$, FLAGS)
    RETURN RUN_DIALOG(FIRST)
  END FUNCTION

  ' Shows a dialog as MSGBOX does, titled TITLE$, with a list of ROWS rows over the buttons &OK
  ' and &Cancel. The items and FLAGS are LIST's. The list shows ITEM_LENGTH characters of each
  ' item. The focus starts in the list, on the first item. Returns the item chosen, 1 for the
  ' first, for OK or for Enter in the list, and 0 for Cancel, for Esc, or when COUNT is 0. With
  ' LIST_MULTI, MARKED reads the marks after it returns.
  ' Trap: with MOST_LISTS lists in use, the dialog has no list, and OK returns 1.
  FUNCTION LISTBOX(TITLE$ AS CONST, ITEMS_AT AS UWORD, ITEMS_BANK AS UBYTE, ITEM_LENGTH AS UBYTE, COUNT AS UBYTE, ROWS AS UBYTE, FLAGS AS UBYTE = 0) AS UBYTE
    DIM CHOSEN AS UBYTE, WIDTH AS UBYTE
    ' A compare gives 1 for true.
    CHOSEN = COUNT <> 0
    ' The last column holds ^ and v, and with LIST_MULTI the first holds the mark.
    WIDTH = ITEM_LENGTH + 1
    IF FLAGS AND LIST_MULTI THEN WIDTH = WIDTH + 1
    DIALOG_WIDTH = WIDTH
    OPEN_DIALOG(TITLE$, ROWS, "&OK", "&Cancel")
    ' The buttons come first, so Enter in the list, the last control, returns EV_DONE.
    IF RUN_DIALOG(LIST(2, 3, "", ITEMS_AT, ITEMS_BANK, ITEM_LENGTH, COUNT, @CHOSEN, ROWS, WIDTH, FLAGS)) = 1 THEN RETURN CHOSEN
    RETURN 0
  END FUNCTION

  ' PRINT_RECORD runs from low RAM, as it selects the items' RAM bank.
#REGION_SLOT 0
  ' Selects RAM bank BANK, prints the string of the record at AT, cut at its first zero, at
  ' LENGTH characters or at WIDTH, and pads it with spaces to WIDTH characters. Returns the
  ' record's first byte. A LENGTH of 0 prints spaces.
  ' Trap: the bank stays selected. A call from a region selects the region's bank again after.
  FUNCTION PRINT_RECORD(AT AS UWORD, BANK AS UBYTE, LENGTH AS UBYTE, WIDTH AS UBYTE) AS UBYTE
    DIM CHARACTER AS UBYTE, FIRST AS UBYTE
    ContentsAt(0) = BANK
    FIRST = ContentsAt(AT)
    REPEAT WIDTH
      CHARACTER = 0
      IF LENGTH <> 0 THEN CHARACTER = ContentsAt(AT)
      IF CHARACTER = 0 THEN
        LENGTH = 0
        CHARACTER = 32
      ELSE
        LENGTH = LENGTH - 1
        AT = AT + 1
      ENDIF
      PRINT CHR$(CHARACTER);
    END REPEAT
    RETURN FIRST
  END FUNCTION

  ' The lists run from region 3, beside VERA.UXI, and reach the forms only through the SUBs of
  ' region 1.
#REGION_SLOT 3
  ' The lists, 1 to MOST_LISTS. LIST_CONTROL is a list's control; a slot is free when that
  ' control is no longer a LIST that holds the slot. The others are LIST's arguments, and
  ' LIST_TOP the item on the list's top row. LIST_MARKS holds LIST_MULTI's marks, one bit an
  ' item, bit 0 of byte 0 for item 0.
  ' Checklist: the LIST_ arrays hold MOST_LISTS + 1 elements.
  CONST MOST_LISTS AS UBYTE = 4
  DIM LIST_CONTROL(5) AS UBYTE, LIST_ITEMS_AT(5) AS UWORD, LIST_BANK(5) AS UBYTE
  DIM LIST_LENGTH(5) AS UBYTE, LIST_COUNT(5) AS UBYTE, LIST_VALUE_AT(5) AS UWORD
  DIM LIST_ROWS(5) AS UBYTE, LIST_WIDTH(5) AS UBYTE, LIST_FLAGS(5) AS UBYTE, LIST_TOP(5) AS UBYTE
  DIM LIST_MARKS(32) AS UBYTE

  ' Makes a list of the current form, ROWS rows of WIDTH columns with the caption CAPTION$
  ' before its first row, and returns its control number, as SAYGET does. The items are COUNT
  ' records of ITEM_LENGTH bytes from ITEMS_AT, each a string padded with zeros, in RAM bank
  ' ITEMS_BANK at $A000 to $BFFF, or in low RAM for 0. The UBYTE at VALUE_AT is the item
  ' chosen, 1 for the first, or 0 for none; pass it as @NAME. The item chosen is drawn in the
  ' MENU_SELECTED color. Up, Down, PgUp, PgDn, Home and End move the choice, and a letter moves
  ' it to the next item that starts with that letter. The list scrolls by the fewest rows that
  ' show the item chosen; a ^ in its last column on the top row and a v on the bottom row mark
  ' items above and below. ROW, COLUMN and FLAGS are SAYGET's. With AUTO as ROW, the form's
  ' next automatic line is below the list. With LIST_MULTI in FLAGS, Space marks and unmarks the
  ' item chosen, and a * before an item shows its mark; MARKED reads the marks. LIST returns 0
  ' when MOST_LISTS lists are in use.
  ' Trap: one list at a time has marks. LIST with LIST_MULTI clears them.
  FUNCTION LIST(ROW AS UBYTE, COLUMN AS UBYTE, CAPTION$ AS CONST, ITEMS_AT AS UWORD, ITEMS_BANK AS UBYTE, ITEM_LENGTH AS UBYTE, COUNT AS UBYTE, VALUE_AT AS UWORD, ROWS AS UBYTE, WIDTH AS UBYTE, FLAGS AS UBYTE = 0) AS UBYTE
    DIM SLOT AS UBYTE, CONTROL AS UBYTE
    SLOT = MOST_LISTS
    DO WHILE SLOT <> 0
      IF LIST_SLOT_OF(LIST_CONTROL(SLOT)) <> SLOT THEN EXIT DO
      SLOT = SLOT - 1
    LOOP
    IF SLOT = 0 THEN RETURN 0
    CONTROL = TALL_FIELD(ROW, COLUMN, CAPTION$, WIDTH, ROWS, FLAGS)
    IF CONTROL = 0 THEN RETURN 0
    MAKE_CHOICE(CONTROL, SLOT, KIND_LIST, @EDIT_LIST)
    LIST_CONTROL(SLOT) = CONTROL
    LIST_ITEMS_AT(SLOT) = ITEMS_AT
    LIST_BANK(SLOT) = ITEMS_BANK
    LIST_LENGTH(SLOT) = ITEM_LENGTH
    LIST_COUNT(SLOT) = COUNT
    LIST_VALUE_AT(SLOT) = VALUE_AT
    LIST_ROWS(SLOT) = ROWS
    LIST_WIDTH(SLOT) = WIDTH
    LIST_FLAGS(SLOT) = FLAGS
    LIST_TOP(SLOT) = 1
    IF FLAGS AND LIST_MULTI THEN
      SLOT = 0
      REPEAT 32
        LIST_MARKS(SLOT) = 0
        SLOT = SLOT + 1
      END REPEAT
    ENDIF
    RETURN CONTROL
  END FUNCTION

  ' The byte of LIST_MARKS that MARK_BIT set last.
  DIM MARK_BYTE AS UBYTE

  ' Puts the byte of LIST_MARKS that holds item INDEX's mark in MARK_BYTE, and returns its bit.
  ' BITS$ is each bit, by the item's number AND 7.
  FUNCTION MARK_BIT(INDEX AS UBYTE, BITS$ AS CONST = !"\&h01\&h02\&h04\&h08\&h10\&h20\&h40\&h80") AS UBYTE
    MARK_BYTE = INDEX >> 3
    RETURN ContentsAt(AddrOf(BITS$) + 2 + (INDEX AND 7))
  END FUNCTION

  ' Returns 1 when LIST_MULTI's mark is on item INDEX, else 0.
  FUNCTION MARKED(INDEX AS UBYTE) AS UBYTE
    DIM BIT AS UBYTE
    BIT = MARK_BIT(INDEX)
    IF LIST_MARKS(MARK_BYTE) AND BIT THEN RETURN 1
    RETURN 0
  END FUNCTION

  ' Prints item ITEM of list SLOT, 1 for the first, as PRINT_RECORD prints it in WIDTH
  ' characters, and returns its first byte. An ITEM past the list's last prints spaces.
  FUNCTION PRINT_ITEM_OF(SLOT AS UBYTE, ITEM AS UBYTE, WIDTH AS UBYTE) AS UBYTE
    DIM AT AS UWORD, LENGTH AS UBYTE
    LENGTH = LIST_LENGTH(SLOT)
    AT = ITEM - 1
    AT = LIST_ITEMS_AT(SLOT) + AT * LENGTH
    IF ITEM > LIST_COUNT(SLOT) THEN LENGTH = 0
    RETURN PRINT_RECORD(AT, LIST_BANK(SLOT), LENGTH, WIDTH)
  END FUNCTION

  ' Draws list SLOT, its first row at ROW and COLUMN, in the FIELD_FOCUS color, or the FIELD
  ' color when MORE_FLAGS is DRAW_ONLY. With MORE_FLAGS DRAW_ONLY it returns DRAW_ONLY. Else it
  ' moves the choice and the marks by the keys LIST gives, and returns any other key.
  FUNCTION LIST_EDIT(SLOT AS UBYTE, ROW AS UBYTE, COLUMN AS UBYTE, MORE_FLAGS AS UBYTE) AS UWORD
    DIM PRESSED AS UWORD, VALUE_AT AS UWORD
    DIM VALUE AS UBYTE, COUNT AS UBYTE, ROWS AS UBYTE, TOP AS UBYTE, ITEM AS UBYTE, SPOT AS UBYTE
    DIM TEXT_WIDTH AS UBYTE, MULTI AS UBYTE, MARK AS UBYTE, CHARACTER AS UBYTE, SCAN AS UBYTE
    DIM STEPS AS UBYTE, BASE AS ENUM.ROLE
    VALUE_AT = LIST_VALUE_AT(SLOT)
    COUNT = LIST_COUNT(SLOT)
    ROWS = LIST_ROWS(SLOT)
    MULTI = LIST_FLAGS(SLOT) AND LIST_MULTI
    ' The last column holds ^ and v, and with LIST_MULTI the first holds the mark.
    TEXT_WIDTH = LIST_WIDTH(SLOT) - 1
    IF MULTI <> 0 THEN TEXT_WIDTH = TEXT_WIDTH - 1
    BASE = ROLE.FIELD_FOCUS
    IF MORE_FLAGS <> 0 THEN BASE = ROLE.FIELD
    DO
      VALUE = ContentsAt(VALUE_AT)
      TOP = LIST_TOP(SLOT)
      IF VALUE <> 0 THEN
        IF VALUE < TOP THEN TOP = VALUE
        IF VALUE - TOP >= ROWS THEN TOP = VALUE - ROWS + 1
      ENDIF
      LIST_TOP(SLOT) = TOP
      ITEM = TOP
      SPOT = 0
      REPEAT ROWS
        USE_COLOR(BASE)
        POS(1) = ROW + SPOT
        POS(0) = COLUMN
        IF MULTI <> 0 THEN
          MARK = 32
          IF MARKED(ITEM) THEN MARK = ASC("*")
          PRINT CHR$(MARK);
        ENDIF
        IF ITEM = VALUE THEN USE_COLOR(ROLE.MENU_SELECTED)
        PRINT_ITEM_OF(SLOT, ITEM, TEXT_WIDTH)
        USE_COLOR(BASE)
        MARK = 32
        IF SPOT = 0 AND TOP > 1 THEN MARK = ASC("^")
        IF SPOT = ROWS - 1 AND ITEM < COUNT THEN MARK = ASC("v")
        PRINT CHR$(MARK);
        ITEM = ITEM + 1
        SPOT = SPOT + 1
      END REPEAT
      IF MORE_FLAGS <> 0 THEN RETURN MORE_FLAGS
      CURSOR OFF
      PRESSED = WAITKEY()
      ' The scan code is the high byte, 0 for a plain key. PgUp and PgDn are Up and Down + 1.
      CHARACTER = PRESSED
      SCAN = ContentsAt(@PRESSED + 1)
      STEPS = 1
      IF SCAN = KEYS.SCAN_PGUP OR SCAN = KEYS.SCAN_PGDN THEN
        SCAN = SCAN - 1
        STEPS = ROWS
      ENDIF
      SELECT CASE SCAN
        CASE KEYS.SCAN_UP
          IF VALUE > STEPS THEN
            VALUE = VALUE - STEPS
          ELSE
            VALUE = 1
          ENDIF
        CASE KEYS.SCAN_DOWN
          IF COUNT - VALUE > STEPS THEN
            VALUE = VALUE + STEPS
          ELSE
            VALUE = COUNT
          ENDIF
        CASE KEYS.SCAN_HOME
          VALUE = 1
        CASE KEYS.SCAN_END
          VALUE = COUNT
        CASE 0
          IF CHARACTER = KEYS.SPACE AND MULTI <> 0 THEN
            MARK = MARK_BIT(VALUE)
            LIST_MARKS(MARK_BYTE) = LIST_MARKS(MARK_BYTE) XOR MARK
          ELSEIF CHARACTER > KEYS.SPACE THEN
            ' A letter OR 32 is its lower case.
            CHARACTER = CHARACTER OR 32
            ITEM = VALUE
            REPEAT COUNT
              IF ITEM >= COUNT THEN ITEM = 0
              ITEM = ITEM + 1
              IF (PRINT_ITEM_OF(SLOT, ITEM, 0) OR 32) = CHARACTER THEN
                VALUE = ITEM
                EXIT REPEAT
              ENDIF
            END REPEAT
          ELSE
            RETURN PRESSED
          ENDIF
        CASE ELSE
          RETURN PRESSED
      END SELECT
      IF VALUE > COUNT THEN VALUE = COUNT
      ContentsAt(VALUE_AT) = VALUE
    LOOP
  END FUNCTION
  ERRORS ON
END NAMESPACE
