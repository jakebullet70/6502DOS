' STR.UXI: the string words of the language under STR, and string routines.
'
' STR.name is the built-in of that name: STR.MID$ is MID$.
'
' Its BINDs add no bytes to a program, and a FUNCTION adds bytes only when called. Include it
' in any file, with or without DOS.UXI.

NAMESPACE STR
  BIND LEN LEN        ' STR.LEN(S$)                  the length of S$
  BIND ASC ASC        ' STR.ASC(S$)                  the code of the first character
  BIND VAL VAL        ' STR.VAL(S$)                  the number in S$, 16 bits
  BIND LVAL LVAL      ' STR.LVAL(S$)                 the number in S$, 32 bits
  BIND CHR$ CHR$      ' STR.CHR$(N)                  the character with code N
  BIND STR$ STR$      ' STR.STR$(N)                  N as a string
  BIND MID$ MID$      ' STR.MID$(S$, START[, COUNT]) COUNT characters from START
  BIND INSTR INSTR    ' STR.INSTR(S$, F$[, START])   the position of F$ in S$, or 0
  BIND LEFT$ LEFT$    ' STR.LEFT$(S$, N)             the first N characters of S$
  BIND RIGHT$ RIGHT$  ' STR.RIGHT$(S$, N)            the last N characters of S$
  BIND TRIM$ TRIM$    ' STR.TRIM$(S$)                S$ without the spaces at its start and end
  BIND LTRIM$ LTRIM$  ' STR.LTRIM$(S$)               S$ without the spaces at its start
  BIND RTRIM$ RTRIM$  ' STR.RTRIM$(S$)               S$ without the spaces at its end
  BIND AddressOf AddrOf

  ' The position of the last FIND$ in TEXT$ that starts at or before START, or 0. START 0
  ' searches the whole of TEXT$. An empty FIND$ gives 0. It calls INSTR once for each match up
  ' to START.
  FUNCTION INSTR_REV(TEXT$, FIND$, START AS UBYTE) AS UBYTE
    DIM POSITION AS UBYTE, LAST AS UBYTE
    POSITION = 0
    LAST = 0
    IF START = 0 THEN START = 255
    DO
      POSITION = INSTR(TEXT$, FIND$, POSITION + 1)
      IF POSITION = 0 OR POSITION > START THEN RETURN LAST
      LAST = POSITION
    LOOP UNTIL POSITION = START
    RETURN LAST
  END FUNCTION

  ' TEXT$ with spaces in front, WIDTH characters in all: right-aligned. A TEXT$ of WIDTH
  ' characters or more comes back whole. WIDTH and the length of TEXT$ are at most 82.
  FUNCTION PADL(TEXT$, WIDTH AS UBYTE) AS STRING
    DIM RESULT$ * 82
    RESULT$ = TEXT$
    ' Moves the characters up by the pad from the last one down, then fills the front.
    ASM
        lda @RESULT$ + 1
        cmp @WIDTH
        bcs done
        phx
        ldx @WIDTH
        stx @RESULT$ + 1
        tay
        beq fill
move:   lda @RESULT$ + 1,y
        sta @RESULT$ + 1,x
        dex
        dey
        bne move
fill:   lda #32
spaces: sta @RESULT$ + 1,x
        dex
        bne spaces
        plx
done:
    END ASM
    RETURN RESULT$
  END FUNCTION

  ' TEXT$ with spaces after it, WIDTH characters in all: left-aligned. A TEXT$ of WIDTH
  ' characters or more comes back whole. WIDTH and the length of TEXT$ are at most 82.
  FUNCTION PADR(TEXT$, WIDTH AS UBYTE) AS STRING
    DIM RESULT$ * 82
    RESULT$ = TEXT$
    ASM
        ldy @RESULT$ + 1
        cpy @WIDTH
        bcs done
        lda #32
fill:   iny
        sta @RESULT$ + 1,y
        cpy @WIDTH
        bne fill
        sty @RESULT$ + 1
done:
    END ASM
    RETURN RESULT$
  END FUNCTION
END NAMESPACE
