' CONS.UXI: the ANSI escape sequences the 6502DOS console obeys, as string constants.
'
' PRINT CONS.RED$; CONS.ON_WHITE$; "Error"; CONS.NORMAL$ prints Error in red on white.
' A sequence with a number starts with CSI$: PRINT CONS.CSI$; "5;10H"; moves the cursor to
' row 5, column 10.
'
' Trap: PRINT puts a space before and after a number, so PRINT CONS.CSI$; ROW; "H" sends
' Esc[ 5 H. Build the number with STR$ and trim it first.
'
' Its constants and BINDs add no bytes to a program, and a SUB or FUNCTION adds bytes only when
' called. Include it in any file, with or without DOS.UXI and KEYS.UXI.
'
' Checklist: the sequences come from ansi in src/asm/console.s, and LX_TAGS in
' UXCBASIC/pyuxc/uxc_lex.py has the same. Change all three together.

NAMESPACE CONS
  ' The console words of the language under CONS. CONS.NEWLINE is PRINT alone.
  BIND PRINT PRINT
  BIND INPUT INPUT
  BIND LINPUT LINPUT
  BIND POS POS
  BIND NEWLINE PRINT

  ' The Control Sequence Introducer, Esc [.
  CONST CSI$ = !"\27["

  ' The cursor to row 1, column 1.
  CONST CURSOR_HOME$ = CSI$ + "H"

  ' POS(1) = CURSOR_OFF hides the cursor while the program waits for a key, and POS(1) =
  ' CURSOR_ON shows it. Neither moves the cursor. The program's end shows it again.
  ' Checklist: GUI.UXI has the same two values; api_con_cursor in src/asm/console.s reads them.
  CONST CURSOR_ON AS UBYTE = $80, CURSOR_OFF AS UBYTE = $C0

  ' CLEAR_SCREEN$ clears the screen and puts the cursor home. CLEAR_EOL$ blanks from the
  ' cursor to the end of the line.
  CONST CLEAR_SCREEN$ = CSI$ + "2J", CLEAR_EOL$ = CSI$ + "K"

  ' NORMAL$ gives the color DOS.SET_COLOR last set. REVERSE$ swaps the foreground and the
  ' background.
  CONST NORMAL$ = CSI$ + "0m", REVERSE$ = CSI$ + "7m"

  ' The foreground colors, SGR 30 to 37.
  CONST BLACK$ = CSI$ + "30m", RED$ = CSI$ + "31m"
  CONST GREEN$ = CSI$ + "32m", YELLOW$ = CSI$ + "33m"
  CONST BLUE$ = CSI$ + "34m", MAGENTA$ = CSI$ + "35m"
  CONST CYAN$ = CSI$ + "36m", WHITE$ = CSI$ + "37m"

  ' The background colors, SGR 40 to 47.
  CONST ON_BLACK$ = CSI$ + "40m", ON_RED$ = CSI$ + "41m"
  CONST ON_GREEN$ = CSI$ + "42m", ON_YELLOW$ = CSI$ + "43m"
  CONST ON_BLUE$ = CSI$ + "44m", ON_MAGENTA$ = CSI$ + "45m"
  CONST ON_CYAN$ = CSI$ + "46m", ON_WHITE$ = CSI$ + "47m"

  ' The screen's rows and columns, read from the console at each call. POS(2) and POS(3) give
  ' the same.
  FUNCTION SCREEN_ROWS() AS UBYTE
    RETURN POS(2)
  END FUNCTION

  FUNCTION SCREEN_COLS() AS UBYTE
    RETURN POS(3)
  END FUNCTION

  ' Moves the cursor to ROW and COLUMN, counted from 0 as POS counts.
  SUB LOCATE(ROW AS UBYTE, COLUMN AS UBYTE)
    POS(1) = ROW
    POS(0) = COLUMN
  END SUB

  ' Prints TEXT$ at ROW and COLUMN and leaves the cursor after it.
  SUB PRINT_AT(ROW AS UBYTE, COLUMN AS UBYTE, TEXT$)
    POS(1) = ROW
    POS(0) = COLUMN
    PRINT TEXT$;
  END SUB

  ' Prints true when VALUE is not 0, and false when it is 0.
  SUB PRINT_BOOL(VALUE AS UBYTE)
    IF VALUE THEN
      PRINT "true";
    ELSE
      PRINT "false";
    END IF
  END SUB
END NAMESPACE
