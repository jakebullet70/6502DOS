' RECORD2 -- string fields: assign, append, copy, functions, @, INPUT, LINPUT, a parameter, a local
TYPE PERSON
  NICK AS STRING * 10
  AGE AS UBYTE
  TOWN AS STRING * 5
END TYPE
DIM P AS PERSON, Q AS PERSON, A$ * 20
DIM F AS PERSON AT $0600
P.NICK = "ALICE"
P.AGE = 30
P.TOWN = "ROMEVILLE"
PRINT P.NICK; P.AGE; P.TOWN
PRINT LEN(P.NICK); LEN(P); PEEK(@P.NICK); PEEK(@P.TOWN)
P.NICK = P.NICK + "XY"
Q = P
P.NICK = ""
PRINT LEN(P.NICK); Q.NICK
IF Q.NICK = "ALICEXY" THEN PRINT "EQ"
A$ = Q.NICK + "!"
PRINT A$; MID$(Q.NICK, 2, 3); INSTR(Q.NICK, "CE"); ASC(Q.NICK)
P.TOWN = "123"
PRINT VAL(P.TOWN) + 1
POKE $0600, 4
POKE $0601, 0
F.NICK = "BOBBY"
PRINT F.NICK; PEEK($0601)
INPUT P.NICK, P.AGE
LINPUT P.TOWN
PRINT "[" + P.NICK + "]"; P.AGE; "[" + P.TOWN + "]"
SUB SHOUT(T$)
  PRINT T$ + "?"
END SUB
SHOUT(Q.NICK)
SUB SHOWLOCAL()
  DIM L AS PERSON
  L.NICK = "LOCALNAME12"
  L.TOWN = L.TOWN + "AB"
  PRINT L.NICK; L.TOWN; PEEK(@L.NICK)
END SUB
SHOWLOCAL()
PRINT "DONE"
