' REPEAT with no count, a constant count, and a BYTE and a WORD count.
DIM A AS UBYTE, B AS UWORD, C AS BYTE
REPEAT
A = A + 1
IF A = 5 THEN EXIT REPEAT
IF A = 2 THEN CONTINUE
PRINT A
END REPEAT
REPEAT 0
PRINT 1
END REPEAT
REPEAT 5
PRINT 2
ENDREPEAT
REPEAT 256
B = B + 1
END REPEAT
REPEAT 300
B = B + 1
END REPEAT
REPEAT 65535
B = B + 1
END REPEAT
REPEAT A
PRINT 3
REPEAT A + 1
PRINT 4
END REPEAT
END REPEAT
REPEAT B
REPEAT C
PRINT 5
END REPEAT
END REPEAT
REPEAT
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
END REPEAT
