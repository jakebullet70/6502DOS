' FOR with BYTE, WORD and signed counters, steps up and down, constant and variable limits.
DIM A AS UBYTE, B AS UWORD, C AS BYTE, W AS INT, N AS UBYTE, M AS UWORD, S AS BYTE
N = 10
M = 1000
S = -3
FOR A = 1 TO 10
PRINT A
NEXT A
FOR A = 10 TO 1 STEP -1
PRINT A
NEXT
FOR A = 0 TO 255
NEXT A
FOR A = 255 TO 0 STEP -1
NEXT A
FOR A = 5 TO 1
PRINT A
NEXT
FOR A = 1 TO 5 STEP -1
PRINT A
NEXT
FOR A = 0 TO 100 STEP 7
NEXT
FOR A = 100 TO 3 STEP -7
NEXT
FOR A = 0 TO 3 STEP 9
NEXT
FOR A = 250 TO 255 STEP 9
NEXT
FOR A = N TO 20
NEXT
FOR A = 1 TO N
NEXT
FOR A = N TO 1 STEP -1
NEXT
FOR A = 1 TO N STEP 3
NEXT
FOR A = 50 TO N STEP -3
NEXT
FOR B = 1 TO 1000
NEXT B
FOR B = 1000 TO 1 STEP -1
NEXT B
FOR B = 0 TO 65535
NEXT
FOR B = 0 TO 60000 STEP 300
NEXT
FOR B = 60000 TO 5 STEP -300
NEXT
FOR B = 0 TO 1000 STEP 50
NEXT
FOR B = 1000 TO 0 STEP -50
NEXT
FOR B = 1 TO M
NEXT
FOR B = M TO 1 STEP -1
NEXT
FOR B = 1 TO M STEP 20
NEXT
FOR B = 1 TO M STEP 2000
NEXT
FOR B = M TO 2 STEP -20
NEXT
FOR B = M TO 2 STEP -2000
NEXT
FOR B = A TO M
NEXT
FOR C = -5 TO 5
PRINT C
NEXT C
FOR C = 5 TO -5 STEP -1
NEXT
FOR C = -128 TO 127
NEXT
FOR C = 127 TO -128 STEP -1
NEXT
FOR C = -100 TO 100 STEP 10
NEXT
FOR C = 100 TO -100 STEP -10
NEXT
FOR C = -10 TO S
NEXT
FOR C = S TO -10 STEP -1
NEXT
FOR C = -10 TO S STEP 4
NEXT
FOR C = 10 TO S STEP -4
NEXT
FOR W = -1000 TO 1000 STEP 100
NEXT
FOR W = 1000 TO -1000 STEP -1
NEXT
FOR W = -5 TO 5
NEXT
FOR W = S TO 300
NEXT
FOR W = 0 TO W STEP 7
NEXT
FOR A = 1 TO 9
IF A = 2 THEN CONTINUE
IF A = 7 THEN EXIT FOR
FOR B = 1 TO 3
IF B = 2 THEN EXIT FOR
NEXT B
NEXT A
FOR A = 1 TO 10 STEP 1
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
NEXT A
