' Constant folding: every operator, signed and LONG constants, CONST.
PRINT 1 + 2; 300 - 400; -5 * 7; 100 / -7; -100 MOD 7; 100 MOD -7
PRINT 6 AND 3; 6 OR 3; 6 XOR 3; -1 AND 255; -2 OR 1; -1 XOR -1
PRINT 1 << 4; -64 >> 2; 65535 << 1; 1 << 20; 200 >> 9; -1 << 15
PRINT 3 = 3; 3 <> 3; 2 < 3; 2 > 3; 2 <= 2; 2 >= 3; -1 < 0; -1 > 65535
PRINT NOT 0; NOT 5; -(-5); --7; -0; NOT NOT 3
PRINT 70000 + 1; 100000 * 3; -70000; 4000000000 / 3; 4000000000 MOD 7
PRINT 65535 + 1; 65535 * 65535; -32768 - 1; -2147483648; 2147483647 + 1
PRINT $FFFF AND -1; $FFFFFFFF; $FFFFFFFF + 1; -1 * -1; -128; -129
PRINT (1 + 2) * (3 + 4); ((((7)))); 2 * 3 + 4 * 5 - 6 / 2
PRINT 1 << 2 + 1; 1 + 2 = 3; 1 OR 2 AND 3; NOT 1 = 2
PRINT 70000 << 1; -70000 >> 1; 70000 AND 65535; 70000 OR 1; 70000 XOR 70000
PRINT 70000 = 70000; 70000 < -1; -70000 < 1; 4294967295 > 1
CONST A AS UBYTE = 200, B AS WORD = -300, C AS LONG = -100000, D AS ULONG = 3000000000
CONST E AS BYTE = -128, F AS INT = 32767, G AS UINT = 65535, H AS ULONG = 4294967295
PRINT A + B; C; D; A * 2; E; F + 1; G + 1; H; -E; C * C
PRINT A; B; C; D; E; F; G; H
