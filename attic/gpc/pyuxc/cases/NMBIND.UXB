' BIND to variables, arrays, SUBs, namespaces, words and other BINDs.
DIM A AS UBYTE, ARR(5) AS UWORD
BIND B = A
BIND C B
BIND SAY = PRINT
BIND SHOUT PRINT
SUB SHOW(X AS UBYTE)
SAY X
ENDSUB
BIND SH = SHOW
NAMESPACE NS
BIND PRINT PRINT
DIM V AS UBYTE
SUB S()
SHOUT 1
ENDSUB
BIND T = S
ENDNAMESPACE
BIND N = NS
BIND R = ARR
B = 4
C = C + 1
SAY A
SHOUT B; C
SH(A)
N.V = 3
N.S()
NS.T()
R(2) = 7
PRINT R(2)
FUNCT F(X AS UBYTE) AS UBYTE
RETURN X
ENDFUNCT
PRINT F(1)
SUB LATE()
BIND LOC = A
LOC = 9
ENDSUB
BIND EARLYSUB = LATERSUB
SUB LATERSUB()
ENDSUB
EARLYSUB()
