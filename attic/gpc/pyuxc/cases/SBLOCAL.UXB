' Locals in SUBs, the pools of SUBs that call each other in a chain, and SUBs in namespaces.
DIM T AS UWORD
SUB LEAF(N AS UWORD)
DIM X AS UWORD, Y AS LONG
X = N * 2
Y = X
T = T + X
ENDSUB
SUB MID1(N AS UBYTE)
DIM Q AS UBYTE
Q = N + 1
LEAF(Q)
LEAF(Q + 1)
ENDSUB
SUB TOP()
MID1(3)
LEAF(4)
END SUB
NAMESPACE NS
SUB INNER(V AS UBYTE)
MID1(V)
ENDSUB
FUNCTION TWICE(V AS UWORD) AS UWORD
RETURN V * 2
ENDFUNCTION
SUB CALLER()
INNER(1)
PRINT TWICE(5)
ENDSUB
ENDNAMESPACE
TOP()
NS.INNER(5)
NS.CALLER()
PRINT NS.TWICE(T)
