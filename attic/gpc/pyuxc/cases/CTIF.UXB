' IF blocks, one-line IF, IF GOTO, and conditions with AND, OR, NOT, XOR.
DIM A AS UBYTE, B AS UWORD, C AS BYTE, L AS LONG, W AS INT
A = 3
B = 1000
C = -2
L = -70000
W = -5
IF A = 3 THEN
PRINT 1
ELSEIF A = 4 THEN
PRINT 2
ELSEIF B > 500
PRINT 3
ELSE
PRINT 4
ENDIF
IF A < 2 THEN PRINT 5
IF A >= 2 AND B <> 7 THEN PRINT 6
IF A > 9 OR B < 2000 OR C < 0 THEN PRINT 7
IF NOT A = 3 THEN PRINT 8
IF (A = 3 AND B = 1000) OR (C = -2 AND NOT L > 0) THEN PRINT 9
IF A XOR B THEN PRINT 10
IF A THEN PRINT 11
IF A AND 1 THEN PRINT 12
IF 1 THEN PRINT 13
IF 0 THEN PRINT 14
IF A = 3 OR 1 THEN PRINT 15
IF A = 3 AND 0 THEN PRINT 16
IF L < W THEN PRINT 17
IF C <= W AND W >= C THEN PRINT 18
IF B THEN
IF A THEN
PRINT 19
END IF
ELSE
PRINT 20
END IF
IF A = 3 GOTO DONE
PRINT 21
DONE:
IF A = 3 THEN GOTO DONE2
PRINT 22
DONE2:
IF B = 1000 THEN
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
ENDIF
