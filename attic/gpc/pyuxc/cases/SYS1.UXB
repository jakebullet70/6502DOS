' SYS1 -- SYS with A, X, Y and P in $030C-$030F
DIM W AS UWORD, I AS UBYTE
POKE $030F, 0
POKE $030C, 65
SYS $FFD2                    ' CHROUT "A"
POKE $030C, 66
W = $FFD2
SYS W                       ' CHROUT "B"
PRINT
' A routine at $0400: inc a, inx, iny, sec, rts
POKE $0400, $1A
POKE $0401, $E8
POKE $0402, $C8
POKE $0403, $38
POKE $0404, $60
POKE $030C, 10
POKE $030D, 20
POKE $030E, 30
POKE $030F, $0C              ' D and I set: SYS clears both
SYS $0400
PRINT PEEK($030C); PEEK($030D); PEEK($030E); PEEK($030F) AND 1; PEEK($030F) AND 12
' X is the expression stack: an expression after SYS still works
FOR I = 1 TO 3
    SYS $0400
    W = (I + 1) * (I + 2)
    PRINT W;
NEXT I
PRINT
PRINT "OK"
