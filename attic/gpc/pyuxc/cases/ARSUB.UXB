' Arrays local to SUBs, and elements passed to them.
DIM G(8) AS UWORD, N AS UBYTE
SUB BUMP(V AS UWORD)
G(N) = V + 1
ENDSUB
FUNCTION TOTAL() AS UWORD
DIM K AS UBYTE, T AS UWORD, LOCAL(4) AS UBYTE
FOR K = 0 TO 3
LOCAL(K) = K
T = T + LOCAL(K) + G(K)
NEXT K
RETURN T
ENDFUNCTION
FUNCTION PICK(K AS UBYTE) AS UBYTE
DIM B(3) AS UBYTE
B(K) = K
RETURN B(K)
ENDFUNCTION
BUMP(G(N))
G(PICK(N)) = TOTAL()
N = PICK(PICK(N))
FOR N = 0 TO 7
G(N) = N
NEXT N
