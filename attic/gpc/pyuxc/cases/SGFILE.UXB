' OPEN in each mode, READ, WRITE, EOF, and INPUT and LINPUT from a file.
DIM F AS UWORD, N AS UBYTE, W AS UWORD, L AS LONG, S$ * 40, B(10) AS UBYTE
F = OPEN("A.TXT", O.READ)
F = OPEN("B.TXT", O.WRITE)
F = OPEN("C.TXT", O.APPEND)
F = OPEN(S$, O.READ)
F = OPEN(S$, O.WRITE)
F = OPEN(S$ + ".X", O.APPEND)
WRITE F, @B, 10
W = READ(F, @B, 10)
IF EOF(F) THEN PRINT 1
INPUT #F, S$
INPUT #F, N, W, L, S$
LINPUT #F, S$
CLOSE F
