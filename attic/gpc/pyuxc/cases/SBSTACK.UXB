' Calls inside the arguments of calls: the arguments are pushed and popped.
DIM A AS UBYTE, B AS UWORD, L AS LONG
FUNCTION G3(X AS UBYTE, Y AS LONG, Z AS UWORD) AS UWORD
RETURN X + Z
ENDFUNCTION
FUNCTION H(X AS UBYTE) AS UBYTE
RETURN X + 1
ENDFUNCTION
FUNCTION K(X AS LONG) AS LONG
RETURN X
ENDFUNCTION
SUB P(X AS UBYTE, Y AS LONG, Z AS UWORD)
PRINT G3(X, Y, Z)
PRINT G3(H(X), K(Y), G3(1, 2, 3))
ENDSUB
B = G3(A, L, G3(H(A), K(L), B))
B = G3((A), L, B)
P(H(1), K(2), 3)
P(1, 2, H(3))
CALL P(A, L, B)
