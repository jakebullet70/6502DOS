' ON CASE tables: with and without CASE ELSE, from 0, to 255, and nested.
DIM A AS UBYTE, B AS UBYTE
ON CASE A
CASE 1
PRINT 1
CASE 3, 5
PRINT 3
CASE ELSE
PRINT 9
END CASE
ON CASE A + 1
CASE 10
PRINT 10
CASE 12, 11
PRINT 11
ENDCASE
ON CASE A
CASE 0
PRINT 0
CASE 255
PRINT 255
END CASE
ON CASE A
CASE ELSE
PRINT 7
END CASE
ON CASE A
END CASE
ON CASE B
CASE 2
ON CASE A
CASE 4
PRINT 4
CASE ELSE
PRINT 6
END CASE
CASE 7
END CASE
ON CASE 3
CASE 3
PRINT 3
END CASE
