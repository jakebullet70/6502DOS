' DO ... LOOP with the tests at the top and the bottom, EXIT DO and CONTINUE.
DIM A AS UBYTE, B AS UWORD, C AS UBYTE
DO
A = A + 1
IF A = 3 THEN CONTINUE
IF A > 9 THEN EXIT DO
PRINT A
LOOP
DO WHILE A > 0
A = A - 1
LOOP
DO UNTIL A = 5
A = A + 1
IF A = 2 THEN EXIT DO
LOOP
DO
B = B + 1
LOOP WHILE B < 100
DO
B = B - 1
LOOP UNTIL B = 0 OR A = 9
DO WHILE A < 10 AND B < 5
A = A + 1
IF A = 4 THEN CONTINUE
LOOP UNTIL B = 3
DO
DO
EXIT DO
LOOP
EXIT DO
LOOP
DO
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
PRINT A; B; C
