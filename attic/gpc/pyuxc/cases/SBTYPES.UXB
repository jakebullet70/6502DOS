' SUBs and FUNCTIONs of every type, LONG and signed parameters, and the fall-out return.
DIM A AS UBYTE, B AS UWORD, C AS BYTE, W AS INT, L AS LONG, U AS ULONG
FUNCTION FB(X AS UBYTE) AS UBYTE
IF X > 3 THEN RETURN X - 1
ENDFUNCTION
FUNCTION FC(X AS BYTE) AS BYTE
RETURN -X
ENDFUNCTION
FUNCTION FW(X AS INT, Y AS UWORD) AS INT
RETURN X - Y
END FUNCTION
FUNCTION FL(X AS LONG, Y AS UBYTE) AS LONG
IF Y = 0 THEN
RETURN X
ENDIF
RETURN X * Y
ENDFUNCTION
FUNCTION FU(X AS ULONG) AS ULONG
DO
RETURN X + 1
LOOP
ENDFUNCTION
SUB S0()
PRINT 1
END SUB
SUB S1(X AS LONG, Y AS BYTE, Z AS UBYTE)
PRINT X; Y; Z
RETURN
ENDSUB
A = FB(7)
C = FC(-5)
W = FW(-3, 100)
L = FL(-70000, 3)
U = FU(100000)
PRINT A; C; W; L; U
S0()
CALL S0()
S1(L, C, A)
CALL S1(-1, -2, 3)
PRINT FB(A) + FW(W, B) + FL(1, 2)
L = FB(1) + FL(FW(1, 2), FB(3))
IF FC(C) < 0 THEN PRINT 2
