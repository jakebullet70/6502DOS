    // STARTSWITH, ENDSWITH
    // SPLIT, JOIN, COUNT
    // ISNUMNER - ISLETTER
    // replace    
    // RPT$
    // MATCH
    
        
    SUB CONTAINS(SEARCHME$,FINDME$) AS BYTE
        RETURN (INSTR(SEARCHME$,FINDME$) <> 0)
    END SUB

   

    SUB PrintBool(V AS BYTE) 
        if v then
            print "true"
        else
            print "false"
        end if
    END SUB
    
    SUB Instr(Text$, Search$) AS BYTE
         IF LEN(Search$) = 0 THEN return 1
  
       dim i
        FOR I = 1 TO LEN(Text$) - LEN(Search$) + 1
            IF MID$(Text$, I, LEN(Search$)) = Search$ THEN return I
        NEXT I
        return 0
        
    END sub        

end namespace


