'----------------------------------------------------------
' KEYS.UXB -- print the code of each key pressed; Q stops
'
'
'----------------------------------------------------------
DIM K AS BYTE
PRINT "Press keys. Q stops."
DO
  K = GETKEY()
  IF K = 0 THEN CONTINUE
  PRINT K
  IF K = 81  THEN EXIT DO
  IF K = 113 THEN EXIT DO
LOOP


STR.PrintBool(str.contains("1234567890","56"))

END


