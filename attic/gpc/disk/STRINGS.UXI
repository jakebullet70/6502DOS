// TIMER INTERRUPT ON
// TIMER INTERRUPT Off



  function InStrRev(s$, f$, start as ubyte) as ubyte
    
    '--- testing out new keywords (works fine)
    '--- some day will make into ASM

    dim sa as uword, fa as uword, sd as uword, fd as uword
    dim sl as ubyte, fl as ubyte, startPos as ubyte, i as ubyte, j as ubyte, ch as ubyte, matched as ubyte

    sa = AddrOf(s$)
    fa = AddrOf(f$)

    sl = ContentsAt(sa + 1)
    fl = ContentsAt(fa + 1)

    if fl = 0  then return 0
    if fl > sl then return 0

    sd = sa + 2
    fd = fa + 2

    if start = 0 or start > sl then
        startPos = sl
    else
        startPos = start
    endif

    ' Fast path: single character
    if fl = 1 then
        ch = ContentsAt(fd)
        for i = startPos to 1 step -1
            if ContentsAt(sd + i - 1) = ch then return i
        next
        return 0
    endif

    if startPos > sl - fl + 1 then startPos = sl - fl + 1

    for i = startPos to 1 step -1
        matched = 1
        for j = 0 to fl - 1
            if ContentsAt(sd + i + j - 1) <> ContentsAt(fd + j) then
                matched = 0
                exit for
            endif
        next
        if matched then return i
    next
    return 0

end function


END NAMESPACE

