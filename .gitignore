# Build and test output: tools/build.py writes build/, UXCBASIC/tests.py writes build/uxctests/.
build/

# Python
__pycache__/
*.pyc

# Written by UXCBASIC/tpl/MKTPL.PY. The tables UXC.TPL.BIN and UXC.TPL.IDS are kept, so a clone
# compiles without running 64tass.
UXCBASIC/tpl/*.LST
UXCBASIC/tpl/UXDOS/*.LST
UXCBASIC/tpl/UXC.TPL.BL

# Written by UXCBASIC/help/MKHELP.PY.
UXCBASIC/help/HELP-TXT/

# MSBASIC: the mist64/msbasic clone with the ROM dumps, and the X16 manual copies, which stay
# local and are never committed.
MSBASIC/ref/
MSBASIC/docs/x16/
MSBASIC/docs/x16-basic-compare.md

# Golden outputs of the tests stay local and are never committed. The test sources are kept.
tests/*.OUT
UXCBASIC/tests/*.OUT
MSBASIC/tests/*.out

# The keys a test types stay local and are never committed.
tests/*.IN
UXCBASIC/tests/*.IN

# Claude Code per-machine settings.
.claude/settings.local.json

# The parked CHKDSK -F test keeps its keys and golden local too.
attic/chkdsk-v2/*.IN
attic/chkdsk-v2/*.OUT
