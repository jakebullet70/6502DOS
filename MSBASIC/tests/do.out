OK
10 I=0
20 DO
30 I=I+1:IF I=3 THEN PRINT "THREE"
40 IF I>=5 THEN EXIT
50 LOOP
60 PRINT "AFTER";I
100 REM NESTED, EXIT DO, EXIT FROM A FOR INSIDE A DO
110 FOR A=1 TO 2:B=0
120 DO
130 B=B+1:C=0
140 DO:C=C+1:IF C=2 THEN EXIT DO
150 LOOP
160 FOR J=1 TO 9:IF J=2 THEN EXIT
170 NEXT J
180 PRINT "NO"
190 LOOP:PRINT A;B;C;J:NEXT A
300 REM BLOCK IF INSIDE, TWO EXITS, TEXT SKIPPED
310 K=0
320 DO
330 K=K+1
340 IF K=4 THEN
350 PRINT "LOOP IN QUOTES":REM LOOP
360 EXIT
370 END IF
380 IF K>9 THEN EXIT
390 LOOP:PRINT "K=";K
400 GOSUB 500:PRINT "BACK"
410 DO:N=N+1:IF N<3 THEN LOOP
420 PRINT "N=";N
430 GOTO 600
500 DO:M=M+1:IF M=2 THEN EXIT
510 LOOP:RETURN
600 E=0:DO:E=E+1:IF E<4 THEN LOOP
610 PRINT "E=";E
700 DO:IF 1 THEN EXIT
710 DO:PRINT "NO":LOOP
720 IF 0 THEN EXIT DO
730 LOOP:PRINT "NEST OK"
740 FOR I=1 TO 300:DO:EXIT:LOOP:NEXT:PRINT "NO LEAK"
750 GOSUB 800
760 END
800 DO:RETURN
RUN
THREE
AFTER 5
 1  1  2  2
 2  1  2  2
LOOP IN QUOTES
K= 4
BACK
N= 3
E= 4
NEST OK
NO LEAK

?RETURN WITHOUT GOSUB ERROR IN  800
