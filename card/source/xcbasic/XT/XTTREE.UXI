' XTTREE.UXI: XT's tree of folders, anchored at C:\, and its pane in columns 0 to 26.
' Include it in XT.UXB, after DOS.UXI, BANK.UXI, VERA.UXI, GUI.UXI and XTFILE.UXI, and after
' NAMES_BANK, FOLDER_PATH, FOCUS, COLOR_OF, DRAW_TITLE, DRAW_MENU and the screen's CONSTs.
'
' A node is a number, 0 to 253, and node 0 is C:\. Its links and flags are in low RAM. Its name
' is in the names bank, at NAMES_START + node * 32, zero-padded. Nodes are never freed. Children
' keep the order of the folder on disk.

CONST NODE_MAX AS UBYTE = 254, NODE_NONE AS UBYTE = 255, ROOT_NODE AS UBYTE = 0
CONST NAME_SIZE AS UBYTE = 32, NAMES_START AS UWORD = $A000
CONST FLAG_LOGGED AS UBYTE = 1, FLAG_EXPANDED AS UBYTE = 2
' A row's name and marker start after this many cells, and each level adds LEVEL_CELLS.
CONST ROW_START AS UBYTE = 1, LEVEL_CELLS AS UBYTE = 2
' The codes of the tree's lines in CP437.
CONST LINE_ACROSS AS UBYTE = 196, LINE_BRANCH AS UBYTE = 195, LINE_LAST AS UBYTE = 192

DIM FIRST_CHILD(NODE_MAX) AS UBYTE, NEXT_SIBLING(NODE_MAX) AS UBYTE, PARENT_NODE(NODE_MAX) AS UBYTE
DIM NODE_FLAGS(NODE_MAX) AS UBYTE
' The nodes the pane can show, from the top. BUILD_VISIBLE fills it.
DIM VISIBLE_NODES(NODE_MAX) AS UBYTE
DIM NODE_COUNT AS UBYTE, VISIBLE_COUNT AS UBYTE
' Positions in VISIBLE_NODES: the highlighted row, and the pane's first row.
DIM TREE_CURSOR AS UBYTE, TREE_TOP AS UBYTE
DIM NAME_TEXT AS STRING * 32, ROW_TEXT AS STRING * 27
DIM LAUNCH_PATH AS STRING * 255, PATH_PART AS STRING * 32

' Puts the name of NODE in NAME_TEXT. Selects the names bank; a region's bank comes back when
' the call returns.
SUB LOAD_NAME(NODE AS UBYTE)
  DIM PLACE AS UWORD, LENGTH AS UBYTE, CODE AS UBYTE
  PLACE = NODE
  PLACE = (PLACE << 5) + NAMES_START
  BANK.USE(NAMES_BANK)
  LENGTH = 0
  DO WHILE LENGTH < NAME_SIZE
    CODE = ContentsAt(PLACE + LENGTH)
    IF CODE = 0 THEN EXIT DO
    ContentsAt(@NAME_TEXT + 2 + LENGTH) = CODE
    LENGTH = LENGTH + 1
  LOOP
  ContentsAt(@NAME_TEXT + 1) = LENGTH
END SUB

' Writes TEXT$ as the name of NODE. Selects the names bank, as LOAD_NAME does.
SUB STORE_NAME(NODE AS UBYTE, TEXT$ AS CONST)
  DIM PLACE AS UWORD, LENGTH AS UBYTE, SPOT AS UBYTE, CODE AS UBYTE
  PLACE = NODE
  PLACE = (PLACE << 5) + NAMES_START
  LENGTH = ContentsAt(@TEXT$ + 1)
  BANK.USE(NAMES_BANK)
  FOR SPOT = 0 TO NAME_SIZE - 1
    CODE = 0
    IF SPOT < LENGTH THEN CODE = ContentsAt(@TEXT$ + 2 + SPOT)
    ContentsAt(PLACE + SPOT) = CODE
  NEXT
END SUB

' Sets FOLDER_PATH to the path of NODE, with a \ at its end.
SUB BUILD_PATH(NODE AS UBYTE)
  FOLDER_PATH = ""
  DO WHILE NODE <> ROOT_NODE
    LOAD_NAME(NODE)
    FOLDER_PATH = NAME_TEXT + "\" + FOLDER_PATH
    NODE = PARENT_NODE(NODE)
  LOOP
  FOLDER_PATH = "C:\" + FOLDER_PATH
END SUB

' Fills VISIBLE_NODES: each node whose parents are all expanded, each parent before its children.
SUB BUILD_VISIBLE()
  DIM NODE AS UBYTE
  VISIBLE_COUNT = 0
  NODE = ROOT_NODE
  DO WHILE NODE <> NODE_NONE
    VISIBLE_NODES(VISIBLE_COUNT) = NODE
    VISIBLE_COUNT = VISIBLE_COUNT + 1
    IF (NODE_FLAGS(NODE) AND FLAG_EXPANDED) <> 0 AND FIRST_CHILD(NODE) <> NODE_NONE THEN
      NODE = FIRST_CHILD(NODE)
    ELSE
      DO WHILE NODE <> NODE_NONE
        IF NEXT_SIBLING(NODE) <> NODE_NONE THEN EXIT DO
        NODE = PARENT_NODE(NODE)
      LOOP
      IF NODE <> NODE_NONE THEN NODE = NEXT_SIBLING(NODE)
    END IF
  LOOP
END SUB

' Moves TREE_TOP so that the pane shows TREE_CURSOR.
SUB SCROLL_TO_CURSOR()
  IF TREE_CURSOR < TREE_TOP THEN TREE_TOP = TREE_CURSOR
  IF TREE_CURSOR - TREE_TOP >= PANE_ROWS THEN TREE_TOP = TREE_CURSOR - PANE_ROWS + 1
END SUB

' Writes CHARACTER at COLUMN of ROW_TEXT. A column past the pane writes nothing: a deep folder's
' row ends at the divider.
SUB ROW_CELL(COLUMN AS UBYTE, CHARACTER AS UBYTE)
  IF COLUMN < DIVIDER_COLUMN THEN ContentsAt(@ROW_TEXT + 2 + COLUMN) = CHARACTER
END SUB

' Writes the row of position SPOT of VISIBLE_NODES, which the pane shows: the lines, the marker
' and the name. The marker is - for an expanded folder with children, a line for a logged folder
' with none, and + for the rest.
SUB DRAW_TREE_ROW(SPOT AS UBYTE)
  DIM NODE AS UBYTE, WALK AS UBYTE, COLUMN AS UBYTE, PLACE AS UBYTE
  DIM CHARACTER AS UBYTE, COLOR AS UBYTE
  NODE = VISIBLE_NODES(SPOT)
  ContentsAt(@ROW_TEXT + 1) = DIVIDER_COLUMN
  FOR PLACE = 0 TO DIVIDER_COLUMN - 1
    ContentsAt(@ROW_TEXT + 2 + PLACE) = ASC(" ")
  NEXT
  COLUMN = ROW_START
  WALK = NODE
  DO WHILE WALK <> ROOT_NODE
    COLUMN = COLUMN + LEVEL_CELLS
    WALK = PARENT_NODE(WALK)
  LOOP
  CHARACTER = ASC("+")
  IF FIRST_CHILD(NODE) <> NODE_NONE THEN
    IF (NODE_FLAGS(NODE) AND FLAG_EXPANDED) <> 0 THEN CHARACTER = ASC("-")
  ELSEIF (NODE_FLAGS(NODE) AND FLAG_LOGGED) <> 0 THEN
    CHARACTER = LINE_ACROSS
  END IF
  ROW_CELL(COLUMN, CHARACTER)
  LOAD_NAME(NODE)
  FOR PLACE = 1 TO LEN(NAME_TEXT)
    ROW_CELL(COLUMN + 1 + PLACE, ContentsAt(@NAME_TEXT + 1 + PLACE))
  NEXT
  IF NODE <> ROOT_NODE THEN
    COLUMN = COLUMN - LEVEL_CELLS
    CHARACTER = LINE_BRANCH
    IF NEXT_SIBLING(NODE) = NODE_NONE THEN CHARACTER = LINE_LAST
    ROW_CELL(COLUMN, CHARACTER)
    ROW_CELL(COLUMN + 1, LINE_ACROSS)
    WALK = PARENT_NODE(NODE)
    DO WHILE WALK <> ROOT_NODE
      COLUMN = COLUMN - LEVEL_CELLS
      IF NEXT_SIBLING(WALK) <> NODE_NONE THEN ROW_CELL(COLUMN, LINE_DOWN)
      WALK = PARENT_NODE(WALK)
    LOOP
  END IF
  COLOR = COLOR_OF(GUI.ROLE.PAGE)
  IF SPOT = TREE_CURSOR THEN
    IF FOCUS = PANE.TREE THEN
      COLOR = COLOR_OF(GUI.ROLE.MENU_SELECTED)
    ELSE
      ContentsAt(@ROW_TEXT + 2) = ASC(">")
    END IF
  END IF
  VERA.PRINTAT(PANE_TOP + SPOT - TREE_TOP, 0, ROW_TEXT, COLOR)
END SUB

' Writes the tree's pane from TREE_TOP, and blanks the rows past the last node.
SUB DRAW_TREE()
  DIM SHOWN AS UBYTE, ROW AS UBYTE
  SHOWN = VISIBLE_COUNT - TREE_TOP
  IF SHOWN > PANE_ROWS THEN SHOWN = PANE_ROWS
  FOR ROW = 0 TO SHOWN - 1
    DRAW_TREE_ROW(TREE_TOP + ROW)
  NEXT
  IF SHOWN < PANE_ROWS THEN
    VERA.FILL(PANE_TOP + SHOWN, 0, DIVIDER_COLUMN, PANE_ROWS - SHOWN, ASC(" "), COLOR_OF(GUI.ROLE.PAGE))
  END IF
END SUB

' Fills the index from NODE, when it is logged, and writes the file window.
SUB SHOW_FILES(NODE AS UBYTE)
  IF (NODE_FLAGS(NODE) AND FLAG_LOGGED) <> 0 THEN
    BUILD_INDEX(NODE)
  ELSE
    CLEAR_INDEX()
  END IF
  DRAW_FILES()
END SUB

' Gives the focus to NEW_FOCUS, a PANE. The file window holds a row.
SUB SET_FOCUS(NEW_FOCUS AS UBYTE)
  FOCUS = NEW_FOCUS
  DRAW_TREE_ROW(TREE_CURSOR)
  DRAW_FILE_ROW(FILE_CURSOR)
  DRAW_MENU()
END SUB

' Highlights position SPOT of VISIBLE_NODES, shows its files, and shows its path in the title.
SUB MOVE_TREE_CURSOR(SPOT AS UBYTE)
  DIM OLD_CURSOR AS UBYTE, OLD_TOP AS UBYTE
  OLD_CURSOR = TREE_CURSOR
  OLD_TOP = TREE_TOP
  TREE_CURSOR = SPOT
  SCROLL_TO_CURSOR()
  IF TREE_TOP <> OLD_TOP THEN
    DRAW_TREE()
  ELSE
    DRAW_TREE_ROW(OLD_CURSOR)
    DRAW_TREE_ROW(TREE_CURSOR)
  END IF
  BUILD_PATH(VISIBLE_NODES(TREE_CURSOR))
  SHOW_FILES(VISIBLE_NODES(TREE_CURSOR))
  DRAW_TITLE()
END SUB

#REGION_SLOT 5

' Reads FOLDER from disk: its folders become its children, and its files become records. Sets
' FOLDER_PATH to the path of FOLDER. A full tree drops the folders past it and keeps reading the
' files. No free bank stops the read. Each shows a dialog after the read. A disk error ends the
' read as the end of the folder does.
SUB LOG_FOLDER(FOLDER AS UBYTE)
  DIM NODE AS UBYTE, LAST_CHILD AS UBYTE, TREE_FULL AS UBYTE, BANKS_FULL AS UBYTE
  NODE_FLAGS(FOLDER) = NODE_FLAGS(FOLDER) OR FLAG_LOGGED
  LAST_CHILD = NODE_NONE
  TREE_FULL = 0
  BANKS_FULL = 0
  BUILD_PATH(FOLDER)
  START_FILE_LOG()
  DOS.FINDFIRST(FOLDER_PATH, DOS.ATTR_DIRECTORY OR DOS.ATTR_HIDDEN OR DOS.ATTR_SYSTEM)
  DO WHILE DOS.ERROR = 0
    IF (DOS.FOUND_ATTRIBUTES AND DOS.ATTR_DIRECTORY) = 0 THEN
      IF ADD_FILE() = 0 THEN
        BANKS_FULL = 1
        EXIT DO
      END IF
    ELSEIF DOS.FOUND_NAME <> "." AND DOS.FOUND_NAME <> ".." THEN
      IF NODE_COUNT = NODE_MAX THEN
        TREE_FULL = 1
      ELSE
        NODE = NODE_COUNT
        NODE_COUNT = NODE_COUNT + 1
        STORE_NAME(NODE, DOS.FOUND_NAME)
        PARENT_NODE(NODE) = FOLDER
        FIRST_CHILD(NODE) = NODE_NONE
        NEXT_SIBLING(NODE) = NODE_NONE
        NODE_FLAGS(NODE) = 0
        IF LAST_CHILD = NODE_NONE THEN
          FIRST_CHILD(FOLDER) = NODE
        ELSE
          NEXT_SIBLING(LAST_CHILD) = NODE
        END IF
        LAST_CHILD = NODE
      END IF
    END IF
    DOS.FINDNEXT()
  LOOP
  END_FILE_LOG(FOLDER)
  IF TREE_FULL <> 0 THEN GUI.MSGBOX("Log", "The tree holds 254 folders")
  IF BANKS_FULL <> 0 THEN GUI.MSGBOX("Log", "No free RAM bank for more files")
END SUB

' Logs and expands the highlighted folder, and redraws the panes. Its row keeps its position, as
' only the rows below it change.
SUB OPEN_FOLDER()
  DIM NODE AS UBYTE
  NODE = VISIBLE_NODES(TREE_CURSOR)
  IF (NODE_FLAGS(NODE) AND FLAG_LOGGED) = 0 THEN
    LOG_FOLDER(NODE)
    SHOW_FILES(NODE)
    DRAW_TITLE()
  END IF
  NODE_FLAGS(NODE) = NODE_FLAGS(NODE) OR FLAG_EXPANDED
  BUILD_VISIBLE()
  DRAW_TREE()
END SUB

' Makes the root, logs it, and logs and expands each folder of C:'s current directory, down as
' far as the tree holds it. Highlights the last of them. FOLDER_PATH holds its path, and the index
' its files.
SUB START_TREE()
  DIM NODE AS UBYTE, CHILD AS UBYTE, PLACE AS UBYTE, SEPARATOR AS UBYTE
  NODE_COUNT = 1
  STORE_NAME(ROOT_NODE, "C:\")
  PARENT_NODE(ROOT_NODE) = NODE_NONE
  FIRST_CHILD(ROOT_NODE) = NODE_NONE
  NEXT_SIBLING(ROOT_NODE) = NODE_NONE
  NODE = ROOT_NODE
  LOG_FOLDER(NODE)
  NODE_FLAGS(NODE) = NODE_FLAGS(NODE) OR FLAG_EXPANDED
  LAUNCH_PATH = DOS.GETCWD(DOS.DRIVE_C + 1) + "\"
  PLACE = 1
  SEPARATOR = INSTR(LAUNCH_PATH, "\", PLACE)
  DO WHILE SEPARATOR <> 0
    PATH_PART = UCASE$(MID$(LAUNCH_PATH, PLACE, SEPARATOR - PLACE))
    CHILD = FIRST_CHILD(NODE)
    DO WHILE CHILD <> NODE_NONE
      LOAD_NAME(CHILD)
      IF UCASE$(NAME_TEXT) = PATH_PART THEN EXIT DO
      CHILD = NEXT_SIBLING(CHILD)
    LOOP
    IF CHILD = NODE_NONE THEN EXIT DO
    NODE = CHILD
    LOG_FOLDER(NODE)
    NODE_FLAGS(NODE) = NODE_FLAGS(NODE) OR FLAG_EXPANDED
    PLACE = SEPARATOR + 1
    SEPARATOR = INSTR(LAUNCH_PATH, "\", PLACE)
  LOOP
  BUILD_VISIBLE()
  TREE_CURSOR = 0
  DO WHILE VISIBLE_NODES(TREE_CURSOR) <> NODE
    TREE_CURSOR = TREE_CURSOR + 1
  LOOP
  SCROLL_TO_CURSOR()
  BUILD_INDEX(NODE)
END SUB

#REGION_SLOT 0

' Acts on a key for the tree's pane. Any other key does nothing.
SUB TREE_KEY(KEY AS UWORD)
  DIM NODE AS UBYTE, LAST_SPOT AS UBYTE
  LAST_SPOT = VISIBLE_COUNT - 1
  NODE = VISIBLE_NODES(TREE_CURSOR)
  SELECT CASE KEY
    CASE KEYS.KEY_UP
      IF TREE_CURSOR > 0 THEN MOVE_TREE_CURSOR(TREE_CURSOR - 1)
    CASE KEYS.KEY_DOWN
      IF TREE_CURSOR < LAST_SPOT THEN MOVE_TREE_CURSOR(TREE_CURSOR + 1)
    CASE KEYS.KEY_PGUP
      IF TREE_CURSOR > PANE_ROWS THEN
        MOVE_TREE_CURSOR(TREE_CURSOR - PANE_ROWS)
      ELSE
        MOVE_TREE_CURSOR(0)
      END IF
    CASE KEYS.KEY_PGDN
      IF LAST_SPOT - TREE_CURSOR > PANE_ROWS THEN
        MOVE_TREE_CURSOR(TREE_CURSOR + PANE_ROWS)
      ELSE
        MOVE_TREE_CURSOR(LAST_SPOT)
      END IF
    CASE KEYS.ENTER
      IF (NODE_FLAGS(NODE) AND FLAG_LOGGED) <> 0 AND FIRST_CHILD(NODE) = NODE_NONE THEN
        IF ROW_COUNT <> 0 THEN SET_FOCUS(PANE.FILES)
      ELSEIF (NODE_FLAGS(NODE) AND FLAG_EXPANDED) <> 0 AND FIRST_CHILD(NODE) <> NODE_NONE THEN
        NODE_FLAGS(NODE) = NODE_FLAGS(NODE) AND FLAG_LOGGED
        BUILD_VISIBLE()
        DRAW_TREE()
      ELSE
        OPEN_FOLDER()
      END IF
    CASE KEYS.TAB, KEYS.KEY_RIGHT
      IF (NODE_FLAGS(NODE) AND FLAG_LOGGED) = 0 OR ROW_COUNT = 0 THEN OPEN_FOLDER()
      IF ROW_COUNT <> 0 THEN SET_FOCUS(PANE.FILES)
    CASE ASC("+")
      OPEN_FOLDER()
    CASE ASC("-"), KEYS.KEY_LEFT
      NODE_FLAGS(NODE) = NODE_FLAGS(NODE) AND FLAG_LOGGED
      BUILD_VISIBLE()
      DRAW_TREE()
  END SELECT
END SUB

' Acts on a key for the file window, which holds a row.
SUB FILES_KEY(KEY AS UWORD)
  SELECT CASE KEY
    CASE KEYS.TAB, KEYS.ENTER, KEYS.KEY_LEFT
      SET_FOCUS(PANE.TREE)
    CASE ELSE
      FILE_KEY(KEY)
  END SELECT
END SUB
