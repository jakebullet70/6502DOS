' RECORD3 -- arrays of records: constant and variable index, string fields, copy, @, LEN
TYPE ITEM
  COUNT AS UBYTE
  PRICE AS UWORD
  NAME AS STRING * 6
END TYPE
DIM STOCK(5) AS ITEM, R AS ITEM, I AS UBYTE, J AS UBYTE
STOCK(0).COUNT = 7
STOCK(0).PRICE = 1000
STOCK(0).NAME = "BOLT"
PRINT STOCK(0).COUNT; STOCK(0).PRICE; STOCK(0).NAME
FOR I = 1 TO 4
  STOCK(I).COUNT = I * 2
  STOCK(I).PRICE = I * 300
  STOCK(I).NAME = "N" + CHR$(64 + I)
NEXT I
FOR I = 0 TO 4
  PRINT STOCK(I).COUNT; STOCK(I).PRICE; STOCK(I).NAME; LEN(STOCK(I).NAME)
NEXT I
STOCK(4).NAME = "ABCDEFGHIJ"
J = 4
PRINT STOCK(J).NAME; LEN(STOCK(J).NAME); PEEK(@STOCK(J).NAME)
R = STOCK(1)
PRINT R.COUNT; R.PRICE; R.NAME
J = 2
R = STOCK(J)
STOCK(0) = R
PRINT STOCK(0).NAME; STOCK(0).PRICE
STOCK(J + 1) = STOCK(0)
PRINT STOCK(3).NAME; STOCK(3).COUNT
I = 1
STOCK(I) = STOCK(J + 2)
PRINT STOCK(1).NAME; STOCK(I).PRICE
STOCK(0).NAME = STOCK(0).NAME + "X"
I = 0
STOCK(I).NAME = STOCK(I).NAME + "Y"
PRINT STOCK(0).NAME
IF STOCK(I).NAME = "NBXY" THEN PRINT "EQ"
PRINT MID$(STOCK(I).NAME, 2, 2); INSTR(STOCK(I).NAME, "XY"); ASC(STOCK(I).NAME)
STOCK(2).NAME = STOCK(I + 1).NAME
PRINT STOCK(2).NAME
STOCK(I + 2).NAME = STOCK(I).NAME + "!"
PRINT STOCK(2).NAME
SUB SHOUT(T$)
  PRINT T$ + "?"
END SUB
SHOUT(STOCK(I + 2).NAME)
SHOUT(STOCK(1).NAME)
STOCK(I).NAME = ""
PRINT LEN(STOCK(0).NAME)
PRINT LEN(STOCK(3)); LEN(ITEM); @STOCK(1) - @STOCK(0); @STOCK(I + 2).PRICE - @STOCK; @STOCK(2).NAME - @STOCK(0)
PRINT "DONE"
