' EXPRPEEK -- PEEK, POKE, @name, nesting
DIM A AS UBYTE, N AS UWORD, P AS UWORD
POKE @A, 42
PRINT A; PEEK(@A)
N = @A
POKE N, 43
PRINT A; PEEK(N)
POKE $9E00, 7
PRINT PEEK($9E00); PEEK($9E00) + 1
P = $9E00
POKE P + 1, PEEK(P) * 3
PRINT PEEK($9E01)
PRINT 1 + (2 + (3 + (4 + (5 + A))))
PRINT (A + 1) * (A - 1) + (A = 43) * 1000
