' FILEW -- OPEN, PRINT # and CLOSE
DIM F AS UWORD, N$ * 12
N$ = "FILEW.TXT"
F = OPEN(N$, O.WRITE)
PRINT #F, "OLD"
CLOSE F
F = OPEN("FILEW.TXT", O.WRITE)
PRINT F
PRINT #F, "AB"; 5, "CD"
PRINT #F, CHR$(70);
CLOSE F
F = OPEN(N$, O.APPEND)
PRINT #F, "X"
CLOSE F
F = OPEN("NOPE", O.READ)
PRINT F = NOFILE
PRINT #1, "SCREEN"
CLOSE NOFILE
