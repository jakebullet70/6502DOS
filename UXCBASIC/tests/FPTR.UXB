' FPTR -- pointers to SUBs: DECLARE, AS signature, @name and CALL pointer WITH (args): an array
' of pointers, a pointer to a SUB in a NAMESPACE, a pointer as a parameter, a pointer call
' inside the arguments of another, and a SUB called both by name and through a pointer
DECLARE FUNCTION OPERATION(LEFT AS UBYTE, RIGHT AS UBYTE) AS UBYTE
DECLARE SUB REPORT(TEXT$ AS CONST, VALUE AS UWORD)
DIM OPERATIONS(3) AS OPERATION, CHOSEN AS OPERATION, SAY AS REPORT, N AS UBYTE

FUNCTION ADD(A AS UBYTE, B AS UBYTE) AS UBYTE
  RETURN A + B
END FUNCTION

FUNCTION LARGER(A AS UBYTE, B AS UBYTE) AS UBYTE
  DIM BEST AS UBYTE
  BEST = A
  IF B > A THEN BEST = B
  RETURN BEST
END FUNCTION

NAMESPACE MATHS
  FUNCTION TIMES(X AS UBYTE, Y AS UBYTE) AS UBYTE
    RETURN X * Y
  END FUNCTION
END NAMESPACE

SUB PLAIN(T$ AS CONST, V AS UWORD)
  PRINT T$; V
END SUB

SUB FANCY(T$ AS CONST, V AS UWORD)
  PRINT "* "; T$; " ="; V
END SUB

FUNCTION APPLY(HOW AS OPERATION, A AS UBYTE) AS UBYTE
  RETURN CALL HOW WITH (A, A + 1)
END FUNCTION

OPERATIONS(0) = @ADD
OPERATIONS(1) = @LARGER
OPERATIONS(2) = @MATHS.TIMES
SAY = @PLAIN
FOR N = 0 TO 2
  CALL SAY WITH ("OP", CALL OPERATIONS(N) WITH (6, 7))
NEXT N
SAY = @FANCY
CHOSEN = OPERATIONS(2)
CALL SAY WITH ("APPLY", APPLY(CHOSEN, 4))
CALL SAY WITH ("NESTED", CALL CHOSEN WITH (CALL OPERATIONS(0) WITH (1, 2), 5))
PRINT ADD(2, 3)
