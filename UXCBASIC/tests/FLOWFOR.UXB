' FLOWFOR -- FOR ... NEXT, both widths, steps, limits in variables, EXIT and CONTINUE
DIM I AS UBYTE, J AS UBYTE, W AS UWORD, L AS UBYTE, M AS UWORD, C AS UWORD
FOR I = 1 TO 5
  PRINT I;
NEXT
PRINT
FOR I = 5 TO 1 STEP -1
  PRINT I;
NEXT I
PRINT
FOR I = 0 TO 10 STEP 3
  PRINT I;
NEXT
PRINT I
FOR I = 10 TO 0 STEP -4
  PRINT I;
NEXT
PRINT I
C = 0
FOR I = 0 TO 255
  C = C + 1
NEXT
PRINT C; I
C = 0
FOR I = 255 TO 0 STEP -1
  C = C + 1
NEXT
PRINT C; I
FOR I = 5 TO 4
  PRINT "NO"
NEXT
PRINT I
L = 3
FOR I = 1 TO L
  PRINT I;
NEXT
PRINT
L = 0
FOR I = 1 TO L
  PRINT "NO"
NEXT
L = 250
FOR I = 240 TO L STEP 7
  PRINT I;
NEXT
PRINT
L = 2
FOR I = 20 TO L STEP -9
  PRINT I;
NEXT
PRINT
FOR I = 1 TO 3
  FOR J = 1 TO 2
    PRINT I * 10 + J;
  NEXT J
NEXT I
PRINT
C = 0
FOR W = 0 TO 999
  C = C + 1
NEXT
PRINT C; W
FOR W = 65530 TO 65535
  PRINT W;
NEXT
PRINT
FOR W = 1000 TO 0 STEP -300
  PRINT W;
NEXT
PRINT
FOR W = 0 TO 65535 STEP 20000
  PRINT W;
NEXT
PRINT
M = 600
FOR W = 250 TO M STEP 100
  PRINT W;
NEXT
PRINT
M = 2
FOR W = 300 TO M STEP -1
  IF W = 297 THEN EXIT FOR
  PRINT W;
NEXT
PRINT W
FOR I = 1 TO 6
  IF I = 3 THEN CONTINUE
  IF I = 5 THEN EXIT FOR
  PRINT I;
NEXT
PRINT I
FOR W = 256 TO 260 STEP 300
  PRINT W;
NEXT
PRINT
FOR W = 1 TO 1000 STEP 500
  PRINT W;
NEXT
PRINT
