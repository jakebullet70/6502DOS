' namespaces: bare names inside, qualified names outside, a main name of the same spelling
NAMESPACE GFX
  DIM COLOR AS UBYTE
  VAR SIZE AS UWORD
  SUB SETCOLOR(C AS UBYTE)
    COLOR = C
    SIZE = SIZE + 1
  ENDSUB
  FUNCTION TWICE(N AS UWORD) AS UWORD
    RETURN N * 2
  ENDFUNCTION
END NAMESPACE
DIM COLOR AS UBYTE
COLOR = 9
GFX.SETCOLOR(5)
CALL GFX.SETCOLOR(6)
PRINT COLOR; GFX.COLOR; GFX.SIZE; GFX.TWICE(21)
POKE @GFX.COLOR, 8
PRINT PEEK(@GFX.COLOR)
