' ENUMAS -- AS ENUM.name: a parameter, a FUNCTION result, a DIM and a field of an ENUM's type
ENUM STATE
  READY, RUNNING, BLOCKED
END ENUM
NAMESPACE GFX
  ENUM MODE
    TEXT, BITMAP
  END ENUM
  SUB SHOW(M AS ENUM.MODE)
    PRINT "MODE"; M
  END SUB
END NAMESPACE
FUNCTION NEXTSTATE(S AS ENUM.STATE) AS ENUM.STATE
  RETURN S + 1
END FUNCTION
TYPE TASK
  ID AS UBYTE
  NOW AS ENUM.STATE
END TYPE
DIM S AS ENUM.STATE
S = NEXTSTATE(STATE.READY)
PRINT S
PRINT NEXTSTATE(S)
GFX.SHOW(GFX.MODE.BITMAP)
DIM M AS ENUM.GFX.MODE
M = 0
GFX.SHOW(M)
DIM T AS TASK
T.NOW = STATE.BLOCKED
PRINT T.NOW
