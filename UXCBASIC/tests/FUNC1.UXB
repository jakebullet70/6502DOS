' FUNC1 -- FUNCTION and FUNCT with their ends; a FUNCTION with no type is a BYTE
FUNCTION HALF(N AS UWORD) AS UBYTE
  RETURN N / 2
END FUNCTION
FUNCT GREET$(N$)
  RETURN "HI " + N$
END FUNCT
function plusone(n as ubyte) as ubyte
  return n + 1
endfunct
FUNCTION TWICE(NW AS UWORD) AS UWORD
  RETURN NW * 2
ENDFUNCTION
SUB SHOW(N AS UBYTE)
  PRINT N
END SUB
PRINT HALF(1000)
PRINT GREET$("BOB")
PRINT PLUSONE(254)
PRINT TWICE(300)
SHOW(7)
