' INPUT2 -- a STRING parameter, a line cut at max, the rest of a line dropped, numbers
' in a SUB, several fields
DIM S$ * 3, N AS UWORD, B AS UBYTE
SUB READLINE(T$)
  LINPUT T$
ENDSUB
FUNCTION READNUMBER(K AS UBYTE) AS UWORD
  INPUT K
  RETURN K + 1
ENDFUNCTION
READLINE(S$)
PRINT S$; LEN(S$)
INPUT N
PRINT N
INPUT N
PRINT N
INPUT B
PRINT B
PRINT READNUMBER(0)
INPUT N, S$, B
PRINT N; S$; B
