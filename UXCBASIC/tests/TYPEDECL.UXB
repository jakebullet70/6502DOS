' TYPEDECL -- TYPE ... END TYPE, in the main program and in a namespace; LEN of a TYPE name
TYPE ITEM
  CODE AS UWORD
  QTY AS UBYTE
  NAME AS STRING * 20
END TYPE
TYPE POINT
  X AS UWORD
  Y AS UWORD
ENDTYPE
NAMESPACE DOS
  TYPE PSPREC
    INT20 AS UWORD
    TOP AS UWORD
    TAIL AS STRING * 127
  END TYPE
END NAMESPACE
PRINT LEN(ITEM); LEN(POINT); LEN(DOS.PSPREC)
DIM N AS UWORD
N = LEN(ITEM) * 3 + 1
PRINT N
DIM S$ * 10
S$ = "ABC"
PRINT LEN(S$); LEN("HELLO")
