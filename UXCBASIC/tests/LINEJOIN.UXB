' Line continuation: a _ at the end of a line joins the next line, several lines join, spaces
' and a tab may follow the _, and a _ in a string, a comment or a name does not join
DIM A AS UBYTE, _
    B AS UWORD
DIM C_ AS UBYTE
A = 1
B = 1000 + _
    200 + _
    34
C_ = 7
PRINT A; B; C_
PRINT "X _"
PRINT "AB"; _
  "CD"
PRINT "EF" ' G _
PRINT "HI" REM _
; COMMENT _
PRINT "JK"
// COMMENT _
PRINT "LM"
PRINT C_
IF A = 1 THEN _
  PRINT "YES"
