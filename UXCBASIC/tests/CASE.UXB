' UCASE$ and LCASE$ -- of a literal, a variable, a temp, and back into the source
DIM T$ * 20
DIM L$ * 255
T$ = "@AZ[`az{{ 09"
PRINT UCASE$("dir Docs"); "|"; LCASE$("DIR Docs"); "|"; UCASE$(""); "|"
PRINT UCASE$(T$); "|"; LCASE$(T$); "|"
PRINT LCASE$(UCASE$(LEFT$(T$, 4)) + "Mix"); "|"; LEN(UCASE$(T$))
T$ = UCASE$(T$)
PRINT T$
L$ = "a"
DO WHILE LEN(L$) < 255
    L$ = L$ + "b"
LOOP
L$ = UCASE$(L$)
PRINT LEN(L$); " "; LEFT$(L$, 3); RIGHT$(L$, 2)
