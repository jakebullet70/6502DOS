' ENUM -- members numbered from 0, = value, bare inside, qualified outside, BYTE or WORD
ENUM STATE
  READY            ' 0
  RUNNING          ' 1
  BLOCKED = 10
  DONE
  LAST = DONE + 5
END ENUM
ENUM COLOR
  RED, GREEN, BLUE
ENDENUM
ENUM BIGS
  SMALL = 250
  HUGE = 1000
  NEXTONE
END ENUM
PRINT STATE.READY; STATE.RUNNING; STATE.BLOCKED; STATE.DONE; STATE.LAST
PRINT COLOR.RED; COLOR.GREEN; COLOR.BLUE
PRINT BIGS.SMALL; BIGS.HUGE; BIGS.NEXTONE
DIM S AS UBYTE
S = STATE.BLOCKED
IF S = STATE.BLOCKED THEN PRINT "WAIT"
NAMESPACE GFX
  ENUM MODE
    TEXT, BITMAP
  END ENUM
END NAMESPACE
PRINT GFX.MODE.BITMAP
