' POW2 -- unsigned / and MOD by a power of 2, which compile as >> and AND
DIM A AS UBYTE, N AS UWORD, L AS ULONG, S AS WORD, T AS BYTE
A = 201
N = 54321
L = 3000000001
S = -7
T = -7
PRINT A / 2; A / 128; A MOD 2; A MOD 64; A / 256; A MOD 256
PRINT N / 2; N / 256; N / 32768; N MOD 16; N MOD 256; N MOD 32768
PRINT L / 2; L / 65536; L MOD 1024; L MOD 65536
PRINT S / 2; S MOD 2; T / 4; T MOD 4
PRINT N / 1; N MOD 1; N / 3; N MOD 3
