' ENUMBARE -- a bare member in an argument to a parameter of an ENUM's type
ENUM STATE
  READY, RUNNING, BLOCKED
END ENUM
NAMESPACE GFX
  ENUM MODE
    TEXT, BITMAP
  END ENUM
  SUB SHOW(M AS ENUM.MODE)
    PRINT "MODE"; M
  END SUB
END NAMESPACE
FUNCTION NEXTSTATE(S AS ENUM.STATE) AS ENUM.STATE
  RETURN S + 1
END FUNCTION
SUB TWO(S AS ENUM.STATE, N AS UBYTE)
  PRINT S; N
END SUB
DIM BLOCKED AS UBYTE
BLOCKED = 9
PRINT NEXTSTATE(READY)
GFX.SHOW(BITMAP)
TWO(NEXTSTATE(RUNNING), BLOCKED)
TWO(STATE.READY, NEXTSTATE(BLOCKED))
