' TEMPPOOL -- SUBs of one level share one pool of temps; a caller's temps outlive its calls
DIM G$ * 20
FUNCTION INNER$(S$)
  RETURN "(" + S$ + ")"
ENDFUNCTION
FUNCTION OUTER$(S$)
  RETURN "<" + INNER$(S$) + ">"
ENDFUNCTION
FUNCTION LEFTSIDE$(S$)
  RETURN "L" + S$
ENDFUNCTION
FUNCTION RIGHTSIDE$(S$)
  RETURN "R" + S$
ENDFUNCTION
FUNCTION TOP$(S$)
  RETURN OUTER$(S$) + "/" + LEFTSIDE$(S$)
ENDFUNCTION
G$ = "X"
PRINT OUTER$(G$)
PRINT LEFTSIDE$("A") + RIGHTSIDE$("B")
PRINT TOP$(G$)
PRINT INNER$(G$) + OUTER$("Y") + INNER$("Z")
