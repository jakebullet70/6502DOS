' SUBNEST -- calls inside the arguments of calls, and calls inside expressions
DIM A AS UWORD, B AS UWORD, C AS UWORD
FUNCTION MAX(P AS UWORD, Q AS UWORD) AS UWORD
  IF P > Q THEN RETURN P
  RETURN Q
ENDFUNCTION
FUNCTION ADD3(X AS UWORD, Y AS UWORD, Z AS UWORD) AS UWORD
  RETURN X + Y + Z
ENDFUNCTION
A = 5
B = 900
C = 77
PRINT MAX(A, MAX(B, C))
PRINT MAX(MAX(A, C), B)
PRINT ADD3(1, MAX(2, 3), ADD3(4, 5, 6))
PRINT 1000 + MAX(A, C) * 2
PRINT MAX(A, C) + MAX(B, A)
IF MAX(A, B) = 900 AND MAX(C, 1) = 77 THEN PRINT "YES"
PRINT MAX((A + 1) * 2, 3)
