' LONG1 -- LONG and ULONG: literals, + - * / MOD, widening, PRINT
DIM L AS LONG, M AS LONG, U AS ULONG, W AS UWORD, I AS INT, B AS BYTE
L = 100000
M = 3
PRINT L; M; L + M; L - M; L * M
PRINT L / M; L MOD M; -L / 7; -L MOD 7
U = 4294967295
PRINT U; U + 1; U / 65536
L = -2147483648
PRINT L; L - 1
PRINT 70000 * 70000; 2147483647 + 1
W = 65535
L = W
PRINT L; L + 1
I = -2
L = I
PRINT L; L * 1000000
B = -5
L = B
PRINT L
