' FLOWIF -- IF blocks, ELSEIF, ELSE, one-line IF, AND and OR in conditions
DIM A AS UBYTE, B AS UBYTE, N AS UWORD
A = 5
B = 10
N = 1000
IF A < B
  PRINT "LT"
ENDIF
IF A > B THEN
  PRINT "GT"
ELSE
  PRINT "NOT GT"
END IF
IF N = 1
  PRINT "ONE"
ELSEIF N = 1000 THEN
  PRINT "THOUSAND"
ELSEIF N > 0
  PRINT "POS"
ELSE
  PRINT "ZERO"
ENDIF
IF A = 5 THEN PRINT "ONE LINE"
IF A = 6 THEN PRINT "NO"
IF A < 9 AND B > 9 THEN PRINT "AND1"
IF A < 2 AND B > 9 THEN PRINT "NO"
IF A < 2 OR B > 9 THEN PRINT "OR1"
IF A < 2 OR B < 2 THEN PRINT "NO"
IF A = 1 OR A = 2 OR A = 5 THEN PRINT "OR3"
IF A = 5 AND B = 1 OR N = 1000 THEN PRINT "MIX1"
IF A = 1 OR B = 10 AND N = 1000 THEN PRINT "MIX2"
IF A = 1 OR B = 10 AND N = 7 THEN PRINT "NO"
IF NOT A = 5 THEN PRINT "NO"
IF NOT A = 6 THEN PRINT "NOT1"
IF A THEN PRINT "TRUE A"
IF N - 1000 THEN PRINT "NO"
IF NOT N - 1000 THEN PRINT "NOT2"
IF A AND 4 THEN PRINT "BIT"
IF A AND 2 THEN PRINT "NO"
IF (A > 1) AND (B > 1) THEN PRINT "PAREN"
IF N >= 1000 AND N <= 1000 THEN PRINT "RANGE"
IF N > 999 AND N < 1001 THEN PRINT "RANGE2"
IF B > A THEN PRINT "VARS"
IF A >= B THEN PRINT "NO"
IF A <= B THEN PRINT "LE"
IF 1 THEN PRINT "CONST"
IF 0 THEN PRINT "NO"
IF A = 5
  IF B = 10
    PRINT "NESTED"
  ENDIF
ENDIF
IF A = 5 THEN IF B = 10 THEN PRINT "NESTED1"
PRINT "DONE"
