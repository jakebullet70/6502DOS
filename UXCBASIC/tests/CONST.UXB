' CONST -- named numbers: folded as numbers, by mark or AS, in a namespace and a SUB
CONST MAX_LEN AS UBYTE = 80
CONST ROWS AS UBYTE = 2 * 30, COLS AS UBYTE = MAX_LEN + 1
CONST BASE AS UWORD = $9F20
CONST BIG AS UWORD = 1000
DIM A(ROWS / 10) AS UBYTE
DIM W AS UWORD
PRINT MAX_LEN; ROWS; COLS; BASE; BIG
W = BASE + 1
PRINT W - BASE
A(ROWS / 10 - 1) = MAX_LEN
PRINT A(5)
NAMESPACE SCREEN
  CONST WIDTH AS UBYTE = 80
  SUB HALF(N AS UBYTE)
    CONST TWO AS UBYTE = 2
    PRINT N / TWO
  ENDSUB
END NAMESPACE
PRINT SCREEN.WIDTH
SCREEN.HALF(SCREEN.WIDTH)
BIND SW = SCREEN.WIDTH
PRINT SW
