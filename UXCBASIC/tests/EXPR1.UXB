' EXPR1 -- operators, precedence, BYTE and WORD widths
DIM A AS UBYTE, B AS UBYTE, N AS UWORD, M AS UWORD
A = 200
B = 100
N = 1000
M = 7
PRINT A + B; A - B; B - A; A + 300
PRINT N * M; N / M; N MOD M; -M
PRINT 2 + 3 * 4; (2 + 3) * 4; 100 - 10 - 1; 2 * 3 MOD 4
PRINT N + A * 2; A * 2
PRINT $F0 AND $3C; $F0 OR $0F; $FF XOR $0F; N AND $FF
PRINT 1 << 4; N >> 2; A >> 4; A << 1
PRINT A > B; A < B; N = 1000; N <> 1000; M <= 7; M >= 8
PRINT NOT 0; NOT 5; NOT A = B; NOT (A > B); NOT N
PRINT N * M / M; (N + M) * (N - M)
B = N
M = A - B + 1
PRINT B; M
