' LOCALPOOL -- the locals of one level share a pool; a caller's locals outlive its calls
FUNCTION SUM(N AS UBYTE) AS UWORD
  DIM TOTAL AS UWORD, K AS UBYTE
  TOTAL = 0
  FOR K = 1 TO N
    TOTAL = TOTAL + K
  NEXT K
  RETURN TOTAL
ENDFUNCTION
FUNCTION TWICE(N AS UBYTE) AS UWORD
  DIM L(3) AS UWORD
  L(0) = N
  L(1) = N + N
  RETURN L(1)
ENDFUNCTION
FUNCTION NAMED$(N AS UBYTE)
  DIM S$ * 10
  S$ = S$ + "N"
  S$ = S$ + CHR$(64 + N)
  RETURN S$
ENDFUNCTION
FUNCTION BOTH(A AS UBYTE, B AS UBYTE) AS UWORD
  DIM KEEP AS UWORD
  KEEP = SUM(A)
  KEEP = KEEP + TWICE(B)
  RETURN KEEP + SUM(B)
ENDFUNCTION
PRINT SUM(10); TWICE(7); BOTH(4, 5)
PRINT NAMED$(3); NAMED$(2)
PRINT SUM(3) + TWICE(SUM(4))
