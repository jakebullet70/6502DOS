' LONG3 -- LONG compares, shifts, bit operators, STR$, a LONG stored in a WORD
DIM L AS LONG, U AS ULONG, W AS UWORD
L = 1000000
PRINT L > 999999; L < 999999; L = 1000000; L <> 1000000; L >= -1; L <= 0
U = 3000000000
PRINT U > 2000000000; U < 5
PRINT L << 4; L >> 3; -L >> 3
PRINT L AND 65535; L OR 1; L XOR L
PRINT STR$(L); STR$(-L); STR$(U); STR$(4294967295)
W = L
PRINT W
PRINT -100000
PRINT 4294967295 / 1; 4294967295 MOD 3000000000; -7000000 / 3; 100000 AND 65535
