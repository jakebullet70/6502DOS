' STR1 -- string variables: DIM, assignment, PRINT, +, LEN and the compares
DIM A$ * 10, B AS STRING * 5, N AS UBYTE
PRINT "["; A$; "]"; LEN(A$)
A$ = "HELLO"
B = "WORLD!"
PRINT A$; " "; B; LEN(A$); LEN(B)
A$ = A$ + "!"
PRINT A$
A$ = "ABCDEFGHIJKLMNOP"
PRINT A$; LEN(A$)
A$ = A$
PRINT A$ + "Z"; LEN(A$ + "Z")
PRINT "AB" + "CD"; B + "1"; B + "2"
IF A$ + "1" = A$ + "1" THEN PRINT "TWO TEMPS"
IF "ABC" < "ABD" THEN PRINT "LT"
IF "AB" < "ABC" THEN PRINT "PREFIX"
B = "X"
IF B = "X" THEN PRINT "EQ"
IF B <> "Y" THEN PRINT "NE"
IF "B" > "A" THEN PRINT "GT"
IF "B" >= "B" THEN PRINT "GE"
IF "A" <= "B" THEN PRINT "LE"
IF "A" > "B" OR B = "Q" THEN PRINT "WRONG"
N = "A" = "A"
PRINT N; "A" > "B"; NOT ("A" < "B")
PRINT "A";
PRINT "B"
