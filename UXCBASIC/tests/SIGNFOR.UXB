' SIGNFOR -- FOR with a signed counter: through 0, negative limits and steps, the clamps
DIM B AS BYTE, W AS WORD, L AS BYTE, M AS INT
FOR B = -3 TO 3
  PRINT B;
NEXT
PRINT
FOR B = 2 TO -2 STEP -1
  PRINT B;
NEXT
PRINT
FOR B = -128 TO 127 STEP 50
  PRINT B;
NEXT
PRINT B
FOR B = 127 TO -128 STEP -100
  PRINT B;
NEXT
PRINT B
FOR W = -1000 TO 1000 STEP 500
  PRINT W;
NEXT
PRINT
FOR W = 500 TO -500 STEP -250
  PRINT W;
NEXT
PRINT
L = -2
FOR B = -5 TO L
  PRINT B;
NEXT
PRINT
FOR B = 3 TO L STEP -2
  PRINT B;
NEXT
PRINT
M = -30000
FOR W = -32768 TO M STEP 1000
  PRINT W;
NEXT
PRINT
L = -125
FOR B = -128 TO L STEP 10
  PRINT B;
NEXT
PRINT
L = 125
FOR B = 127 TO L STEP -10
  PRINT B;
NEXT
PRINT
FOR B = 1 TO -1
  PRINT "NO"
NEXT
PRINT B
