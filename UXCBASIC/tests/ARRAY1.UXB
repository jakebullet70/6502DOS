' ARRAY1 -- BYTE and WORD arrays: constant, BYTE and WORD indexes, zero at the start
DIM B(10) AS UBYTE, W(5) AS UWORD, I AS UBYTE, J AS UWORD, S AS UWORD
PRINT B(3); W(4)
B(0) = 7
B(9) = 200
W(0) = 1000
W(4) = 65535
PRINT B(0); B(9); W(0); W(4)
FOR I = 0 TO 9
  B(I) = I * 3
NEXT
S = 0
FOR I = 0 TO 9
  S = S + B(I)
NEXT
PRINT S
FOR J = 0 TO 4
  W(J) = J * 1000
NEXT
PRINT W(J - 1); W(2)
I = 3
W(I) = 7
PRINT W(I); W(I + 1)
PRINT B(B(1))
