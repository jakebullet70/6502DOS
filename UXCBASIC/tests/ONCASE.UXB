' ONCASE -- ON CASE: lists, gaps, CASE ELSE, no CASE ELSE, 0 and 255, nesting, EXIT, and
' the tables after a SUB left out
SUB NEVER_CALLED()
  PRINT "NEVER"
ENDSUB
DIM I AS UBYTE, J AS UBYTE
FOR I = 0 TO 7
  ON CASE I
    CASE 2
      PRINT "TWO";
    CASE 3, 5
      PRINT "THREE OR FIVE";
    CASE ELSE
      PRINT "ELSE";
  END CASE
  PRINT I
NEXT I
FOR I = 3 TO 7
  ON CASE I + 1
    CASE 5
      PRINT "FIVE";
    CASE 7
      PRINT "SEVEN";
  ENDCASE
  PRINT I
NEXT I
FOR J = 0 TO 255 STEP 255
  ON CASE J
    CASE 255
      PRINT "MAX"
    CASE 0
      PRINT "ZERO"
  END CASE
NEXT J
J = 9
ON CASE J
  CASE ELSE
    PRINT "ONLY ELSE"
END CASE
FOR I = 1 TO 3
  FOR J = 1 TO 2
    ON CASE I
      CASE 1
        ON CASE J
          CASE 1
            PRINT "1-1 ";
          CASE 2
            PRINT "1-2 ";
        END CASE
      CASE 2
        PRINT "2 ";
      CASE ELSE
        PRINT "ELSE ";
    END CASE
  NEXT J
NEXT I
PRINT
DO
  ON CASE I
    CASE 4
      EXIT DO
  END CASE
  I = I + 1
LOOP
PRINT I
