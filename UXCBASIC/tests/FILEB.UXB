' FILEB -- READ and WRITE move raw bytes, CR, LF and 0 included
DIM F AS UWORD, N AS UWORD, IW AS UWORD, E AS UWORD, I AS UBYTE, B(40) AS UBYTE, C(60) AS UBYTE, S$ * 4
FOR I = 0 TO 39
    B(I) = I + 65
NEXT
B(1) = 13
B(2) = 10
B(3) = 0
F = OPEN("FILEB.BIN", O.WRITE)
WRITE F, @B, 40
WRITE F, @B, 0
CLOSE F
F = OPEN("FILEB.BIN", O.READ)
N = READ(F, @C, 15)
PRINT N; EOF(F)
N = READ(F, @C + 15, 45)
PRINT N; EOF(F)
N = READ(F, @C, 10)
PRINT N
CLOSE F
E = 0
FOR IW = 0 TO 39
    IF C(IW) <> B(IW) THEN E = E + 1
NEXT
PRINT E
F = OPEN("FILEB.BIN", O.READ)
PRINT READ(F, @C, 0); READ(F, @C, 40) + 1
CLOSE F
S$ = "HI"
WRITE 1, @S$ + 2, 2
PRINT
