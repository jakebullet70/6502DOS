' ARRAY2 -- an array in a SUB, @name of an array, a WORD index into a BYTE array
DIM B(10) AS UBYTE, J AS UWORD
SUB FILL(N AS UBYTE)
  DIM L(3) AS UWORD
  L(0) = N
  L(1) = N * 2
  L(2) = L(0) + L(1)
  PRINT L(2)
ENDSUB
FOR J = 0 TO 9
  B(J) = J * 3
NEXT
PRINT PEEK(@B + 2)
J = 5
PRINT B(J)
PRINT B(2) + B(3) * 2
FILL(4)
PRINT B(9) = 27
