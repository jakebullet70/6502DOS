' JUMPOUT -- a branch that ends in RETURN, GOTO, EXIT, CONTINUE or END, before ELSEIF, ELSE
' or CASE; a branch that ends in IF c THEN RETURN still jumps out
DIM I AS UBYTE
FOR I = 0 TO 4
  PRINT CLASSIFY(I); PICK_RANGE(I);
NEXT I
PRINT
FOR I = 0 TO 9
  IF I = 2 THEN
    GOTO SKIPPED
  ELSEIF I = 4 THEN
    CONTINUE
  ELSEIF I = 6 THEN
    EXIT FOR
  ELSE
    PRINT I;
  ENDIF
  PRINT "-";
SKIPPED:
NEXT I
PRINT
FOR I = 0 TO 3
  ON CASE I
    CASE 0
      CONTINUE
    CASE 1
      PRINT "ONE";
    CASE 2
      EXIT FOR
  END CASE
  PRINT I;
NEXT I
PRINT
IF I = 0 THEN
  END
ELSE
  PRINT "TWO"
ENDIF
IF I = 2 THEN
  PRINT "BYE"
  END
ELSE
  PRINT "NO"
ENDIF
PRINT "NOT HERE"

FUNCTION CLASSIFY(N AS UBYTE) AS UBYTE
  IF N = 0 THEN
    RETURN 10
  ELSEIF N < 3 THEN
    IF N = 1 THEN RETURN 11
  ELSE
    RETURN 12
  ENDIF
  RETURN 13
END FUNCTION

FUNCTION PICK_RANGE(N AS UBYTE) AS UBYTE
  SELECT CASE N
    CASE 0
      RETURN 20
    CASE 1 TO 3
      IF N = 1 THEN RETURN 21
    CASE ELSE
      RETURN 22
  END SELECT
  RETURN 23
END FUNCTION
