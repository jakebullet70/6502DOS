' DEADSUB -- SUBs nothing calls are left out: one between live SUBs, a chain only a dead SUB
' calls, a dead SUB passing arguments to a live one, a FUNCTION, a string and a FOR loop
' after the cut, a GOTO across it
DIM I AS UBYTE, S AS UWORD
GOTO START
SUB UNUSED1()
  PRINT "NEVER 1"
  CALL ONLYDEAD()
  CALL INNER(9)
  S = TWICE(7)
ENDSUB
SUB ONLYDEAD()
  PRINT "NEVER 2"
ENDSUB
START:
CALL OUTER(3)
FOR I = 1 TO 3
  S = S + TWICE(I)
NEXT I
PRINT S
IF S > 5 THEN GOTO DONE
PRINT "SKIPPED"
DONE:
PRINT "END"
END
SUB OUTER(N AS UBYTE)
  PRINT "OUTER"; N
  CALL INNER(N + 1)
ENDSUB
FUNCTION UNUSED2(V AS UBYTE) AS UWORD
  RETURN V * 1000
ENDFUNCTION
SUB INNER(N AS UBYTE)
  DIM T AS STRING * 10
  T = "INNER"
  PRINT T; N
ENDSUB
FUNCTION TWICE(V AS UBYTE) AS UWORD
  RETURN V + V
ENDFUNCTION
