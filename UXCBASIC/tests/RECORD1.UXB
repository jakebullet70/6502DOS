' RECORD1 -- a single record: DIM AS a TYPE, BYTE and WORD fields, LEN, @, a copy, AT, a local
TYPE ITEM
  CODE AS UWORD
  QTY AS UBYTE
END TYPE
NAMESPACE DOS
  TYPE PSPREC
    INT20 AS UWORD
    TOP AS UWORD
  END TYPE
  DIM PSP AS PSPREC AT $0700
END NAMESPACE
DIM R AS ITEM, S AS ITEM
R.CODE = 1000
R.QTY = 7
PRINT R.CODE; R.QTY; R.CODE + R.QTY
S = R
S.QTY = S.QTY + 1
PRINT S.CODE; S.QTY; R.QTY
PRINT LEN(R); @S - @R; @S.QTY - @S
DOS.PSP.TOP = $1234
PRINT ContentsAtW($0702); @DOS.PSP.TOP
PRINT PEEK(@R + 2)
SUB SHOW()
  DIM L AS ITEM
  L = R
  L.CODE = L.CODE + 1
  PRINT L.CODE; L.QTY
END SUB
SHOW()
PRINT "DONE"
