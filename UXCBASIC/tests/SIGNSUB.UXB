' SIGNSUB -- signed parameters, FUNCTION results, arrays, fields and CONSTs
CONST LOW AS BYTE = -100, HIGH AS WORD = -20000
DIM A(3) AS BYTE, I AS UBYTE, S AS WORD
TYPE PT
  X AS INT
  Y AS BYTE
END TYPE
DIM P AS PT
FUNCTION HALF(N AS WORD) AS WORD
  RETURN N / 2
END FUNCTION
FUNCTION NEG(N AS BYTE) AS BYTE
  RETURN -N
END FUNCTION
SUB SHOW(N AS BYTE)
  PRINT N;
END SUB
PRINT LOW; HIGH; LOW < 0; HIGH / 1000
A(0) = -1
A(1) = -2
A(2) = 3
S = 0
FOR I = 0 TO 2
  S = S + A(I)
NEXT
PRINT S; A(1) < A(2)
P.X = -300
P.Y = -7
PRINT P.X; P.Y; P.X < P.Y
PRINT HALF(-301); NEG(5); NEG(-5)
SHOW(-9)
SHOW(LOW)
PRINT
