' Escaped strings: a ! before the quote takes FreeBASIC's escapes, a string with no ! keeps
' its \, the digits of an escape stop at their most, and a \" does not hide a _ that joins
CONST REVERSE$ = !"\27[7m"
PRINT "C:\DOS\N"
PRINT !"A\\B\"C\'D"
PRINT ASC(!"\a"); ASC(!"\b"); ASC(!"\t"); ASC(!"\n"); ASC(!"\l"); ASC(!"\v"); ASC(!"\f")
PRINT ASC(!"\r"); ASC(!"\T"); ASC(!"\27"); ASC(!"\255"); ASC(!"\&h1B"); ASC(!"\&HfF")
PRINT ASC(!"\&o33"); ASC(!"\&B11011"); ASC(!"\&b11111111")
PRINT !"\65\66C"; !"\0654"; !"\&h414"; !"\&o1014"
PRINT LEN(!"\0X"); ASC(!"\0X"); LEN(REVERSE$); ASC(REVERSE$); MID$(REVERSE$, 2)
PRINT !"\" _"; _
  "Y"
PRINT !"\\"; _
  "Z"
PRINT "\"; _
  "W"
