' IF on a constant: the branch that never runs is cut.
CONST YES AS UBYTE = 1, NO AS UBYTE = 0
DIM COUNT AS UBYTE

SUB ONLY_DEAD()
  PRINT "NEVER"
END SUB

IF NO = 1 THEN
  PRINT "A WRONG"
  ONLY_DEAD()
END IF
IF YES = 1 THEN
  PRINT "B RIGHT"
ELSE
  PRINT "B WRONG"
END IF
IF NO THEN
  PRINT "C WRONG"
ELSE
  PRINT "C RIGHT"
END IF
COUNT = 2
IF COUNT = 1 THEN
  PRINT "D WRONG"
ELSEIF NO THEN
  PRINT "D WRONG 2"
ELSEIF YES THEN
  PRINT "D RIGHT"
ELSE
  PRINT "D WRONG 3"
END IF
IF NO THEN PRINT "E WRONG"
IF YES THEN PRINT "E RIGHT"
IF NO THEN
  IF YES THEN
    PRINT "F WRONG"
  END IF
END IF
DO
  COUNT = COUNT + 1
  IF NO THEN EXIT DO
  IF COUNT = 5 THEN EXIT DO
LOOP
PRINT "G "; COUNT
IF COUNT = 9 THEN
  PRINT "H WRONG"
ELSEIF YES THEN
  PRINT "H RIGHT"
END IF
