' KEEPSUB -- #KEEP keeps SUBs nothing calls: by name before and after the SUB, a SUB that a
' kept SUB calls, and the SUBs inside #KEEP ... #ENDKEEP. Only DROPPED is left out.
#KEEP KEPT1
DIM S AS UWORD
S = 5
PRINT "MAIN"; S
END
SUB KEPT1()
  PRINT "KEPT 1"
  CALL CHAINED()
ENDSUB
SUB CHAINED()
  PRINT "CHAINED"
ENDSUB
SUB DROPPED()
  PRINT "DROPPED"
ENDSUB
#KEEP
SUB REGION1()
  PRINT "REGION 1"
ENDSUB
FUNCTION REGION2(V AS UBYTE) AS UWORD
  RETURN V + 1
ENDFUNCTION
#ENDKEEP
SUB KEPT2()
  PRINT "KEPT 2"
ENDSUB
#KEEP KEPT2, REGION1
