' SELECT -- SELECT CASE: values, lists, ranges, IS, CASE ELSE, no match, strings, an
' expression selector, INT, LONG, nesting, in a SUB, EXIT from a loop
DIM I AS UBYTE, W AS UWORD, N AS INT, L AS LONG, M$ * 8
FOR I = 0 TO 9
  SELECT CASE I
    CASE 1
      PRINT "ONE";
    CASE 2, 4
      PRINT "TWO OR FOUR";
    CASE 5 TO 7
      PRINT "FIVE TO SEVEN";
    CASE IS >= 8
      PRINT "EIGHT UP";
    CASE ELSE
      PRINT "ELSE";
  END SELECT
  PRINT I
NEXT I
FOR W = 998 TO 1002
  SELECT CASE W
    CASE 999, 1001 TO 1001
      PRINT "ODD";
    CASE IS < 999
      PRINT "LOW";
  ENDSELECT
  PRINT W
NEXT W
FOR N = -2 TO 2
  SELECT CASE N
    CASE IS < 0
      PRINT "NEG";
    CASE 0
      PRINT "ZERO";
    CASE IS > 0
      PRINT "POS";
  END SELECT
  PRINT N
NEXT N
L = 70000
SELECT CASE L
  CASE 1 TO 65535
    PRINT "WORD"
  CASE 65536 TO 100000
    PRINT "LONG"
END SELECT
FOR I = 1 TO 4
  SELECT CASE I * 3 + 1
    CASE 4, 13
      PRINT "A";
    CASE 7
      PRINT "B";
    CASE ELSE
      PRINT "C";
  END SELECT
NEXT I
PRINT
M$ = "GOTO"
SHOW_WORD()
M$ = "IF"
SHOW_WORD()
M$ = "BYE"
SHOW_WORD()
FOR I = 1 TO 2
  FOR W = 1 TO 2
    SELECT CASE I
      CASE 1
        SELECT CASE W
          CASE 1
            PRINT "1-1 ";
          CASE 2
            PRINT "1-2 ";
        END SELECT
      CASE ELSE
        PRINT "2 ";
    END SELECT
  NEXT W
NEXT I
PRINT
I = 0
DO
  SELECT CASE I
    CASE 3
      EXIT DO
  END SELECT
  I = I + 1
LOOP
PRINT I
SELECT CASE I
END SELECT
PRINT "END"

SUB SHOW_WORD()
  DIM K AS UBYTE
  K = 2
  SELECT CASE M$
    CASE "IF", "ELSE"
      PRINT "FLOW"
    CASE "GOTO"
      SELECT CASE K + 1
        CASE 3
          PRINT "JUMP"
      END SELECT
    CASE ELSE
      PRINT "OTHER"
  END SELECT
END SUB
