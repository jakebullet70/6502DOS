' SUB1 -- SUBs with and without a value, CALL and a bare call, RETURN early
DIM T AS UWORD, B AS UBYTE
FUNCTION ADD(A AS UWORD, BW AS UWORD) AS UWORD
  RETURN A + BW
ENDFUNCTION
SUB SHOW(N AS UBYTE)
  PRINT N
ENDSUB
FUNCTION TWICE(X AS UWORD) AS UWORD
  RETURN X * 2
END FUNCTION
SUB EARLY(N AS UBYTE)
  IF N > 5 THEN RETURN
  PRINT "SMALL"; N
ENDSUB
T = ADD(2, 3)
PRINT T
CALL SHOW(7)
SHOW(8)
PRINT TWICE(300)
EARLY(3)
EARLY(9)
B = 4
PRINT ADD(B, 1000) + 1
FUNCTION NOARGS() AS UBYTE
  RETURN 42
ENDFUNCTION
PRINT NOARGS()
CALL NOARGS()
