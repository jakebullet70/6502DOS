' ASMBYTES -- bytes into the code, on one line and in a block
DIM N AS UBYTE, W AS UWORD
ASM $DA, $A9, 65, $20, $03B8, $FA    ' phx : lda #65 : jsr con_out : plx
PRINT
ASM
    $A9, 66          ' lda #66
    $8D, @N         ' sta N

    $A9, $34
    $8D, @W
    $A9, $12
    $8D, @W + 1
END ASM
PRINT N; W
ASM
    $EA
ENDASM
PRINT "OK"
