' FILER -- INPUT #, LINPUT # and EOF, with CR, LF and CR LF line ends
DIM F AS UWORD, L$ * 40, A$ * 20, B$ * 1, N AS UWORD, C AS UWORD
F = OPEN("FILER.TXT", O.WRITE)
PRINT #F, "ONE, TWO"
PRINT #F, "X"; CHR$(10); "Y"; CHR$(13); CHR$(10); "Z"
PRINT #F, "AB", 42
PRINT #F, "LONG"
CLOSE F
F = OPEN("FILER.TXT", O.READ)
LINPUT #F, L$
PRINT "["; L$; "]"
INPUT #F, A$
PRINT "["; A$; "]"
INPUT #F, A$
PRINT "["; A$; "]"
LINPUT #F, L$
PRINT "["; L$; "]"
INPUT #F, A$, N
PRINT "["; A$; "]"; N
PRINT EOF(F)
LINPUT #F, B$
PRINT "["; B$; "]"
PRINT EOF(F)
LINPUT #F, L$
PRINT "["; L$; "]"
CLOSE F
F = OPEN("FILER.TXT", O.READ)
C = 0
DO WHILE NOT EOF(F)
    LINPUT #F, L$
    C = C + 1
LOOP
CLOSE F
PRINT C
F = OPEN("FILER.TXT", O.WRITE)
CLOSE F
F = OPEN("FILER.TXT", O.READ)
PRINT EOF(F)
CLOSE F
PRINT EOF(NOFILE)
