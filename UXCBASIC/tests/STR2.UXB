' STR2 -- LEN, ASC, VAL, CHR$, STR$ and MID$
DIM S$ * 20, W AS UWORD, B AS UBYTE
S$ = "HELLO WORLD"
PRINT LEN("ABC"); ASC("A"); ASC("")
PRINT ASC(S$); LEN(S$)
PRINT CHR$(65); CHR$(66 + 1)
B = 72
PRINT CHR$(B) + "I"
PRINT STR$(123); "|"
W = 4567
PRINT STR$(W); "|"; LEN(STR$(W))
PRINT VAL("123") + 1
PRINT VAL(" -5")
PRINT VAL("12AB"); VAL("ABC")
PRINT MID$(S$, 7)
PRINT MID$(S$, 1, 5)
PRINT MID$(S$, 3, 2); "|"; MID$(S$, 20, 3); "|"
B = 2
PRINT MID$(S$, B + 1, B + 1)
S$ = MID$(S$, 7, 5) + "!"
PRINT S$
PRINT MID$(STR$(W), 2); LEN(MID$(S$, 2))
PRINT W + LEN(S$ + S$) * 2
