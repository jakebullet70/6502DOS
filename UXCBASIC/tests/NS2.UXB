' nested and reopened namespaces, relative names, BIND
DIM TOTAL AS UWORD
NAMESPACE OUTER
  DIM A AS UBYTE
  NAMESPACE INNER
    DIM B AS UBYTE
    SUB SETB(V AS UBYTE)
      B = V
      A = V + 1
      TOTAL = TOTAL + V
    ENDSUB
  END NAMESPACE
  SUB USEINNER()
    INNER.SETB(10)
  ENDSUB
ENDNAMESPACE
NAMESPACE OUTER
  DIM C AS UBYTE
END NAMESPACE
SUB SHOW(N AS UBYTE)
  DIM SEEN AS UBYTE
  SEEN = N + 1
ENDSUB
OUTER.USEINNER()
OUTER.C = 3
SHOW(77)
PRINT OUTER.A; OUTER.INNER.B; OUTER.C; TOTAL
BIND I = OUTER.INNER
BIND S = I.SETB
BIND T = TOTAL
S(4)
PRINT I.B; T
