' DIMADDR -- DIM name AT address: BYTE and WORD variables at fixed addresses
DIM REG_A AS UBYTE AT $030C, REG_X AS UBYTE AT $030D, REG_Y AS UBYTE AT $030E, REG_P AS UBYTE AT $030F
DIM PAIR AS UWORD AT $9E00, LOW AS UBYTE AT $9E00
DIM HIGH AS UBYTE AT $9E00 + 1, I AS UBYTE AT $9E02
PAIR = $1234
PRINT LOW; HIGH; PEEK($9E01)
LOW = 7
PRINT PAIR
PRINT @REG_P
' SYS with the registers by name
REG_P = 0
REG_A = 65
SYS $03B8                    ' con_out
PRINT
' sec and rts at $9E10: the carry comes back in REG_P
POKE $9E10, $38
POKE $9E11, $60
SYS $9E10
IF REG_P AND 1 THEN PRINT "CARRY"
' FOR over a variable at an address
FOR I = 1 TO 3
    PRINT PEEK($9E02);
NEXT I
PRINT
' ASM: @name of a variable at an address is two bytes
ASM $AD, @HIGH               ' lda $9E01
ASM $8D, @REG_A              ' sta $030C
PRINT REG_A
