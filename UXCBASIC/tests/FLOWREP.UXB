' FLOWREP -- REPEAT with a constant, a BYTE and a WORD count, and with none
DIM C AS UWORD, N AS UBYTE, M AS UWORD
C = 0
REPEAT 10
  C = C + 1
END REPEAT
PRINT C
C = 0
REPEAT 0
  C = C + 1
ENDREPEAT
PRINT C
N = 0
C = 0
REPEAT N
  C = C + 1
END REPEAT
PRINT C
N = 255
C = 0
REPEAT N
  C = C + 1
END REPEAT
PRINT C
M = 256
C = 0
REPEAT M
  C = C + 1
END REPEAT
PRINT C
M = 1000
C = 0
REPEAT M
  C = C + 1
END REPEAT
PRINT C
C = 0
REPEAT 300
  C = C + 1
END REPEAT
PRINT C
C = 0
REPEAT
  C = C + 1
  IF C = 77 THEN EXIT REPEAT
END REPEAT
PRINT C
C = 0
M = 0
REPEAT 5
  C = C + 1
  IF C = 2 THEN CONTINUE
  M = M + 1
END REPEAT
PRINT C; M
REPEAT 3
  REPEAT 2
    PRINT "X";
  END REPEAT
  PRINT "/";
END REPEAT
PRINT
