' DEADSTR -- the string literals of SUBs nothing calls are left out, and so is a literal of a
' CONST only a dead SUB uses. The literals after each one left out move down. A literal that a
' dead SUB shares with live code is kept.
CONST ONLY_DEAD$ = "ONLY IN A DEAD SUB"
CONST LIVE_TEXT$ = "CONST TEXT"
PRINT "FIRST"
SUB GONE_ONE()
  PRINT "GONE ONE"
  PRINT ONLY_DEAD$
END SUB
PRINT "SECOND"
SUB GONE_TWO()
  PRINT "GONE TWO"
  PRINT "SHARED"
END SUB
PRINT "SHARED"
PRINT "THIRD"
PRINT LIVE_TEXT$
END
