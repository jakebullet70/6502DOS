' DEADVAR -- global variables nothing names get no room: a BYTE, an array, a string and a
' record never used, and a WORD only a dead SUB uses. The variables after each one left out
' move down: a WORD, an array, a string with its max, a record and a BYTE still work.
TYPE ITEM
  CODE AS UWORD
  QTY AS UBYTE
END TYPE
DIM GAP1 AS UBYTE, KEPTW AS UWORD
DIM GAP2(20) AS UWORD, KEPTA(4) AS UBYTE
DIM GAP3 AS STRING * 30
DIM KEPTS AS STRING * 8
DIM GAP4 AS ITEM, KEPTR AS ITEM
DIM ONLYDEAD AS UWORD, LAST AS UBYTE
KEPTW = 1234
KEPTA(3) = 77
KEPTS = "HELLO WORLD"
KEPTR.CODE = 500
KEPTR.QTY = 9
LAST = 42
PRINT KEPTW; KEPTA(3); KEPTS; KEPTR.CODE; KEPTR.QTY; LAST
END
SUB UNUSED()
  ONLYDEAD = 5
ENDSUB
