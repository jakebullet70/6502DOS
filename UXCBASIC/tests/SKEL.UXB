' SKEL.UXB -- what the step 2 skeleton compiles
REM a whole-line comment
; a whole-line comment
## a whole-line comment
// a whole-line comment
DIM A AS UBYTE, B AS UWORD
VAR C AS UWORD, D AS UBYTE
A = 200 ' a trailing comment
B = 54321 REM a trailing comment
c = $FFFF
d = %101
PRINT "HELLO FROM UXCBASIC"
PRINT "A = "; A
PRINT "B% = "; B;
PRINT " / C = "; C
print "D = "; D; " / "; 0; " / "; 65535
DONE:
END
