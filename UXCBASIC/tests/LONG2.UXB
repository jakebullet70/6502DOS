' LONG2 -- LONG arrays, record fields, SUB parameters, FUNCTION results, CONST
CONST BIG AS LONG = -70000, HUGE AS ULONG = 4000000000
TYPE SIZES
  NAME AS STRING * 8
  BYTES AS ULONG
END TYPE
DIM A(4) AS LONG, F AS SIZES, R(2) AS SIZES, I AS UBYTE, T AS LONG
FUNCTION TWICE(N AS LONG) AS LONG
  RETURN N * 2
END FUNCTION
SUB SHOW(N AS LONG, U AS ULONG)
  PRINT N; U
END SUB
FOR I = 0 TO 3
  A(I) = BIG * I
NEXT I
PRINT A(0); A(1); A(2); A(3)
T = 0
FOR I = 0 TO 3
  T = T + A(I)
NEXT I
PRINT T
F.BYTES = HUGE
PRINT F.BYTES; F.BYTES + 1
R(1).BYTES = 123456789
I = 1
PRINT R(I).BYTES
PRINT TWICE(BIG); TWICE(TWICE(100000))
SHOW(BIG, HUGE)
SHOW(TWICE(-3), 7)
PRINT BIG; HUGE
